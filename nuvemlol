do
    local uiSource = game:HttpGet(
        "https://raw.githubusercontent.com/ghostofcelleron/Celeron/refs/heads/main/ui"
    )

    local function replacePlain(source, old, new)
        local startAt = 1
        while true do
            local first, last = string.find(source, old, startAt, true)
            if not first then break end
            source = string.sub(source, 1, first - 1) .. new .. string.sub(source, last + 1)
            startAt = first + #new
        end
        return source
    end

    uiSource = replacePlain(
        uiSource,
        "while task.wait() do",
        "while task.wait(0.25) do"
    )

    uiSource = replacePlain(
        uiSource,
        [=[game:GetService("RunService").Heartbeat:Connect(function()
			local elapsedTime = tick() - startTime
			clockLabel.Text = "Time Open: " .. formatTime(elapsedTime) 
		end)]=],
        [=[clockLabel.Text = "Celeron"]=]
    )

    uiSource = replacePlain(
        uiSource,
        [=[local lastTime = tick()
	local frameCount = 0

	if not RunService:IsStudio() then
		RunService.RenderStepped:Connect(function()
			frameCount = frameCount + 1
			local currentTime = tick()
			if currentTime - lastTime >= 1 then
				fps.Text = "FPS: " .. frameCount
				frameCount = 0
				lastTime = currentTime
			end

			local pinge = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) -- seconds to milliseconds
			ping.Text = "PING: " .. pinge .. "ms"
		end)
	end]=],
        [=[fps.Visible = false
	ping.Visible = false]=]
    )

    uiSource = replacePlain(
        uiSource,
        [=[local dragging = false
			local currentValue = initialValue]=],
        [=[local dragging = false
			local dragConnection = nil
			local currentValue = initialValue]=]
    )

    uiSource = replacePlain(
        uiSource,
        [=[slider.InputBegan:Connect(function(input)
				if valueLabel:IsFocused() then return end

				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					setValueFromX(input.Position.X)
				end
			end)]=],
        [=[slider.InputBegan:Connect(function(input)
				if valueLabel:IsFocused() then return end

				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					setValueFromX(input.Position.X)

					if dragConnection then
						dragConnection:Disconnect()
					end

					dragConnection = UIS.InputChanged:Connect(function(changed)
						if not dragging then return end
						if changed.UserInputType == Enum.UserInputType.MouseMovement
							or changed.UserInputType == Enum.UserInputType.Touch then
							setValueFromX(changed.Position.X)
						end
					end)
				end
			end)]=]
    )

    uiSource = replacePlain(
        uiSource,
        [=[RunService.RenderStepped:Connect(function()
				if dragging then
					local mousePos = UIS:GetMouseLocation()
					setValueFromX(mousePos.X)
				end
			end)

			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)]=],
        [=[UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
					if dragConnection then
						dragConnection:Disconnect()
						dragConnection = nil
					end
				end
			end)]=]
    )

    local uiChunk, uiError = loadstring(uiSource)
    assert(uiChunk, uiError)
    ui = uiChunk()
end

