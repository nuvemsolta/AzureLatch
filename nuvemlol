do
    task.defer(function()
        task.wait()

        local localPlayer = game:GetService("Players").LocalPlayer
        local tweenService = game:GetService("TweenService")
        local soundService = game:GetService("SoundService")
        local debris = game:GetService("Debris")

        local darkUI = game:GetService("CoreGui"):FindFirstChild("dark_UI")
            or localPlayer.PlayerGui:FindFirstChild("dark_UI")

        local main = darkUI and darkUI:FindFirstChild("main")
        local tabs = main and main:FindFirstChild("tabContainer")

        if not main or not tabs then
            return
        end

        local mainScale = main:FindFirstChild("celeronscale")

        if not mainScale then
            mainScale = Instance.new("UIScale")
            mainScale.Name = "celeronscale"
            mainScale.Scale = 1
            mainScale.Parent = main
        end

        local openTween

        local function playOpen()
            if openTween then
                openTween:Cancel()
            end

            mainScale.Scale = 0.965

            openTween = tweenService:Create(
                mainScale,
                TweenInfo.new(
                    0.22,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Scale = 1
                }
            )

            openTween:Play()
        end

        local function playOpenSound()
            local sound = Instance.new("Sound")
            sound.SoundId = "rbxassetid://6895079853"
            sound.Volume = 0.12
            sound.PlaybackSpeed = 0.95
            sound.Parent = soundService
            sound:Play()
            debris:AddItem(sound, 1)
        end

        local function hookTab(button)
            if not button:IsA("TextButton")
                or button:GetAttribute("celeronanimated") then
                return
            end

            button:SetAttribute("celeronanimated", true)

            local scale = Instance.new("UIScale")
            scale.Name = "tabscale"
            scale.Scale = 1
            scale.Parent = button

            button.Activated:Connect(function()
                tweenService:Create(
                    scale,
                    TweenInfo.new(
                        0.055,
                        Enum.EasingStyle.Quad,
                        Enum.EasingDirection.Out
                    ),
                    {
                        Scale = 0.9
                    }
                ):Play()

                task.delay(0.055, function()
                    if not scale.Parent then
                        return
                    end

                    tweenService:Create(
                        scale,
                        TweenInfo.new(
                            0.14,
                            Enum.EasingStyle.Back,
                            Enum.EasingDirection.Out
                        ),
                        {
                            Scale = 1
                        }
                    ):Play()
                end)
            end)
        end

        for _, button in ipairs(tabs:GetChildren()) do
            hookTab(button)
        end

        tabs.ChildAdded:Connect(function(child)
            task.defer(function()
                hookTab(child)
            end)
        end)

        playOpen()

        local wasHidden = main.Position.Y.Scale > 1

        main:GetPropertyChangedSignal("Position"):Connect(function()
            local y = main.Position.Y.Scale

            if y > 1 then
                wasHidden = true
                return
            end

            if wasHidden and y < 0.95 then
                wasHidden = false
                playOpen()
                playOpenSound()
            end
        end)
    end)
end


