        -- ========================================================
        -- SAE AUTO REFLEX RABONA NUTMEG TACKLING
        -- Recovered behavior:
        --   * only while Sae's generic tackle animation is playing
        --   * remember a nearby (<=15) ball owner
        --   * after the local player wins the ball, listen for one of the
        --     three captured reflex sounds on that previous owner
        --   * when still within 12 studs, trigger Tspecialer (when ready)
        --     followed by skill2
        -- ========================================================
        local function addSaeAutoReflexN(section)
            local state = {
                enabled = false,
                target = nil,
                triggered = false,
            }

            local tackleAnimation = "109744655458082"
            local reflexSounds = {
                ["91659314150979"] = true,
                ["113245624532376"] = true,
                ["101213707639775"] = true,
            }

            local function localTacklePlaying()
                local char = LocalPlayerN.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then return false end

                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    local id = track.Animation and tostring(track.Animation.AnimationId) or ""
                    if id:find(tackleAnimation, 1, true) then
                        return true
                    end
                end
                return false
            end

            local function hasReflexSound(model)
                local root = model and model:FindFirstChild("HumanoidRootPart")
                if not root then return false end

                for _, child in ipairs(root:GetChildren()) do
                    if child:IsA("Sound") then
                        local id = tostring(child.SoundId or "")
                        for wanted in pairs(reflexSounds) do
                            if id:find(wanted, 1, true) then
                                return true
                            end
                        end
                    end
                end
                return false
            end

            local function reset()
                state.target = nil
                state.triggered = false
            end

            task.spawn(function()
                while true do
                    if not state.enabled then
                        task.wait(1)
                        continue
                    end

                    if getStyleN() ~= "sae" then
                        reset()
                        task.wait(1)
                        continue
                    end

                    local char = LocalPlayerN.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if not hum or not root then
                        task.wait()
                        continue
                    end

                    if not localTacklePlaying() then
                        reset()
                        task.wait()
                        continue
                    end

                    local characters = WorkspaceN:FindFirstChild("characters")
                    if not characters then
                        task.wait()
                        continue
                    end

                    if not state.target then
                        for _, model in ipairs(characters:GetChildren()) do
                            if model.Name ~= LocalPlayerN.Name and model:FindFirstChild("Ball") then
                                local targetRoot = model:FindFirstChild("HumanoidRootPart")
                                if targetRoot and (targetRoot.Position - root.Position).Magnitude <= 15 then
                                    state.target = model
                                    break
                                end
                            end
                        end
                    else
                        local localHasBall = char:FindFirstChild("Ball") ~= nil
                        local targetHasBall = state.target:FindFirstChild("Ball") ~= nil

                        if localHasBall and not targetHasBall and not state.triggered then
                            local targetRoot = state.target:FindFirstChild("HumanoidRootPart")
                            if targetRoot
                                and (targetRoot.Position - root.Position).Magnitude <= 12
                                and hasReflexSound(state.target) then

                                state.triggered = true
                                if not onCooldownN("Tspecialer") then
                                    fireSkillN("Tspecialer")
                                    task.wait()
                                end
                                fireSkillN("skill2")
                            end
                        end
                    end

                    task.wait()
                end
            end)

            local path = "Player_Sae_Rabona Nutmeg Aimbot_Auto Reflex Rabona Nutmeg Tackling"
            local _, initial = addToggleN(
                section,
                path,
                "Auto Reflex Rabona Nutmeg Tackling",
                false,
                function(v)
                    state.enabled = v
                    if not v then reset() end
                end
            )
            state.enabled = initial
            return state
        end

