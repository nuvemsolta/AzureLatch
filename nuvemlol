            return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        end

        local mouse = UserInputService:GetMouseLocation()
        return Vector2.new(mouse.X, mouse.Y)
    end

    local function closestTeammate(useCenter)
        local camera = Workspace.CurrentCamera
        local point = aimPoint(useCenter)
        if not camera or not point then return nil end

        local bestOnScreen, bestOnScreenDist = nil, math.huge
        local bestForward, bestForwardDist = nil, math.huge

        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= passPlayer and other.Team == passPlayer.Team then
                local character = other.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")

                if humanoid and root and humanoid.Health > 0 then
                    local screen, onScreen = camera:WorldToViewportPoint(root.Position)
                    if screen.Z > 0 then
                        local distance = (Vector2.new(screen.X, screen.Y) - point).Magnitude

                        if onScreen and distance < bestOnScreenDist then
                            bestOnScreenDist = distance
                            bestOnScreen = character
                        end

                        if useCenter and distance < bestForwardDist then
                            bestForwardDist = distance
                            bestForward = character
                        end
                    end
                end
            end
        end

        return bestOnScreen or (useCenter and bestForward or nil)
    end

    local function inLobby()
        local teams = game:GetService("Teams")
        local lobby = teams:FindFirstChild("lobby")
        return lobby and passPlayer.Team == lobby
    end

    local function sendInfinitePass(skillName, useCenter)
        if not passState.enabled or passState.busy or inLobby() then return end

        local now = os.clock()
        local last = passState.lastUse[skillName] or 0
        if now - last < 0.18 then return end

        local target = closestTeammate(useCenter)
        if not target then return end

        passState.lastUse[skillName] = now
        passState.busy = true

        pcall(function()
            passRemote:FireServer(
                buffer.fromstring(buffers["base"]),
                {{skillName, target}}
            )
        end)

        task.delay(0.12, function()
            passState.busy = false
        end)
    end

