                function section:CreateToggle(controlSettings, key)
                    controlSettings = type(controlSettings) == "table" and controlSettings or {}
                    local nameText = tostring(controlSettings.Name or "Toggle")
                    local callback = type(controlSettings.Callback) == "function" and controlSettings.Callback or function() end
                    local value = controlSettings.CurrentValue == true

                    local row = rowBase(self, 22)
                    local box = create("Frame", {
                        Name = "Frame",
                        AnchorPoint = Vector2.new(0, 0.5),
                        Position = UDim2.fromScale(0, 0.5),
                        Size = UDim2.fromOffset(14, 14),
                        BackgroundColor3 = value and Theme.Accent or Theme.Control,
                        BorderSizePixel = 0,
                        ZIndex = 6,
                    }, row)
                    corner(box, 2)
                    if value then setAccent(box) end

                    makeControlText(row, nameText, UDim2.new(1, -22, 1, 0), UDim2.fromOffset(22, 0), Enum.Font.SourceSans, 14)

                    local button = create("TextButton", {
                        Name = "TextButton",
