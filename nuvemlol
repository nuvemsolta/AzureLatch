    if gp or input.KeyCode ~= bindKey then return end
    if not airDribbleState.enabled then return end

    airDribbleState.isHolding = true

    performAirDribble()

    if holdingConnection then holdingConnection:Disconnect() end
    airDribbleAccumulator = 0

    holdingConnection = RunService.Heartbeat:Connect(function(dt)
        if not airDribbleState.isHolding
            or not airDribbleState.enabled then

            holdingConnection:Disconnect()
            holdingConnection = nil
            airDribbleAccumulator = 0
            return
        end

        airDribbleAccumulator += dt

        if airDribbleAccumulator < (1 / 30) then
            return
        end

        airDribbleAccumulator = 0
        performAirDribble()
    end)
end)

