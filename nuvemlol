        local function hotbarCounterKey()
            local bar = hotbar()
            if not bar then return nil, "hotbar missing" end

            local foundKey, foundSlot, count = nil, nil, 0

            for _, slot in ipairs(bar:GetChildren()) do
                local number = slot.Name:lower():match("^skill(%d+)$")

                if number then
                    local txt = clean(slotText(slot))

                    if txt:find("counter", 1, true) then
                        local key = "toggleCounter" .. number

                        if state.autoSkills[key] then
                            count += 1
                            foundKey = key
                            foundSlot = slot.Name
                        end
                    end
                end
            end

            if count == 1 then
                return foundKey, foundSlot
            end

            return nil, count > 1 and "multiple counter skills" or "no counter-named skill"
        end

        local function currentStyle()
            -- Player style is authoritative; user's diagnostics proved
            -- Character.style can stay stale after swapping.
            local value =
                lp:GetAttribute("style")
                or lp:GetAttribute("Style")

            if value ~= nil and tostring(value) ~= "" then
                return tostring(value):lower(), "Player.style"
            end

            local char = lp.Character
            value = char and (
                char:GetAttribute("style")
                or char:GetAttribute("Style")
            )

            if value ~= nil and tostring(value) ~= "" then
                return tostring(value):lower(), "Character.style"
            end

            return nil, "unknown"
        end

        local function selectCounter()
            local style, source = currentStyle()
            local key, slot = hotbarCounterKey()

            if not key and style then
                key = styleFallback[clean(style)]
                slot = key and "style fallback" or slot
            end

            if not key or not state.autoSkills[key] then
                log("AUTO_DETECT_FAIL", tostring(style) .. " | " .. tostring(slot))
                notify("Auto Counter", "Counter not found. Use Copy Counter Debug.", 3)
                return false
            end

            for stateKey in pairs(state.autoSkills) do
                state[stateKey] = false
            end

            state[key] = true
            state.lastStyle = style
            state.lastStyleSource = source

            log(
                "AUTO_DETECT",
                tostring(style) .. " -> " .. state.autoSkills[key] .. " (" .. tostring(slot) .. ")"
            )

            notify(
