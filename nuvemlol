local function getFormlessTrack(humanoid)
    if formlessState.track and formlessState.trackHumanoid == humanoid then
        return formlessState.track
    end

    if formlessState.track then
        pcall(function()
            formlessState.track:Stop(0)
        end)
        formlessState.track = nil
        formlessState.trackHumanoid = nil
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local ok, track = pcall(function()
        return animator:LoadAnimation(formlessAnimation)
    end)

    if not ok then
        return nil
    end

    formlessState.track = track
    formlessState.trackHumanoid = humanoid
    return track
end

local function performFormless()
    if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
        return
    end

    local localPlayer = Players.LocalPlayer
    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid or humanoid.Health <= 0 then
        return
    end

    humanoid.AutoRotate = false

    local camera = workspace.CurrentCamera
    local originalType = camera.CameraType
    local originalSubject = camera.CameraSubject
    local flipped = camera.CFrame * CFrame.Angles(0, math.rad(180), 0)

    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = flipped

    task.delay(0.1, function()
        local currentCharacter = localPlayer.Character
        local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")

        if currentHumanoid then
            camera.CameraSubject = currentHumanoid
            camera.CameraType = Enum.CameraType.Custom
        else
            camera.CameraSubject = originalSubject
            camera.CameraType = originalType
        end

        if humanoid.Parent then
            humanoid.AutoRotate = true
        end
    end)

    task.wait(0.15)

    if not root.Parent or not humanoid.Parent or humanoid.Health <= 0 then
        return
    end

    local track = getFormlessTrack(humanoid)
    if track then
        track:Play(0)
    end

    local direction = root.CFrame.LookVector
    local kickVector = Vector3.new(direction.X * 0.5, 1, direction.Z * 0.5)

    formlessRemote:FireServer(formlessPacket, {
        {"kick", 25, false, kickVector}
    })

    formlessRemote:FireServer(formlessPacket, {
        {"skill1"}
    })
end

