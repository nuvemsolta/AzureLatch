        end)

        -- ---------------- Ball Metavision ----------------
        -- Native Start() forces Mode="Old": blue history + gray trajectory.
        local metaState = {
            Enabled = false,
            Mode = "Old",
            OldConnection = nil,
            OldData = nil,
        }

        local function stopOld()
            if metaState.OldConnection then
                metaState.OldConnection:Disconnect()
                metaState.OldConnection = nil
            end

            local data = metaState.OldData
            if not data then return end

            local function destroyList(list)
                for i = #list, 1, -1 do
                    local part = list[i]
                    if part then pcall(function() part:Destroy() end) end
                    list[i] = nil
                end
            end

            destroyList(data.BlueArcParts)
            destroyList(data.GrayArcParts)
            destroyList(data.PartPool)
            if data.BlueContainer then pcall(function() data.BlueContainer:Destroy() end) end
            if data.GrayContainer then pcall(function() data.GrayContainer:Destroy() end) end
            metaState.OldData = nil
        end

        local function startOld()
            stopOld()

            local data = {
                BlueArcParts = {},
                GrayArcParts = {},
                PartPool = {},
                PositionHistory = {},
                VelocityHistory = {},
                LastBallPosition = nil,
                SmoothedVelocity = Vector3.zero,
                BallInstance = nil,
                LastUpdateTime = nil,
                FrameSkipCounter = 0,
                BLUE_ARC_COLOR = Color3.fromRGB(9, 137, 207),
                GRAY_ARC_COLOR = Color3.fromRGB(150, 150, 150),
                ARC_WIDTH = 0.2,
                ARC_TRANSPARENCY = 0.4,
                MAX_HISTORY = 50,
                PREDICTION_STEPS = 18,
                PREDICTION_TIME = 2,
                MIN_MOVE = 0.5,
                SMOOTHING = 0.15,
                VEL_HISTORY_SIZE = 10,
                DRAG = 0.9737,
                GROUND = 1.5,
            }
            metaState.OldData = data

            data.BlueContainer = Instance.new("Folder")
            data.BlueContainer.Name = "BlueArc"
            data.BlueContainer.Parent = WorkspaceV
            data.GrayContainer = Instance.new("Folder")
            data.GrayContainer.Name = "GrayArc"
            data.GrayContainer.Parent = WorkspaceV

            local function acquirePart()
                local part = table.remove(data.PartPool)
                if part then
                    part.Transparency = 0
                    return part
                end
                part = Instance.new("Part")
                part.Anchored = true
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
                part.CastShadow = false
                part.Material = Enum.Material.Neon
                return part
            end

            local function releasePart(part)
                if not part then return end
                part.Transparency = 1
                part.Parent = nil
                data.PartPool[#data.PartPool + 1] = part
            end

            local function clearArc(list)
                for i = #list, 1, -1 do
                    releasePart(list[i])
                    list[i] = nil
                end
            end

            local function resetBallState()
                clearArc(data.BlueArcParts)
                clearArc(data.GrayArcParts)
                table.clear(data.PositionHistory)
                table.clear(data.VelocityHistory)
                data.BallInstance = nil
                data.LastBallPosition = nil
                data.LastUpdateTime = nil
                data.SmoothedVelocity = Vector3.zero
            end

            local function ensureBall()
                if data.BallInstance and data.BallInstance.Parent then return true end
                if data.BallInstance and not data.BallInstance.Parent then resetBallState() end
                local terrain = WorkspaceV:FindFirstChildOfClass("Terrain")
                local ball = (terrain and terrain:FindFirstChild("Ball")) or WorkspaceV:FindFirstChild("Ball")
                if ball and ball:IsA("BasePart") then
                    data.BallInstance = ball
                    table.clear(data.PositionHistory)
                    table.clear(data.VelocityHistory)
                    data.LastBallPosition = nil
                    data.LastUpdateTime = nil
                    data.SmoothedVelocity = Vector3.zero
                    return true
                end
                return false
            end

            local function setSegment(part, a, b, width, color, transparency, parent)
                local length = (b - a).Magnitude
                if length <= 0.01 then
                    part.Transparency = 1
                    return
                end
                part.Size = Vector3.new(width, width, length)
                part.CFrame = CFrame.new(a, b) * CFrame.new(0, 0, -length / 2)
                part.Color = color
                part.Transparency = transparency
                part.Parent = parent
            end

            local function renderBlue()
                local needed = math.max(#data.PositionHistory - 1, 0)
                for i = 1, needed do
                    local part = data.BlueArcParts[i] or acquirePart()
                    data.BlueArcParts[i] = part
                    setSegment(part, data.PositionHistory[i], data.PositionHistory[i + 1], data.ARC_WIDTH, data.BLUE_ARC_COLOR, data.ARC_TRANSPARENCY, data.BlueContainer)
                end
                for i = #data.BlueArcParts, needed + 1, -1 do
                    releasePart(data.BlueArcParts[i])
                    data.BlueArcParts[i] = nil
                end
            end

            local function renderGray(position, velocity)
                local points = table.create(data.PREDICTION_STEPS + 1)
                points[1] = position
                local gravity = WorkspaceV.Gravity
                local currentPos = position
                local currentVel = velocity
                local dt = data.PREDICTION_TIME / data.PREDICTION_STEPS
                for i = 1, data.PREDICTION_STEPS do
                    currentVel = Vector3.new(currentVel.X * data.DRAG, currentVel.Y - gravity * dt, currentVel.Z * data.DRAG)
                    currentPos += currentVel * dt
                    if currentPos.Y <= data.GROUND then
                        currentPos = Vector3.new(currentPos.X, data.GROUND, currentPos.Z)
                        currentVel = Vector3.new(currentVel.X * 0.85, 0, currentVel.Z * 0.85)
                    end
                    points[i + 1] = currentPos
                end
                local needed = #points - 1
                for i = 1, needed do
                    local part = data.GrayArcParts[i] or acquirePart()
                    data.GrayArcParts[i] = part
                    setSegment(part, points[i], points[i + 1], data.ARC_WIDTH * 0.75, data.GRAY_ARC_COLOR, data.ARC_TRANSPARENCY, data.GrayContainer)
                end
                for i = #data.GrayArcParts, needed + 1, -1 do
                    releasePart(data.GrayArcParts[i])
                    data.GrayArcParts[i] = nil
                end
            end

            metaState.OldConnection = RunServiceV.Heartbeat:Connect(function()
                if not metaState.Enabled or metaState.Mode ~= "Old" then return end
                data.FrameSkipCounter += 1
                if data.FrameSkipCounter < 2 then return end
                data.FrameSkipCounter = 0

                if not ensureBall() then
                    clearArc(data.BlueArcParts)
                    clearArc(data.GrayArcParts)
                    return
                end

                local position = data.BallInstance.Position
                if #data.PositionHistory == 0 then
                    data.PositionHistory[1] = position
                    renderBlue()
                    data.LastBallPosition = position
                    data.LastUpdateTime = tick()
                    return
                end

                if (position - data.PositionHistory[#data.PositionHistory]).Magnitude > data.MIN_MOVE then
                    data.PositionHistory[#data.PositionHistory + 1] = position
                    while #data.PositionHistory > data.MAX_HISTORY do table.remove(data.PositionHistory, 1) end
                    renderBlue()
                end

                local now = tick()
                if data.LastBallPosition then
                    local deltaTime = now - (data.LastUpdateTime or now)
                    if deltaTime > 0 and deltaTime < 0.1 then
                        local rawVelocity = (position - data.LastBallPosition) / deltaTime
                        data.VelocityHistory[#data.VelocityHistory + 1] = rawVelocity
                        while #data.VelocityHistory > data.VEL_HISTORY_SIZE do table.remove(data.VelocityHistory, 1) end
                        if #data.VelocityHistory >= 5 then
                            local weighted, weightSum = Vector3.zero, 0
                            local count = #data.VelocityHistory
                            for i, sample in ipairs(data.VelocityHistory) do
                                local weight = i / count
                                weighted += sample * weight
                                weightSum += weight
                            end
                            if weightSum > 0 then
                                data.SmoothedVelocity = data.SmoothedVelocity:Lerp(weighted / weightSum, data.SMOOTHING)
                            end
                        else
                            data.SmoothedVelocity = data.SmoothedVelocity:Lerp(rawVelocity, data.SMOOTHING * 0.5)
                        end

                        if data.SmoothedVelocity.Magnitude < 1 then
                            clearArc(data.GrayArcParts)
                        else
                            renderGray(position, data.SmoothedVelocity)
                        end
                    end
                end
                data.LastBallPosition = position
                data.LastUpdateTime = now
            end)
        end

        local function stopMeta()
            metaState.Enabled = false
            stopOld()
        end

        local function startMeta()
            stopMeta()
            metaState.Enabled = true
            metaState.Mode = "Old"
            startOld()
        end

        local metaFolder = visualsUI:FolderInGroup("Ball Metavision", "Ball Metavision.", Color3.fromRGB(24,255,228), true, "Visuals")
        metaFolder:Toggle("Ball Metavision", nil, false, function(value)
            if value == true then startMeta() else stopMeta() end
        end)

    end)

    if not ok then
        warn("[EvoHub Visuals V9] " .. tostring(err))
    end
end)

