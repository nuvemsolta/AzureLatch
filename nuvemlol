    end

    local function hookSkillButton(button, skillName)
        if not button:IsA("GuiButton") then return end

        addConnection(button.Activated:Connect(function()
            if isTouchInput() then
                sendInfinitePass(skillName, true)
            end
        end))

        addConnection(button.InputBegan:Connect(function(input)
            if isTouchInput() and input.UserInputType == Enum.UserInputType.Touch then
                sendInfinitePass(skillName, true)
            end
        end))
    end

    local function hookSkillSlot(slot, skillName)
        passState.slots[skillName] = slot

        if slot:IsA("GuiButton") then
            hookSkillButton(slot, skillName)
        elseif slot:IsA("GuiObject") then
            addConnection(slot.InputBegan:Connect(function(input)
                if isTouchInput() and input.UserInputType == Enum.UserInputType.Touch then
                    sendInfinitePass(skillName, true)
                end
            end))
        end

        for _, object in ipairs(slot:GetDescendants()) do
            if object:IsA("GuiButton") then
                hookSkillButton(object, skillName)
            end
        end

        local cooldown = slot:FindFirstChild("Cooldown", true)
        if cooldown and cooldown:IsA("GuiObject") then
            local wasVisible = cooldown.Visible
            addConnection(cooldown:GetPropertyChangedSignal("Visible"):Connect(function()
                local visible = cooldown.Visible
                if isTouchInput() and visible and not wasVisible then
                    sendInfinitePass(skillName, true)
                end
                wasVisible = visible
            end))
        end

        addConnection(slot.DescendantAdded:Connect(function()
            passState.dirty = true
        end))
        addConnection(slot.DescendantRemoving:Connect(function()
            passState.dirty = true
        end))
    end

    local function rebuildMobileHooks()
        local hotbar = currentHotbar()
        disconnectMobileHooks()
        passState.hotbar = hotbar
        passState.dirty = false

        if not hotbar then return end

        for index = 1, 4 do
            local skillName = "skill" .. index
            local slot = hotbar:FindFirstChild(skillName)
            if slot then
                hookSkillSlot(slot, skillName)
            end
        end

        addConnection(hotbar.ChildAdded:Connect(function()
            passState.dirty = true
        end))
        addConnection(hotbar.ChildRemoved:Connect(function()
            passState.dirty = true
        end))
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or isTouchInput() then return end
        local skillName = passKeys[input.KeyCode]
        if skillName then
            sendInfinitePass(skillName, false)
        end
    end)

    local function stopPassWatcher()
        if passState.watchConnection then
            passState.watchConnection:Disconnect()
            passState.watchConnection = nil
        end

        passState.watchAccumulator = 0
        disconnectMobileHooks()
        passState.hotbar = nil
        passState.dirty = true
    end

    local function startPassWatcher()
        stopPassWatcher()
        rebuildMobileHooks()

        passState.watchConnection =
            RunService.Heartbeat:Connect(function(dt)
                if not passState.enabled then
                    return
                end

                passState.watchAccumulator += dt

                if passState.watchAccumulator < 0.2 then
                    return
                end

                passState.watchAccumulator = 0

                local hotbar = currentHotbar()

                if hotbar ~= passState.hotbar then
                    passState.dirty = true
                end

                if not passState.dirty and hotbar then
                    for index = 1, 4 do
                        local name = "skill" .. index

                        if hotbar:FindFirstChild(name)
                            ~= passState.slots[name] then

                            passState.dirty = true
                            break
                        end
                    end
                end

                if passState.dirty then
                    rebuildMobileHooks()
                end
            end)
    end

    add:Toggle(
        "Infinite Range Passing",
        "Passes to the teammate closest to your cursor or screen center.",
        function(value)
            passState.enabled = value == true

            if passState.enabled then
                startPassWatcher()
