    local function disconnect(list) for _,c in ipairs(list) do c:Disconnect() end;table.clear(list) end
    local function selectedAction()
        for _,key in ipairs(toggleKeys) do if autoSkillState[key] then return autoSkillState.autoSkills[key] end end
        if autoSkillState.toggleTSpecial then return autoSkillState.autoSkills.toggleTSpecial end
        if autoSkillState.toggleDribble then return autoSkillState.autoSkills.toggleDribble end
    end
    local function stopEvaluation()
        if evaluation then evaluation:Disconnect();evaluation=nil end
        pending={};elapsed=0
    end
    local function evaluate(dt)
        elapsed=elapsed+dt;if elapsed<1/60 then return end;elapsed=0
        local action=selectedAction()
        if not action or not hasball() then stopEvaluation();return end
        local char=localplayer.Character
        local root=char and char:FindFirstChild("HumanoidRootPart")
        local humanoid=char and char:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health<=0 then stopEvaluation();return end
        local now=os.clock()
        local best,bestDistance=nil,math.huge
        for opponent,entry in pairs(pending) do
            local targetChar=opponent.Character
            local targetRoot=targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local targetHumanoid=targetChar and targetChar:FindFirstChildOfClass("Humanoid")
            if not entry.track.IsPlaying or now-entry.at>2 or targetChar~=entry.char or opponent.Team==localplayer.Team
                or opponent.Neutral or localplayer.Neutral or not opponent.Team or not localplayer.Team
                or not targetRoot or not targetHumanoid or targetHumanoid.Health<=0 then
                pending[opponent]=nil
            else
                local guard=env.NuvemTactics
                local blocked=guard and guard.isCounterActive and guard.isCounterActive(opponent)
                local delta=targetRoot.Position-root.Position
                local distance=delta:Dot(delta)
                local ready=now-(autoSkillState.cooldowns[opponent] or -math.huge)>=autoSkillState.playerCooldown
                if not blocked and ready and distance<=autoSkillState.mCD^2 and distance<bestDistance then
                    best,bestDistance=opponent,distance
                end
            end
        end
        if best then
            local teammate=autoSkillState.useClosestTeammate and getcteammate() or nil
            local ok,errorMessage=pcall(fireSkill,action,teammate)
            pending[best]=nil
            if ok then autoSkillState.cooldowns[best]=now else warn("[Nuvem Counter] "..tostring(errorMessage)) end
        end
        if next(pending)==nil then stopEvaluation() end
    end
    local function observe(opponent,track)
        if not alive or not selectedAction() or not hasball() then return end
        if opponent.Team==localplayer.Team or opponent.Neutral or localplayer.Neutral then return end
        local animation=track.Animation
        if not animation or not steal_anims[animation.AnimationId] then return end
        pending[opponent]={track=track,char=opponent.Character,at=os.clock()}
        if not evaluation then evaluation=RunService.Heartbeat:Connect(evaluate) end
    end
    local function remove(opponent)
        local record=records[opponent]
        if record then disconnect(record.charConnections);disconnect(record.connections) end
        records[opponent],pending[opponent],autoSkillState.cooldowns[opponent]=nil,nil,nil
    end
    local function watch(opponent)
        if opponent==localplayer or records[opponent] then return end
        local record={connections={},charConnections={},animators={}};records[opponent]=record
        local function bind(char)
            disconnect(record.charConnections);record.animators={};pending[opponent]=nil
            local function animator(object)
                if not object:IsA("Animator") or record.animators[object] then return end
                record.animators[object]=true
                record.charConnections[#record.charConnections+1]=object.AnimationPlayed:Connect(function(track) observe(opponent,track) end)
            end
            for _,object in ipairs(char:GetDescendants()) do animator(object) end
            record.charConnections[#record.charConnections+1]=char.DescendantAdded:Connect(animator)
        end
        record.connections[#record.connections+1]=opponent.CharacterAdded:Connect(bind)
        record.connections[#record.connections+1]=opponent.CharacterRemoving:Connect(function() disconnect(record.charConnections);pending[opponent]=nil end)
        if opponent.Character then bind(opponent.Character) end
    end
    for _,opponent in ipairs(Players:GetPlayers()) do watch(opponent) end
    globalConnections[#globalConnections+1]=Players.PlayerAdded:Connect(watch)
    globalConnections[#globalConnections+1]=Players.PlayerRemoving:Connect(remove)
    local runtime={version=2}
    function runtime.destroy()
        if not alive then return end;alive=false;stopEvaluation();disconnect(globalConnections)
        for opponent in pairs(records) do remove(opponent) end
    end
    env.NuvemCounterRuntime=runtime
    win:OnDestroy(runtime.destroy)
end


