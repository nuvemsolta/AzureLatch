        local function sectionSearch(section, query)
            query = tostring(query or ""):lower()
            if query == "" then
                section.Frame.Visible = true
                for _, record in ipairs(section.Controls) do
                    record.Row.Visible = true
                end
                return
            end

            local sectionMatch = section.Name:lower():find(query, 1, true) ~= nil
            local any = false

            for _, record in ipairs(section.Controls) do
                local match = sectionMatch or record.Name:lower():find(query, 1, true) ~= nil
                record.Row.Visible = match
                any = any or match
            end

            section.Frame.Visible = any
        end

