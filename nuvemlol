-- ================================================================
-- GLOBAL EVOHUB NOTIFICATION ROUTER
-- Every feature in the combined build uses EvoHubNotifications.
-- Legacy Celeron StarterGui:SetCore notifications are rewritten below.
-- ================================================================
local function EvoNotify(title, message, duration)
    if Luna.NotificationsEnabled == false then
        return nil
    end

    title = tostring(title or "")
    message = tostring(message or "")
    duration = tonumber(duration) or 2

    local cleanState = message
        :lower()
        :gsub("%s+", "")
        :gsub("%.", "")

    -- Shared CreateToggle already emits the canonical
    -- "<Feature> Enabled/Disabled" notification. Suppress only duplicate
    -- legacy state notifications that happen inside that same callback.
    if (Luna._ToggleCallbackDepth or 0) > 0
        and (cleanState == "enabled" or cleanState == "disabled") then
        return nil
    end

    local content

    if title == ""
        or title:lower() == "evo hub // re"
        or title:lower() == "evo hub //re"
        or title:lower() == "evohub // re" then

        content = message

    elseif cleanState == "enabled" or cleanState == "disabled" then
        content = title .. " " .. (
            cleanState == "enabled" and "Enabled" or "Disabled"
        )

    elseif message == "" then
        content = title

    else
        content = title .. ": " .. message
    end

    return Luna:CreateNotification({
        Content = content,
        Duration = duration,
    })
end

-- ================================================================
-- AUTO CONFIG
-- Uses the SAME file/key format as Daffy's old UI:
--     celeron/AzureLatch.json
-- So your old saved settings are picked up instead of everything
-- silently starting disabled after changing UI libraries.
-- Writes are debounced so dragging a slider does not spam writefile.
-- ================================================================
local HttpService = game:GetService("HttpService")
local CONFIG_FOLDER = "celeron"
local CONFIG_FILE = CONFIG_FOLDER .. "/AzureLatch.json"
local configData = {}
local configWriteGeneration = 0

local function configLoad()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return
    end
    local okExists, exists = pcall(isfile, CONFIG_FILE)
    if not okExists or not exists then return end

    local okRead, raw = pcall(readfile, CONFIG_FILE)
    if not okRead or type(raw) ~= "string" then return end

    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
    if okDecode and type(decoded) == "table" then
        configData = decoded
    end
end

local function configFlush()
    if type(writefile) ~= "function" then return end
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" then
            if not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
        end
        writefile(CONFIG_FILE, HttpService:JSONEncode(configData))
    end)
end

local function configSaveSoon()
    configWriteGeneration += 1
    local generation = configWriteGeneration
    task.delay(0.25, function()
        if generation ~= configWriteGeneration then return end
        configFlush()
    end)
end

local function configGet(key, fallback)
    local value = configData[key]
    if value == nil then return fallback end
    return value
end

local function configSet(key, value)
    configData[key] = value
    configSaveSoon()
end

configLoad()

