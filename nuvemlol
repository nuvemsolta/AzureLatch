--========================================================
-- AUTO COUNTER - attached core integration (V5)
-- Adapted from azure_latch_auto_counter.txt into Luna UI.
-- Keeps the proven AnimationPlayed -> Heartbeat -> FireServer design.
-- Removed legacy auto-detect/debug UI is intentionally not reintroduced.
--========================================================
task.spawn(function()
    local bootOK, bootError = pcall(function()
        local folder = maintab2:Folder("Auto Dribble / Counter Features.", Color3.fromRGB(24, 255, 228), true)
        folder:Label("Auto Counter: attached core integrated into the hub.")

        local PlayersService = game:GetService("Players")
        local ReplicatedStorageService = game:GetService("ReplicatedStorage")
        local RunServiceService = game:GetService("RunService")
        local localplayer = PlayersService.LocalPlayer
        local env = (getgenv and getgenv()) or _G

        if type(env.CeleronCounterRuntime) == "table"
            and type(env.CeleronCounterRuntime.destroy) == "function" then
            pcall(env.CeleronCounterRuntime.destroy)
        end

        local state = {
            enabled = true,
            counterChance = 100,
            useClosestTeammate = false,
            range = 65,
            fireRate = 0.05,
            playerCooldown = 0.33,
            autoSkills = {
                toggleDribble = "dribble",
                toggleCounter1 = "skill1",
                toggleCounter2 = "skill2",
                toggleCounter3 = "skill3",
                toggleCounter4 = "skill4",
                toggleCounter5 = "skill5",
                toggleTSpecial = "Tspecialer",
            },
            toggleDribble = false,
            toggleCounter1 = false,
            toggleCounter2 = false,
            toggleCounter3 = false,
            toggleCounter4 = false,
            toggleCounter5 = false,
            toggleTSpecial = false,
            destroyed = false,
            players = {},
            globalConnections = {},
        }

        -- The attachment used the first two IDs. Keep the hub's already-known
        -- extra hostile steal IDs too so V5 does not regress detection coverage.
        local hostileAnimations = {
            ["109744655458082"] = true,
            ["113088324958896"] = true,
            ["96801747244950"] = true,
            ["130345228612384"] = true,
            ["82417661349987"] = true,
        }

        local runtime = {version = "AttachedCore-V5", state = state}
        env.CeleronCounterRuntime = runtime

        local function disconnect(conn)
            if typeof(conn) == "RBXScriptConnection" then
                pcall(function() conn:Disconnect() end)
            end
        end

        local function getRoot(char)
            return char and char:FindFirstChild("HumanoidRootPart")
        end

        local function hasBall()
            local char = localplayer.Character
            if not char then return false end
            return char:FindFirstChild("Ball") ~= nil
                or char:FindFirstChild("Football") ~= nil
                or char:GetAttribute("HasBall") == true
        end

        local function teamKey(plr)
            if not plr then return nil end
            local custom = plr:GetAttribute("team") or plr:GetAttribute("Team")
            if custom ~= nil and tostring(custom) ~= "" then
                return "attr:" .. tostring(custom)
            end
            if plr.Team then
                return "team:" .. tostring(plr.Team.Name)
            end
            return nil
        end

        local function isTeammate(plr)
            local mine = teamKey(localplayer)
            local theirs = teamKey(plr)
            if mine and theirs then
                return mine == theirs
            end
            return localplayer.Team ~= nil and plr.Team == localplayer.Team
        end

        local function getUseBuffer()
            -- Prefer the hub's already initialized exact buffer.
            if buffers and type(buffers["base"]) == "string" and buffers["base"] ~= "" then
                local ok, value = pcall(buffer.fromstring, buffers["base"])
                if ok then return value end
            end

            -- RE core fallback: discover current bytenet_use packet id.
            local packetId = 30
            pcall(function()
                local storage = ReplicatedStorageService:FindFirstChild("BytenetStorage")
                local networking = storage and storage:FindFirstChild("Networking")
                if networking and networking:IsA("StringValue") then
                    local found = networking.Value:match('"bytenet_use"%s*:%s*(%d+)')
                    if found then packetId = tonumber(found) or packetId end
                end
            end)
            return buffer.fromstring(string.char(packetId) .. "\1")
        end

        local function getClosestTeammate()
            local root = getRoot(localplayer.Character)
            if not root then return nil end

            local closest, best = nil, math.huge
            for _, plr in ipairs(PlayersService:GetPlayers()) do
                if plr ~= localplayer and isTeammate(plr) then
                    local other = getRoot(plr.Character)
                    if other then
                        local dist = (root.Position - other.Position).Magnitude
                        if dist < best then
                            closest, best = plr, dist
                        end
                    end
                end
            end
            return closest
        end

        local function fireSkill(skillName, targetPlayer)
            if not hasBall() then return false end
            local remote = ReplicatedStorageService:FindFirstChild("ByteNetReliable")
            if not remote then return false end

            local payload
            if state.useClosestTeammate and targetPlayer and targetPlayer.Character then
                payload = {{skillName, targetPlayer.Character}}
            else
                payload = {{skillName}}
            end

            local ok = pcall(function()
                remote:FireServer(getUseBuffer(), payload)
            end)
            return ok
        end

        local counterKeys = {
            "toggleCounter1", "toggleCounter2", "toggleCounter3",
            "toggleCounter4", "toggleCounter5", "toggleTSpecial", "toggleDribble",
        }

        local function fireCounters()
            local teammate = state.useClosestTeammate and getClosestTeammate() or nil
            for _, key in ipairs(counterKeys) do
                if state[key] then
                    fireSkill(state.autoSkills[key], teammate)
                end
            end
        end

        local function clearPlayerRecord(record)
            if not record then return end
            disconnect(record.loop)
            disconnect(record.animator)
            disconnect(record.charAdded)
            record.loop, record.animator, record.charAdded = nil, nil, nil
        end

        local function removePlayer(plr)
            local record = state.players[plr]
            if not record then return end
            clearPlayerRecord(record)
            state.players[plr] = nil
        end

        local function isHostileTrack(track)
            local anim = track and track.Animation
            local id = anim and tostring(anim.AnimationId):match("%d+")
            return id ~= nil and hostileAnimations[id] == true
        end

        local function startCounterLoop(plr, record, track)
            disconnect(record.loop)
            record.loop = nil

            if math.random(1, 100) > state.counterChance then return end

            local lastPoll = 0
            local loop
            loop = RunServiceService.Heartbeat:Connect(function()
                if state.destroyed or not track.IsPlaying or not hasBall() then
                    disconnect(loop)
                    if record.loop == loop then record.loop = nil end
                    return
                end

                if not state.enabled then return end

                local now = os.clock()
                if now - lastPoll < state.fireRate then return end
                lastPoll = now

                if record.lastCounter and now - record.lastCounter < state.playerCooldown then
                    return
                end

                local mine = getRoot(localplayer.Character)
                local theirs = getRoot(plr.Character)
                if not mine or not theirs then return end
                if (mine.Position - theirs.Position).Magnitude > state.range then return end

                record.lastCounter = now
                fireCounters()
            end)
            record.loop = loop
        end

        local function watchPlayer(plr)
            if plr == localplayer or state.players[plr] then return end
            local record = {generation = 0}
            state.players[plr] = record

            local function onCharacter(char)
                record.generation += 1
                local generation = record.generation
                disconnect(record.loop)
                disconnect(record.animator)
                record.loop, record.animator = nil, nil

                local humanoid = char:WaitForChild("Humanoid", 6)
                if not humanoid or state.destroyed or generation ~= record.generation then return end

                local animator = humanoid:FindFirstChildOfClass("Animator")
                    or humanoid:WaitForChild("Animator", 4)
                if not animator or state.destroyed or generation ~= record.generation then return end

                record.animator = animator.AnimationPlayed:Connect(function(track)
                    if state.destroyed or isTeammate(plr) or not isHostileTrack(track) then return end
                    startCounterLoop(plr, record, track)
                end)
            end

            record.charAdded = plr.CharacterAdded:Connect(onCharacter)
            if plr.Character then task.spawn(onCharacter, plr.Character) end
        end

        for _, plr in ipairs(PlayersService:GetPlayers()) do
            watchPlayer(plr)
        end
