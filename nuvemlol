local function packetIdByName(name, fallback)
    local result = fallback
    pcall(function()
        local storage = ReplicatedStorage:FindFirstChild("BytenetStorage")
        local networking = storage and storage:FindFirstChild("Networking")
        if networking and networking:IsA("StringValue") then
            local found = networking.Value:match(
                '"' .. tostring(name) .. '"%s*:%s*(%d+)'
            )
            if found then
                result = tonumber(found) or result
            end
        end
    end)
    return result
end

local function packetBufferOneByte(name, fallback, trailingOne)
    local id = packetIdByName(name, fallback)
    local suffix = trailingOne and "\1" or ""
    return buffer.fromstring(string.char(id) .. suffix)
end

