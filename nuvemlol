        local function notify(text, duration)
            pcall(function()
                EvoNotify("EvoHub RE Lineups", tostring(text), duration or 3)
            end)
        end

        local function normalizeStyle(raw)
            raw = tostring(raw or ""):lower():gsub("%s+", "")
            if raw == "masterykaiser" then raw = "kaiser" end
            if raw == "baroucurve" then raw = "barou_curve" end
            if raw == "kiyorastrong" then raw = "kiyora_strong" end
            if raw == "rinflow" then raw = "rin_flow" end
            if raw == "yukimiyaflow" then raw = "yukimiya_flow" end
            if raw == "nelisagi" or raw == "nel_isagi" then raw = "nelisagi" end
            return raw
        end

        local function getCurrentStyle()
            if state.selectedStyle ~= "Auto" then
                return STYLE_OPTION_TO_KEY[state.selectedStyle]
            end

            local char = player.Character
            local raw = player:GetAttribute("style") or player:GetAttribute("Style")

            if char then
                raw = char:GetAttribute("style") or char:GetAttribute("Style") or raw
                local st = char:FindFirstChild("state")
                local sv = st and st:FindFirstChild("style")
                if sv and sv.Value and tostring(sv.Value) ~= "" then
                    raw = sv.Value
                end
            end

            return normalizeStyle(raw)
        end

        local function normalizeTeam(raw)
            raw = tostring(raw or ""):upper()
            if raw == "A" or raw:find("TEAMA", 1, true) then return "A" end
            if raw == "B" or raw:find("TEAMB", 1, true) then return "B" end
            if raw:match("^A[%s_%-]") then return "A" end
            if raw:match("^B[%s_%-]") then return "B" end
            return nil
        end

        local function getCurrentTeam()
            local chars = Workspace:FindFirstChild("characters")
            local worldChar = chars and chars:FindFirstChild(player.Name)
            local worldState = worldChar and worldChar:FindFirstChild("state")
            local worldTeam = worldState and worldState:FindFirstChild("team")
            local team = worldTeam and normalizeTeam(worldTeam.Value)
            if team then return team end

            local char = player.Character
            if char then
                local st = char:FindFirstChild("state")
                local tv = st and st:FindFirstChild("team")
                team = tv and normalizeTeam(tv.Value)
                if team then return team end

                team = normalizeTeam(char:GetAttribute("team") or char:GetAttribute("Team"))
                if team then return team end
            end

            return normalizeTeam(player:GetAttribute("team") or player:GetAttribute("Team"))
        end

        local function bucket(style, team)
            state.index[style] = state.index[style] or { A = {}, B = {} }
            return state.index[style][team]
        end

        local function isDuplicate(list, target)
            for i = 1, #list do
                local p = list[i].target
                if math.abs(p.X - target.X) < 2 and math.abs(p.Z - target.Z) < 2 then
                    return true
                end
            end
            return false
        end

        local function addEntry(style, team, target, mouseTarget, lookVector, isFlow, imported)
            style = normalizeStyle(style)
            team = normalizeTeam(team)
            if style == "" or not team or not STYLE_CONFIG[style] then return false end

            local list = bucket(style, team)
            if isDuplicate(list, target) then return false end

            list[#list + 1] = {
                style = style,
                team = team,
                target = target,
                mouseTarget = mouseTarget,
                lookVector = lookVector,
                isFlow = isFlow == true,
                imported = imported == true
            }
            return true
        end

        local function ensureIndex()
            if state.indexed then return true end

            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, EMBEDDED_ROWS_JSON)
            if not ok or type(decoded) ~= "table" then
                warn("[EvoHub RE] embedded lineup decode failed:", decoded)
                return false
            end

            for i = 1, #decoded do
                local r = decoded[i]
                local style = STYLE_KEYS[tonumber(r[1]) or 0]
                local team = tonumber(r[2]) == 0 and "A" or "B"
                if style then
                    addEntry(
                        style,
                        team,
                        Vector3.new(r[4], r[5], r[6]),
                        Vector3.new(r[7], r[8], r[9]),
                        Vector3.new(r[10], r[11], r[12]),
                        tonumber(r[3]) == 1,
                        false
                    )
                end
            end

            state.indexed = true
            return true
        end

        local function importJSON(raw)
            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
            if not ok or type(decoded) ~= "table" then return 0 end

            local added = 0
            for i = 1, #decoded do
                local item = decoded[i]
                if type(item) == "table" and type(item.targetPosition) == "table" then
                    local style = normalizeStyle(item.style)
                    if item.isFlow == true and style ~= "" and not style:find("_flow$") then
                        style = style .. "_flow"
                    end

                    local tp = item.targetPosition
                    local mp = type(item.mouseTargetPosition) == "table" and item.mouseTargetPosition or tp
                    local lv = type(item.lookVector) == "table" and item.lookVector or { X = 0, Y = 0, Z = 0 }

                    local okTarget, target = pcall(Vector3.new, tonumber(tp.X) or 0, tonumber(tp.Y) or 3, tonumber(tp.Z) or 0)
                    local okMouse, mouseTarget = pcall(Vector3.new, tonumber(mp.X) or 0, tonumber(mp.Y) or 0, tonumber(mp.Z) or 0)
                    local okLook, lookVector = pcall(Vector3.new, tonumber(lv.X) or 0, tonumber(lv.Y) or 0, tonumber(lv.Z) or 0)

                    if okTarget and okMouse and okLook and addEntry(
                        style,
                        item.team,
                        target,
                        mouseTarget,
                        lookVector,
                        item.isFlow == true,
                        true
                    ) then
                        added += 1
                    end
                end
            end

            return added
        end

        local function tryRead(path)
            if type(path) ~= "string" or path == "" then return 0 end
            if type(isfile) ~= "function" or type(readfile) ~= "function" then return 0 end

            local okExists, exists = pcall(isfile, path)
            if not okExists or not exists then return 0 end

            local okRead, raw = pcall(readfile, path)
            if not okRead or type(raw) ~= "string" then return 0 end
            return importJSON(raw)
        end

        local function reloadExternal(silent)
            if not ensureIndex() then return end
            local total = 0
            local seen = {}

            local function readOnce(path)
                if seen[path] then return end
                seen[path] = true
                total += tryRead(path)
            end

            readOnce(state.importPath)
            readOnce("lineups.json")
            readOnce("EvoHubAlpha/lineups.json")

            if type(listfiles) == "function" then
                pcall(function()
                    local files = listfiles("EvoHubAlpha")
                    for _, path in ipairs(files) do
                        local lower = tostring(path):lower()
                        if lower:match("lineups[^/\\]*%.json$") then
                            readOnce(path)
                        end
                    end
                end)
            end

            if state.enabled then
                state.lastPoolStyle = nil
                state.lastPoolTeam = nil
            end

            if not silent then
                notify(total > 0 and ("Imported " .. total .. " new lineup(s).") or "No new lineups found.")
            end
        end

        local function groundPosition(target)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = player.Character and { player.Character } or {}

            local result = Workspace:Raycast(
                target + Vector3.new(0, 15, 0),
                Vector3.new(0, -80, 0),
                params
            )

            if result then
                return result.Position + Vector3.new(0, 0.04, 0)
            end

            return Vector3.new(target.X, target.Y - 2.95, target.Z)
        end

        local function markerColor(style)
            local cfg = STYLE_CONFIG[style]
            return cfg and cfg.color or Color3.fromRGB(70, 190, 255)
        end

        local function makeMarker(entry, index)
            local part = Instance.new("Part")
            part.Name = "LineUpMarker_" .. tostring(index or 1)
            part.Size = Vector3.new(4, 8, 4)
            part.Shape = Enum.PartType.Cylinder
            part.Material = Enum.Material.Neon
            part.Color = markerColor(entry.style)
            part.Transparency = 0.3
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.CastShadow = false
            part.CFrame =
                CFrame.new(groundPosition(entry.target) + Vector3.new(0, 0.2, 0))
                * CFrame.Angles(0, 0, math.rad(90))
            part:SetAttribute("BaseColor", part.Color)
            part:SetAttribute("TargetX", entry.target.X)
            part:SetAttribute("TargetY", entry.target.Y)
            part:SetAttribute("TargetZ", entry.target.Z)
            part.Parent = Workspace
            return part
        end

        local function destroyMarker(part)
            if part and part.Parent then
                part:Destroy()
            end
        end

        local function destroyAllMarkers()
            for i = 1, #state.allMarkers do
                destroyMarker(state.allMarkers[i])
            end
            table.clear(state.allMarkers)

            destroyMarker(state.nearbyMarker)
            state.nearbyMarker = nil
            state.activeMarker = nil
        end

        local function restoreActiveMarkerColor()
            local marker = state.activeMarker
            if marker and marker.Parent then
                local base = marker:GetAttribute("BaseColor")
                if typeof(base) == "Color3" then
                    marker.Color = base
                end
            end
            state.activeMarker = nil
        end

        local function findMarkerFor(entry)
            for i = 1, #state.allMarkers do
                local marker = state.allMarkers[i]
                if marker and marker.Parent then
                    local dx = math.abs((marker:GetAttribute("TargetX") or math.huge) - entry.target.X)
                    local dz = math.abs((marker:GetAttribute("TargetZ") or math.huge) - entry.target.Z)
                    if dx < 0.05 and dz < 0.05 then
                        return marker
                    end
                end
            end
            return nil
        end

        local function rebuildMarkers()
            restoreActiveMarkerColor()
            destroyAllMarkers()

            if not state.enabled then return end

            if state.markerMode == "All (EvoHub)" then
                for i = 1, #state.pool do
                    state.allMarkers[#state.allMarkers + 1] = makeMarker(state.pool[i], i)
                end
            end
        end

        local function rebuildPool(force)
            if not ensureIndex() then return false end

            local style = getCurrentStyle()
            local team = getCurrentTeam()

            if not style or not STYLE_CONFIG[style] or not team then
                -- Native CreateMarkers destroys the previous style's markers first.
                -- V4 only did this when force=true, leaving orphan markers after a style swap.
                state.pool = {}
                state.active = nil
                state.lastPoolStyle = nil
                state.lastPoolTeam = nil
                rebuildMarkers()
                return false
            end

            if not force and style == state.lastPoolStyle and team == state.lastPoolTeam then
                return true
            end

            state.lastPoolStyle = style
            state.lastPoolTeam = team

            local byStyle = state.index[style]
            state.pool = byStyle and byStyle[team] or {}
            state.active = nil
            rebuildMarkers()

            notify(
                string.format(
                    "%s | Team %s | %d lineup(s)",
                    STYLE_LABEL[style] or style,
                    team,
                    #state.pool
                ),
                2
            )

            return true
        end

        local function nearestEntry(position)
            local best, bestDistSq
            local toleranceSq = state.positionTolerance * state.positionTolerance

            for i = 1, #state.pool do
                local entry = state.pool[i]
                local dx = position.X - entry.target.X
                local dz = position.Z - entry.target.Z
                local distSq = dx * dx + dz * dz

                if distSq <= toleranceSq and (not bestDistSq or distSq < bestDistSq) then
                    best = entry
                    bestDistSq = distSq
                end
            end

            return best
        end

        local function lineupCharacter()
            local characters = Workspace:FindFirstChild("characters")
            return characters and characters:FindFirstChild(player.Name)
        end

        local function hasLineupBall()
            local char = lineupCharacter()
            return char and char:FindFirstChild("Ball") ~= nil
        end

        local function freeFreeze()
            if not state.frozen then return end
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum then
                hum.WalkSpeed = state.oldWalkSpeed or 16
                hum.JumpPower = state.oldJumpPower or 50
                hum.PlatformStand = false
            end
            if root then root.Anchored = false end
            state.frozen = false
            state.freezeHumanoid = nil
            state.freezeRoot = nil
        end

        local function freezeCharacter()
            local char = player.Character
            if not char then return false end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root then return false end
            state.oldWalkSpeed = hum.WalkSpeed
            state.oldJumpPower = hum.JumpPower
            state.freezeHumanoid = hum
            state.freezeRoot = root
            if state.useFreeze then
                hum.WalkSpeed = 0
                hum.JumpPower = 0
                hum.PlatformStand = true
                root.Anchored = true
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end)
                state.frozen = true
            end
            return true
        end

        local function entryAimDirection(entry, root)
            local target = entry.mouseTarget
            local look = entry.lookVector

            if state.useAccuracy and state.accuracy < 100 then
                local miss = 100 - state.accuracy
                if math.random(0, 100) <= miss then
                    local errorScale = (miss / 50) * 15
                    target += Vector3.new(
                        (math.random() - 0.5) * 2 * errorScale,
                        0,
                        (math.random() - 0.5) * 2 * errorScale
                    )

                    if look.Magnitude > 0.001 then
                        local yaw = math.rad((math.random() - 0.5) * 2 * (miss / 2.5))
                        look = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(look)
                    end
                end
            end

            if look.Magnitude > 0.001 then
                return look.Unit
            end

            local delta = target - root.Position
            if delta.Magnitude <= 0.001 then return root.CFrame.LookVector end
            return delta.Unit
        end

        local function cancelAimConnection()
            state.aimToken += 1
            if state.aimConnection then
                state.aimConnection:Disconnect()
                state.aimConnection = nil
            end
        end

        local function unlockMouse()
            if not state.mouseLocked then return end
            UserInputService.MouseDeltaSensitivity = state.originalMouseDelta or 1
            state.mouseLocked = false
            state.originalMouseDelta = nil
        end

        local function stopAim()
            cancelAimConnection()
            unlockMouse()
        end

        local function aimAt(entry)
            cancelAimConnection()
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local camera = Workspace.CurrentCamera
            if not root or not camera then return false end

            if not state.mouseLocked then
                state.originalMouseDelta = UserInputService.MouseDeltaSensitivity
                UserInputService.MouseDeltaSensitivity = 0
                state.mouseLocked = true
            end

            local direction = entryAimDirection(entry, root)
            local flat = Vector3.new(direction.X, 0, direction.Z)
            if flat.Magnitude > 0.001 then
                root.CFrame = CFrame.new(root.Position, root.Position + flat.Unit)
            end

            local duration = state.smoothAiming and state.smoothness or 0.01
            local targetCF = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + direction)
            if duration <= 0.02 then
                camera.CFrame = targetCF
                return true
            end

            local TweenService = game:GetService("TweenService")
            local startAt = tick()
            local startLook = camera.CFrame.LookVector
            local targetLook = targetCF.LookVector
            local token = state.aimToken
            local done = false

            state.aimConnection = RunService.RenderStepped:Connect(function()
                if token ~= state.aimToken then done = true return end
                local alpha = math.clamp((tick() - startAt) / duration, 0, 1)
                local eased = TweenService:GetValue(alpha, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                local look = startLook:Lerp(targetLook, eased)
                if look.Magnitude > 0.001 then
                    camera.CFrame = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + look.Unit)
                end
                if alpha >= 1 then done = true end
            end)

            while not done do
                if token ~= state.aimToken or not state.enabled or state.active ~= entry or not hasLineupBall() then break end
                task.wait()
            end
            if state.aimConnection then state.aimConnection:Disconnect() state.aimConnection = nil end
            if token ~= state.aimToken or not state.enabled or state.active ~= entry or not hasLineupBall() then return false end
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + targetLook)
            return true
        end

        local function isActionReady(action)
            local pg = player:FindFirstChild("PlayerGui")
            local hotbar = pg
                and pg:FindFirstChild("Hotbar")
                and pg.Hotbar:FindFirstChild("Backpack")
                and pg.Hotbar.Backpack:FindFirstChild("Hotbar")

            local slot = hotbar and hotbar:FindFirstChild(action)
            local cooldown = slot and slot:FindFirstChild("Cooldown", true)

            if cooldown and cooldown:IsA("GuiObject") then
                return cooldown.Visible ~= true
            end

            return true
        end

        local function getUsePacket()
            if buffers and buffers["base"] then
                local ok, packet = pcall(buffer.fromstring, buffers["base"])
                if ok and packet then state.basePacket = packet end
            end
            return state.basePacket
        end

        local function sendByteNet(action, flag)
            local packet = getUsePacket()
            local remote = ReplicatedStorage:FindFirstChild("ByteNetReliable")
            if not packet or not remote or not action then return false end
            local payload = flag == nil and {{action}} or {{action, flag}}
            return pcall(function() remote:FireServer(packet, payload) end)
        end

        local function findBaseClient()
            local ok, result = pcall(function()
                if shared and type(shared.metatable) == "table" and type(shared.metatable.baseClient) == "table" and type(shared.metatable.baseClient.use) == "function" then
                    return shared.metatable.baseClient
                end
                if type(getgenv) == "function" then
                    for _, value in pairs(getgenv()) do
                        if type(value) == "table" then
                            local candidate = rawget(value, "baseClient")
                            if type(candidate) == "table" and type(candidate.use) == "function" then return candidate end
                        end
                    end
                end
            end)
            return ok and result or nil
        end

        local function sendFollowViaPackets(skill, follow, delayAmount)
            local module = ReplicatedStorage:FindFirstChild("packets")
            if not module or not module:IsA("ModuleScript") then return false end
            local ok, packets = pcall(require, module)
            if not ok or type(packets) ~= "table" or type(packets.bytenet_use) ~= "table" or type(packets.bytenet_use.send) ~= "function" then return false end
            return pcall(function()
                packets.bytenet_use.send({skill})
                task.wait(delayAmount)
                if follow == "Tspecialer" then packets.bytenet_use.send({"Tspecialer", true}) else packets.bytenet_use.send({follow}) end
            end)
        end

        local function performAction(cfg)
            if not cfg or not cfg.skill or not hasLineupBall() then return false end
            if not isActionReady(cfg.skill) then return false end
            if cfg.follow and not isActionReady(cfg.follow) then return false end

            if cfg.follow then
                local delayAmount = cfg.followDelay or 0.1
                local baseClient = findBaseClient()
                if baseClient then
                    local ok = pcall(function()
                        baseClient:use(cfg.skill)
                        task.wait(delayAmount)
                        if cfg.follow == "Tspecialer" then baseClient:use("Tspecialer", true) else baseClient:use(cfg.follow) end
                    end)
                    if ok then return true end
                end
                if sendFollowViaPackets(cfg.skill, cfg.follow, delayAmount) then return true end
                if not sendByteNet(cfg.skill) then return false end
                task.wait(delayAmount)
                if cfg.follow == "Tspecialer" then
                    pcall(function()
                        local vim = game:GetService("VirtualInputManager")
                        vim:SendKeyEvent(true, Enum.KeyCode.T, false, game)
                        task.wait(0.02)
                        vim:SendKeyEvent(false, Enum.KeyCode.T, false, game)
                    end)
                else
                    sendByteNet(cfg.follow)
                end
                return true
            end

            local deadline = tick() + 1
            local cooldownObserved = false
            while tick() < deadline do
                if not state.enabled or state.active == nil or not hasLineupBall() then return false end
                sendByteNet(cfg.skill)
                if not isActionReady(cfg.skill) then cooldownObserved = true break end
                task.wait(0.03)
            end
            return cooldownObserved
        end

        local function executeEntry(entry)
            if state.executing or not entry or not hasLineupBall() then return false end
            local now = tick()
            if now - state.lastExecuteAt < 0.3 then return false end
            local cfg = STYLE_CONFIG[entry.style]
            if not cfg or not cfg.skill then return false end
            if not isActionReady(cfg.skill) or (cfg.follow and not isActionReady(cfg.follow)) then return false end

            state.executing = true
            state.lastExecuted = entry
            task.spawn(function()
                local success = false
                local ok, err = pcall(function()
                    if not hasLineupBall() or state.active ~= entry then return end
                    freezeCharacter()
                    local char = player.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    root.CFrame = CFrame.new(entry.target)
                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.Velocity = Vector3.zero
                        root.RotVelocity = Vector3.zero
                    end)
                    if state.smoothAiming then task.wait(0.01) end
                    if not aimAt(entry) then return end
                    if state.smoothAiming then task.wait(0.01) end
                    if not hasLineupBall() or state.active ~= entry then return end
                    success = performAction(cfg)
                    if success then task.wait(0.5) end
                    state.lastExecuteAt = tick()
                end)
                stopAim()
                freeFreeze()
                state.executing = false
                if not ok then warn("[EvoHub RE Lineups] execute failed:", err) end
            end)
            return true
        end

        local function setActive(entry)
            -- Lineup aiming/execution is possession-only. Markers may remain
            -- visible, but walking over one without the ball must do nothing.
            if entry and not hasLineupBall() then
                entry = nil
            end

            if state.active == entry then
                -- Possession can be lost without changing the nearest marker.
                if entry and not hasLineupBall() then
                    state.active = nil
                    stopAim()
                    freeFreeze()
                end
                return
            end

            restoreActiveMarkerColor()
            state.active = entry

            if state.markerMode == "Nearby" then
                destroyMarker(state.nearbyMarker)
                state.nearbyMarker = nil

                if entry then
                    state.nearbyMarker = makeMarker(entry, 1)
                    state.activeMarker = state.nearbyMarker
                end
            elseif entry then
                state.activeMarker = findMarkerFor(entry)
            end

            if state.activeMarker and state.activeMarker.Parent then
                state.activeMarker.Color = Color3.fromRGB(0, 255, 0)
            end

            if entry and hasLineupBall() then
                -- Auto-use is native lineup behavior now: entering the correct
                -- marker with possession aims and sends the style's mapped skill.
                executeEntry(entry)
            else
                stopAim()
                freeFreeze()
                state.lastExecuted = nil
            end
        end

        local function stopRuntime()
            if state.heartbeat then
                state.heartbeat:Disconnect()
                state.heartbeat = nil
            end
            setActive(nil)
            destroyAllMarkers()
            stopAim()
            freeFreeze()
        end

        local function startRuntime()
            stopRuntime()

            if not ensureIndex() then
                state.enabled = false
                notify("Failed to decode lineup database.")
                return
            end

            reloadExternal(true)
            rebuildPool(true)

            state.scanAccumulator = 0
            state.refreshAccumulator = 0

            state.heartbeat = RunService.Heartbeat:Connect(function(dt)
                if not state.enabled then return end

                state.scanAccumulator += dt
                state.refreshAccumulator += dt

                if state.refreshAccumulator >= 0.50 then
                    state.refreshAccumulator = 0
                    rebuildPool(false)
                end

                if state.scanAccumulator < 0.04 then return end
                state.scanAccumulator = 0

                -- Native source default is Disable Basic Lineups = false.
                -- Yield to legacy/basic pads unless the user disables them.
                if not state.disableBasicLineups and padCount and padCount > 0 then
                    setActive(nil)
                    return
                end

                if not hasLineupBall() then
                    setActive(nil)
                    return
                end

                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then
                    setActive(nil)
                    return
                end

                setActive(nearestEntry(root.Position))
            end)
        end

        -- V16 native visible controls:
        -- Enable / Toggle Line Ups [C] / Use Freeze / Smooth Aiming / Smoothness /
        -- Use Accuracy / Accuracy / Disable Basic Lineups.
        local enableToggle

        local function syncEnableToggle(value)
            if enableToggle and type(enableToggle.SetValue) == "function" then
                enableToggle:SetValue(value == true, true)
            end
        end

        local function manualSetEnabled(value)
            local style = getCurrentStyle()

            if value == true then
                state.suspendedStyle = nil
                state.enabled = true
                startRuntime()
                syncEnableToggle(state.enabled)
            else
                state.suspendedStyle = style
                state.enabled = false
                stopRuntime()
                syncEnableToggle(false)
            end
        end

        autoline:Toggle("Use Freeze", nil, true, function(value)
            state.useFreeze = value == true
            if not state.useFreeze then freeFreeze() end
        end)

        autoline:Toggle("Smooth Aiming", nil, false, function(value)
            state.smoothAiming = value == true
        end)

        autoline:Slider("Smoothness", 0.15, 0.01, 0.50, 0.01, function(value)
            state.smoothness = tonumber(value) or 0.15
        end)

        autoline:Toggle("Use Accuracy", nil, false, function(value)
            state.useAccuracy = value == true
        end)

        autoline:Slider("Accuracy", 100, 50, 100, 1, function(value)
            state.accuracy = tonumber(value) or 100
        end)

        autoline:Toggle("Disable Basic Lineups", nil, false, function(value)
            state.disableBasicLineups = value == true
        end)

        enableToggle = autoline:Toggle("Enable", nil, false, function(value)
            manualSetEnabled(value == true)
        end)

        local nativeLineupKeybind = autoline:Keybind(
            "Toggle Line Ups",
            Enum.KeyCode.C,
            "Toggle",
            function(active)
                manualSetEnabled(active == true)
            end
        )

        if nativeLineupKeybind then
            nativeLineupKeybind.ManualWatermark = false
        end

        -- User-requested lifecycle parity:
        -- each newly equipped supported style auto-starts its lineups;
        -- changing to another supported style rebuilds them;
        -- unsupported/nil style always clears the previous markers.
        state.lifecycleConnection = RunService.Heartbeat:Connect(function(dt)
            state.lifecycleAccumulator += dt
            if state.lifecycleAccumulator < 0.20 then return end
            state.lifecycleAccumulator = 0

            local style = getCurrentStyle()
            local team = getCurrentTeam()

            if style ~= state.observedStyle then
                state.observedStyle = style
                state.suspendedStyle = nil
            end

            local eligible = style
                and STYLE_CONFIG[style] ~= nil
                and team ~= nil

            if not eligible then
                if state.enabled then
                    state.enabled = false
                    stopRuntime()
                else
                    state.pool = {}
                    state.lastPoolStyle = nil
                    state.lastPoolTeam = nil
                    rebuildMarkers()
                end

                syncEnableToggle(false)
                return
            end

            if state.suspendedStyle == style then
                if state.enabled then
                    state.enabled = false
                    stopRuntime()
                end
                syncEnableToggle(false)
                return
            end

            if not state.enabled then
                state.enabled = true
                startRuntime()
                syncEnableToggle(state.enabled)
            end
        end)

        player.CharacterAdded:Connect(function()
            task.wait(0.15)
            setActive(nil)
            freeFreeze()
            state.lastPoolStyle = nil
            state.lastPoolTeam = nil
            state.observedStyle = nil
            destroyAllMarkers()
            -- lifecycleConnection restarts the correct style automatically
            -- once the new character/state is available.
        end)
    end

    installEvoHubRELineups()
end


