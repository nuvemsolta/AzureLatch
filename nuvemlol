local airDribbleAccumulator = 0
local airDribbleRemote = ReplicatedStorage:WaitForChild("ByteNetReliable")
local airDribblePacket = buffer.fromstring(buffers["base"])
local airDribbleAnimation = Instance.new("Animation")
airDribbleAnimation.AnimationId = "rbxassetid://76587445975710"
local airDribbleTrack = nil
local airDribbleTrackHumanoid = nil

local function getAirDribbleTrack(hum)
    if airDribbleTrack and airDribbleTrackHumanoid == hum then
        return airDribbleTrack
    end

    if airDribbleTrack then
        pcall(function() airDribbleTrack:Stop(0) end)
        airDribbleTrack = nil
    end

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end

    local ok, track = pcall(function()
        return animator:LoadAnimation(airDribbleAnimation)
    end)

    if ok then
        airDribbleTrack = track
        airDribbleTrackHumanoid = hum
        return track
    end

    return nil
end

local function performAirDribble()
    local now = tick()
    if now - airDribbleState.lastKick < cooldown then
        return
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end

    airDribbleState.lastKick = now

    local track = getAirDribbleTrack(hum)
    if track then
        track:Play(0)
    end

    local dir = root.CFrame.LookVector
    local kickVec = Vector3.new(dir.X * 0.75, 0.65, dir.Z * 0.75)

    airDribbleRemote:FireServer(airDribblePacket, {
        { "kick", 28, false, kickVec }
    })
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp or input.KeyCode ~= bindKey then return end
    if not airDribbleState.enabled then return end

    airDribbleState.isHolding = true

    performAirDribble()

    if holdingConnection then holdingConnection:Disconnect() end
    airDribbleAccumulator = 0

    holdingConnection = RunService.Heartbeat:Connect(function(dt)
        if not airDribbleState.isHolding
            or not airDribbleState.enabled then

            holdingConnection:Disconnect()
            holdingConnection = nil
            airDribbleAccumulator = 0
            return
        end

        airDribbleAccumulator += dt

        if airDribbleAccumulator < (1 / 30) then
            return
        end

        airDribbleAccumulator = 0
        performAirDribble()
    end)
end)

