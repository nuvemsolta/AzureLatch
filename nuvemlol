            local distance =
                math.max(raw.Magnitude, 1)

            local height =
                math.clamp(
                    raw.Y,
                    -distance * 0.9,
                    distance * 0.9
                )

            local horizontal =
                math.sqrt(
                    math.max(
                        distance * distance
                            - height * height,
                        0.01
                    )
                )

            local flatLook = Vector3.new(
                camera.CFrame.LookVector.X,
                0,
                camera.CFrame.LookVector.Z
            )

            if flatLook.Magnitude <= 0.01 then
                flatLook =
                    -root.CFrame.LookVector
            else
                flatLook = flatLook.Unit
            end

            state.cameraOffset =
                -flatLook * horizontal
                + Vector3.new(0, height, 0)
        end

        camera.CameraType =
            Enum.CameraType.Scriptable

        return camera
    end

    local function updateCamera(root, targetPosition)
        local camera = setupCamera(root)

        if not camera then
            return
        end

        UserInputServiceService.MouseBehavior =
            Enum.MouseBehavior.Default

        camera.CameraType =
            Enum.CameraType.Scriptable

        local cameraPosition =
            root.Position + state.cameraOffset

        if (targetPosition - cameraPosition).Magnitude
            <= 0.001 then

            return
        end

        camera.CFrame =
            CFrame.lookAt(
                cameraPosition,
                targetPosition,
                Vector3.yAxis
            )

        camera.Focus =
            CFrame.new(targetPosition)
    end

    local function lockTarget()
        local target = state.lockBall

        if target
            and target.Parent
            and target:IsA("BasePart") then

            state.lockMissingSince = 0
            return target
        end

        target = currentBall()

        if target then
            state.lockBall = target
            state.lockMissingSince = 0
            return target
        end

        if state.lockMissingSince == 0 then
            state.lockMissingSince = os.clock()
        end

        return nil
    end

    local trapGroundParams = RaycastParams.new()
    trapGroundParams.FilterType = Enum.RaycastFilterType.Exclude

    local function groundMissed(target, char)
        local now = os.clock()

        if now - state.lockLastGroundCheck < 0.05 then
            return state.lockLastGrounded
        end

        state.lockLastGroundCheck = now

        trapGroundParams.FilterDescendantsInstances = {
            char,
            target
        }

        local position = target.Position
        local velocity = target.AssemblyLinearVelocity

        local hit = WorkspaceService:Raycast(
            position,
            Vector3.new(0, -3.5, 0),
            trapGroundParams
        )

        local distance =
            hit
            and (position - hit.Position).Magnitude
            or math.huge

        local airborneNow =
            distance > 1.15
            or velocity.Y > 1.2

        if airborneNow then
            state.lockSeenAir = true
            state.lockLowSince = 0
            state.lockLastGrounded = false
            return false
        end

        if not state.lockSeenAir then
            state.lockLastGrounded = false
            return false
        end

        if velocity.Y > 0.35 then
            state.lockLowSince = 0
            state.lockLastGrounded = false
            return false
        end

        if state.lockLowSince == 0 then
            state.lockLowSince = now
            state.lockLastGrounded = false
            return false
        end

        state.lockLastGrounded =
            now - state.lockLowSince >= 0.22

        return state.lockLastGrounded
    end

    local function physicsLock(dt)
        if not state.lockActive then
            return
        end

        if hasBall() then
            stopLock()
            return
        end

        local target = lockTarget()

        if not target then
            if state.lockMissingSince > 0
                and os.clock() - state.lockMissingSince > 0.18 then

                stopLock()
            end

            return
        end

        local char = character()
        local humanoid =
            char and char:FindFirstChildOfClass("Humanoid")
        local root =
            char and char:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root then
            stopLock()
            return
        end

        local holder =
            ballHolder and ballHolder.Value

        if holder
            and holder ~= char then

            stopLock()
            return
        end

        faceBall(
            root,
            humanoid,
            target.Position
        )

        pullBall(
            root,
            target.Position,
            dt
        )
    end

    local function startLock(ball)
        if not ball or not ball.Parent then
            return
        end

        stopLock()

        state.lockActive = true
        state.lockBall = ball
        state.lockConfirmed = false
        state.lockMissingSince = 0
        state.lockSeenAir = false
        state.lockLowSince = 0
        state.lockLastGroundCheck = 0
        state.lockLastGrounded = false

        physicsLock(0)

        RunServiceService:BindToRenderStep(
            lockName,
            Enum.RenderPriority.Last.Value + 100,
            function()
                if not state.lockActive then
                    return
                end

                if hasBall() then
                    stopLock()
                    return
                end

                local target = lockTarget()

                if not target then
                    if state.lockMissingSince > 0
                        and os.clock() - state.lockMissingSince > 0.18 then

                        stopLock()
                    end

                    return
                end

                local char = character()
                local root =
                    char and char:FindFirstChild("HumanoidRootPart")

                if not root then
                    stopLock()
                    return
                end

                updateCamera(
                    root,
                    target.Position
                )

                if groundMissed(target, char) then
                    stopLock()
                end
            end
        )
    end

    local function confirmLock()
        if state.lockActive then
            state.lockConfirmed = true
        end
    end

    local function fireTrap(profile)
        if profile.style == "Nagi" then
            remote:FireServer(
                packet,
                {
                    {
                        "skill2",
                        true
                    }
                }
            )

            return true
        end

        if profile.style == "Shidou" then
            remote:FireServer(
                packet,
                {
                    {
                        "skill1",
                        "Front",
                        true
                    }
                }
            )

            return true
        end

        return false
    end

    local function tryPending()
        local pending = state.pending

        if not pending then
            return
        end

        local ball = pending.ball

        if not state.enabled
            or not ball
            or not ball.Parent
            or hasBall() then

            state.pending = nil
            return
        end

        local char = character()
        local humanoid =
            char and char:FindFirstChildOfClass("Humanoid")
        local root =
            char and char:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root then
            state.pending = nil
            return
        end

        local timing = trapTiming(ball, root)

        if not timing then
            state.pending = nil
            return
        end

        pending.enterTime = timing.enterTime
        pending.activationLead = timing.activationLead
        pending.jumpLead = timing.jumpLead

        if onCooldown(pending.profile.skill) then
            state.pending = nil
            return
        end

        if not pending.jumpStarted
            and timing.enterTime <= timing.jumpLead then

            pending.jumpStarted = true
            humanoid.Jump = true
            humanoid:ChangeState(
                Enum.HumanoidStateType.Jumping
            )
        end

        if pending.jumpStarted then
            humanoid.Jump = true
        end

        if timing.enterTime > timing.activationLead then
            return
        end

        if not airborne(humanoid, root) then
            return
        end

        state.pending = nil
        state.attemptedBall = ball

        startLock(ball)

        if not fireTrap(pending.profile) then
            stopLock()
        end
    end

    local function beginAttempt(ball)
        if state.pending
            or state.attemptedBall == ball then

            return
        end

        local profile =
            resolveProfile(false)

        if not profile then
            return
        end

        state.pending = {
            ball = ball,
            profile = profile,
            jumpStarted = false,
            enterTime = nil,
            activationLead = nil,
            jumpLead = nil
        }

        tryPending()
    end

    local function evaluate()
        if not state.enabled
            or hasBall()
            or os.clock() > state.eligibleUntil then

            return
        end

        if ballHolder
            and ballHolder.Value ~= nil then

            return
        end

        local ball = currentBall()

        if not ball
            or not eligibleBall(ball) then

            return
        end

        local now = os.clock()

        updateObservedVelocity(
            ball,
            now
        )

        if state.attemptedBall == ball then
            return
        end

        if state.pending then
            tryPending()
            return
        end

        local char = character()
        local root =
            char and char:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        local timing =
            trapTiming(ball, root)

        if timing
            and timing.enterTime <= timing.jumpLead then

            beginAttempt(ball)
        end
    end

    local function hookLocalAnimator(char)
        if state.localAnimatorConnection then
            state.localAnimatorConnection:Disconnect()
            state.localAnimatorConnection = nil
        end

        task.spawn(function()
            if not state.enabled
                or not char
                or not char.Parent then

                return
            end

            local humanoid =
                char:FindFirstChildOfClass("Humanoid")
                or char:WaitForChild("Humanoid", 5)

            local animator =
                humanoid
                and (
                    humanoid:FindFirstChildOfClass("Animator")
                    or humanoid:WaitForChild("Animator", 5)
                )

            if not state.enabled
                or not animator then

                return
            end

            state.localAnimatorConnection =
                animator.AnimationPlayed:Connect(function(track)
                    local animation =
                        track.Animation

                    if not animation then
                        return
                    end

                    local style =
                        CONFIRMED_TRAP_ANIMATIONS[
                            animation.AnimationId
                        ]

                    if not style then
                        return
                    end

                    if style == "Nagi"
                        or style == "Shidou" then

                        state.profile = {
                            style = style,
                            skill = profiles[style].skill
                        }
                    end

                    confirmLock()
                end)
        end)
    end

    local function hookSourceCharacter(char, key)
        if not char or not char.Parent then
            return
        end

        task.spawn(function()
            local humanoid =
                char:FindFirstChildOfClass("Humanoid")
                or char:WaitForChild("Humanoid", 5)

            local animator =
                humanoid
                and (
                    humanoid:FindFirstChildOfClass("Animator")
                    or humanoid:WaitForChild("Animator", 5)
                )

            if not state.enabled
                or not animator
                or not char.Parent then

                return
            end

            local existing =
                state.npcConnections[key]

            if existing then
                existing:Disconnect()
            end

            state.npcConnections[key] =
                animator.AnimationPlayed:Connect(function(track)
                    if not state.enabled
                        or not track.Animation then

                        return
                    end

                    local animationId =
                        track.Animation.AnimationId

                    if animationId == SUPER_THROW_ANIMATION
                        and isSuperThrowSource(char) then

                        armRelease(
                            char,
                            "superthrow",
                            true
                        )

                        return
                    end

                    if ballHolder
                        and ballHolder.Value == char
                        and isDefensiveSource(char) then

                        if animationId == AIR_KICK_ANIMATION
                            or track.Priority.Value
                                >= Enum.AnimationPriority.Action.Value then

                            state.fastSource = char
                            state.fastUntil =
                                os.clock() + 1.3
                        end
                    end
                end)
        end)
    end

    local function hookPlayer(player)
        if player == localPlayer then
            return
        end

        local old =
            state.playerCharacterConnections[player]

        if old then
            old:Disconnect()
        end

        state.playerCharacterConnections[player] =
            player.CharacterAdded:Connect(function(char)
                hookSourceCharacter(
                    char,
                    player
                )
            end)

        if player.Character then
            hookSourceCharacter(
                player.Character,
                player
            )
        end
    end

    local function hookNPC(char)
        if not isNeutralNPC(char) then
            return
        end

        hookSourceCharacter(
            char,
            char
        )
    end

    local function clearSourceHooks()
        for key, connection in pairs(state.npcConnections) do
            if connection then
                connection:Disconnect()
            end

            state.npcConnections[key] = nil
        end

        for player, connection in pairs(state.playerCharacterConnections) do
            if connection then
                connection:Disconnect()
            end

            state.playerCharacterConnections[player] = nil
        end

        disconnectList(
            state.sourceConnections
        )
    end

    local function resetRuntime()
        state.pending = nil
        state.attemptedBall = nil

        state.releaseSource = nil
        state.releaseKind = nil
        state.eligibleUntil = 0
        state.eligibleBall = nil

        state.fastSource = nil
        state.fastUntil = 0

        state.lastBallPosition = nil
        state.lastBallTime = 0
        state.observedVelocity =
            Vector3.zero
        state.evalAccumulator = 0
    end

    local function onHolderChanged(current)
        local previous =
            state.lastHolder

        state.lastHolder =
            current

        if current == nil then
            if previous == character() then
                clearRelease()
                state.pending = nil
                state.attemptedBall = nil
                stopLock()
                return
            end

            if state.releaseKind == "superthrow"
                and state.releaseSource == previous
                and os.clock() <= state.eligibleUntil
                and isSuperThrowSource(previous) then

                state.eligibleBall = nil
                state.pending = nil
                state.attemptedBall = nil
                evaluate()
                return
            end

            if isDefensiveSource(previous) then
                local fast =
                    state.fastSource == previous
                    and os.clock() <= state.fastUntil

                armRelease(
                    previous,
                    "pass",
                    fast
                )

                state.pending = nil
                state.attemptedBall = nil
                evaluate()
                return
            end

            clearRelease()
            return
        end

        if current == character() then
            clearRelease()
            state.pending = nil
            state.attemptedBall = nil
            stopLock()
            return
        end

        if state.lockActive then
            stopLock()
        end

        if not (
            state.releaseKind == "superthrow"
            and state.releaseSource == current
            and os.clock() <= state.eligibleUntil
        ) then
            clearRelease()
        end
    end

    local function enable()
        if state.enabled then
            return
        end

        state.enabled = true
        resetRuntime()

        state.profile = nil
        state.profileCheckedAt = 0
        resolveProfile(true)

        local ball =
            terrain:FindFirstChild("Ball")

        if ball
            and ball:IsA("BasePart") then

            setBall(ball)
        end

        if ballHolder then
            state.lastHolder =
                ballHolder.Value

            addConnection(
                ballHolder.Changed:Connect(
                    onHolderChanged
                )
            )
        end

        addConnection(
            terrain.ChildAdded:Connect(function(child)
                if child.Name ~= "Ball"
                    or not child:IsA("BasePart") then

                    return
                end

                setBall(child)

                if state.releaseSource
                    and os.clock() <= state.eligibleUntil then

                    state.eligibleBall = child
                    evaluate()
                end
            end)
        )

        addConnection(
            terrain.ChildRemoved:Connect(function(child)
                if child ~= state.ball then
                    return
                end

                state.ball = nil
                state.lastBallPosition = nil
                state.lastBallTime = 0
                state.observedVelocity =
                    Vector3.zero

                if state.lockActive then
                    state.lockMissingSince =
                        os.clock()
                end
            end)
        )

        addConnection(
            localPlayer.CharacterAdded:Connect(function(char)
                stopLock()
                resetRuntime()
                state.profile = nil
                state.profileCheckedAt = 0

                hookLocalAnimator(char)
            end)
        )

        addConnection(
            PlayersService.PlayerAdded:Connect(
                hookPlayer
            ),
            true
        )

        addConnection(
            PlayersService.PlayerRemoving:Connect(function(player)
                local connection =
                    state.playerCharacterConnections[player]

                if connection then
                    connection:Disconnect()
                    state.playerCharacterConnections[player] = nil
                end

                local animatorConnection =
                    state.npcConnections[player]

                if animatorConnection then
                    animatorConnection:Disconnect()
                    state.npcConnections[player] = nil
                end
            end),
            true
        )

        for _, player in ipairs(PlayersService:GetPlayers()) do
            hookPlayer(player)
        end

        local charactersFolder =
            WorkspaceService:FindFirstChild("characters")

        if charactersFolder then
            for _, char in ipairs(charactersFolder:GetChildren()) do
                hookNPC(char)
            end

            addConnection(
                charactersFolder.ChildAdded:Connect(
                    hookNPC
                ),
                true
            )
        end

        if localPlayer.Character then
            hookLocalAnimator(
                localPlayer.Character
            )
        end

        addConnection(
            RunServiceService.PreSimulation:Connect(function(dt)
                if not state.enabled then
                    return
                end

                if state.lockActive then
                    physicsLock(dt)
                end

                if state.pending
                    or (
                        state.releaseSource
                        and os.clock()
                            <= state.eligibleUntil
                    ) then

                    state.evalAccumulator += dt
                    if state.evalAccumulator >= (1 / 60) then
                        state.evalAccumulator = 0
                        evaluate()
                    end
                else
                    state.evalAccumulator = 0
                end
            end)
        )
    end

    local function disable()
        if not state.enabled then
            return
        end

        state.enabled = false

        stopLock()

        if state.localAnimatorConnection then
            state.localAnimatorConnection:Disconnect()
            state.localAnimatorConnection = nil
        end

        clearSourceHooks()
        disconnectList(
            state.connections
        )

        resetRuntime()
    end

    at:Dropdown(
        "Auto Trap Mode",
        {
            "Legit",
            "Blatant"
        },
        function(value)
            if value == "Legit"
                or value == "Blatant" then

                state.mode = value
            end
        end
    )

    at:Slider(
        "Auto Trap Range",
        18,
        5,
        60,
        1,
        function(value)
            state.range = value
            state.pending = nil
            state.attemptedBall = nil
        end
    )

    at:Toggle("Auto Trap", function(value)
        if value == true then
            enable()
        else
            disable()
        end
    end)
end

local autoact = maintab2:Folder("Auto Activate Features.", Color3.fromRGB(24, 255, 228), true)
autoact:Label("Auto Activate: Activates The Move When Ball Within Range.")

do
    local autoActivateState = {
        enabled = false,
        distance = 10,
        moveNumber = 1,
        m2Held = false,
        armed = true,
        waitingCooldown = false,
        cooldownSeen = false,
        cooldownObject = nil,
        cooldownSkill = nil,
        lastBall = nil,
        lastFire = 0,
        connection = nil,
        accumulator = 0
    }

    local autoActivateUIS = game:GetService("UserInputService")
    local autoActivateRunService = game:GetService("RunService")
    local autoActivatePlayers = game:GetService("Players")
    local autoActivateReplicatedStorage = game:GetService("ReplicatedStorage")
    local autoActivateRemote = autoActivateReplicatedStorage:WaitForChild("ByteNetReliable")
    local autoActivatePacket = buffer.fromstring(buffers["base"])
    local autoActivatePlayer = autoActivatePlayers.LocalPlayer

    local function isMobile()
        local ok, preferred = pcall(function()
            return autoActivateUIS.PreferredInput
        end)

        if ok then
            return preferred == Enum.PreferredInput.Touch
        end

        return autoActivateUIS.TouchEnabled
            and not autoActivateUIS.KeyboardEnabled
    end

    local function resetCycle()
        autoActivateState.armed = true
        autoActivateState.waitingCooldown = false
        autoActivateState.cooldownSeen = false
        autoActivateState.lastBall = nil
        autoActivateState.lastFire = 0
    end

    local function clearCooldown()
        autoActivateState.cooldownObject = nil
        autoActivateState.cooldownSkill = nil
    end

    local function getCooldown()
        local skillName = "skill" .. tostring(autoActivateState.moveNumber)

        if autoActivateState.cooldownObject
            and autoActivateState.cooldownObject.Parent
            and autoActivateState.cooldownSkill == skillName then

            return autoActivateState.cooldownObject
        end

        clearCooldown()

        local playerGui = autoActivatePlayer:FindFirstChild("PlayerGui")
        local hotbar = playerGui and playerGui:FindFirstChild("Hotbar")
        local backpack = hotbar and hotbar:FindFirstChild("Backpack")
        local slots = backpack and backpack:FindFirstChild("Hotbar")
        local slot = slots and slots:FindFirstChild(skillName)
        local cooldown = slot and slot:FindFirstChild("Cooldown", true)

        if cooldown and cooldown:IsA("GuiObject") then
            autoActivateState.cooldownObject = cooldown
            autoActivateState.cooldownSkill = skillName
            return cooldown
        end
    end

    local function cooldownState()
        local cooldown = getCooldown()

        if not cooldown then
            return false, false
        end

        return true, cooldown.Visible == true
    end

    local function canActivate()
        if not autoActivateState.enabled then
            return false
        end

        if isMobile() then
            return true
        end

        return autoActivateState.m2Held
    end

    local function fireMove(now)
        if now - autoActivateState.lastFire < 0.12 then
            return
        end

        autoActivateState.lastFire = now
        autoActivateState.armed = false
        autoActivateState.waitingCooldown = true
        autoActivateState.cooldownSeen = false

        autoActivateRemote:FireServer(
            autoActivatePacket,
            {
                {
                    "skill" .. autoActivateState.moveNumber
                }
            }
        )
    end

    local startAutoActivateLoop
    local stopAutoActivateLoop

    autoact:Textbox("Auto Activate Move Number", "Example: 1, 2, 3, 4, 5.", function(value)
        local number = tonumber(value)

        if number and number >= 1 and number <= 5 then
            autoActivateState.moveNumber = number
            clearCooldown()
            resetCycle()
        end
    end)

    autoact:Slider("Auto Activate Distance", 10, 3, 70, 0.5, function(value)
        autoActivateState.distance = value
    end)

    autoact:Toggle("Auto Activate", function(value)
        autoActivateState.enabled = value == true
        autoActivateState.m2Held = false
        clearCooldown()
        resetCycle()

        if autoActivateState.enabled then
            startAutoActivateLoop()
        else
            stopAutoActivateLoop()
        end
    end)

    autoActivateUIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or isMobile() then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            autoActivateState.m2Held = true

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end
    end)

    autoActivateUIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            autoActivateState.m2Held = false

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end
    end)

    autoActivatePlayer.CharacterAdded:Connect(function()
        clearCooldown()
        resetCycle()
    end)

    local function autoActivateStep(dt)
        if not autoActivateState.enabled then
            return
        end

        autoActivateState.accumulator += dt

        if autoActivateState.accumulator < (1 / 30) then
            return
        end

        autoActivateState.accumulator = 0

        local character = autoActivatePlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        local now = os.clock()
        local ball = workspace.Terrain:FindFirstChild("Ball")
        local cooldownKnown, cooldownActive = cooldownState()

        if autoActivateState.waitingCooldown then
            if cooldownKnown and cooldownActive then
                autoActivateState.cooldownSeen = true

            elseif autoActivateState.cooldownSeen and not cooldownActive then
                autoActivateState.waitingCooldown = false
                autoActivateState.cooldownSeen = false
                autoActivateState.armed = true
            end
        end

        if not ball then
            autoActivateState.lastBall = nil

            if autoActivateState.waitingCooldown
                and not autoActivateState.cooldownSeen
                and now - autoActivateState.lastFire >= 0.2 then

                autoActivateState.waitingCooldown = false
                autoActivateState.armed = true

            elseif not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end

            return
        end

        if autoActivateState.lastBall ~= ball then
            autoActivateState.lastBall = ball

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end

        local delta = root.Position - ball.Position
        local distanceSq = delta:Dot(delta)
        local triggerDistance = autoActivateState.distance
        local inRange = distanceSq <= triggerDistance * triggerDistance
        local exitDistance = triggerDistance
            + math.max(1.5, triggerDistance * 0.08)

        if distanceSq > exitDistance * exitDistance then
            if autoActivateState.waitingCooldown
                and not autoActivateState.cooldownSeen
                and now - autoActivateState.lastFire >= 0.2 then

                autoActivateState.waitingCooldown = false
                autoActivateState.armed = true

            elseif not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end

        if not canActivate()
            or not inRange
            or not autoActivateState.armed
            or autoActivateState.waitingCooldown
            or cooldownActive then

            return
        end

        fireMove(now)
    end

    stopAutoActivateLoop = function()
        if autoActivateState.connection then
            autoActivateState.connection:Disconnect()
            autoActivateState.connection = nil
        end

        autoActivateState.accumulator = 0
    end

    startAutoActivateLoop = function()
