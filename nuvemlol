                setSidebarSelected(section)
                task.defer(function()
                    if tab.Page and section.Frame and section.Frame.Parent then
                        local relative = section.Frame.AbsolutePosition.Y
                            - tab.Page.AbsolutePosition.Y
                            + tab.Page.CanvasPosition.Y
