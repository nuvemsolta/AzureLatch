                stopCamLock()
            end

            return
        end

        if not holdingRMB
            or not humanoid then

            resetLineupPhysics()
            if not padIndex and activeTarget then
                stopCamLock()
            end
            return
        end

        if not padIndex then
            resetLineupPhysics()
            stopCamLock()
            return
        end

        local targetPart =
            Workspace:FindFirstChild("target" .. padIndex)

        if not targetPart then
            resetLineupPhysics()
            return
        end

        if activeTarget ~= targetPart then
            startCamLock(targetPart)
        end

        applyLineupMode()
    end)
