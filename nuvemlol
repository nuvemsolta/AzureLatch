        local current = root.Position

        local delta = Vector3.new(
            targetPosition.X - current.X,
            0,
            targetPosition.Z - current.Z
        )

        local distance = delta.Magnitude

        if distance <= 0.65
            or distance > state.range + 20 then

            return
        end

        local step = math.min(
            distance - 0.65,
            92 * math.clamp(dt or (1 / 60), 0, 0.04)
        )

        if step <= 0 then
            return
        end

        local newPosition =
            current + delta.Unit * step

        root.CFrame =
            CFrame.lookAt(
                newPosition,
                Vector3.new(
                    targetPosition.X,
                    newPosition.Y,
                    targetPosition.Z
                ),
                Vector3.yAxis
