                                or input.UserInputType == Enum.UserInputType.Touch
                            ) then
                                update(input.Position.X)
                            end
                        end)
                    end

                    local function apply()
                        object.Value = Color3.fromHSV(hue, sat, val)
                        swatch.BackgroundColor3 = object.Value
                        pcall(callback, object.Value)
                    end

                    makeHSVSlider("H", hue, function(x) hue = x; apply() end)
                    makeHSVSlider("S", sat, function(x) sat = x; apply() end)
                    makeHSVSlider("V", val, function(x) val = x; apply() end)

                    function object:SetValue(newValue, silent)
