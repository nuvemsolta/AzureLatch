        local function createDistanceEngine(ctx)
            local player = assert(ctx.player, "player required")
            local RunService = assert(ctx.runService, "runService required")
            local autoLineupState = ctx.autoLineupState

            local engine = {
                ActiveBuffs = {},
                ActiveDashes = {},
                RenderConn = nil,
                AnimConn = nil,
                CharacterConn = nil,
            }

            local FALLBACK_FORWARD = Vector3.new(0, 0, 1)

            local function autoLineupBusy()
                return autoLineupState
                    and (autoLineupState.IsExecuting or autoLineupState.Frozen)
            end

            local function horizontalUnit(v, fallback)
                local h = Vector3.new(v.X, 0, v.Z)
                if h.Magnitude < 0.01 then
                    return fallback
                end
                return h.Unit
            end

            local function namedDirection(hrp, name)
                local forward = horizontalUnit(hrp.CFrame.LookVector, FALLBACK_FORWARD)
                local right = horizontalUnit(hrp.CFrame.RightVector, Vector3.new(1, 0, 0))

                if name == "Right" then
                    return right
                elseif name == "Left" then
                    return -right
                elseif name == "Front" then
                    return forward
                elseif name == "Back" then
                    return -forward
                elseif name == "FrontRight" then
                    return (forward + right).Unit
                elseif name == "FrontLeft" then
                    return (forward - right).Unit
                elseif name == "RightBack" then
                    return (-forward + right).Unit
                elseif name == "LeftBack" then
                    return (-forward - right).Unit
                end

                return forward
            end

            function engine:stopAll()
                table.clear(self.ActiveDashes)

                if self.RenderConn then
                    self.RenderConn:Disconnect()
                    self.RenderConn = nil
                end
            end

            local function updateDashes(dt)
                if autoLineupBusy() then
                    engine:stopAll()
                    return
                end

                for index = #engine.ActiveDashes, 1, -1 do
                    local dash = engine.ActiveDashes[index]
                    local hrp = dash.hrp

                    if not hrp or not hrp.Parent then
                        table.remove(engine.ActiveDashes, index)
                        continue
                    end

                    local stepDistance
                    if dash.isUnlimited then
                        stepDistance = dash.speed * dt
                    else
                        stepDistance = math.min(dash.speed * dt, dash.remaining)
                    end

                    local direction

                    if dash.isDirectional and dash.directionName then
                        direction = namedDirection(hrp, dash.directionName)
                    elseif dash.useMovement then
                        local character = hrp.Parent
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                        if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
