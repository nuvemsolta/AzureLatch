                end

                local function horizontalVertical(ball, rootPosition)
                    local horizontal = (
                        Vector3.new(rootPosition.X, 0, rootPosition.Z)
                        - Vector3.new(ball.Position.X, 0, ball.Position.Z)
                    ).Magnitude
                    local vertical = math.abs(rootPosition.Y - ball.Position.Y)
                    return horizontal, vertical
                end

                local function attempt(skill, ball, rootPosition, shouldFlick)
                    local maxDist = skill == "skill3"
                        and variant.skill3MaxDist
                        or variant.skill4MaxDist
                    local maxVert = skill == "skill3"
                        and variant.skill3MaxVert
                        or variant.skill4MaxVert

                    local horizontal, vertical = horizontalVertical(ball, rootPosition)
                    if horizontal > maxDist or vertical > maxVert then
                        return false
                    end

                    if skill == "skill4" and ball.Position.Y < variant.skill4MinHeight then
                        return false
                    end

                    if Core:isOnCooldown(skill) then
                        return false
                    end

                    if variant.useJump and ball.Position.Y >= 5 then
                        jump()
                        task.wait(0.03)
