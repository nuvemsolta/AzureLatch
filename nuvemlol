                local terrain = workspace:FindFirstChild("Terrain")
                local ball = terrain and terrain:FindFirstChild("Ball")

                if ball and ball:IsA("BasePart") then
                    return ball
                end

                local fallback = workspace:FindFirstChild("Ball", true)

                if fallback and fallback:IsA("BasePart") then
                    return fallback
                end

                return nil
            end

            local function cancelBoost(cfg)
                for _, dash in ipairs(ActiveDashes) do
                    if dash.cfg == cfg then
                        dash.cancelled = true
                    end
                end
            end

            local function startBoost(cfg, direction, track)
                local _, _, root = getCharacter()
                if not root then
                    return
                end

                local distance = Distances[cfg.sliderVar] or 0
                if distance <= 0 then
                    return
                end

                local moveDir = flatUnit(direction)
                if not moveDir then
                    return
                end

