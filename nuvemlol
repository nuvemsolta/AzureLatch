            local Core = assert(ctx.core, "core helpers required")

            local AutoDefensive = {
                Variants = {},
                Enabled = false,
                ByteNetReliable = nil,
                Connection = nil,
                AnimationTracking = {},
                LastDefenseTime = 0,

                -- Earlier values exist in the obfuscated initializer, but later duplicate
                -- keys overwrite them. Effective values are 200 / 200.
                MAX_BALL_DISTANCE = 200,
                MAX_VERTICAL_DISTANCE = 200,

                GlobalGoalboxes = {
                    A = {minX = -668.15, maxX = -407.51, minZ = 1611.19, maxZ = 1706.13},
                    B = {minX = -668.01, maxX = -407.68, minZ = 841.70, maxZ = 935.59},
                },

                GlobalEnemyGoalboxes = {
                    A = {minX = -858.81, maxX = -217.79, minZ = 1460.15, maxZ = 1706.26},
                    B = {minX = -859.01, maxX = -217.90, minZ = 841.60, maxZ = 1098.19},
