Players.LocalPlayer.CharacterAdded:Connect(setupBallMagnetCharacter)

local function stopBallMagnetLoop()
    if ballMagnetState.conn then
        ballMagnetState.conn:Disconnect()
        ballMagnetState.conn = nil
    end
    ballMagnetState.accumulator = 0
end

local function startBallMagnetLoop()
    stopBallMagnetLoop()

    ballMagnetState.conn = RunService.Heartbeat:Connect(function(dt)
        if not ballMagnetState.active then return end

        ballMagnetState.accumulator += dt
        if ballMagnetState.accumulator < (1 / 60) then return end
        ballMagnetState.accumulator = 0

        local root = ballMagnetState.hrp
        if not root or not root.Parent then return end

        local radius = ballMagnetState.radius
        if radius < 2 then return end

        if ballMagnetState.useM2Hold
            and not ballMagnetUIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            return
        end

        local ball = ballMagnetTerrain:FindFirstChild("Ball")
        if not ball then return end

        local delta = root.Position - ball.Position
        if delta:Dot(delta) > radius * radius then return end

        local now = os.clock()
        if now - ballMagnetState.lastFire < ballMagnetState.fireInterval then return end
        ballMagnetState.lastFire = now

        ballMagnetRemote:FireServer(ballMagnetPacket)
    end)
end

