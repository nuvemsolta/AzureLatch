        end
        for _, profile in pairs(profiles) do
            for _, word in ipairs(profile.trapWords) do
                if (texts[profile.skill] or ""):find(normalize(word), 1, true) then state.profile = profile; return profile end
            end
        end
        local text = table.concat(all, " ")
        local found, best = nil, 0
        for _, profile in pairs(profiles) do
            local score = 0
            for _, word in ipairs(profile.words) do if text:find(word, 1, true) then score = score + #word end end
            if score > best then found, best = profile, score end
        end
        if not found then
            local function inspect(object)
                if not object then return end
                for key, value in pairs(object:GetAttributes()) do
                    key = normalize(key)
                    if key:find("style", 1, true) or key:find("character", 1, true) then
                        local valueText = normalize(value)
                        for name, profile in pairs(profiles) do
                            if valueText:find(normalize(name), 1, true) then found = profile; return end
                        end
                    end
                end
            end
            inspect(lp)
            if not found then inspect(state.char) end
        end
        state.profile = found
        return found
    end
    local function onCooldown(profile)
        local entry = state.slots[profile.skill]
        local slot = entry and entry.slot
        if not slot or not slot.Parent then return false end

        local cooldown = entry.cooldown
        if not cooldown or not cooldown.Parent then
            cooldown = slot:FindFirstChild("Cooldown", true)
            entry.cooldown = cooldown
        end

        return cooldown and cooldown:IsA("GuiObject") and cooldown.Visible or false
    end
    local function refreshGroundFilter(ball, now)
        if state.filterBall == ball and now - state.filterAt < 0.25 then return end
        state.filterBall, state.filterAt = ball, now
        local exclude = {ball}
        for char in pairs(state.characters) do if char.Parent then exclude[#exclude + 1] = char end end
        if state.char then exclude[#exclude + 1] = state.char end
        groundParams.FilterDescendantsInstances = exclude
    end
    local function sampleBall(ball, now)
        refreshGroundFilter(ball, now)
        local position, physics = ball.Position, ball.AssemblyLinearVelocity
        local previous = state.sample
        local dt = previous and now - previous.at or 0
        local valid = previous and previous.ball == ball and dt >= 1 / 500 and dt <= 0.12
        local measured = valid and (position - previous.position) / dt or nil
        local discontinuity = measured and (position - previous.position).Magnitude > math.max(8, physics.Magnitude * dt * 3)
        if discontinuity then valid, measured = false, nil end
        local velocity = physics
        -- Positional replication is a fallback for range prediction, not aerial evidence.
        if measured and physics.Magnitude < 1 and measured.Magnitude > 1 and measured.Magnitude < 500 then velocity = measured end
        local radius = math.max(ball.Size.Y * 0.5, 0.1)
        local depth = 256
        local hit = ws:Raycast(position, Vector3.new(0, -depth, 0), groundParams)
        local groundKnown = hit ~= nil and hit.Normal.Y >= 0.65
        local clearance = groundKnown and math.max(0, position.Y - hit.Position.Y - radius) or 0
        local sample = {ball = ball, at = now, position = position, velocity = velocity,
            physics = physics, measuredY = measured and measured.Y or nil,
            clearance = clearance, groundKnown = groundKnown,
            samples = valid and math.min(previous.samples + 1, 4) or 1,
            previousClearance = valid and previous.groundKnown and previous.clearance or nil}
        state.sample = sample
        return sample
    end
    -- Pure gate, shared by acquisition, the jump wait and the final send check.
    local function airEligible(sample, height, gravity)
        if not sample or not sample.groundKnown or sample.samples < 2 then return false end
        local clearance = sample.clearance
        if clearance <= 0.35 then return false end -- rolling and tiny contact bounces
        if clearance >= height and sample.previousClearance and sample.previousClearance > 0.35 then return true end
        local up = sample.physics.Y
        -- A high measured velocity alone can be a replication snap. Require both signals.
        if up <= 4 or not sample.measuredY or sample.measuredY <= 2
            or not sample.previousClearance or clearance <= sample.previousClearance then return false end
        local apex = clearance + up * up / (2 * math.max(gravity, 1))
        return apex >= height
    end
    -- Aerial controller. Hiori never enters this sampler, classifier or planner.
    local aerialCollision = RaycastParams.new()
    aerialCollision.FilterType = Enum.RaycastFilterType.Exclude
    aerialCollision.IgnoreWater = true
    aerialCollision.RespectCanCollide = true
    local aerialQuery = RaycastParams.new()
    aerialQuery.FilterType = Enum.RaycastFilterType.Exclude
    aerialQuery.IgnoreWater = true
    aerialQuery.RespectCanCollide = false
    local function resetAerial()
        state.aerialSample, state.aerialFloor, state.aerialContact = nil, nil, nil
    end
    local function floorHit(origin, params)
        local hit = ws:Raycast(origin, Vector3.new(0, -512, 0), params)
        if hit and hit.Normal.Y >= 0.65 then return hit.Position.Y end
    end
    local function localFloor(now)
        local root, humanoid = state.root, state.humanoid
        local cached = state.aerialFloor
        if cached and now - cached.at < 0.15 and (root.Position - cached.position).Magnitude < 8 then
            return cached.y
        end
        local origin = root.Position + Vector3.new(0, 4, 0)
        local solid, visible = floorHit(origin, aerialCollision), floorHit(origin, aerialQuery)
        local y = solid and visible and math.max(solid, visible) or solid or visible
        -- A grounded rig also bounds the pitch height. This rejects a ray that
        -- passes through a thin pitch and hits a lower map/baseplate surface.
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            local feet
            for _, name in ipairs({"LeftFoot", "RightFoot", "Left Leg", "Right Leg"}) do
                local foot = state.char:FindFirstChild(name)
                if foot and foot:IsA("BasePart") then
                    local bottom = foot.Position.Y - foot.Size.Y * 0.5
                    feet = feet and math.min(feet, bottom) or bottom
                end
            end
            local support = feet or root.Position.Y - root.Size.Y * 0.5 - (humanoid.HipHeight or 2)
            y = y and math.max(y, support) or support
        end
        if cached and cached.y and humanoid.FloorMaterial == Enum.Material.Air
            and (root.Position - cached.position).Magnitude < 16 then
            y = y and math.max(y, cached.y) or cached.y
        end
        state.aerialFloor = {at = now, position = root.Position, y = y}
        return y
    end
    local function aerialGround(ball, position, now)
        refreshGroundFilter(ball, now)
        aerialCollision.FilterDescendantsInstances = groundParams.FilterDescendantsInstances
        aerialQuery.FilterDescendantsInstances = groundParams.FilterDescendantsInstances
        local radius = math.max(ball.Size.Y * 0.5, 0.1)
        local origin = position + Vector3.new(0, radius + 4, 0)
        local solid, visible = floorHit(origin, aerialCollision), floorHit(origin, aerialQuery)
        local ground = solid and visible and math.max(solid, visible) or solid or visible
        -- A second point on each side protects against a seam or hole below
        -- the ball. The highest supported floor is the conservative bound.
        for _, sign in ipairs({-1, 1}) do
            local side = floorHit(origin + Vector3.new(sign * radius * 0.8, 0, 0), aerialQuery)
            if side then ground = ground and math.max(ground, side) or side end
        end
        local support = localFloor(now)
        local offset = position - state.root.Position
        if support and offset.X * offset.X + offset.Z * offset.Z <= (state.range + 24) ^ 2 then
            ground = ground and math.max(ground, support) or support
        end
        return ground, ground and position.Y - radius - ground or nil
    end
    local function sampleAerial(ball, now)
        local previous = state.aerialSample
        if previous then previous.previous = nil end -- retain two snapshots, never the whole match
        local position, physics = ball.Position, ball.AssemblyLinearVelocity
        local floor, clearance = aerialGround(ball, position, now)
        local sample = {ball = ball, at = now, position = position, physics = physics,
            ground = floor, clearance = clearance, radius = math.max(ball.Size.Y * 0.5, 0.1),
            fresh = false, continuous = false, velocity = physics, previous = previous}
        if previous and previous.ball == ball then
            local dt = now - previous.motionAt
            local delta = position - previous.motionPosition
            local speed = math.max(physics.Magnitude, previous.velocity.Magnitude)
            if dt > 0 and dt <= 0.2 and delta.Magnitude <= math.max(8, speed * dt * 2) then
                sample.continuous = true
                if dt >= 1 / 500 and delta.Magnitude > 0.01 then
                    sample.fresh = true
                    sample.velocity, sample.motionAt, sample.motionPosition = delta / dt, now, position
                    sample.dy = delta.Y
                else
                    sample.velocity = previous.velocity
                    sample.motionAt, sample.motionPosition = previous.motionAt, previous.motionPosition
                end
            end
        end
        if not sample.continuous then
            sample.motionAt, sample.motionPosition = now, position
            if previous then
                local dt = now - previous.motionAt
                local delta = position - previous.motionPosition
                if dt >= 1 / 500 and dt <= 0.2 and delta.Magnitude <= 128 then
                    -- A position-driven fast ball needs another coherent update.
                    -- This provisional speed does not count as flight evidence.
                    sample.velocity = delta / dt
                end
            end
        end
        state.aerialSample = sample
        return sample
    end
    local AERIAL_MIN_HEIGHT = 3 -- Internal ground-shot safety bound, in studs.
    -- Cobalt captures: high basicShot Y=0.697, low basicShot Y=-0.141.
    -- The enemy's FireServer call is private to their client, so classify the
    -- replicated ball's first coherent motion using the same normalized Y axis.
    local GROUND_KICK_MAX_ELEVATION = 0.10
    local HIGH_LAUNCH_MIN_ELEVATION = 0.18
    local LAUNCH_SIGNATURE_WINDOW = 0.30
    local function aerialMinimum()
        return AERIAL_MIN_HEIGHT
    end
    local function classifyFlight(release, sample)
        local flight = release.flight
        if not flight then
            flight = {phase = "observing", updates = 0, groundUpdates = 0}
            release.flight = flight
        end
        if flight.phase == "ended" then return false end
        if sample.clearance == nil then
            flight.phase = "observing"; flight.updates = 0
            flight.minY, flight.maxY, flight.firstAt = nil, nil, nil
            state.reason = "ground unknown; aerial action blocked"
            return false
        end
        if not sample.continuous then
            flight.phase = "observing"; flight.updates = 1
            flight.minY, flight.maxY, flight.firstAt = sample.position.Y, sample.position.Y, sample.at
            flight.groundUpdates = 0
            state.reason = "collecting independent position samples"
            return false
        end
        if sample.fresh then
            flight.firstAt = flight.firstAt or sample.at
            flight.minY = math.min(flight.minY or sample.position.Y, sample.position.Y)
            flight.maxY = math.max(flight.maxY or sample.position.Y, sample.position.Y)
            flight.updates = flight.updates + 1
            if sample.clearance <= 0.75 then flight.groundUpdates = flight.groundUpdates + 1
            else flight.groundUpdates = 0 end
            if release.superThrow and not flight.groundKick and sample.clearance >= aerialMinimum()
                and sample.velocity.Magnitude >= 6 and flight.phase ~= "airborne" then
                -- Hand-height flat throws are airborne even without an upward arc.
                -- Still require free possession and coherent replicated movement.
                flight.launchMeasured, flight.phase = true, "airborne"
            end
            if not release.header and not flight.launchMeasured
                and sample.at - release.started <= LAUNCH_SIGNATURE_WINDOW then
                local observedSpeed = sample.velocity.Magnitude
                local physicsSpeed = sample.physics.Magnitude
                if observedSpeed >= 6 then
                    flight.launchObservedY = sample.velocity.Y / observedSpeed
                    flight.launchPhysicsY = physicsSpeed >= 6 and sample.physics.Y / physicsSpeed or nil
                    -- Require both available signals to agree before permanently
                    -- tagging this release as ground. A later bounce cannot re-arm it.
                    if flight.launchObservedY <= GROUND_KICK_MAX_ELEVATION
                        and (flight.launchPhysicsY == nil
                            or flight.launchPhysicsY <= GROUND_KICK_MAX_ELEVATION) then
                        flight.groundKick = true
                    elseif flight.launchObservedY >= HIGH_LAUNCH_MIN_ELEVATION
                        and (flight.launchPhysicsY == nil
                            or flight.launchPhysicsY >= HIGH_LAUNCH_MIN_ELEVATION) then
                        local observedRise = math.max(sample.velocity.Y, 0)
                        local physicsRise = physicsSpeed >= 6 and math.max(sample.physics.Y, 0) or observedRise
                        local agreedRise = math.min(observedRise, physicsRise)
                        flight.projectedApex = sample.clearance
                            + agreedRise * agreedRise / (2 * math.max(ws.Gravity, 1))
                        if flight.projectedApex >= aerialMinimum() then
                            flight.launchConfirmed = true
                            flight.phase = "launched"
                        end
                    end
                    flight.launchMeasured = true
                end
            end
        end
        if flight.groundKick then
            state.reason = "ground kick launch signature; blocked"
            return false
        end
        if (flight.phase == "airborne" and sample.clearance < 1.25)
            or (flight.groundUpdates >= 3 and sample.at - release.started >= 0.05) then
            flight.phase = "ended"
            invalidate("ground contact ended this flight")
            return false
        end
        if sample.at - sample.motionAt > 0.12 then
            state.reason = "stale ball position; blocked"
            return false
        end
        if release.superThrow and flight.phase == "airborne" and sample.clearance >= aerialMinimum() then
            return true
        end
        if flight.launchConfirmed then
            if sample.clearance >= aerialMinimum() and flight.phase ~= "airborne" then
                flight.phase = "airborne"
            elseif flight.phase ~= "airborne" then
                state.reason = "high launch confirmed; predicting catch"
            end
            return true
        end
        if sample.clearance < aerialMinimum() then
            state.reason = "below real aerial height; blocked"
            return false
        end
        -- Power/AssemblyLinearVelocity never grants permission. Movement in
        -- WORLD Y must be observed; a changed ground ray is not vertical travel.
        local travel = (flight.maxY or 0) - (flight.minY or 0)
        if flight.updates < 3 or sample.at - (flight.firstAt or sample.at) < 0.025 or travel < 1.25 then
            state.reason = "awaiting real vertical travel"
            return false
        end
        if flight.phase ~= "airborne" and math.abs(sample.velocity.Y) < 3 then
            state.reason = "flat trajectory; aerial action blocked"
            return false
        end
        if flight.phase ~= "airborne" then
            flight.phase = "airborne"
        end
        return true
    end
    local function aerialLiveGate(sample, predictive)
        if not sample or sample.clearance == nil or sample.at - sample.motionAt > 0.12 then return false end
        local release = state.release
        local flight = release and release.flight
        if not flight or flight.groundKick then return false end
        if flight.phase == "airborne" and sample.clearance >= aerialMinimum() then return true end
        return predictive == true and flight.launchConfirmed == true
            and flight.projectedApex and flight.projectedApex >= aerialMinimum()
    end
    local wantsJump, verticalBounds

    local function skillCatchWindow(sample, profile, first, last)
        -- Solve height boundaries exactly instead of stepping over short windows.
        -- Horizontal range stays user-configurable; vertical reach is derived
        -- automatically from the rig/profile and never assumes server acceptance.
        local root = state.root
        local airborne = state.humanoid.FloorMaterial == Enum.Material.Air
        local y = sample.position.Y - root.Position.Y
        local vy = sample.velocity.Y - (airborne and root.AssemblyLinearVelocity.Y or 0)
        local ay = airborne and 0 or -0.5 * ws.Gravity
        local upReach, downReach = verticalBounds(profile, sample)
        local candidates = {first, last}
        local function add(t)
            if t >= first and t <= last then candidates[#candidates + 1] = t end
        end
        local function boundary(a, b, c)
            if math.abs(a) < 0.000001 then
                if math.abs(b) > 0.000001 then add(-c / b) end
                return
            end
            local d = b * b - 4 * a * c
            if d < 0 then return end
            local square = math.sqrt(d)
            add((-b - square) / (2 * a)); add((-b + square) / (2 * a))
        end
        boundary(ay, vy, y - upReach)
        boundary(ay, vy, y + downReach)
        boundary(-0.5 * ws.Gravity, sample.velocity.Y,
            sample.clearance - aerialMinimum())
        table.sort(candidates)
        local function eligible(t)
            local gap = y + vy * t + ay * t * t
            local clearance = sample.clearance + sample.velocity.Y * t - 0.5 * ws.Gravity * t * t
            return gap <= upReach + 0.000001
                and gap >= -downReach - 0.000001
                and clearance >= aerialMinimum() - 0.000001
        end
        for index, t in ipairs(candidates) do
            if eligible(t) then return t end
            local nextTime = candidates[index + 1]
            if nextTime and nextTime > t and eligible((t + nextTime) * 0.5) then
                return t + math.min(0.00001, (nextTime - t) * 0.5)
            end
        end
    end
    local function catchWindow(sample, profile, horizon, preparingJump)
        if not aerialLiveGate(sample, preparingJump or horizon > 0) then return nil end
        local root, humanoid = state.root, state.humanoid
        local relative = sample.position - root.Position
        local velocity = sample.velocity - root.AssemblyLinearVelocity
        local a = velocity.X * velocity.X + velocity.Z * velocity.Z
        local b = 2 * (relative.X * velocity.X + relative.Z * velocity.Z)
        local c = relative.X * relative.X + relative.Z * relative.Z - state.range * state.range
        local first, last = 0, horizon
        if a <= 0.01 then if c > 0 then return nil end
        else
            local discriminant = b * b - 4 * a * c
            if discriminant < 0 then return nil end
            local square = math.sqrt(discriminant)
            first, last = math.max(0, (-b - square) / (2 * a)), math.min(horizon, (-b + square) / (2 * a))
            if first > last then return nil end
        end
        local airborne = humanoid.FloorMaterial == Enum.Material.Air
        if profile.aerialReach and not preparingJump and not wantsJump(profile) then
            return skillCatchWindow(sample, profile, first, last)
        end
        local jumpSpeed = 0
        if preparingJump and not airborne and wantsJump(profile) then
            if humanoid.UseJumpPower == false then
                jumpSpeed = math.sqrt(2 * math.max(ws.Gravity, 1) * math.max(humanoid.JumpHeight or 0, 0))
            else jumpSpeed = math.max(humanoid.JumpPower or 50, 0) end
        end
        local ceiling, downReach = verticalBounds(profile, sample)
        local bottom = -downReach
        for index = 0, 12 do
            local t = first + (last - first) * index / 12
            local ballY = sample.position.Y + sample.velocity.Y * t - 0.5 * ws.Gravity * t * t
            local playerY = root.Position.Y
            if airborne then playerY = playerY + root.AssemblyLinearVelocity.Y * t - 0.5 * ws.Gravity * t * t
            elseif jumpSpeed > 0 then playerY = playerY + math.max(0, jumpSpeed * t - 0.5 * ws.Gravity * t * t) end
            local gap = ballY - playerY
            if gap >= bottom and gap <= ceiling and ballY - sample.radius - sample.ground >= aerialMinimum() then return t end
        end
    end
    local function profileAirEligible(profile, sample)
        return profile.allowGround == true or aerialLiveGate(sample)
    end

    -- Mandatory jump stays mandatory (Nagi/Shidou). "Use Jump" is only an
    -- optional preference and individual profiles can opt out (Kiyora).
    wantsJump = function(profile)
        return profile.jump == true or (state.useJump and profile.optionalJump ~= false)
    end

    -- Automatic vertical reach. No user slider is needed.
    -- Default reach follows the local rig/head + ball radius. Profiles may
    -- override this internally when a skill has a proven special hitbox.
    verticalBounds = function(profile, sample)
        local root = state.root
        local head = state.char and state.char:FindFirstChild("Head")
        local headOffset = head and root and math.max(0, head.Position.Y - root.Position.Y) or 2
        local radius = sample and sample.radius or (sample and sample.ball and math.max(sample.ball.Size.Y * 0.5, 0.1)) or 0.5
        local up = tonumber(profile.verticalReach) or (headOffset + radius + 2)
        local down = tonumber(profile.verticalDown) or math.min(2.5, up)

        if profile.allowGround then
            up = tonumber(profile.maxHeight) or up
            -- Ground-capable skills must still be allowed to interact at feet level.
            down = math.max(down, headOffset + radius + 1)
        end

        return math.max(up, 0.5), math.max(down, 0.5)
    end

    local function inside(relative, profile, sample)
        local horizontalSq = relative.X * relative.X + relative.Z * relative.Z
        if horizontalSq > state.range * state.range then return false end

        local up, down = verticalBounds(profile, sample)
        return relative.Y <= up and relative.Y >= -down
    end

    local function interception(sample, profile)
        local relative = sample.position - state.root.Position
        if inside(relative, profile, sample) then return true end
        if not state.trajectoryPredict then return false end
        local velocity = sample.velocity - state.root.AssemblyLinearVelocity
        local horizontalSquared = velocity.X * velocity.X + velocity.Z * velocity.Z
        if horizontalSquared <= 0.01 then return false end
        local horizon = math.min(state.trajectoryLookahead, profile.lead + math.min(state.ping, 0.08))
        local t = math.clamp(-(relative.X * velocity.X + relative.Z * velocity.Z) / horizontalSquared, 0, horizon)
        if t <= 0 then return false end
        local future = relative + velocity * t
        if not profile.allowGround then
            future = future + Vector3.new(0, -0.5 * ws.Gravity * t * t, 0)
            if sample.clearance + sample.velocity.Y * t - 0.5 * ws.Gravity * t * t <= 0.35 then return false end
        end
        return inside(future, profile, sample)
    end
    local function aerialSkillHorizon(profile)
        if not state.trajectoryPredict then return 0 end
        return math.min(state.trajectoryLookahead, profile.lead + math.min(state.ping, 0.08))
    end
    local function profileInterception(sample, profile)
        if profile.name == "Hiori" then
            if not state.root or not state.root.Parent then return false end
            -- Use current position at preparation and at send, never a predicted descent.
            local position = sample.ball and sample.ball.Parent and sample.ball.Position or sample.position
            if position.Y - state.root.Position.Y > (profile.maxHeight or 6) then
                state.reason = "Hiori: ball above height limit"
                return false
            end
        end
        if profile.allowGround then return interception(sample, profile) end
        return catchWindow(sample, profile, aerialSkillHorizon(profile), false) ~= nil
    end

    stopLock = function()
        local active = state.active
        if not active then return end
        state.active = nil
        rs:UnbindFromRenderStep(renderName)
        if active.stopConnection then active.stopConnection:Disconnect() end
        if active.humanoid and active.humanoid.Parent then active.humanoid.AutoRotate = active.autoRotate end
        local camera = active.camera
        if active.ownsCamera and camera == ws.CurrentCamera and camera.CameraType == Enum.CameraType.Scriptable
            and camera.CameraSubject == active.cameraSubject then
            local delta = state.root and state.root.Parent and state.root.Position - active.startRoot or Vector3.zero
            camera.CFrame, camera.Focus = active.cameraCFrame + delta, active.cameraFocus + delta
            camera.CameraType = active.cameraType
        end
    end
    local function faceBall(active, dt)
        local root, ball = state.root, active.ball
        if not root or not ball.Parent then return end
        local position, target = root.Position, ball.Position
        if active.kind == "helper" then
            local offset = target - Vector3.new(0, 3, 0) - position
            if offset.Magnitude > 0.5 then
                position = position + offset.Unit * math.min(offset.Magnitude - 0.5, state.helperSpeed * math.clamp(dt, 0, 0.04))
            end
        elseif state.mode == "Blatant" and active.confirmed then
            local offset = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
            if offset.Magnitude > 0.65 then position = position + offset.Unit * math.min(offset.Magnitude - 0.65, 92 * math.clamp(dt, 0, 0.04)) end
        end
        local flat = Vector3.new(target.X, position.Y, target.Z)
        if (flat - position).Magnitude > 0.001 then
            state.humanoid.AutoRotate = false
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.lookAt(position, flat, Vector3.yAxis)
        end
        local camera = active.camera
        if active.ownsCamera then
            if camera ~= ws.CurrentCamera or camera.CameraType ~= Enum.CameraType.Scriptable
                or camera.CameraSubject ~= active.cameraSubject then stopLock(); return end
            local cameraPosition = position + active.cameraOffset
            if (target - cameraPosition).Magnitude < 1.5 then cameraPosition = cameraPosition - active.cameraCFrame.LookVector * 2 end
            local direction = target - cameraPosition
            if direction.Magnitude > 0.001 then
                local up = math.abs(direction.Unit.Y) > 0.985 and Vector3.new(0, 0, -1) or Vector3.yAxis
                camera.CFrame, camera.Focus = CFrame.lookAt(cameraPosition, target, up), CFrame.new(target)
            end
        end
    end
    local function startLock(ball, kind, profile, release, now)
        stopLock()
        local active = {ball = ball, kind = kind, profile = profile, release = release,
            started = now, deadline = now + 0.4, humanoid = state.humanoid,
            autoRotate = state.humanoid.AutoRotate, confirmed = false}
        local camera = ws.CurrentCamera
        if camera and camera.CameraType ~= Enum.CameraType.Scriptable then
            active.camera, active.cameraType, active.cameraSubject = camera, camera.CameraType, camera.CameraSubject
            active.cameraCFrame, active.cameraFocus = camera.CFrame, camera.Focus
            active.startRoot, active.cameraOffset = state.root.Position, camera.CFrame.Position - state.root.Position
            active.ownsCamera = true
            camera.CameraType = Enum.CameraType.Scriptable
        end
        state.active = active
        faceBall(active, 0)
        rs:BindToRenderStep(renderName, Enum.RenderPriority.Last.Value + 1, function()
            if state.active ~= active then return end
            if not state.root or not state.root.Parent or not state.humanoid or state.humanoid.Health <= 0
                or not active.ball.Parent or localHeld() or os.clock() > active.deadline then stopLock(); return end
            faceBall(active, 0)
        end)
        return active
    end
    local function confirm(active, track)
        if state.active ~= active then return end
        active.confirmed = true
        if active.release then active.release.confirmed = true end
        local duration = track.Length > 0 and track.Length / math.max(math.abs(track.Speed), 0.1) or 0.5
        active.deadline = math.min(active.started + 1.25, os.clock() + math.clamp(duration + 0.08, 0.2, 1.25))
        if active.stopConnection then active.stopConnection:Disconnect() end
        active.stopConnection = track.Stopped:Connect(function() if state.active == active then stopLock() end end)
    end
    local function payloadFor(profile, ball, root)
        if profile.args then return profile.args(ball, root) end
        if profile.name == "Nagi" then return {"skill2", true} end
        if profile.name == "Shidou" then return {"skill1", "Front", true} end
        if profile.name == "Hiori" then
            local delta = ball.Position - root.Position
            return {"skill2", delta.Magnitude > 0.001 and delta.Unit or root.CFrame.LookVector}
        end
        if profile.name == "DonLorenzo" then return {"skill4"} end
        if profile.name == "Kiyora" then return {"skill3", "Right"} end
    end
    local function sendTrap(active, sample, now)
        local release, profile = active.release, active.profile
        if active.sentAt or state.active ~= active then return end
        if not state.enabled or not releaseValid(release, now) or release.ball ~= sample.ball
            or resolveProfile(now, true) ~= profile or onCooldown(profile)
            or not profileAirEligible(profile, sample) or not profileInterception(sample, profile) then
            state.reason = "send rejected by live validation"; stopLock(); return
        end
        if wantsJump(profile) then
            if state.humanoid.FloorMaterial ~= Enum.Material.Air and not active.jumpAt then
                active.jumpAt = now
                state.humanoid.Jump = true
                state.humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            if profile.jump and state.humanoid.FloorMaterial ~= Enum.Material.Air then
                if now - (active.jumpAt or now) > 0.25 then stopLock() end
                return
            end
        end
        faceBall(active, 0)
        if state.active ~= active then return end
        local ok, payload = pcall(payloadFor, profile, sample.ball, state.root)
        if not ok or not payload then state.reason = "invalid skill payload"; stopLock(); return end
        -- Commit once; FireServer success means queued locally, not accepted by server.
        active.sentAt, active.deadline = now, now + math.clamp(0.25 + state.ping * 2, 0.25, 0.6)
        release.attempts, release.lastSend = release.attempts + 1, now
        release.sentDistance = (sample.position - state.root.Position).Magnitude
        local sent = pcall(function() remote:FireServer(packet, {payload}) end)
        if not sent then state.reason = "remote send failed"; stopLock(); return end
        state.sends = state.sends + 1
        state.reason = "skill sent; awaiting confirmation"
    end
    localAnimation = function(track)
        local id = track.Animation and track.Animation.AnimationId:match("%d+")
        if not id then return end

        -- Never react to our own goalkeeper Super Throw as an incoming trap.
        if id == SUPER_THROW then
            state.botThrows[state.char] = nil
            invalidate("local Super Throw ignored by Auto Trap")
            stopLock()
            return
        end

        local active = state.active
        if active and active.kind == "auto" and active.sentAt and animationProfiles[id] == active.profile then confirm(active, track); return end
        if not state.helper or active or not helperAnimations[id] or not state.root or localHeld() then return end
        local ball = ws.Terrain:FindFirstChild("Ball")
        if not ball or not ball:IsA("BasePart") or (ball.Position - state.root.Position).Magnitude > state.helperRange then return end
        active = startLock(ball, "helper", animationProfiles[id], nil, os.clock())
        confirm(active, track)
    end
    local function observeAttack(char, track)
        local id = track.Animation and track.Animation.AnimationId:match("%d+")
        if not state.enabled or not id or track.Looped then return end
        if id == SUPER_THROW and char ~= state.char then
            local sourcePlayer = ps:GetPlayerFromCharacter(char)

            -- A real Player using Super Throw is accepted only if they are an enemy.
            -- This prevents our own GK from passing to us and accidentally firing Auto Trap.
            if sourcePlayer and not enemy(char) then
                state.botThrows[char] = nil
                state.reason = "friendly GK Super Throw ignored"
                return
            end

            local now = os.clock()
            local length = tonumber(track.Length) or 0
            local window = math.clamp(length > 0 and (length + 0.75) or 4, 3, 7)
            state.botThrows[char] = now + window
            if state.owner ~= char then acquire(char) end
        end
        if not enemy(char) and not superThrowArmed(char, os.clock()) then return end
        if state.owner ~= char and not char:FindFirstChild("Ball") then return end
        if ignoredAnimations[id] or helperAnimations[id] then return end
        if track.Priority.Value < Enum.AnimationPriority.Action.Value and id ~= SUPER_THROW and id ~= "76587445975710" then return end
        state.attacks[char] = {id = id, track = track, at = os.clock()}
        -- Warm the profile cache at attack start. Never send from animation alone.
        if state.root then resolveProfile(os.clock(), true) end
    end
    local function segmentDistance(point, a, b)
        local delta = b - a
        local length = delta:Dot(delta)
        local t = length > 0.001 and math.clamp((point - a):Dot(delta) / length, 0, 1) or 0
        local contact = a + delta * t
        return (point - contact).Magnitude, contact
    end
    local function headerRelease(char, sample, now)
        local player = enemy(char)
        if not player then return false end
        state.epoch = state.epoch + 1
        state.releasedEpoch, state.owner = state.epoch, char
        invalidate("enemy header redirected a free ball")
        state.release = {source = char, player = player, team = player.Team,
            header = true, epoch = state.epoch,
            started = now, expires = now + 6, attempts = 0, lastSend = -math.huge,
            confirmed = false, ball = sample.ball}
        state.headerCooldown = now + 0.25
        state.aerialContact = nil
        return true
    end
    local function observeAerialHeader(sample, now)
        local previous = sample.previous
        if not previous or previous.ball ~= sample.ball or not sample.continuous
            or not sample.fresh or now <= state.headerCooldown
            or (state.active and state.active.sentAt) then return false end
        if holderValue and characterOf(holderValue.Value) then return false end
        local contact = state.aerialContact
        if contact and now - contact.at > 0.16 then state.aerialContact = nil; contact = nil end
        if not contact then
            local best = math.huge
            for char, record in pairs(state.characters) do
                local humanoid = record.humanoid or char:FindFirstChildOfClass("Humanoid")
                local head, root = char:FindFirstChild("Head"), char:FindFirstChild("HumanoidRootPart")
                if enemy(char) and humanoid and humanoid.Health > 0
                    and humanoid.FloorMaterial == Enum.Material.Air and head and root
                    and head:IsA("BasePart") and not char:FindFirstChild("Ball") then
                    local radius = sample.radius + math.max(head.Size.Y * 0.5, 0.5) + 0.75
                    local distance, point = segmentDistance(head.Position, previous.position, sample.position)
                    if distance <= radius and point.Y > root.Position.Y + 0.5 and distance < best then
                        best = distance
                        contact = {char = char, at = now, incoming = previous.velocity,
                            physics = previous.physics, measured = previous.fresh == true}
                    end
                end
            end
            state.aerialContact = contact
        end
        if not contact then return false end
        local elapsed = math.max(now - contact.at, now - previous.at)
        local correction = Vector3.new(0, ws.Gravity * elapsed, 0)
        local observed = (sample.velocity - contact.incoming + correction).Magnitude
        local physical = (sample.physics - contact.physics + correction).Magnitude
        local threshold = math.max(24, contact.incoming.Magnitude * 0.25)
        if (not contact.measured or observed < threshold) and physical < threshold then return false end
        return headerRelease(contact.char, sample, now)
    end
    local function sendAerial(active, sample, now)
        local release, profile = active.release, active.profile
        if active.sentAt or state.active ~= active then return end
        -- Measure AGAIN at commit. No stored flight certificate can override
        -- a ball now touching the ground, an ownership change or a stale sample.
        local position = sample.ball.Position
        local floor, clearance = aerialGround(sample.ball, position, now)
        local live = {position = position, ground = floor, clearance = clearance,
            radius = sample.radius, velocity = sample.velocity, motionAt = sample.motionAt, at = now}
        local skillHorizon = aerialSkillHorizon(profile)
        if not state.enabled or not releaseValid(release, now) or release.ball ~= sample.ball
            or resolveProfile(now, true) ~= profile or onCooldown(profile)
            or not clearance or not aerialLiveGate(sample, skillHorizon > 0)
            or catchWindow(live, profile, skillHorizon, false) == nil then
            state.reason = "aerial commit rejected by live height/reach checks"
            stopLock(); return
        end
        if profile.jump and state.humanoid.FloorMaterial ~= Enum.Material.Air then
            stopLock(); return
        end
        local ok, payload = pcall(payloadFor, profile, sample.ball, state.root)
        if not ok or not payload then state.reason = "invalid skill payload"; stopLock(); return end
        faceBall(active, 0)
        if state.active ~= active then return end
        active.sentAt, active.deadline = now, now + math.clamp(0.25 + state.ping * 2, 0.25, 0.6)
        release.attempts, release.lastSend = 1, now
        local sent = pcall(function() remote:FireServer(packet, {payload}) end)
        if not sent then
            state.reason = "remote send failed"; stopLock(); return
        end
        state.sends = state.sends + 1
        state.reason = "aerial skill sent once; awaiting confirmation"
    end
    aerialTick = function(profile, now, dt)
        if localHeld() then invalidate("local possession"); resetAerial(); stopLock(); return end
        if state.owner and state.owner:FindFirstChild("Ball") then
            if state.active and state.active.kind == "auto" then stopLock() end
            resetAerial(); predictAttack(now)
            return
        end
        if state.owner then arm(state.owner) end
        local ball = ws.Terrain:FindFirstChild("Ball")
        if not ball or not ball:IsA("BasePart") then resetAerial(); stopLock(); state.reason = "no free ball"; return end
        if state.ball ~= ball then
            if state.release and state.release.ball then invalidate("free ball replaced") end
            state.ball, state.filterAt = ball, -math.huge
            resetAerial()
        end
        local sample = sampleAerial(ball, now)
        state.sample = sample
        local active = state.active
        if active and active.kind == "helper" then
            if active.ball ~= ball or now > active.deadline or (ball.Position - state.root.Position).Magnitude > state.helperRange then stopLock(); return end
            faceBall(active, dt); return
        end
        observeAerialHeader(sample, now)
        active = state.active
        -- A local header may release a held ball without an incoming free-ball
        -- sample. Only acquire it after outgoing head-height travel is observed.
        if not state.release and state.owner == state.char and sample.previous and sample.fresh
            and state.humanoid.FloorMaterial == Enum.Material.Air and sample.velocity.Y > 8 then
            local head = state.char:FindFirstChild("Head")
            if head and sample.previous.position.Y > state.root.Position.Y + 0.5
                and (sample.previous.position - head.Position).Magnitude <= sample.radius + head.Size.Y * 0.5 + 0.75 then
                headerRelease(state.char, sample, now)
            end
        end
        local release = state.release
        if not releaseValid(release, now) then
            local holder = holderValue and characterOf(holderValue.Value)
            local possessionGrace = release and release.superThrow and 1.25 or 0.25
            if release and release.epoch == state.epoch and holder == release.source
                and not release.source:FindFirstChild("Ball") and now - release.started <= possessionGrace then
                -- Child removal and ballHolder replication can arrive separately.
                -- Super Throw gets a longer replication grace because the keeper
                -- animation can lead the holder clear by noticeably more than one frame.
                classifyFlight(release, sample)
                stopLock(); state.reason = "waiting for replicated possession to clear"; return
            end
            invalidate("no valid enemy release or local header"); return
        end
        release.ball = release.ball or ball
        if release.ball ~= ball then invalidate("release ball changed"); return end
        if not classifyFlight(release, sample) then stopLock(); return end
        if sample.velocity.Magnitude < state.minSpeed then state.reason = "below minimum speed"; stopLock(); return end
        if active then
            if active.release ~= release or active.profile ~= profile or active.ball ~= ball
                or now > active.deadline then stopLock(); return end
            if not active.sentAt then sendAerial(active, sample, now)
            elseif not active.confirmed and onCooldown(profile) then
                active.confirmed, release.confirmed = true, true
                active.deadline = math.min(active.started + 1.25, now + 0.3)
            end
            if state.active == active then faceBall(active, dt) end
            return
        end
        if release.attempts > 0 or release.confirmed or onCooldown(profile) then return end
        local humanoid = state.humanoid
        if humanoid.Sit or humanoid.PlatformStand then state.reason = "character cannot act"; return end
        local needsJump = wantsJump(profile)
        if needsJump and humanoid.FloorMaterial ~= Enum.Material.Air then
            if humanoid.GetStateEnabled and not humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping) then return end
            local horizon = state.trajectoryPredict and state.trajectoryLookahead or 0
            local entry = catchWindow(sample, profile, horizon, true)
            if entry == nil then state.reason = "no reachable aerial window"; return end
            if not release.jumpAt then
                release.jumpAt = now
                humanoid.Jump = true
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            state.reason = "jumping; camera waits for capture window"
            return
        end
        if catchWindow(sample, profile, aerialSkillHorizon(profile), false) == nil then
            state.reason = "outside aerial timing window"; return
        end
        active = startLock(ball, "auto", profile, release, now)
        sendAerial(active, sample, now)
    end

    predictAttack = function(now)
        state.predictionAt = nil
        if not state.trajectoryPredict or not state.owner then return end
        local attack = state.attacks[state.owner]
        local model = attack and timings[attack.id]
        if not model or model.count < 3 or model.spread > 0.06 or not attack.track.IsPlaying or attack.track.Speed <= 0 then return end
        local remaining = (model.mean - attack.track.TimePosition) / attack.track.Speed
        if remaining >= 0 and remaining <= math.min(state.trajectoryLookahead, 0.15 + state.ping) then
            state.predictionAt = now + remaining
            resolveProfile(now, true)
            state.reason = "animation predicts release; awaiting ball evidence"
        end
    end
    tick = function(dt)
        if not state.running or not state.root or not state.root.Parent or not state.humanoid or state.humanoid.Health <= 0 then stopLock(); return end
        local now = os.clock()
        if now - state.pingAt >= 1 then
            state.pingAt = now
            local ok, value = pcall(function() return lp:GetNetworkPing() end)
            if ok and type(value) == "number" then state.ping = math.clamp(value, 0, 0.2) end
        end
        local selected = state.enabled and resolveProfile(now, false)
        if selected and not selected.allowGround then aerialTick(selected, now, dt); return end
        if state.aerialSample then resetAerial(); state.sample = nil end
        if localHeld() then invalidate("local possession"); stopLock(); return end
        if state.owner and state.owner:FindFirstChild("Ball") then
            if state.active and state.active.kind == "auto" then stopLock() end
            predictAttack(now)
            return
        end
        if state.owner then arm(state.owner) end
        local ball = ws.Terrain:FindFirstChild("Ball")
        if not ball or not ball:IsA("BasePart") then
            state.sample = nil; state.reason = "no free ball"; stopLock(); return
        end
        if state.ball ~= ball then
            if state.release and state.release.ball then invalidate("free ball replaced") end
            state.ball, state.sample, state.filterAt = ball, nil, -math.huge
        end
        local sample = sampleBall(ball, now)
        local active = state.active
        if active and active.kind == "helper" then
            if active.ball ~= ball or now > active.deadline or (ball.Position - state.root.Position).Magnitude > state.helperRange then stopLock(); return end
            faceBall(active, dt); return
        end
        if not state.enabled then stopLock(); return end
        local profile = resolveProfile(now, false)
        local release = state.release
        if not releaseValid(release, now) then invalidate("no valid enemy release"); return end
        release.ball = release.ball or ball
        if release.ball ~= ball then invalidate("release ball changed"); return end
        -- Landing ends the release. A later contact bounce cannot re-arm the same shot.
        if sample.groundKnown and sample.samples >= 2 and sample.clearance <= 0.35 then
            if release.seenAir then invalidate("aerial release landed"); return end
            release.landedAt = release.landedAt or now
        else release.landedAt = nil end
        if not profile then state.reason = "unsupported style"; stopLock(); return end
        -- This branch now serves Hiori only; original classification is unchanged.
        if airEligible(sample, state.airHeight, ws.Gravity) then release.seenAir = true end
        if not profileAirEligible(profile, sample) then state.reason = sample.groundKnown and "ground ball rejected" or "ground unknown; blocked"; stopLock(); return end
        if sample.velocity.Magnitude < state.minSpeed and not (active and active.confirmed) then state.reason = "below minimum speed"; stopLock(); return end
        if active then
            if active.release ~= release or active.profile ~= profile or active.ball ~= ball or now > active.deadline then stopLock(); return end
            if not active.sentAt then sendTrap(active, sample, now)
            elseif not active.confirmed and onCooldown(profile) then
                active.confirmed, release.confirmed = true, true
                active.deadline = math.min(active.started + 1.25, now + 0.3)
            end
            if state.active == active then faceBall(active, dt) end
            return
        end
        if onCooldown(profile) or release.confirmed or release.attempts >= 2 then return end
        if release.attempts > 0 and (now - release.lastSend < 0.35 or release.sentDistance - (sample.position - state.root.Position).Magnitude < 2) then return end
        if not profileInterception(sample, profile) then state.reason = "outside interception window"; return end
        active = startLock(ball, "auto", profile, release, now)
        sendTrap(active, sample, now)
    end
    local function removeCharacter(char)
        local record = state.characters[char]
        if not record then return end
        disconnect(record.connections)
        state.characters[char], state.attacks[char], state.botThrows[char] = nil, nil, nil
        state.filterAt = -math.huge
        if state.owner == char then state.owner = nil; invalidate("source removed") end
    end
    local function watchCharacter(char)
        if not char or not char:IsA("Model") or state.characters[char] then return end
        local record = {connections = {}, animators = {}}
        state.characters[char] = record
        state.filterAt = -math.huge
        local function hookAnimator(animator)
            if not animator:IsA("Animator") or record.animators[animator] then return end
            record.animators[animator] = true
            record.connections[#record.connections + 1] = animator.AnimationPlayed:Connect(function(track)
                if char == state.char then localAnimation(track) else observeAttack(char, track) end
            end)
            -- A streamed/late-bound keeper may already be mid-throw.
            -- Do not replay local trap tracks or treat every old animation as an attack.
            if char ~= state.char then
                local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
                if ok then
                    for _, track in ipairs(tracks) do
                        local id = track.Animation and track.Animation.AnimationId:match("%d+")
                        if id == SUPER_THROW and track.IsPlaying and track.TimePosition <= 3 then
                            observeAttack(char, track)
                        end
                    end
                end
            end
        end
        local function hookHumanoid(humanoid)
            if not humanoid:IsA("Humanoid") or record.humanoid == humanoid then return end
            record.humanoid = humanoid
        end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then hookHumanoid(humanoid) end

        -- Player rigs usually place Animator under Humanoid, while some NPC/bot
        -- rigs can animate through AnimationController. Watch Animator directly
        -- so GK BOT and GK Player Super Throw use the same path.
        for _, object in ipairs(char:GetDescendants()) do
            if object:IsA("Animator") then hookAnimator(object)
            elseif object:IsA("Humanoid") then hookHumanoid(object) end
        end

        record.connections[#record.connections + 1] = char.DescendantAdded:Connect(function(object)
            if object:IsA("Animator") then hookAnimator(object)
            elseif object:IsA("Humanoid") then hookHumanoid(object) end
        end)

        record.connections[#record.connections + 1] = char.ChildAdded:Connect(function(child)
            if child.Name == "Ball" then acquire(char) end
        end)
        record.connections[#record.connections + 1] = char.ChildRemoved:Connect(function(child)
            if child.Name == "Ball" and state.owner == char then arm(char) end
        end)
        record.connections[#record.connections + 1] = char.AncestryChanged:Connect(function(_, parent) if not parent then removeCharacter(char) end end)
        if char:FindFirstChild("Ball") then acquire(char) end
    end
    local function bindLocal(char)
        state.generation = state.generation + 1
        local generation = state.generation
        stopLock()
        state.char, state.root, state.humanoid = char, nil, nil
        state.profileAt, state.slotAt = -math.huge, -math.huge
        state.owner, state.sample, state.ball = nil, nil, nil
        state.headerSample, state.headerCooldown = nil, 0
        resetAerial()
        invalidate("respawn")
        watchCharacter(char)
        task.spawn(function()
            local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
            local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
            if not state.running or state.generation ~= generation or char ~= lp.Character or not humanoid or not root then return end
            state.root, state.humanoid = root, humanoid
            if char:FindFirstChild("Ball") then acquire(char) end
        end)
    end
    local function removePlayer(player)
        local record = state.players[player]
        if not record then return end
        disconnect(record.connections)
        if record.char then removeCharacter(record.char) end
        state.players[player] = nil
    end
    local function watchPlayer(player)
        if state.players[player] then return end
        local record = {connections = {}}
        state.players[player] = record
        local function bind(char)
            if record.char and record.char ~= char then removeCharacter(record.char) end
            record.char = char
            if player == lp then bindLocal(char) else watchCharacter(char) end
        end
        record.connections[#record.connections + 1] = player.CharacterAdded:Connect(bind)
        record.connections[#record.connections + 1] = player.CharacterRemoving:Connect(function(char)
            removeCharacter(char)
            if player == lp then
                state.generation = state.generation + 1
                stopLock(); state.root, state.humanoid, state.char = nil, nil, nil
            end
        end)
        for _, property in ipairs({"Team", "Neutral"}) do
            record.connections[#record.connections + 1] = player:GetPropertyChangedSignal(property):Connect(function()
                if player == lp or state.owner == player.Character then invalidate("team changed") end
            end)
        end
        if player.Character then bind(player.Character) end
    end
    local function hasAnimationRig(model)
        if not model or not model:IsA("Model") then return false end
        if model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController") then
            return true
        end
        return model:FindFirstChildWhichIsA("Animator", true) ~= nil
    end

    syncRuntime = function()
        if state.destroyed then return end
        local run = state.enabled or state.helper
        if run == state.running then return end
        state.running = run
        if not run then
            state.generation = state.generation + 1
            stopLock(); disconnect(state.connections)
            for _, record in pairs(state.players) do disconnect(record.connections) end
            for _, record in pairs(state.characters) do disconnect(record.connections) end
            state.players, state.characters, state.attacks, state.botThrows = {}, {}, {}, {}
            state.owner, state.release, state.sample, state.ball = nil, nil, nil, nil
            state.headerSample, state.headerCooldown = nil, 0
        resetAerial()
            state.root, state.humanoid, state.char = nil, nil, nil
            state.reason = "disabled"
            return
        end
        for _, player in ipairs(ps:GetPlayers()) do watchPlayer(player) end
        state.connections[#state.connections + 1] = ps.PlayerAdded:Connect(watchPlayer)
        state.connections[#state.connections + 1] = ps.PlayerRemoving:Connect(removePlayer)
        if holderValue then
            local owner = characterOf(holderValue.Value)
            if owner then acquire(owner) end
            state.connections[#state.connections + 1] = holderValue.Changed:Connect(function()
                local current = characterOf(holderValue.Value)
                if current then acquire(current) elseif state.owner then arm(state.owner) end
            end)
        end
        local characters = ws:FindFirstChild("characters")
        if characters then
            for _, char in ipairs(characters:GetChildren()) do if hasAnimationRig(char) then watchCharacter(char) end end
            state.connections[#state.connections + 1] = characters.ChildAdded:Connect(watchCharacter)
        end
        for _, child in ipairs(ws:GetChildren()) do
            if hasAnimationRig(child) then watchCharacter(child) end
        end
        state.connections[#state.connections + 1] = ws.DescendantAdded:Connect(function(object)
            if object:IsA("Humanoid") or object:IsA("AnimationController") then
                local model = object:FindFirstAncestorOfClass("Model")
                if model then watchCharacter(model) end
            elseif object:IsA("Animator") then
                local model = object:FindFirstAncestorOfClass("Model")
                if model then watchCharacter(model) end
            end
        end)
        state.connections[#state.connections + 1] = lp.AttributeChanged:Connect(function() state.profileAt = -math.huge end)
        -- Exactly one sample/evaluation per physics frame, after simulation.
        state.connections[#state.connections + 1] = rs.Heartbeat:Connect(function(dt)
            tick(dt)
        end)
    end
    function runtime.registerProfile(name, definition)
        if type(name) ~= "string" or name == "" or type(definition) ~= "table"
            or type(definition.skill) ~= "string" or not definition.skill:match("^skill%d+$") or type(definition.args) ~= "function" then
            return false, "Expected name, skillN and args(ball, root)"
        end
        local words, animations, trapWords = {normalize(name)}, {}, {}
        for _, word in ipairs(definition.words or {}) do
            if type(word) ~= "string" then return false, "Profile words must be strings" end
            words[#words + 1] = normalize(word)
        end
        for _, word in ipairs(definition.trapWords or {}) do
            if type(word) ~= "string" or normalize(word) == "" then return false, "Invalid trap word" end
            trapWords[#trapWords + 1] = normalize(word)
        end
        for _, id in ipairs(definition.animations or {}) do
            local digits = tostring(id):match("%d+")
            if not digits then return false, "Invalid animation ID" end
            animations[#animations + 1] = digits
        end
        local previous = profiles[name]
        if previous then for _, id in ipairs(previous.animations) do if animationProfiles[id] == previous then animationProfiles[id] = nil end end end
        local profile = {
            name = name, skill = definition.skill, args = definition.args,
            words = words, animations = animations, trapWords = trapWords,
            jump = definition.jump == true,
            optionalJump = definition.optionalJump ~= false,
            allowGround = definition.allowGround == true,
            aerialReach = definition.aerialReach == true,
            verticalReach = tonumber(definition.verticalReach),
            verticalDown = tonumber(definition.verticalDown),
            maxHeight = tonumber(definition.maxHeight),
            lead = math.clamp(tonumber(definition.lead) or 0.18, 0.05, 0.8)
        }
        profiles[name] = profile
        for _, id in ipairs(animations) do animationProfiles[id], helperAnimations[id] = profile, true end
        stopLock(); state.profileAt = -math.huge
        return true
    end
    function runtime.destroy()
        if state.destroyed then return end
        state.enabled, state.helper = false, false
        syncRuntime()
        state.destroyed = true
        if env.CeleronTrapRuntime == runtime then env.CeleronTrapRuntime = nil end
    end
    at:Dropdown("Auto Trap Mode", {"Legit", "Blatant"}, function(value)
        if value == "Legit" or value == "Blatant" then stopLock(); state.mode = value end
    end)
    at:Slider("Max Ball Distance", 30, 5, 100, 1, function(value) state.range = math.clamp(value, 5, 100) end)
    at:Slider("Min Ball Speed", 0.1, 0, 100, 0.1, function(value) state.minSpeed = math.clamp(value, 0, 100) end)
    at:Toggle("Use Jump", function(value) state.useJump = value == true end)
    at:Toggle("Auto Trap", function(value)
        state.enabled = value == true
        invalidate("auto toggle changed")
        if state.owner and not state.owner:FindFirstChild("Ball") then state.owner = nil end
        syncRuntime()
    end)
    th:Toggle("Trap Helper", function(value)
        state.helper = value == true
        if not state.helper and state.active and state.active.kind == "helper" then stopLock() end
        syncRuntime()
    end)
    th:Slider("Trap Helper Max Distance", 50, 5, 200, 1, function(value) state.helperRange = value end)
    th:Slider("Trap Helper Speed", 50, 10, 1000, 1, function(value) state.helperSpeed = value end)
end

