                    end
                end

                if dash.scaleNaturalMotion then
                    local currentPos = hrp.Position
                    local rawDelta = Vector3.new(
                        currentPos.X - dash.lastPosition.X,
                        0,
                        currentPos.Z - dash.lastPosition.Z
                    )

                    local rawMag = rawDelta.Magnitude

                    if rawMag > 0.001 then
                        if rawMag > 8 then
                            rawDelta = rawDelta.Unit * 8
                            rawMag = 8
                        end

                        local extra = rawDelta * dash.multiplier
                        local extraCap = math.min(
                            3,
                            math.max(1.25, rawMag * 1.5)
                        )

                        if extra.Magnitude > extraCap then
                            extra = extra.Unit * extraCap
                        end

                        if extra.Magnitude > 0.001 then
                            hrp.CFrame = hrp.CFrame + extra
                        end
                    end

                    dash.lastPosition = hrp.Position
                    continue
                end

                local step

                if dash.cfg.isUnlimited then
                    step = dash.speed * safeDt
                else
                    step = math.min(
                        dash.speed * safeDt,
                        dash.remaining
                    )
                end

                local moveDir

                if dash.moveDir then
                    moveDir = dash.moveDir
                elseif dash.isDirectional then
                    local baseLook = hrp.CFrame.LookVector
                    local right = baseLook:Cross(Vector3.new(0, 1, 0))
                    local offset = dash.offset
                    local rawDir =
                        right * -offset.X
                        + baseLook * offset.Z

                    local flatDir =
                        Vector3.new(
                            rawDir.X,
                            0,
                            rawDir.Z
                        )

                    moveDir =
                        flatDir.Magnitude > 0.01
                        and flatDir.Unit
                        or DEFAULT_DIR
                else
                    local look = hrp.CFrame.LookVector
                    local flatLook =
                        Vector3.new(
                            look.X,
                            0,
                            look.Z
                        )

                    moveDir =
                        flatLook.Magnitude > 0.01
                        and flatLook.Unit
                        or DEFAULT_DIR
                end

                local newPos =
                    hrp.Position
                    + moveDir * step

                if dash.preserveRotation then
                    hrp.CFrame =
                        hrp.CFrame
                        + moveDir * step
                else
                    hrp.CFrame =
                        CFrame.new(
                            newPos.X,
                            hrp.Position.Y,
                            newPos.Z
                        )
                        * CFrame.new(
                            ZERO,
                            moveDir
                        )
                end

                if not dash.cfg.isUnlimited then
                    dash.remaining -= step

                    if dash.remaining <= 0.001 then
                        table.remove(ActiveDashes, i)
                    end
                end
            end

            if #ActiveDashes == 0 and renderConn then
                renderConn:Disconnect()
                renderConn = nil
            end
        end

        local function startUpdateIfNeeded()
            if not renderConn and #ActiveDashes > 0 then
                renderConn = game:GetService("RunService").Heartbeat:Connect(updateDashes)
            end
        end

        local function startDash(hrp, cfg, track, directionName)
            local dist = Distances[cfg.sliderVar]
            if not dist or dist <= 0 then return end

            local now = os.clock()
            local last = Distances.__cooldowns[cfg.sliderVar] or 0

            if now - last < (cfg.cooldown or 0) then
                return
            end

            Distances.__cooldowns[cfg.sliderVar] = now

            if cfg.scaleNaturalMotion then
                for _, active in ipairs(ActiveDashes) do
                    if active.cfg == cfg then
                        active.cancelled = true
                    end
                end

                local duration = cfg.duration or 1

                if track and track.Length and track.Length > 0.1 then
                    duration = math.clamp(
                        track.Length + 0.15,
                        0.5,
                        3
                    )
                end

                local dash = {
                    hrp = hrp,
                    cfg = cfg,
                    scaleNaturalMotion = true,
                    multiplier = math.clamp(dist / 100, 0, 2),
                    lastPosition = hrp.Position,
                    expiresAt = os.clock() + duration,
                    cancelled = false
                }

                if track then
                    local stoppedConn

                    stoppedConn = track.Stopped:Connect(function()
                        dash.cancelled = true

                        if stoppedConn then
                            stoppedConn:Disconnect()
                            stoppedConn = nil
                        end
                    end)
                end

                table.insert(ActiveDashes, dash)
                startUpdateIfNeeded()
                return
            end

            task.delay(cfg.wait or 0, function()
                if not hrp or not hrp.Parent then return end

                if track
                    and (cfg.wait or 0) > 0
                    and track.IsPlaying == false then
                    return
                end

                local dash = {
                    hrp = hrp,
                    remaining = dist,
                    cfg = cfg,
                    isDirectional = cfg.isDirectional == true,
                    expiresAt =
                        os.clock()
                        + math.max(
                            (cfg.duration or 0.5) * 4 + 1,
                            2
                        )
                }

                if dash.isDirectional and directionName then
                    dash.offset =
                        DirectionOffsets[directionName]
                        or Vector3.new(0, 0, 1)
                end

                if cfg.isUnlimited then
                    dash.remaining = math.huge
                    dash.speed = cfg.speed or 150
                    dash.expiresAt = os.clock() + 15

                    if track then
                        local stoppedConn

                        stoppedConn = track.Stopped:Connect(function()
                            dash.cancelled = true

                            if stoppedConn then
                                stoppedConn:Disconnect()
                                stoppedConn = nil
                            end
                        end)
                    end
                else
                    local duration =
                        math.max(
                            cfg.duration or 0.4,
                            0.05
                        )

                    dash.speed =
                        dist / duration
                end

                table.insert(ActiveDashes, dash)
                startUpdateIfNeeded()
            end)
        end

        local function onAnimationPlayed(track)
            if not track.Animation then return end

            local id =
                tostring(
                    track.Animation.AnimationId
                ):match("%d+")

            if not id then return end

            for _, cfg in pairs(DashConfigs) do
                if cfg.remoteDriven then
                    continue
                end

                local match = false
                local directionName = nil

                if cfg._animId and id == cfg._animId then
                    match = true

                elseif cfg._animIds then
                    if cfg.isDirectional then
                        directionName =
                            cfg._animIds[id]

                        if directionName then
                            match = true
                        end
                    elseif cfg._animIds[id] then
                        match = true
                    end
                end

                if match and cfg.moveName then
                    local wildActive =
                        (Distances.wildInstinctsDist or 0) > 0

                    local scorpionActive =
                        (Distances.scorpionDist or 0) > 0

                    if wildActive and scorpionActive then
                        local hintAge =
                            os.clock()
                            - (
                                Distances.__gagamaruHintAt
                                or 0
                            )

                        if hintAge > 2
                            or Distances.__gagamaruHint
                                ~= cfg.moveName then

                            match = false
                        end
                    end
                end

                if match
                    and cachedHRP
                    and cachedHRP.Parent then

                    if cfg.requiresBall then
                        local ball =
                            cachedHRP.Parent:
                            FindFirstChild("Ball")

                        if not ball then
                            continue
                        end
                    end

                    startDash(
                        cachedHRP,
                        cfg,
                        track,
                        directionName
                    )
                end
            end
        end

        local function setupCharacter(char)
            local hum = char:WaitForChild("Humanoid", 5)
            if not hum then return end
            local animator = hum:WaitForChild("Animator", 5)
            if not animator then return end
            cachedHRP = char:WaitForChild("HumanoidRootPart", 5)
            if not cachedHRP then return end
            animator.AnimationPlayed:Connect(onAnimationPlayed)
        end

        if player.Character then
            setupCharacter(player.Character)
        end
        player.CharacterAdded:Connect(setupCharacter)

        do
            local WILD_LEFT_ANIMATION_ID = "119102674949397"
            local WILD_RIGHT_ANIMATION_ID = "127218859810420"
            local SCORPION_ANIMATION_ID = "126121761510176"

            local animatorConnection = nil
            local axisConnection = nil
            local cachedRight = nil
            local freezeRightUntil = 0
            local generation = 0

            local function flatUnit(vector)
                local flat = Vector3.new(
                    vector.X,
                    0,
                    vector.Z
                )

                if flat.Magnitude <= 0.001 then
                    return nil
                end

                return flat.Unit
            end

            local function getCharacter()
                local char = Players.LocalPlayer.Character
                if not char then
                    return nil
                end

                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")

                if not humanoid or not root then
                    return nil
                end

                return char, humanoid, root
            end

            local function getBall()
                local terrain = workspace:FindFirstChild("Terrain")
                local ball = terrain and terrain:FindFirstChild("Ball")

                if ball and ball:IsA("BasePart") then
                    return ball
                end

                local fallback = workspace:FindFirstChild("Ball", true)

                if fallback and fallback:IsA("BasePart") then
                    return fallback
                end

                return nil
            end

            local function cancelBoost(cfg)
                for _, dash in ipairs(ActiveDashes) do
                    if dash.cfg == cfg then
                        dash.cancelled = true
                    end
                end
            end

            local function startBoost(cfg, direction, track)
                local _, _, root = getCharacter()
                if not root then
                    return
                end

                local distance = Distances[cfg.sliderVar] or 0
                if distance <= 0 then
                    return
                end

                local moveDir = flatUnit(direction)
                if not moveDir then
                    return
                end

                cancelBoost(cfg)

                local maxSpeed = cfg.maxExtraSpeed or 95
                local duration = math.max(
                    cfg.duration or 0.5,
                    distance / maxSpeed
                )

                duration = math.clamp(
                    duration,
                    0.14,
                    1.35
                )

                local dash = {
                    hrp = root,
                    remaining = distance,
                    cfg = cfg,
                    moveDir = moveDir,
                    preserveRotation = true,
                    cancelled = false,
                    speed = distance / duration,
                    expiresAt = os.clock() + duration + 0.30
                }

                if track then
                    local stoppedConnection

                    stoppedConnection = track.Stopped:Connect(function()
                        dash.cancelled = true

                        if stoppedConnection then
                            stoppedConnection:Disconnect()
                            stoppedConnection = nil
                        end
                    end)
                end

                table.insert(ActiveDashes, dash)
                startUpdateIfNeeded()
            end

            local function chooseScorpionDirection(humanoid, root, token)
                local startPosition = root.Position

                for _ = 1, 6 do
                    RunService.PostSimulation:Wait()

                    if token ~= generation or not root.Parent then
                        return nil
                    end

                    local delta = Vector3.new(
                        root.Position.X - startPosition.X,
                        0,
                        root.Position.Z - startPosition.Z
                    )

                    if delta.Magnitude >= 0.04 then
                        return delta.Unit
                    end

                    local velocity = flatUnit(root.AssemblyLinearVelocity)

                    if velocity and root.AssemblyLinearVelocity.Magnitude >= 0.75 then
                        return velocity
                    end
                end

                local ball = getBall()

                if ball then
                    local towardBall = flatUnit(ball.Position - root.Position)

                    if towardBall then
                        return towardBall
                    end
                end

                local moveDirection = flatUnit(humanoid.MoveDirection)

                if moveDirection then
                    return moveDirection
                end

                return flatUnit(root.CFrame.LookVector)
            end

            local function onWildAnimation(side)
                if (Distances.wildInstinctsDist or 0) <= 0 then
                    return
                end

                local _, _, root = getCharacter()

                if not root then
                    return
                end

                local right = cachedRight or flatUnit(root.CFrame.RightVector)

                if not right then
                    return
                end

                generation += 1
                freezeRightUntil = os.clock() + 0.35

                startBoost(
                    DashConfigs.WildInstincts,
                    right * side,
                    nil
                )
            end

            local function onScorpionAnimation(track)
                local _, humanoid, root = getCharacter()

                if not humanoid or not root then
                    return
                end

                if (Distances.scorpionDist or 0) <= 0 then
                    return
                end

                generation += 1
                local token = generation

                task.spawn(function()
                    local direction = chooseScorpionDirection(
                        humanoid,
                        root,
                        token
                    )

                    if token ~= generation
                        or not direction
                        or not track.IsPlaying then
                        return
                    end

                    startBoost(
                        DashConfigs.Scorpion,
                        direction,
                        track
                    )
                end)
            end

            local function hookAnimator(char)
                if animatorConnection then
                    animatorConnection:Disconnect()
                    animatorConnection = nil
                end

                local humanoid = char:WaitForChild("Humanoid", 5)

                if not humanoid then
                    return
                end

                local animator =
                    humanoid:FindFirstChildOfClass("Animator")
                    or humanoid:WaitForChild("Animator", 5)

                if not animator then
                    return
                end

                animatorConnection = animator.AnimationPlayed:Connect(function(track)
                    if not track.Animation then
                        return
                    end

                    local animationId = tostring(
                        track.Animation.AnimationId
                    ):match("%d+")

                    if animationId == WILD_LEFT_ANIMATION_ID then
                        onWildAnimation(-1)

                    elseif animationId == WILD_RIGHT_ANIMATION_ID then
                        onWildAnimation(1)

                    elseif animationId == SCORPION_ANIMATION_ID then
                        onScorpionAnimation(track)
                    end
                end)
            end

            if axisConnection then
                axisConnection:Disconnect()
            end

            axisConnection = RunService.Heartbeat:Connect(function()
                if os.clock() < freezeRightUntil then
                    return
                end

                local _, _, root = getCharacter()

                if not root then
                    cachedRight = nil
                    return
                end

                local right = flatUnit(root.CFrame.RightVector)

                if right then
                    cachedRight = right
                end
            end)

            if Players.LocalPlayer.Character then
                local _, _, root = getCharacter()

                if root then
                    cachedRight = flatUnit(root.CFrame.RightVector)
                end

                hookAnimator(Players.LocalPlayer.Character)
            end

            Players.LocalPlayer.CharacterAdded:Connect(function(char)
                generation += 1
                cachedRight = nil
                freezeRightUntil = 0

                cancelBoost(
                    DashConfigs.WildInstincts
                )

                cancelBoost(
                    DashConfigs.Scorpion
                )

                task.defer(
                    hookAnimator,
                    char
                )
            end)
        end


        d:Slider("Diving Header Distance", 0, 0, 125, 1, function(v)
            Distances.divingDist = v
        end)

        d:Slider("Wild Instincts Distance", 0, 0, 250, 1, function(v)
            Distances.wildInstinctsDist = v
        end)

        d:Slider("Scorpion Distance", 0, 0, 250, 1, function(v)
            Distances.scorpionDist = v
        end)

    end)

    if not moveBuffOK then
        warn("[MoveBuffs][BOOT] " .. tostring(moveBuffError))
    end
end)


local teamHighlightState = {
    active = false,
    folder = nil,
    connections = {},
    playerConnections = {}
}

local function teamHighlightNotify(text)
    StarterGui:SetCore("SendNotification", {
        Title = "Team Highlighting",
        Text = text,
        Duration = 2
    })
end

local function disconnectTeamHighlightConnections()
    for i = #teamHighlightState.connections, 1, -1 do
        local connection = teamHighlightState.connections[i]
        if connection then connection:Disconnect() end
        teamHighlightState.connections[i] = nil
    end

    for player, list in pairs(teamHighlightState.playerConnections) do
        for i = #list, 1, -1 do
            local connection = list[i]
            if connection then connection:Disconnect() end
        end
        teamHighlightState.playerConnections[player] = nil
    end
end

local function clearTeamHighlights()
    if teamHighlightState.folder then
        teamHighlightState.folder:Destroy()
        teamHighlightState.folder = nil
    end
end

local function ensureTeamHighlightFolder()
    if teamHighlightState.folder and teamHighlightState.folder.Parent then
        return teamHighlightState.folder
    end

    local folder = Instance.new("Folder")
    folder.Name = "ActiveTeamHighlights"
    folder.Parent = Workspace
    teamHighlightState.folder = folder
    return folder
end

local function refreshPlayerHighlight(player)
    if not teamHighlightState.active or player == Players.LocalPlayer then return end

    local folder = ensureTeamHighlightFolder()
    local name = "P_" .. tostring(player.UserId)
    local highlight = folder:FindFirstChild(name)
    local charactersFolder = Workspace:FindFirstChild("characters")
    local character = (charactersFolder and charactersFolder:FindFirstChild(player.Name)) or player.Character

    if not character then
        if highlight then highlight:Destroy() end
        return
    end

    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.FillTransparency = 0.65
        highlight.OutlineTransparency = 0.2
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = folder
    end

    local function worldTeam(plr)
        local characters = Workspace:FindFirstChild("characters")
        local wc = characters and characters:FindFirstChild(plr.Name)
        local st = wc and wc:FindFirstChild("state")
        local tv = st and (st:FindFirstChild("team") or st:FindFirstChild("Team"))
        if tv and tv:IsA("ValueBase") then return tostring(tv.Value) end
        return plr.Team and tostring(plr.Team.Name) or nil
    end

    local mine, theirs = worldTeam(Players.LocalPlayer), worldTeam(player)
    local sameTeam = mine ~= nil and theirs ~= nil and mine == theirs
    local color = sameTeam and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(255, 50, 50)
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.Adornee = character
end

local function refreshAllTeamHighlights()
    if not teamHighlightState.active then return end
    for _, player in ipairs(Players:GetPlayers()) do
        refreshPlayerHighlight(player)
    end
end

local function hookTeamHighlightPlayer(player)
    if player == Players.LocalPlayer or teamHighlightState.playerConnections[player] then return end

    local list = {}
    teamHighlightState.playerConnections[player] = list

    list[#list + 1] = player.CharacterAdded:Connect(function()
        task.defer(function()
            if teamHighlightState.active then refreshPlayerHighlight(player) end
        end)
    end)

    list[#list + 1] = player:GetPropertyChangedSignal("Team"):Connect(function()
        if teamHighlightState.active then refreshPlayerHighlight(player) end
    end)

    refreshPlayerHighlight(player)
end

othersil:Toggle("Team Highlighting", "Highlights Your Teammates / Enemies Accordingly.", function(value)
    teamHighlightState.active = value == true
    teamHighlightNotify(teamHighlightState.active and "Enabled." or "Disabled.")

    disconnectTeamHighlightConnections()

    if not teamHighlightState.active then
