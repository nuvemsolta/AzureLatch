                                or 0
                            )

                        if hintAge > 2
                            or Distances.__gagamaruHint
                                ~= cfg.moveName then

                            match = false
                        end
                    end
                end

                if match
                    and cachedHRP
                    and cachedHRP.Parent then

                    if cfg.requiresBall then
                        local ball =
                            cachedHRP.Parent:
                            FindFirstChild("Ball")

                        if not ball then
                            continue
