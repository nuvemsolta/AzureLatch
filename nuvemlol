local ballMagnetTerrain = Workspace.Terrain

local ballMagnetState = {
    active = false,
    conn = nil,
    lastFire = 0,
    fireInterval = 1 / 60,
    radius = 7,
    hrp = nil,
    useM2Hold = false,
    accumulator = 0
}

local function setupBallMagnetCharacter(char)
    ballMagnetState.hrp = char:WaitForChild("HumanoidRootPart", 10)
end

if Players.LocalPlayer.Character then
    task.defer(setupBallMagnetCharacter, Players.LocalPlayer.Character)
