                root.CFrame = targetCFrame + Vector3.new(0, 5, 0)
            end
            task.wait(0.25)

            for i = 1, 2 do
                if not flowPartData.flowActive or flow.Value >= 100 then break end
                flowPartData.ByteNetReliable:FireServer(
