    local function isDonText(value)
        local valueNormalized = normalizeName(value)
        return valueNormalized == "donlorenzo"
            or valueNormalized == "donlorenzomastery"
            or valueNormalized == "masterylorenzo"
            or string.find(valueNormalized, "donlorenzo", 1, true) ~= nil
            or string.find(valueNormalized, "zombiedribble", 1, true) ~= nil
    end

    local function objectLooksLikeDon(object)
        if not object then return false end
        if isDonText(object.Name) then return true end

        for name, value in pairs(object:GetAttributes()) do
            if isDonText(name) or isDonText(value) then return true end
        end

        if object:IsA("StringValue") and isDonText(object.Value) then return true end
        if (object:IsA("TextLabel") or object:IsA("TextButton")) and isDonText(object.Text) then
            return true
        end

        return false
    end

    local function scanSmallTree(root)
        if not root then return false end
        if objectLooksLikeDon(root) then return true end

        for _, object in ipairs(root:GetDescendants()) do
            if objectLooksLikeDon(object) then return true end
        end

        return false
    end

    local function isDonLorenzo()
        local now = os.clock()
        if now - donCacheAt < 1 then
            return donCacheValue
        end

        donCacheAt = now
        donCacheValue = false

        local character = LocalPlayer.Character
        if objectLooksLikeDon(LocalPlayer) or scanSmallTree(character) then
            donCacheValue = true
            return true
        end

        local charactersFolder = Workspace:FindFirstChild("characters")
        local workspaceCharacter = charactersFolder and charactersFolder:FindFirstChild(LocalPlayer.Name)
        if workspaceCharacter ~= character and scanSmallTree(workspaceCharacter) then
            donCacheValue = true
            return true
        end

        local hotbar = playerGui:FindFirstChild("Hotbar")
        if scanSmallTree(hotbar) then
            donCacheValue = true
        end

        return donCacheValue
    end

    local function isVisibleThroughParents(object)
        local current = object
        while current and current ~= playerGui do
            if current:IsA("ScreenGui") and not current.Enabled then return false end
            if current:IsA("GuiObject") and not current.Visible then return false end
            current = current.Parent
        end
        return true
    end

    local function findQTE()
        local qteGui = playerGui:FindFirstChild("Qte") or playerGui:FindFirstChild("QTE")
        if not qteGui then return nil, nil, nil end

        local qteGroup = qteGui:FindFirstChild("QTE", true)
            or qteGui:FindFirstChild("CanvasGroup", true)
            or qteGui

        local targetButton = qteGroup:FindFirstChild("Button", true)
        if targetButton and not targetButton:IsA("GuiButton") then
            targetButton = nil
        end

        return qteGui, qteGroup, targetButton
    end

    local function promptIsVisible()
        local qteGui, qteGroup, button = findQTE()
        if not qteGui or not button then return false, qteGui, qteGroup, button end
        if not isVisibleThroughParents(qteGui) or not isVisibleThroughParents(button) then
            return false, qteGui, qteGroup, button
        end
        if qteGroup:IsA("GuiObject") and not isVisibleThroughParents(qteGroup) then
            return false, qteGui, qteGroup, button
        end
        return true, qteGui, qteGroup, button
    end

    local function fireButton(button)
        if not button or not button.Parent then return end

        local fired = false
        if type(firesignal) == "function" then
            local ok1 = pcall(firesignal, button.Activated)
            local ok2 = pcall(firesignal, button.MouseButton1Click)
            fired = ok1 or ok2
        end

        if not fired and type(getconnections) == "function" then
            for _, signal in ipairs({button.Activated, button.MouseButton1Click}) do
                local ok, list = pcall(getconnections, signal)
                if ok and type(list) == "table" then
                    for _, connection in ipairs(list) do
                        if type(connection.Fire) == "function" then
                            pcall(function() connection:Fire() end)
                            fired = true
                        elseif type(connection.Function) == "function" then
                            pcall(function() connection:Function() end)
                            fired = true
                        end
                    end
                end
            end
        end

        if fired then return end

        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local center = button.AbsolutePosition + button.AbsoluteSize / 2
            vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
            vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
        end)
    end

    local function cancelPrompt()
        activePrompt = false
        lastButton = nil
        promptToken += 1
    end

    local function beginPrompt(startedAt, knownButton)
        if not qteEnabled or activePrompt then return end

        activePrompt = true
        lastButton = knownButton
        promptToken += 1
        local myToken = promptToken
        local delayTime = isDonLorenzo() and DON_QTE_DELAY or NORMAL_QTE_DELAY
        local targetTime = (startedAt or os.clock()) + delayTime

        task.spawn(function()
            while qteEnabled and myToken == promptToken do
                local remaining = targetTime - os.clock()
                if remaining <= 0 then break end
                task.wait(math.max(math.min(remaining, 0.05), 0.005))
            end

            if not qteEnabled or myToken ~= promptToken then return end

            local visible, _, _, liveButton = promptIsVisible()
            if visible and liveButton then
                fireButton(liveButton)
            end

            activePrompt = false
        end)
    end

    local function probeQTE(eventTime)
        if not qteEnabled then return end

        local visible, _, _, button = promptIsVisible()
        if not visible then
            if activePrompt then cancelPrompt() end
            return
        end

        if not activePrompt then
            beginPrompt(eventTime or os.clock(), button)
        elseif button and lastButton ~= button then
            lastButton = button
        end
    end

    local function disconnectWatched()
        for i = #watchedConnections, 1, -1 do
            local connection = watchedConnections[i]
            if connection then connection:Disconnect() end
            watchedConnections[i] = nil
        end

        if qteDescendantConnection then
            qteDescendantConnection:Disconnect()
            qteDescendantConnection = nil
        end
    end

    local function watchVisibility(object)
        if not object then return end

        if object:IsA("ScreenGui") then
            watchedConnections[#watchedConnections + 1] = object:GetPropertyChangedSignal("Enabled"):Connect(function()
                if qteEnabled then probeQTE(os.clock()) end
            end)
        elseif object:IsA("GuiObject") then
            watchedConnections[#watchedConnections + 1] = object:GetPropertyChangedSignal("Visible"):Connect(function()
                if qteEnabled then probeQTE(os.clock()) end
            end)
        end
    end

    local function refreshQTEWatchers()
        if not qteEnabled then return end

        local qteGui, qteGroup, button = findQTE()
        if qteGui ~= currentQteGui
            or qteGroup ~= currentQteGroup
            or button ~= currentQteButton then
            disconnectWatched()
            currentQteGui = qteGui
            currentQteGroup = qteGroup
            currentQteButton = button

            if qteGui then
                watchVisibility(qteGui)
                watchVisibility(qteGroup)
                watchVisibility(button)

                qteDescendantConnection = qteGui.DescendantAdded:Connect(function(object)
                    if object.Name == "QTE"
                        or object.Name == "CanvasGroup"
                        or object.Name == "Button" then
                        task.defer(function()
                            if qteEnabled then
                                refreshQTEWatchers()
                                probeQTE(os.clock())
                            end
                        end)
                    end
                end)
            end
        end
    end

    local function disconnectQTE()
        generation += 1
        if playerGuiConnection then
            playerGuiConnection:Disconnect()
            playerGuiConnection = nil
        end
        disconnectWatched()
        currentQteGui = nil
        currentQteGroup = nil
        currentQteButton = nil
        cancelPrompt()
    end

    local function setQTEEnabled(value)
        qteEnabled = value == true
        disconnectQTE()
        if not qteEnabled then return end

        generation += 1
        local myGeneration = generation

        playerGuiConnection = playerGui.DescendantAdded:Connect(function(object)
            if not qteEnabled then return end

            if object.Name == "Qte" or object.Name == "QTE" then
                task.defer(function()
                    if qteEnabled then
                        refreshQTEWatchers()
                        probeQTE(os.clock())
                    end
                end)
                return
            end

            if currentQteGui
                and object:IsDescendantOf(currentQteGui)
                and (object.Name == "CanvasGroup" or object.Name == "Button") then
                task.defer(function()
                    if qteEnabled then
                        refreshQTEWatchers()
                        probeQTE(os.clock())
                    end
                end)
            end
        end)

        refreshQTEWatchers()
        task.defer(probeQTE)

        task.spawn(function()
            while qteEnabled and generation == myGeneration do
                probeQTE()
                task.wait(0.15)
            end
        end)
    end

    othersil:Toggle(
        "Auto QuickTimeEvent",
        "Automatically Does QuickTimeEvents.",
        function(value)
            setQTEEnabled(value)
        end
    )
end


