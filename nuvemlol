        mobileKeySystem.buttons[index] = nil
    end
end)




local function runOptionalRemote(label, url, useCacheFlag)
    local okHttp, source = pcall(function()
        if useCacheFlag then
            return game:HttpGet(url, true)
        end
        return game:HttpGet(url)
    end)

    if not okHttp or type(source) ~= "string" or source == "" then
        warn("[Celeron] Optional loader failed to download: " .. label)
        return false
    end

    local chunk, compileError = loadstring(source)
    if type(chunk) ~= "function" then
        warn("[Celeron] Optional loader failed to compile: " .. label .. " | " .. tostring(compileError))
        return false
    end

    local okRun, runtimeError = pcall(chunk)
    if not okRun then
        warn("[Celeron] Optional loader failed to run: " .. label .. " | " .. tostring(runtimeError))
        return false
    end

    return true
end

