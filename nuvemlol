        local function addSidebarEntry(tab, section)
            if selectedTab ~= tab then return end

            local button = create("TextButton", {
                Name = section.Name,
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundTransparency = 1,
                Text = section.Name,
