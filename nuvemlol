local airDribbleTrackHumanoid = nil

local function getAirDribbleTrack(hum)
    if airDribbleTrack and airDribbleTrackHumanoid == hum then
        return airDribbleTrack
    end

    if airDribbleTrack then
        pcall(function() airDribbleTrack:Stop(0) end)
        airDribbleTrack = nil
    end

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end

    local ok, track = pcall(function()
        return animator:LoadAnimation(airDribbleAnimation)
    end)

    if ok then
        airDribbleTrack = track
        airDribbleTrackHumanoid = hum
        return track
    end

    return nil
end

local function performAirDribble()
    local now = tick()
    if now - airDribbleState.lastKick < cooldown then
        return
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end

    airDribbleState.lastKick = now

    local track = getAirDribbleTrack(hum)
    if track then
        track:Play(0)
    end

    local dir = root.CFrame.LookVector
    local kickVec = Vector3.new(dir.X * 0.75, 0.65, dir.Z * 0.75)

    airDribbleRemote:FireServer(airDribblePacket, {
        { "kick", 28, false, kickVec }
    })
end

