            local function cancelBoost(cfg)
                for _, dash in ipairs(ActiveDashes) do
                    if dash.cfg == cfg then
                        dash.cancelled = true
                    end
                end
            end

            local function startBoost(cfg, direction, track)
                local _, _, root = getCharacter()
                if not root then
                    return
                end

                local distance = Distances[cfg.sliderVar] or 0
                if distance <= 0 then
                    return
                end

                distance = clampGagamaruDistance(cfg, distance)
                Distances[cfg.sliderVar] = distance

                local moveDir = flatUnit(direction)
                if not moveDir then
                    return
                end

                cancelBoost(cfg)

                local maxSpeed = cfg.maxExtraSpeed or 95
                local duration = math.max(
                    cfg.duration or 0.5,
                    distance / maxSpeed
                )

                duration = math.clamp(
                    duration,
                    0.14,
                    1.35
                )

                local dash = {
                    hrp = root,
                    remaining = distance,
                    cfg = cfg,
                    moveDir = moveDir,
                    preserveRotation = true,
                    cancelled = false,
                    speed = distance / duration,
                    expiresAt = os.clock() + duration + 0.30
                }

                if track then
                    local stoppedConnection

                    stoppedConnection = track.Stopped:Connect(function()
                        dash.cancelled = true

                        if stoppedConnection then
                            stoppedConnection:Disconnect()
                            stoppedConnection = nil
                        end
                    end)
                end

                table.insert(ActiveDashes, dash)
                startUpdateIfNeeded()
            end

            local function chooseScorpionDirection(humanoid, root, token)
                local startPosition = root.Position

                for _ = 1, 6 do
                    RunService.PostSimulation:Wait()

                    if token ~= generation or not root.Parent then
                        return nil
                    end

                    local delta = Vector3.new(
                        root.Position.X - startPosition.X,
                        0,
                        root.Position.Z - startPosition.Z
                    )

                    if delta.Magnitude >= 0.04 then
                        return delta.Unit
                    end

                    local velocity = flatUnit(root.AssemblyLinearVelocity)

                    if velocity and root.AssemblyLinearVelocity.Magnitude >= 0.75 then
                        return velocity
                    end
                end

                local ball = getBall()

                if ball then
                    local towardBall = flatUnit(ball.Position - root.Position)

                    if towardBall then
                        return towardBall
                    end
                end

                local moveDirection = flatUnit(humanoid.MoveDirection)

                if moveDirection then
                    return moveDirection
                end

                return flatUnit(root.CFrame.LookVector)
            end

            local function onWildAnimation(side)
                if not GagamaruEnabled.wildInstinctsDist
                    or (Distances.wildInstinctsDist or 0) <= 0 then
                    return
                end

                local _, _, root = getCharacter()

                if not root then
                    return
                end

                local right = cachedRight or flatUnit(root.CFrame.RightVector)

                if not right then
                    return
                end

                generation += 1
                freezeRightUntil = os.clock() + 0.35

                startBoost(
                    DashConfigs.WildInstincts,
                    right * side,
                    nil
