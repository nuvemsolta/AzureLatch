        function window:SetScale(value)
            value = tonumber(value)
            if not value then return false end

            value = math.clamp(value, 0.5, 1.5)
            self.CurrentScale = value

            local scaleObject = self.UIScale
            if not scaleObject or not scaleObject.Parent then
                scaleObject = self.Main:FindFirstChildOfClass("UIScale")
                self.UIScale = scaleObject
            end

            if scaleObject then
                scaleObject.Scale = value
            end

            -- The original hub keeps an 800x450 base canvas and scales that
            -- subtree. Recenter after every scale change so mobile doesn't drift.
            self.Main.Size = UDim2.fromOffset(800, 450)
            if self.Main.AnchorPoint == Vector2.new(0.5, 0.5) then
                self.Main.Position = UDim2.fromScale(0.5, 0.5)
            end

            return true
        end

