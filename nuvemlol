    local heroicClashSize = 0
    local heroicClashUntil = 0
    local heroicAnimationConnection = nil

    local HEROIC_CLASH_ANIMATION =
        "101568232677122"

    local activeWhiffs = setmetatable({}, {
        __mode = "k"
    })

    local function fmtVector(vector)
        return string.format(
            "%.2f x %.2f x %.2f",
            vector.X,
            vector.Y,
            vector.Z
        )
    end

    local function armHeroicClash(source)
        if heroicClashSize <= 0 then
            return
        end

        heroicClashUntil =
            os.clock() + 1.5

        print(
            "Heroic Clash: "
            .. tostring(source)
        )
    end

    local function stopWhiff(part, restore)
        local data =
            activeWhiffs[part]

        if not data then
            return
        end

        if data.preSimulation then
            data.preSimulation:
                Disconnect()
        end

        if data.destroying then
            data.destroying:
                Disconnect()
        end

        activeWhiffs[part] = nil

        if not restore
            or not part
            or not part.Parent then

            return
        end

        pcall(function()
            part.Size =
                data.size

            part.CanTouch =
                data.canTouch

            part.CanQuery =
                data.canQuery

            part.CanCollide =
                data.canCollide
        end)
    end

    local function touchHandlerCount(part)
        if type(getconnections) ~= "function" then
            return "?"
        end

        local ok, connections =
            pcall(
                getconnections,
                part.Touched
            )

        if not ok
            or type(connections) ~= "table" then

            return "?"
        end

        return tostring(
            #connections
        )
    end

    local function trackWhiff(part)
        if heroicClashSize <= 0
            or os.clock() > heroicClashUntil
            or activeWhiffs[part]
            or not part.Parent then

            return
        end

        local character =
            Players.LocalPlayer.Character

        local root =
            character
            and character:
                FindFirstChild(
                    "HumanoidRootPart"
                )

        if root
            and (
                part.Position
                - root.Position
            ).Magnitude > 35 then

            return
        end

        local data = {
            size = part.Size,
            canTouch = part.CanTouch,
            canQuery = part.CanQuery,
            canCollide = part.CanCollide
        }

        activeWhiffs[part] =
            data

        print(
            "Heroic Clash whiff | normal: "
            .. fmtVector(
                data.size
            )
            .. " | CanTouch: "
            .. tostring(
                data.canTouch
            )
            .. " | Touch handlers: "
            .. touchHandlerCount(
                part
            )
        )

        data.destroying =
            part.Destroying:
            Connect(function()
                stopWhiff(
                    part,
                    false
                )
            end)

        data.preSimulation =
            RunService.PreSimulation:
            Connect(function()
                if heroicClashSize <= 0
                    or os.clock()
                        > heroicClashUntil then

                    stopWhiff(
                        part,
                        true
                    )

                    return
                end

                if not part.Parent then
                    stopWhiff(
                        part,
                        false
                    )

                    return
                end

                pcall(function()
                    part.Size =
                        Vector3.new(
                            heroicClashSize,
                            heroicClashSize,
                            heroicClashSize
                        )

                    part.CanTouch = true
                    part.CanQuery = true
                    part.CanCollide = false
                end)
            end)
    end

    local function inspectObject(object)
        if heroicClashSize <= 0
            or os.clock() > heroicClashUntil
            or not object:IsA("BasePart") then

            return
        end

        if string.lower(
            object.Name
        ) == "whiff" then

            trackWhiff(
                object
            )
        end
    end

    local function scanExistingWhiffs()
        if heroicClashSize <= 0 then
            return
        end

        local character =
            Players.LocalPlayer.Character

        local root =
            character
            and character:
                FindFirstChild(
                    "HumanoidRootPart"
                )

        if not root then
            return
        end

        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do
            if object:IsA("BasePart")
                and string.lower(
                    object.Name
                ) == "whiff"
                and (
                    object.Position
                    - root.Position
                ).Magnitude <= 35 then

                trackWhiff(
                    object
                )
            end
        end
    end

    local function hookAnimator(character)
        if heroicAnimationConnection then
            heroicAnimationConnection:
                Disconnect()

            heroicAnimationConnection =
                nil
        end

        local humanoid =
            character:
            WaitForChild(
                "Humanoid",
                5
            )

        if not humanoid then
            return
        end

        local animator =
            humanoid:
            FindFirstChildOfClass(
                "Animator"
            )
            or humanoid:
                WaitForChild(
                    "Animator",
                    5
                )

        if not animator then
            return
        end

        heroicAnimationConnection =
            animator.AnimationPlayed:
            Connect(function(track)
                local animation =
                    track.Animation

                if not animation then
                    return
                end

                local id =
                    tostring(
                        animation.AnimationId
                    ):match("%d+")

                if id
                    == HEROIC_CLASH_ANIMATION then

                    armHeroicClash(
                        "animation"
                    )

                    task.defer(
                        scanExistingWhiffs
                    )
                end
            end)
    end

    if Players.LocalPlayer.Character then
        task.defer(
            hookAnimator,
            Players.LocalPlayer.Character
        )
    end

    Players.LocalPlayer.CharacterAdded:
    Connect(function(character)
        task.defer(
            hookAnimator,
            character
        )
    end)

    Workspace.DescendantAdded:
    Connect(function(object)
        if os.clock()
            <= heroicClashUntil then

            task.defer(
                inspectObject,
                object
            )
        end
    end)

    do
        local remote =
            ReplicatedStorage:
            FindFirstChild(
                "ByteNetReliable"
            )

        if remote
            and type(hookmetamethod)
                == "function"
            and type(getnamecallmethod)
                == "function" then

            local oldNamecall

            local replacement =
                function(self, ...)
                    local method =
                        getnamecallmethod()

                    if self == remote
                        and method
                            == "FireServer" then

                        local args =
                            table.pack(...)

                        local packet =
                            args[1]

                        local payload =
                            args[2]

                        local okLength, length =
                            pcall(
                                buffer.len,
                                packet
                            )

                        if okLength
                            and length == 2 then

                            local okA, a =
                                pcall(
                                    buffer.readu8,
                                    packet,
                                    0
                                )

                            local okB, b =
                                pcall(
                                    buffer.readu8,
                                    packet,
                                    1
                                )

                            local move =
                                type(payload)
                                    == "table"
                                and payload[1]
                                or nil

                            if okA
                                and okB
                                and a == 25
                                and b == 1
                                and type(move)
                                    == "table"
                                and move[1]
                                    == "skill3"
                                and type(move[2])
                                    == "boolean" then

                                armHeroicClash(
                                    move[2]
                                    and "left"
                                    or "right"
                                )

                                task.defer(
                                    scanExistingWhiffs
                                )
                            end
                        end
                    end

                    return oldNamecall(
                        self,
                        ...
                    )
                end

            if type(newcclosure)
                == "function" then

                replacement =
                    newcclosure(
                        replacement
                    )
            end

            local okHook, original =
                pcall(
                    hookmetamethod,
                    game,
                    "__namecall",
                    replacement
                )

            if okHook
                and original then

                oldNamecall =
                    original
            end
        end
    end

    kunigamiTests:Slider(
        "Heroic Clash Hitbox Increase",
        0,
        0,
        500,
        1,
        function(value)
            heroicClashSize =
                math.clamp(
                    tonumber(value)
                        or 0,
                    0,
                    500
                )

            if heroicClashSize <= 0 then
                heroicClashUntil = 0

                for part in pairs(
                    activeWhiffs
                ) do
                    stopWhiff(
                        part,
                        true
                    )
                end
            end
        end
    )
end


