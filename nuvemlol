                if autoGoalState.enabled and autoGoalHasBall() then
                    autoGoalRemote:FireServer(
                        autoGoalPacket,
                        {{"kick", 20, false, vector.create(0, 1, 0)}}
                    )
                end
            end

            autoGoalState.busy = false
        end)
    end)
end)

