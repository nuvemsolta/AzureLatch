                    function object:SetValue(newValue, silent)
                        self.Value = tostring(newValue or "")
                        field.Text = self.Value
                        if not silent then pcall(callback, self.Value) end
                    end

                    function object:GetValue()
                        return self.Value
                    end

                    field.FocusLost:Connect(function(enterPressed)
                        object.Value = field.Text
