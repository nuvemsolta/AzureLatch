    -- V22.3 stability helpers.
    -- Dynamic Enum indexing throws for invalid members in Roblox; it does not
    -- return nil. Every persisted/input key must go through these helpers.
    local function safeEnumMember(enumType, name)
        if typeof(name) == "EnumItem" then
            return name
        end

        if type(name) ~= "string" or name == "" then
            return nil
        end

        local ok, result = pcall(function()
            return enumType[name]
        end)

        if ok and typeof(result) == "EnumItem" then
            return result
        end

        return nil
    end

    local function safeInputEnum(value, fallback)
        if typeof(value) == "EnumItem" then
            return value
        end

        if type(value) ~= "string" then
            return fallback
        end

        return safeEnumMember(Enum.KeyCode, value)
            or safeEnumMember(Enum.UserInputType, value)
            or fallback
    end

    local function safeWaitForChild(parent, name, timeout)
        if typeof(parent) ~= "Instance" then
            return nil
        end

        local existing = parent:FindFirstChild(name)
        if existing then
            return existing
        end

        local ok, result = pcall(function()
            return parent:WaitForChild(name, timeout or 8)
        end)

        if ok then
            return result
        end

        return nil
    end

