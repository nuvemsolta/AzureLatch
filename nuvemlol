                button.BackgroundTransparency = 1
                button.Text = ""
                button.Size = UDim2.fromScale(1, 1)
                button.AutoButtonColor = false
                button.Parent = frame

                -- Mobile parity: the original control can be repositioned.
                -- Keep tap and drag separate so moving the button never fires Air Dribble.
                local dragging = false
                local activeInput = nil
                local dragStart = nil
                local frameStart = nil
                local moved = false
                local DRAG_THRESHOLD = 8

                local function keepConnection(connection)
                    state.MobileConnections[#state.MobileConnections + 1] = connection
                    return connection
                end

                local function viewportSize()
                    local cam = WorkspaceN.CurrentCamera
                    return cam and cam.ViewportSize or Vector2.new(800, 600)
                end

                local function updateDrag(input)
                    if not dragging or not dragStart or not frameStart then return end

                    local delta = input.Position - dragStart
                    if delta.Magnitude >= DRAG_THRESHOLD then
                        moved = true
                    end

                    local viewport = viewportSize()
                    local halfX = math.max(1, frame.AbsoluteSize.X * 0.5)
                    local halfY = math.max(1, frame.AbsoluteSize.Y * 0.5)

                    local centerX = frameStart.X + halfX + delta.X
                    local centerY = frameStart.Y + halfY + delta.Y

                    centerX = math.clamp(centerX, halfX, math.max(halfX, viewport.X - halfX))
                    centerY = math.clamp(centerY, halfY, math.max(halfY, viewport.Y - halfY))

                    frame.Position = UDim2.fromOffset(centerX, centerY)
                end

                keepConnection(button.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch
                        or input.UserInputType == Enum.UserInputType.MouseButton1 then

                        dragging = true
                        activeInput = input
                        dragStart = input.Position
                        frameStart = frame.AbsolutePosition
                        moved = false
                    end
                end))

                keepConnection(UserInputServiceN.InputChanged:Connect(function(input)
                    if not dragging then return end

                    if activeInput and activeInput.UserInputType == Enum.UserInputType.Touch then
                        if input == activeInput then
                            updateDrag(input)
                        end
                    elseif input.UserInputType == Enum.UserInputType.MouseMovement then
                        updateDrag(input)
                    end
                end))

                keepConnection(UserInputServiceN.InputEnded:Connect(function(input)
                    if not dragging then return end

                    local isActiveTouch = activeInput
                        and activeInput.UserInputType == Enum.UserInputType.Touch
                        and input == activeInput
                    local isMouseRelease = input.UserInputType == Enum.UserInputType.MouseButton1

                    if isActiveTouch or isMouseRelease then
                        local shouldExecute = not moved
                        dragging = false
                        activeInput = nil
                        dragStart = nil
                        frameStart = nil

                        if shouldExecute then
                            execute()
                        end
                    end
                end))

                state.MobileGui = gui
            end

