-- EvoHub-style active lineup indicator.
-- It only exists for the ONE lineup the player is currently standing in,
-- so the visual stays cheap even if hundreds of lineup pads are loaded.
local activeLineupMarker = nil
local activeLineupMarkerIndex = nil
local ACTIVE_LINEUP_COLOR = Color3.fromRGB(155, 225, 255)

local function destroyActiveLineupMarker()
    activeLineupMarkerIndex = nil
    if activeLineupMarker then
        activeLineupMarker:Destroy()
        activeLineupMarker = nil
    end
end

local function createActiveLineupMarker(padPart, padIndex)
    destroyActiveLineupMarker()
    if not padPart or not padPart.Parent then return end

    local model = Instance.new("Model")
    model.Name = "Celeron_ActiveLineupMarker"
    model.Parent = Workspace

    local center = Vector3.new(
        padPart.Position.X,
        padPart.Position.Y + (padPart.Size.Y * 0.5) + 0.10,
        padPart.Position.Z
    )

    -- 3 parts instead of the old 22-part ring. Same visual idea, much cheaper on mobile.
    local base = Instance.new("Part")
    base.Name = "Base"
    base.Shape = Enum.PartType.Cylinder
    base.Anchored = true
    base.CanCollide = false
    base.CanTouch = false
    base.CanQuery = false
    base.CastShadow = false
    base.Material = Enum.Material.Neon
    base.Color = ACTIVE_LINEUP_COLOR
    base.Transparency = 0.24
    base.Size = Vector3.new(0.12, 3.7, 3.7)
    base.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
    base.Parent = model

    local beam = Instance.new("Part")
    beam.Name = "Beam"
    beam.Anchored = true
    beam.CanCollide = false
    beam.CanTouch = false
    beam.CanQuery = false
    beam.CastShadow = false
    beam.Material = Enum.Material.Neon
    beam.Color = ACTIVE_LINEUP_COLOR
    beam.Transparency = 0.30
    beam.Size = Vector3.new(0.10, 3.4, 0.10)
    beam.Position = center + Vector3.new(0, 1.75, 0)
    beam.Parent = model

    local orb = Instance.new("Part")
    orb.Name = "Top"
    orb.Shape = Enum.PartType.Ball
    orb.Anchored = true
    orb.CanCollide = false
    orb.CanTouch = false
    orb.CanQuery = false
    orb.CastShadow = false
    orb.Material = Enum.Material.Neon
    orb.Color = Color3.fromRGB(240, 250, 255)
    orb.Transparency = 0.05
    orb.Size = Vector3.new(0.58, 0.58, 0.58)
    orb.Position = center + Vector3.new(0, 3.55, 0)
    orb.Parent = model

    activeLineupMarker = model
    activeLineupMarkerIndex = tostring(padIndex)
end

local function updateActiveLineupMarker(padIndex)
    if not padIndex then
        if activeLineupMarker then
            destroyActiveLineupMarker()
        end
        return
    end

    padIndex = tostring(padIndex)
    if activeLineupMarker
        and activeLineupMarker.Parent
        and activeLineupMarkerIndex == padIndex then
        return
    end

    local padPart = Workspace:FindFirstChild("pad" .. padIndex)
    if padPart then
        createActiveLineupMarker(padPart, padIndex)
    else
        destroyActiveLineupMarker()
    end
end

