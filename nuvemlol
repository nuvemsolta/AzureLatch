            if not dist or dist <= 0 then return end

            local now = os.clock()
            local last = Distances.__cooldowns[cfg.sliderVar] or 0

            if now - last < (cfg.cooldown or 0) then
                return
            end

            Distances.__cooldowns[cfg.sliderVar] = now

            if cfg.scaleNaturalMotion then
                for _, active in ipairs(ActiveDashes) do
                    if active.cfg == cfg then
                        active.cancelled = true
                    end
                end

                local duration = cfg.duration or 1

                if track and track.Length and track.Length > 0.1 then
                    duration = math.clamp(
                        track.Length + 0.15,
                        0.5,
                        3
                    )
                end

                local dash = {
                    hrp = hrp,
                    cfg = cfg,
                    scaleNaturalMotion = true,
                    multiplier = math.clamp(dist / 100, 0, 2),
                    lastPosition = hrp.Position,
                    expiresAt = os.clock() + duration,
                    cancelled = false
                }

                if track then
                    local stoppedConn

                    stoppedConn = track.Stopped:Connect(function()
                        dash.cancelled = true

                        if stoppedConn then
                            stoppedConn:Disconnect()
                            stoppedConn = nil
                        end
                    end)
                end

                table.insert(ActiveDashes, dash)
                startUpdateIfNeeded()
                return
            end

            task.delay(cfg.wait or 0, function()
                if not hrp or not hrp.Parent then return end

                if track
                    and (cfg.wait or 0) > 0
                    and track.IsPlaying == false then
                    return
                end

                local dash = {
                    hrp = hrp,
                    remaining = dist,
                    cfg = cfg,
                    isDirectional = cfg.isDirectional == true,
                    expiresAt =
                        os.clock()
                        + math.max(
                            (cfg.duration or 0.5) * 4 + 1,
                            2
                        )
                }

                if dash.isDirectional and directionName then
                    dash.offset =
                        DirectionOffsets[directionName]
                        or Vector3.new(0, 0, 1)
                end

                if cfg.isUnlimited then
                    dash.remaining = math.huge
                    dash.speed = cfg.speed or 150
                    dash.expiresAt = os.clock() + 15

                    if track then
                        local stoppedConn

                        stoppedConn = track.Stopped:Connect(function()
                            dash.cancelled = true

                            if stoppedConn then
                                stoppedConn:Disconnect()
                                stoppedConn = nil
                            end
                        end)
                    end
                else
                    local duration =
                        math.max(
                            cfg.duration or 0.4,
                            0.05
                        )

                    dash.speed =
                        dist / duration
                end

                table.insert(ActiveDashes, dash)
                startUpdateIfNeeded()
            end)
