                    local object = {
                        Instance = row,
                        Value = value,
                        Name = nameText,
                        ConfigPath = key and tostring(key) or nameText,
                        HasKeybind = false,
                    }

                    function object:SetValue(newValue, silent)
                        newValue = newValue == true
                        local changed = self.Value ~= newValue
                        self.Value = newValue

                        local targetColor =
                            newValue and Theme.Accent or Theme.Control

                        if changed then
                            pcall(function()
                                TweenService:Create(
                                    box,
                                    TweenInfo.new(
                                        0.15,
                                        Enum.EasingStyle.Quad,
                                        Enum.EasingDirection.Out
                                    ),
                                    { BackgroundColor3 = targetColor }
                                ):Play()
                            end)
                        else
                            box.BackgroundColor3 = targetColor
                        end

                        if type(Library.OnControlVisualChanged) == "function" then
                            pcall(Library.OnControlVisualChanged, self, "toggle")
                        end

                        if not silent then
                            Library._ToggleCallbackDepth =
                                (Library._ToggleCallbackDepth or 0) + 1

                            pcall(callback, newValue)

                            Library._ToggleCallbackDepth =
                                math.max(
                                    (Library._ToggleCallbackDepth or 1) - 1,
                                    0
                                )

                            -- V19.1 captured the ORIGINAL global EvoHub notification
                            -- using Ball Metavision as the reference. Apply the same
                            -- center toast to every feature toggle.
                            if changed and Library.NotificationsEnabled ~= false then
                                local displayName = nameText
                                if displayName == "Enable"
                                    and type(section.Name) == "string"
                                    and section.Name ~= "" then
                                    displayName = section.Name
                                end

                                Library:CreateNotification({
                                    Content = displayName
                                        .. (newValue and " Enabled" or " Disabled"),
                                    Duration = 3,
                                })
                            end
                        end
                    end

                    function object:GetValue()
                        return self.Value
                    end

                    button.Activated:Connect(function()
                        object:SetValue(not object.Value)
                    end)

                    addControlRecord(self, row, nameText)
                    return registerControl(key, object)
                end

                function section:CreateSlider(controlSettings, key)
                    controlSettings = type(controlSettings) == "table" and controlSettings or {}
                    local nameText = tostring(controlSettings.Name or "Slider")
                    local callback = type(controlSettings.Callback) == "function" and controlSettings.Callback or function() end
                    local range = type(controlSettings.Range) == "table" and controlSettings.Range or {0, 100}
                    local minimum = tonumber(range[1]) or 0
                    local maximum = tonumber(range[2]) or 100
                    if maximum <= minimum then maximum = minimum + 1 end
                    local increment = tonumber(controlSettings.Increment) or 1
                    local value = math.clamp(tonumber(controlSettings.CurrentValue) or minimum, minimum, maximum)

                    local row = rowBase(self, 48)
                    makeControlText(row, nameText, UDim2.new(0.6, 0, 0, 16), nil, Enum.Font.SourceSans, 14)

                    local valueLabel = makeControlText(
                        row,
                        formatNumber(value, increment),
                        UDim2.fromOffset(50, 16),
                        UDim2.new(1, -50, 0, 0),
                        Enum.Font.SourceSans,
                        13,
                        Enum.TextXAlignment.Right
                    )
                    valueLabel.TextColor3 = Theme.Muted

                    local trackFrame = create("Frame", {
                        Name = "Frame",
                        Position = UDim2.new(0, 0, 1, -16),
                        Size = UDim2.new(1, 0, 0, 12),
                        BackgroundColor3 = Theme.Slider,
                        BorderSizePixel = 0,
                        ZIndex = 6,
                    }, row)
                    create("UICorner", { CornerRadius = UDim.new(1, 0) }, trackFrame)

                    local fill = create("Frame", {
                        Name = "Frame",
                        Size = UDim2.fromScale((value - minimum) / (maximum - minimum), 1),
                        BackgroundColor3 = Theme.Accent,
                        BorderSizePixel = 0,
                        ZIndex = 7,
                    }, trackFrame)
                    create("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
                    setAccent(fill)

                    local dragButton = create("TextButton", {
                        Name = "TextButton",
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.fromScale(0.5, 0.5),
                        Size = UDim2.new(1, 24, 0, 44),
                        BackgroundTransparency = 1,
                        Text = "",
                        AutoButtonColor = false,
                        ZIndex = 8,
                    }, trackFrame)

                    local object = {
                        Instance = row,
                        Value = value,
                    }

                    local function quantize(raw)
                        local snapped = math.floor(((raw - minimum) / increment) + 0.5) * increment + minimum
                        return math.clamp(snapped, minimum, maximum)
                    end

                    function object:SetValue(newValue, silent)
                        newValue = quantize(tonumber(newValue) or minimum)
                        self.Value = newValue
                        valueLabel.Text = formatNumber(newValue, increment)
                        fill.Size = UDim2.fromScale((newValue - minimum) / (maximum - minimum), 1)
                        if not silent then pcall(callback, newValue) end
                    end

                    function object:GetValue()
                        return self.Value
                    end

                    local draggingSlider = false
                    local sliderTouchStart = nil
                    local sliderTouchMode = nil

                    local function updateFromX(x)
                        local width = trackFrame.AbsoluteSize.X
                        if width <= 0 then return end
                        local alpha = math.clamp((x - trackFrame.AbsolutePosition.X) / width, 0, 1)
                        object:SetValue(minimum + (maximum - minimum) * alpha)
                    end

                    dragButton.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            draggingSlider = true
                            sliderTouchMode = "slider"
                            updateFromX(input.Position.X)
                        elseif input.UserInputType == Enum.UserInputType.Touch then
                            draggingSlider = true
                            sliderTouchStart = input.Position
                            sliderTouchMode = nil
                        end
                    end)

                    dragButton.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            draggingSlider = false
                            sliderTouchMode = nil
                        elseif input.UserInputType == Enum.UserInputType.Touch then
                            if draggingSlider and sliderTouchMode == nil then
                                updateFromX(input.Position.X)
                            end
                            draggingSlider = false
                            sliderTouchStart = nil
                            sliderTouchMode = nil
                        end
                    end)

                    UIS.InputChanged:Connect(function(input)
                        if not draggingSlider then return end

                        if input.UserInputType == Enum.UserInputType.MouseMovement
                            and sliderTouchMode == "slider" then
                            updateFromX(input.Position.X)

                        elseif input.UserInputType == Enum.UserInputType.Touch
                            and sliderTouchStart then

                            local delta = input.Position - sliderTouchStart

                            if sliderTouchMode == nil and delta.Magnitude >= 7 then
                                if math.abs(delta.X) > math.abs(delta.Y) * 1.10 then
                                    sliderTouchMode = "slider"
                                else
                                    sliderTouchMode = "scroll"
                                end
                            end

                            if sliderTouchMode == "slider" then
                                updateFromX(input.Position.X)
                            end
                        end
                    end)

                    addControlRecord(self, row, nameText)
                    return registerControl(key, object)
                end

                function section:CreateInput(controlSettings, key)
                    controlSettings = type(controlSettings) == "table" and controlSettings or {}
                    local nameText = tostring(controlSettings.Name or "Input")
