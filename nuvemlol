        -- ========================================================
        -- GENERIC EVOHUB ANIMATION AIMBOT ENGINE
        -- ========================================================
        local function newAimbot(section, groupName, sectionName, cfg)
            local state = {
                enabled = false,
                aiming = false,
                currentTarget = nil,
                animator = nil,
                velocity = Vector3.zero,
                oldPos = nil,
                usePrediction = true,
                prediction = 0.5,
                smoothness = 0.5,
                aimConn = nil,
                monitorConn = nil,
                charConn = nil,
            }

            local function getClosestEnemy()
                local char = LocalPlayerN.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local myTeam = stateTeamN(LocalPlayerN)
                if not root or not myTeam or myTeam == "lobby" then return nil end

                local closest, closestDistance = nil, cfg.maxDistance or 1000

                for _, player in ipairs(PlayersN:GetPlayers()) do
                    if player ~= LocalPlayerN and aliveN(player) then
                        local team = stateTeamN(player)
                        if team and team ~= "lobby" and team ~= myTeam then
                            if not cfg.requireBall or hasBallN(player) then
                                local targetRoot = player.Character
                                    and player.Character:FindFirstChild("HumanoidRootPart")
                                if targetRoot then
                                    local dist = (targetRoot.Position - root.Position).Magnitude
                                    if dist < closestDistance then
                                        closest = player
                                        closestDistance = dist
                                    end
                                end
                            end
                        end
                    end
                end

                return closest
            end

            local function stopAim()
                state.aiming = false
                state.currentTarget = nil
                state.velocity = Vector3.zero
                state.oldPos = nil
                if state.aimConn then
                    state.aimConn:Disconnect()
                    state.aimConn = nil
                end
            end

            local function aimTick(dt)
                if not state.aiming then
                    stopAim()
                    return
                end

                local target = state.currentTarget
                if not target or not target.Character
                    or (cfg.requireBall and not hasBallN(target)) then
                    target = getClosestEnemy()
                    state.currentTarget = target
                    state.oldPos = nil
                    state.velocity = Vector3.zero
                end

                local targetRoot = target and target.Character
                    and target.Character:FindFirstChild("HumanoidRootPart")
                local camera = WorkspaceN.CurrentCamera

                if not targetRoot or not camera then return end

                if state.oldPos and dt > 0 then
                    local delta = targetRoot.Position - state.oldPos
                    local measured = Vector3.new(
                        delta.X / dt,
                        (delta.Y / dt) * 0.94,
                        delta.Z / dt
                    )
                    state.velocity = state.velocity:Lerp(measured, 0.4)
                end
                state.oldPos = targetRoot.Position

                local pos = targetRoot.Position
                if cfg.hasPrediction and state.usePrediction then
                    pos += state.velocity * state.prediction
                end

                local desired = CFrame.new(camera.CFrame.Position, pos)
                if cfg.hasPrediction then
                    camera.CFrame = camera.CFrame:Lerp(desired, state.smoothness)
                else
                    camera.CFrame = desired
                end
            end

            local function startAim()
                if state.aiming then return end
                state.aiming = true
                state.currentTarget = getClosestEnemy()
                state.velocity = Vector3.zero
                state.oldPos = nil

                if state.aimConn then state.aimConn:Disconnect() end
                state.aimConn = RunServiceN.RenderStepped:Connect(aimTick)
            end

            local function animationPlaying()
                if not state.animator then return false end
                for _, track in ipairs(state.animator:GetPlayingAnimationTracks()) do
                    local id = track.Animation and tostring(track.Animation.AnimationId) or ""
                    if id:find(tostring(cfg.animId), 1, true)
                        and track.TimePosition >= (cfg.delay or 0) then
                        return true
                    end
                end
                return false
            end

            local function monitor()
                if not state.enabled or not styleAllowedN(cfg.styles or cfg.style)
                    or not state.animator then
                    if state.aiming then stopAim() end
                    return
                end

                local playing = animationPlaying()
                if playing and not state.aiming then
                    startAim()
                elseif not playing and state.aiming then
                    stopAim()
                end
            end

            local function setupCharacter(char)
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then return end
                state.animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5)

                if state.monitorConn then state.monitorConn:Disconnect() end
                state.monitorConn = RunServiceN.Heartbeat:Connect(monitor)
            end

            local function start()
                if state.enabled then return end
                state.enabled = true
                if LocalPlayerN.Character then setupCharacter(LocalPlayerN.Character) end

                if state.charConn then state.charConn:Disconnect() end
                state.charConn = LocalPlayerN.CharacterAdded:Connect(function(char)
                    task.wait(1)
                    if state.enabled then setupCharacter(char) end
                end)

                notifyN(cfg.name .. " Enabled")
            end

            local function stop()
                state.enabled = false
                stopAim()
                state.animator = nil

                if state.monitorConn then
                    state.monitorConn:Disconnect()
                    state.monitorConn = nil
                end
                if state.charConn then
                    state.charConn:Disconnect()
                    state.charConn = nil
                end

                notifyN(cfg.name .. " Disabled")
            end

            local path = "Player_" .. groupName .. "_" .. sectionName .. "_" .. cfg.name
            local toggle, initial = addToggleN(
                section, path, cfg.name, false,
                function(v)
                    if v then start() else stop() end
                end
