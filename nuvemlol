    safeWaitForChild(
        bootstrapReplicatedStorage,
        "BytenetStorage",
        8
    )

local networkingObject =
    safeWaitForChild(
        bytenetStorage,
        "Networking",
        8
    )

local networkingValue =
    networkingObject
    and networkingObject:IsA("StringValue")
    and networkingObject.Value
    or ""

if networkingValue == "" then
    warn("[EVORE22.3] Networking map unavailable; using packet fallbacks.")
end

local function byteNetPacketId(name, fallback)
    local found =
        networkingValue:match(
            '"' .. tostring(name) .. '"%s*:%s*(%d+)'
        )

    local id = tonumber(found) or tonumber(fallback) or 0
    return math.clamp(math.floor(id), 0, 255)
end

local function byteNetPacketString(name, fallback, trailingOne)
    local value = string.char(byteNetPacketId(name, fallback))

    if trailingOne then
        value ..= "\1"
    end

    return value
end

