        local function notifyN(text)
            pcall(function()
                EvoNotify("evo hub // re", tostring(text or ""), 2)
            end)
        end

        local function getStyleN()
            local style = LocalPlayerN:GetAttribute("style")
            if style == nil and LocalPlayerN.Character then
                style = LocalPlayerN.Character:GetAttribute("style")
            end
            return tostring(style or ""):lower()
        end

        local function realCharacterN()
            local chars = WorkspaceN:FindFirstChild("characters")
            return (chars and chars:FindFirstChild(LocalPlayerN.Name))
