        or plr.Character
end

local function testHasBall(plr)
    local char = testWorldCharacter(plr)
    return char and char:FindFirstChild("Ball") ~= nil
end

local function testRoot(plr)
    local char = testWorldCharacter(plr)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root and plr.Character then
        root = plr.Character:FindFirstChild("HumanoidRootPart")
    end
    return root
