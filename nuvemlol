    local function trapTiming(ball, root)
        local velocity = velocityOf(ball)

        if velocity.Magnitude < 1.25 then
            return nil
        end

        local rootVelocity = root.AssemblyLinearVelocity
        local catchOffset = Vector3.new(0, 2.25, 0)
        local catchPosition = root.Position + catchOffset

        local relative = ball.Position - catchPosition
        local relativeVelocity = velocity - rootVelocity
        local relativeSpeedSq = relativeVelocity:Dot(relativeVelocity)

        local ping = oneWayPing()
        local networkLead = ping + (1 / 120)
        local fast = releaseIsFast()

        local closestTime = networkLead

        if relativeSpeedSq > 0.001 then
            closestTime = math.max(
                networkLead,
                -relative:Dot(relativeVelocity) / relativeSpeedSq
            )
        end

        local distance = relative.Magnitude
        local travelEstimate =
            distance / math.max(relativeVelocity.Magnitude, 1)

        local horizon = math.clamp(
            math.max(
                closestTime + (fast and 0.55 or 0.35),
                travelEstimate + (fast and 0.4 or 0.25)
            ),
            fast and 0.65 or 0.45,
            fast and 1.75 or 1.35
        )

        local margin = math.clamp(
            velocity.Magnitude * ping,
            0,
            fast and 5.5 or 4.25
        )

        local gravity = WorkspaceService.Gravity
        local samples = fast and 14 or 10
        local enterTime = nil

        for index = 0, samples do
            local t =
                networkLead
                + (horizon - networkLead)
                * (index / samples)

            local ballPosition =
                ball.Position
                + velocity * t
                + Vector3.new(
                    0,
                    -0.5 * gravity * t * t,
                    0
                )

            local rootBase =
                root.Position + rootVelocity * t

            local targetPosition =
                rootBase + catchOffset

            local futureDistance =
                (ballPosition - targetPosition).Magnitude

            local futureHeight =
                ballPosition.Y - rootBase.Y

            if futureDistance <= state.range + margin
                and futureHeight >= 0.9 then

                enterTime = t
                break
            end
        end

        if not enterTime then
            return nil
        end

        local approaching =
            relative:Dot(relativeVelocity) < 0
            or distance <= state.range

        if not approaching then
            return nil
        end

        local speedBonus = math.clamp(
            velocity.Magnitude / (fast and 240 or 300),
            0,
            fast and 0.26 or 0.18
        )

        local activationLead

        if fast then
            activationLead = math.clamp(
                0.8 + ping * 1.7 + speedBonus,
                0.8,
                1.08
            )
        else
            activationLead = math.clamp(
                0.62 + ping * 1.5 + speedBonus,
                0.62,
                0.88
            )
        end

        local jumpLead = math.clamp(
            activationLead + 0.16,
            fast and 0.96 or 0.78,
            fast and 1.22 or 1.04
        )

        return {
            enterTime = enterTime,
            activationLead = activationLead,
            jumpLead = jumpLead
        }
    end

