        end

        local function anyCounter()
            for key in pairs(state.autoSkills) do
                if state[key] then return true end
            end
            return false
        end

        local function closestTeammate()
            local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return nil end

            local mine = teamKey(lp)
            if not mine then return nil end

            local best, bestSq = nil, math.huge

            for _, plr in ipairs(P:GetPlayers()) do
                if plr ~= lp and teamKey(plr) == mine and plr.Character then
                    local root = plr.Character:FindFirstChild("HumanoidRootPart")

                    if root then
                        local d = root.Position - myRoot.Position
                        local sq = d:Dot(d)

                        if sq < bestSq then
                            bestSq = sq
                            best = plr
                        end
                    end
                end
            end

            return best
        end

        local function activeSkills()
            local skills = {}

            for key, skillName in pairs(state.autoSkills) do
                if state[key] then
                    skills[#skills + 1] = skillName
                end
            end

            return skills
        end

        local function counterOnCooldown()
            local bar = hotbar()
            if not bar then return false end

            for _, skillName in ipairs(activeSkills()) do
                if skillName:match("^skill%d+$") then
                    local slot = bar:FindFirstChild(skillName)
                    local cooldown = slot and slot:FindFirstChild("Cooldown", true)

                    if cooldown
                        and cooldown:IsA("GuiObject")
                        and cooldown.Visible then
                        return true
                    end
                end
            end

            return false
        end

        local function fireCounters(allowRecent)
            local t = clock()
            local okPossession, recentOnly = possessionOK(t)

            if not okPossession then return false end
            if recentOnly and not allowRecent then return false end
            if not anyCounter() then return false end

            local teammate = state.useClosestTeammate and closestTeammate() or nil
            local fired = false

            for key, skillName in pairs(state.autoSkills) do
                if state[key] then
                    local ok

                    if state.useClosestTeammate
                        and teammate
                        and teammate.Character then

                        ok = pcall(function()
                            remote:FireServer(
                                packet,
                                {{skillName, teammate.Character}}
                            )
                        end)
                    else
                        ok = pcall(function()
                            remote:FireServer(
                                packet,
                                {{skillName}}
                            )
                        end)
                    end

                    fired = ok or fired
                end
            end

            return fired
        end

        local function pingLead()
            local ok, ping = pcall(function()
                return lp:GetNetworkPing()
            end)

            if not ok or type(ping) ~= "number" then
                ping = 0.06
            end

            -- Small lead only. It helps close-range latency without firing
            -- while the attacker is still far away.
            return math.clamp(0.020 + ping * 0.35, 0.025, 0.065)
        end

        local function flat(v)
            return Vector3.new(v.X, 0, v.Z)
        end

        local function segmentDistanceSq(a, b)
            local segment = b - a
            local lenSq = segment:Dot(segment)

            if lenSq <= 0.000001 then
                return a:Dot(a)
            end

            local alpha = math.clamp((-a):Dot(segment) / lenSq, 0, 1)
            local closest = a + segment * alpha
            return closest:Dot(closest)
        end

        local function removeThreat(plr, reason)
            local threat = state.threats[plr]

            if threat then
                log("END", threat.name .. " | " .. tostring(reason))
                state.threats[plr] = nil
            end
        end

        local function fireThreat(threat, reason, distance)
            if not threat or threat.fired then return end

            local t = clock()
            local possession, recentOnly = possessionOK(t)
            if not possession then return end

            threat.fired = true

            log(
                "COUNTER",
                string.format(
                    "%s | %s | %.2f studs",
                    threat.name,
                    reason,
                    distance
                )
            )

            fireCounters(recentOnly)

            -- Two tiny retries only for packet/replication races.
            for _, delayTime in ipairs({0.016, 0.038}) do
                task.delay(delayTime, function()
                    if state.destroyed or counterOnCooldown() then return end
                    if not isEnemy(threat.player) then return end

                    local stillOwned, recent = possessionOK(clock())
                    if not stillOwned then return end

                    fireCounters(recent)
                end)
            end
        end

        local function evaluateThreat(threat, t)
            if not threat or threat.fired then return end

            if t > threat.expires then
                removeThreat(threat.player, "expired")
                return
            end

            if not isEnemy(threat.player) then
                removeThreat(threat.player, "not enemy")
                return
            end

            if threat.track
                and not threat.track.IsPlaying
                and t - threat.started > 0.08 then

                removeThreat(threat.player, "animation stopped")
                return
            end

            if not anyCounter() then return end

            local myRoot, enemyRoot = roots(threat.player)
            if not myRoot or not enemyRoot then return end

            local yGap = math.abs(enemyRoot.Position.Y - myRoot.Position.Y)
            if yGap > state.verticalRange then return end

            local relative = flat(enemyRoot.Position - myRoot.Position)
            local distSq = relative:Dot(relative)
            local distance = math.sqrt(math.max(distSq, 0))

            local previous = threat.previous
            threat.previous = relative

            local radius = state.range + threat.extra
            local radiusSq = radius * radius

            -- 1) Actual current overlap.
            if distSq <= radiusSq then
                fireThreat(threat, "range", distance)
                return
            end

            -- 2) Fast dash crossed the range between two frames.
            if previous and segmentDistanceSq(previous, relative) <= radiusSq then
                fireThreat(threat, "crossed range", distance)
                return
            end

            -- 3) Very small ping compensation. Never predicts from far away.
            local maxPredictDistance = radius + 2.25
            if distance > maxPredictDistance then
                return
            end

            local relVelocity =
                flat(enemyRoot.AssemblyLinearVelocity)
                - flat(myRoot.AssemblyLinearVelocity)

            local speedSq = relVelocity:Dot(relVelocity)
            if speedSq <= 0.01 then return end

            local timeClosest =
                math.clamp(
                    -relative:Dot(relVelocity) / speedSq,
                    0,
                    pingLead()
                )

            if timeClosest <= 0 then return end

            local predicted = relative + relVelocity * timeClosest

            if predicted:Dot(predicted) <= radiusSq then
                fireThreat(threat, "incoming", distance)
            end
        end

        local function startThreat(plr, track, id)
            if not isEnemy(plr) then return end

            local profile = steal[id]
            if not profile then return end

            local t = clock()
            local previousStart = state.recentStart[plr]

            if previousStart and t - previousStart < state.duplicateWindow then
                return
            end

            state.recentStart[plr] = t

            local length = tonumber(track.Length) or 0
            local duration = math.max(length, 0.45)

            local threat = {
                player = plr,
                track = track,
                id = id,
                name = profile.name,
                extra = profile.extra,
                started = t,
                expires = t + math.clamp(duration + 0.15, 0.45, 1.8),
                previous = nil,
                fired = false,
            }

            state.threats[plr] = threat

            local myRoot, enemyRoot = roots(plr)
            if myRoot and enemyRoot then
                threat.previous = flat(enemyRoot.Position - myRoot.Position)
            end

            log("ATTACK", profile.name .. " from " .. plr.Name)

            -- If they start the steal already inside range, react now.
            evaluateThreat(threat, t)
        end

        local function clearRecord(record)
            if not record then return end

            for _, conn in ipairs(record.connections or {}) do
                disconnect(conn)
            end

            record.connections = {}
            record.animators = {}
        end

        local function watchAnimator(animator, plr, record)
            if not animator:IsA("Animator") or record.animators[animator] then
                return
            end

            record.animators[animator] = true

            record.connections[#record.connections + 1] =
                animator.AnimationPlayed:Connect(function(track)
                    if state.destroyed
                        or not track
                        or not track.Animation
                        or not isEnemy(plr) then
                        return
                    end

                    local id =
                        tostring(track.Animation.AnimationId or ""):match("%d+")

                    if id and steal[id] then
                        startThreat(plr, track, id)
                    end
                end)
        end

        local function hookCharacter(plr, char)
            local record = state.playerRecords[plr]

            if not record then
                record = {connections = {}, animators = {}}
                state.playerRecords[plr] = record
            else
                clearRecord(record)
            end

            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("Animator") then
                    watchAnimator(obj, plr, record)
                end
            end

            record.connections[#record.connections + 1] =
                char.DescendantAdded:Connect(function(obj)
                    if obj:IsA("Animator") then
                        watchAnimator(obj, plr, record)
                    end
                end)
        end

        local function setupPlayer(plr)
            if plr == lp then return end

            if plr.Character then
                hookCharacter(plr, plr.Character)
            end

            addConnection(plr.CharacterAdded:Connect(function(char)
                hookCharacter(plr, char)
            end))
        end

        for _, plr in ipairs(P:GetPlayers()) do
            setupPlayer(plr)
        end

        addConnection(P.PlayerAdded:Connect(setupPlayer))

        addConnection(P.PlayerRemoving:Connect(function(plr)
            removeThreat(plr, "left")

            local record = state.playerRecords[plr]
            if record then
                clearRecord(record)
                state.playerRecords[plr] = nil
            end
        end))

        addConnection(RS.PreSimulation:Connect(function()
            if state.destroyed then return end

            local t = clock()

            if hasBall() then
                state.lastHadBallAt = t
            end

            for plr, threat in pairs(state.threats) do
                if threat then
                    evaluateThreat(threat, t)
                else
                    state.threats[plr] = nil
                end
            end
        end))

        local function diagnostics()
            local style, styleSource = currentStyle()
            local key, slot = hotbarCounterKey()
            local active = table.concat(activeSkills(), ",")
            local lines = {
                "========== AUTO COUNTER V4 ==========",
                "style=" .. tostring(style),
                "styleSource=" .. tostring(styleSource),
                "counter=" .. tostring(key and state.autoSkills[key] or "none"),
                "counterSource=" .. tostring(slot),
                "team=" .. tostring(teamKey(lp)),
                "range=" .. tostring(state.range),
                "ping=" .. tostring(math.floor(pingLead() * 1000)) .. "ms lead",
                "hasBall=" .. tostring(hasBall()),
                "active=" .. active,
                "",
                "EVENTS",
            }

            for _, event in ipairs(state.events) do
                lines[#lines + 1] = event
            end

            lines[#lines + 1] = "===================================="
            return table.concat(lines, "\n")
        end

        local function copyDebug()
            local report = diagnostics()

            if type(setclipboard) == "function" then
                pcall(setclipboard, report)
            elseif type(toclipboard) == "function" then
                pcall(toclipboard, report)
            else
                print(report)
            end

            notify("Auto Counter", "Debug copied.", 2)
        end

        local function createToggle(name, key)
            autodrib:Toggle(name, function(value)
                if state.keybindsEnabled then
                    notify("Auto Counter", "Turn keybinds off first.", 2)
                    return
                end

                if type(value) == "boolean" then
                    state[key] = value
                else
                    state[key] = not state[key]
                end

                updateStatus()
            end)
        end

        autodrib:Button("Auto Detect Counter", "", function()
            selectCounter()
            updateStatus()
        end)

        autodrib:Button("Copy Counter Debug", "", function()
            copyDebug()
        end)

        autodrib:Slider("Auto Counter Range", 5, 2, 12, 0.5, function(value)
            state.range = math.clamp(value, 2, 12)
        end)

        autodrib:Toggle("Show Active Auto Counters", function(value)
            state.showActiveCounters =
                type(value) == "boolean" and value
                or not state.showActiveCounters

            updateStatus()
        end)

        autodrib:Toggle("Toggle Keybinds", function(value)
            state.keybindsEnabled =
                type(value) == "boolean" and value
                or not state.keybindsEnabled
        end)

        autodrib:Toggle("Use Closest Teammate", function(value)
            state.useClosestTeammate =
                type(value) == "boolean" and value
                or not state.useClosestTeammate
        end)

        createToggle("Auto Dribble", "toggleDribble")
        createToggle("Auto Counter (Move One)", "toggleCounter1")
        createToggle("Auto Counter (Move Two)", "toggleCounter2")
        createToggle("Auto Counter (Move Three)", "toggleCounter3")
        createToggle("Auto Counter (Move Four)", "toggleCounter4")
        createToggle("Auto Counter (Move Five)", "toggleCounter5")
        createToggle("T Special", "toggleTSpecial")

        addConnection(UIS.InputBegan:Connect(function(input, processed)
            if processed or not state.keybindsEnabled then return end

            local map = {
                [Enum.KeyCode.Z] = "toggleDribble",
                [Enum.KeyCode.X] = "toggleCounter1",
                [Enum.KeyCode.C] = "toggleCounter2",
                [Enum.KeyCode.V] = "toggleCounter3",
                [Enum.KeyCode.N] = "toggleCounter4",
                [Enum.KeyCode.M] = "toggleCounter5",
                [Enum.KeyCode.L] = "toggleTSpecial",
            }

            local key = map[input.KeyCode]
            if key then
                state[key] = not state[key]
                updateStatus()
            end
        end))

        -- Re-detect when the actual Player style changes.
        addConnection(lp.AttributeChanged:Connect(function(name)
            local lower = tostring(name):lower()

            if lower == "style"
                or lower == "character"
                or lower == "class" then

                task.delay(0.20, function()
                    if not state.destroyed then
                        selectCounter()
                        updateStatus()
                    end
                end)
            end
        end))

        addConnection(lp.CharacterAdded:Connect(function()
            state.lastHadBallAt = -math.huge

            task.delay(1.25, function()
                if not state.destroyed then
                    selectCounter()
                    updateStatus()
                end
            end)
        end))

        task.delay(1.5, function()
            if not state.destroyed then
                selectCounter()
                updateStatus()
            end
        end)

        function runtime.getState()
            return {
                version = 4,
                style = state.lastStyle,
                range = state.range,
                team = teamKey(lp),
                activeSkills = activeSkills(),
            }
        end

        function runtime.getDiagnostics()
            return diagnostics()
        end

        function runtime.copyDiagnostics()
            copyDebug()
        end

        function runtime.destroy()
            if state.destroyed then return end
            state.destroyed = true

            for _, conn in ipairs(state.connections) do
                disconnect(conn)
            end

            for _, record in pairs(state.playerRecords) do
                clearRecord(record)
            end

            if statusGui and statusGui.Parent then
                statusGui:Destroy()
            end

            if env.CeleronCounterRuntime == runtime then
                env.CeleronCounterRuntime = nil
            end
        end

        warn("[AutoCounter V4] READY")
        updateStatus()
    end)

    if not bootOK then
        warn("[AutoCounter V4][BOOT] " .. tostring(bootError))
    end
end)

