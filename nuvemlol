        local function newRecoveredDefenseN(section, predictSection, groupName, cfg)
            local state = {
                enabled = false,
                goalboxOnly = false,
                animationPredict = false,
                maxBallDistance = 53,
                maxVerticalDistance = 65,
                minBallSpeed = 100,
                lastDefenseTime = 0,
                lastBallOwnerTeam = nil,
                animationTracking = {},
                animDelays = {},
                conn = nil,
            }

            for _, entry in ipairs(COMMON_DEFENSE_ANIMS_N) do
                state.animDelays[entry.id] = entry.delay
            end

            local function charactersFolder()
                return WorkspaceN:FindFirstChild("characters")
            end

            local function worldBall()
                local terrain = WorkspaceN:FindFirstChildOfClass("Terrain")
                return (terrain and terrain:FindFirstChild("Ball"))
                    or WorkspaceN:FindFirstChild("Ball")
            end

            local function ballVelocity(ball)
                local cfBall = ReplicatedStorageN:FindFirstChild("CFBall")
                local velocity = cfBall and cfBall:FindFirstChild("velocity")
                if velocity and velocity:IsA("Vector3Value") then
                    return velocity.Value
                end
                return ball and ball.AssemblyLinearVelocity or Vector3.zero
            end

            local function currentBallOwnerTeam()
                local characters = charactersFolder()
                if not characters then return nil end

                for _, model in ipairs(characters:GetChildren()) do
                    if model:FindFirstChild("Ball") then
                        local modelState = model:FindFirstChild("state")
                        local team = modelState and (modelState:FindFirstChild("team") or modelState:FindFirstChild("Team"))
                        if team and team:IsA("ValueBase") then
                            return tostring(team.Value)
                        end
                    end
                end
                return nil
            end

            local function inGoalbox(position, team)
                local box = DEFENSE_GOALBOXES_N[tostring(team or "")]
                if not box then return false end
                return position.X >= box.minX and position.X <= box.maxX
                    and position.Z >= box.minZ and position.Z <= box.maxZ
            end

            local function ballMovingToward(ball, velocity, rootPosition)
                if not ball or velocity.Magnitude <= 0.001 then return false end
                local toward = rootPosition - ball.Position
                if toward.Magnitude <= 0.001 then return true end
                return velocity.Unit:Dot(toward.Unit) > math.cos(math.rad(45))
            end

            local function ballWithinLimits(ball, rootPosition)
                if not ball then return false end
                local horizontal = (
                    Vector3.new(rootPosition.X, 0, rootPosition.Z)
                    - Vector3.new(ball.Position.X, 0, ball.Position.Z)
                ).Magnitude
                local vertical = math.abs(rootPosition.Y - ball.Position.Y)
                return horizontal <= state.maxBallDistance
                    and vertical <= state.maxVerticalDistance
            end

            local function cardinalDirection(root, hum)
                local move = root.CFrame:VectorToObjectSpace(hum.MoveDirection)
                local x = math.round(move.X)
                local z = math.round(move.Z)
                if x == 1 then return "Right" end
                if x == -1 then return "Left" end
                if z == 1 then return "Back" end
                return "Front"
            end

            local function fallbackInput()
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.wait(0.02)
                    vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                    task.wait(0.01)
                    vim:SendKeyEvent(true, Enum.KeyCode.Four, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, Enum.KeyCode.Four, false, game)
                end)
            end

            local function performDefense()
                if onCooldownN("skill4") then return false end

                local char = LocalPlayerN.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not hum or not root then return false end

                local payload
                if cfg.justiceHeader then
                    -- Exact special Justice Header behavior recovered from stage1.
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    root.Velocity = root.Velocity + Vector3.new(0, 55, 0)
                    payload = { { "skill4", true, cardinalDirection(root, hum) } }
                else
                    payload = { { "skill4", true } }
                end

                if fireUseN(payload) then
                    return true
                end

                fallbackInput()
                return true
            end

            local function processBall(myTeam, rootPosition)
                local ownerTeam = currentBallOwnerTeam()
                if ownerTeam then
                    state.lastBallOwnerTeam = ownerTeam
                end

                if hasBallN(LocalPlayerN) then return end

                local ball = worldBall()
                if not ball then return end
                local velocity = ballVelocity(ball)
                if velocity.Magnitude < state.minBallSpeed then return end
                if not ballMovingToward(ball, velocity, rootPosition) then return end
                if not ballWithinLimits(ball, rootPosition) then return end

                if not state.lastBallOwnerTeam or not myTeam then return end
                if state.lastBallOwnerTeam == "lobby" or myTeam == "lobby" then return end
                if state.lastBallOwnerTeam == myTeam then return end
                if state.goalboxOnly and not inGoalbox(rootPosition, myTeam) then return end

                if tick() - state.lastDefenseTime > 6 then
                    state.lastDefenseTime = tick()
                    performDefense()
                end
            end

            local function processAnimationPredict(myTeam, rootPosition)
                if not state.animationPredict then return end
                if state.goalboxOnly and not inGoalbox(rootPosition, myTeam) then return end

                local characters = charactersFolder()
                if not characters then return end
                local now = tick()

                for _, model in ipairs(characters:GetChildren()) do
                    if model.Name ~= LocalPlayerN.Name then
                        local modelState = model:FindFirstChild("state")
                        local team = modelState and (modelState:FindFirstChild("team") or modelState:FindFirstChild("Team"))
                        local teamValue = team and tostring(team.Value) or nil

                        if teamValue and teamValue ~= myTeam and teamValue ~= "lobby" then
                            local hum = model:FindFirstChildOfClass("Humanoid")
                            local animator = hum and hum:FindFirstChildOfClass("Animator")
                            if animator then
                                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                    local id = track.Animation and tostring(track.Animation.AnimationId) or nil
                                    local delayValue = id and state.animDelays[id]
                                    if id and track.IsPlaying and delayValue ~= nil then
                                        local key = model.Name .. "_" .. id
                                        local record = state.animationTracking[key]
                                        if not record then
                                            record = {
                                                detectedTime = now,
                                                hasTriggered = false,
                                                delay = delayValue,
                                            }
                                            state.animationTracking[key] = record
                                        end

                                        if not record.hasTriggered
                                            and now - record.detectedTime >= record.delay
                                            and now - state.lastDefenseTime > 6 then
                                            state.lastDefenseTime = now
                                            performDefense()
                                            record.hasTriggered = true
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                end

                for key, record in pairs(state.animationTracking) do
                    if now - record.detectedTime > 5 then
                        state.animationTracking[key] = nil
                    end
                end
            end

            local function heartbeat()
                if not state.enabled or getStyleN() ~= cfg.style then return end
                local char = LocalPlayerN.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local myTeam = stateTeamN(LocalPlayerN)
                if not myTeam or myTeam == "lobby" then return end

                processBall(myTeam, root.Position)
                processAnimationPredict(myTeam, root.Position)
            end

            local function start()
                if state.enabled then return end
                state.enabled = true
                if state.conn then state.conn:Disconnect() end
                state.conn = RunServiceN.Heartbeat:Connect(heartbeat)
                notifyN(cfg.name .. " Enabled")
            end

            local function stop()
                state.enabled = false
                if state.conn then
                    state.conn:Disconnect()
                    state.conn = nil
                end
                state.animationTracking = {}
                state.lastDefenseTime = 0
                notifyN(cfg.name .. " Disabled")
            end

            local prefix = "Player_" .. groupName .. "_" .. cfg.name .. "_"
            local toggle, initial = addToggleN(
                section,
                prefix .. cfg.name,
                cfg.name,
                false,
                function(v)
                    if v then start() else stop() end
                end
            )

            local _, initialGoalbox = addToggleN(
                section,
                prefix .. "Goalbox Only",
                "Goalbox Only",
                false,
                function(v) state.goalboxOnly = v end
            )
            state.goalboxOnly = initialGoalbox

            local _, initialPredict = addToggleN(
                section,
                prefix .. "Animation Predict",
                "Animation Predict",
                false,
                function(v) state.animationPredict = v end
            )
            state.animationPredict = initialPredict

            local _, initialSpeed = addSliderN(
                section,
                prefix .. "Min Ball Speed",
                "Min Ball Speed",
                0.1, 100, 100, 0.1,
                function(v) state.minBallSpeed = v end
            )
            state.minBallSpeed = initialSpeed

            local _, initialDist = addSliderN(
                section,
                prefix .. "Max Ball Distance",
                "Max Ball Distance",
                10, 200, 53, 1,
                function(v) state.maxBallDistance = v end
            )
            state.maxBallDistance = initialDist

            local _, initialVert = addSliderN(
                section,
                prefix .. "Max Vertical Distance",
                "Max Vertical Distance",
                10, 200, 65, 1,
                function(v) state.maxVerticalDistance = v end
            )
            state.maxVerticalDistance = initialVert

            local predictPrefix = "Player_" .. groupName .. "_Animation Predict_"
            for _, entry in ipairs(COMMON_DEFENSE_ANIMS_N) do
                local _, initialDelay = addSliderN(
                    predictSection,
                    predictPrefix .. entry.name,
                    entry.name,
                    0, 1.5, entry.delay, 0.01,
                    function(v) state.animDelays[entry.id] = v end
                )
                state.animDelays[entry.id] = initialDelay
            end

            addKeybindN(
                section,
                prefix .. cfg.name .. " Keybind",
                cfg.name,
                cfg.defaultKey,
                "Toggle",
                function(active)
                    if getStyleN() ~= cfg.style then return end
                    if toggle and toggle.SetValue and toggle.Value ~= active then
                        toggle:SetValue(active == true)
                    end
                end
            )

            if initial then start() end
            return state
        end

