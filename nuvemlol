        local function rebuildSidebar(tab)
            clearSidebar()
            for _, groupName in ipairs(tab.Groups) do
                addSidebarEntry(tab, groupName)
            end

            local target = tab.SelectedGroup
                or (tab.DefaultGroup and tab.GroupSet[tab.DefaultGroup] and tab.DefaultGroup)
                or tab.Groups[1]
            if target then
                applyGroup(tab, target)
            end
        end

        local function selectTab(tab)
            selectedTab = tab

            for _, other in ipairs(window.Tabs) do
                local selected = other == tab
                if selected then
                    other.TabLine.Visible = true
                end

                pcall(function()
                    TweenService:Create(
                        other.TabLine,
                        TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                        { Size = selected and UDim2.new(1, 0, 0, 2) or UDim2.new(0, 0, 0, 2) }
                    ):Play()
                    TweenService:Create(
                        other.TabButton,
                        TweenInfo.new(0.15),
                        { TextColor3 = selected and Theme.Text or Theme.Muted }
                    ):Play()
                end)

                if not selected then
                    task.delay(0.16, function()
                        if selectedTab ~= other and other.TabLine.Parent then
                            other.TabLine.Visible = false
                        end
                    end)
                end
            end

            contentScroll.Visible = true
            contentScroll.CanvasPosition = Vector2.new(0, 0)
            rebuildSidebar(tab)
            searchBox.Text = ""
            searchResults.Visible = false
            searchResults.Size = UDim2.new(1, 0, 0, 0)
            playContentFade()
