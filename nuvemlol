            FrontRight = Vector3.new(1, 0, 1).Unit,
            LeftBack = Vector3.new(-1, 0, -1).Unit,
            RightBack = Vector3.new(1, 0, -1).Unit,
        }

        local function updateDashes(dt)
            local safeDt = math.min(dt, 1 / 30)

            for i = #ActiveDashes, 1, -1 do
                local dash = ActiveDashes[i]
                local hrp = dash.hrp

                if not hrp or not hrp.Parent or dash.cancelled then
                    table.remove(ActiveDashes, i)
                    continue
                end

                if dash.expiresAt and os.clock() >= dash.expiresAt then
                    table.remove(ActiveDashes, i)
                    continue
                end

                if dash.stopOnBall then
                    local char = hrp.Parent
                    local caught = char and char:FindFirstChild("Ball") ~= nil

                    if not caught then
                        local terrain = workspace:FindFirstChild("Terrain")
                        local ball = terrain and terrain:FindFirstChild("Ball")

                        if ball and ball:IsA("BasePart") then
                            caught = (ball.Position - hrp.Position).Magnitude <= 3.6
                        end
                    end

                    if caught then
                        table.remove(ActiveDashes, i)
                        continue
                    end
                end

                if dash.scaleNaturalMotion then
                    local currentPos = hrp.Position
                    local rawDelta = Vector3.new(
                        currentPos.X - dash.lastPosition.X,
                        0,
                        currentPos.Z - dash.lastPosition.Z
                    )

                    local rawMag = rawDelta.Magnitude

                    if rawMag > 0.001 then
                        if rawMag > 8 then
                            rawDelta = rawDelta.Unit * 8
                            rawMag = 8
                        end

                        local extra = rawDelta * dash.multiplier
                        local extraCap = math.min(
                            3,
                            math.max(1.25, rawMag * 1.5)
                        )

                        if extra.Magnitude > extraCap then
                            extra = extra.Unit * extraCap
                        end

                        if extra.Magnitude > 0.001 then
                            hrp.CFrame = hrp.CFrame + extra
                        end
                    end

                    dash.lastPosition = hrp.Position
                    continue
                end

                local step

                if dash.cfg.isUnlimited then
                    step = dash.speed * safeDt
                else
                    step = math.min(
                        dash.speed * safeDt,
                        dash.remaining
                    )
                end

                local moveDir

                if dash.moveDir then
                    moveDir = dash.moveDir
                elseif dash.isDirectional then
                    local baseLook = hrp.CFrame.LookVector
                    local right = baseLook:Cross(Vector3.new(0, 1, 0))
                    local offset = dash.offset
                    local rawDir =
                        right * -offset.X
                        + baseLook * offset.Z

                    local flatDir =
                        Vector3.new(
                            rawDir.X,
                            0,
                            rawDir.Z
                        )

                    moveDir =
                        flatDir.Magnitude > 0.01
                        and flatDir.Unit
                        or DEFAULT_DIR
                else
                    local look = hrp.CFrame.LookVector
                    local flatLook =
                        Vector3.new(
                            look.X,
                            0,
                            look.Z
                        )

                    moveDir =
                        flatLook.Magnitude > 0.01
                        and flatLook.Unit
                        or DEFAULT_DIR
                end

                local newPos =
                    hrp.Position
                    + moveDir * step

                if dash.preserveRotation then
                    hrp.CFrame =
                        hrp.CFrame
                        + moveDir * step
                else
                    hrp.CFrame =
                        CFrame.new(
                            newPos.X,
                            hrp.Position.Y,
                            newPos.Z
                        )
                        * CFrame.new(
                            ZERO,
                            moveDir
                        )
                end

                if not dash.cfg.isUnlimited then
                    dash.remaining -= step

                    if dash.remaining <= 0.001 then
                        table.remove(ActiveDashes, i)
                    end
                end
            end

            if #ActiveDashes == 0 and renderConn then
                renderConn:Disconnect()
                renderConn = nil
            end
        end

