        local function newInstantSkill(section, groupName, cfg)
            local state = {
                enabled = false,
                executing = false,
                wasFlow100 = false,
                ready = false,
                animUsed = false,
                track = nil,
                heartbeat = nil,
                charConn = nil,
            }

            local styles = cfg.styles or cfg.style
            local requireBall = cfg.requireBall ~= false
            local requireFlowDrop = cfg.requireFlowDrop ~= false
            local requireLastAwaken = cfg.requireLastAwaken == true
            local blockOnce = cfg.blockOnce ~= false
            local blockAnimIds = cfg.blockAnimIds or {}

            local function reset()
                state.wasFlow100 = false
                state.ready = false
                state.animUsed = false
                state.executing = false
            end

            local function stopAnim()
                if state.track then
                    pcall(function() state.track:Stop() end)
                    state.track = nil
                end
            end

            local function playAnim()
                stopAnim()
                if cfg.playAnimId then
                    state.track = makeTrackN(cfg.playAnimId)
                    if state.track then pcall(function() state.track:Play() end) end
                end
            end

            local function hasBlockedAnimation()
                local char = LocalPlayerN.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local animator = hum and hum:FindFirstChildOfClass("Animator")
                if not animator then return false end

                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    local id = track.Animation and tostring(track.Animation.AnimationId) or ""
                    for _, blockId in ipairs(blockAnimIds) do
                        if id:find(tostring(blockId), 1, true) then
                            return true
                        end
                    end
                end
                return false
            end

            local function nearestCheck(radius, enemiesOnly)
                if not radius then return true end

                local char = LocalPlayerN.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return false end
                local myTeam = stateTeamN(LocalPlayerN)

                for _, player in ipairs(PlayersN:GetPlayers()) do
                    if player ~= LocalPlayerN and aliveN(player) then
                        local team = stateTeamN(player)
                        if team ~= "lobby" and (not enemiesOnly or team ~= myTeam) then
                            local otherRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                            if otherRoot and (otherRoot.Position - root.Position).Magnitude <= radius then
                                return true
                            end
                        end
                    end
                end
                return false
            end

            local function tickState()
                if not state.enabled then return end

                if requireLastAwaken and not lastAwakenIsMeN() then
                    reset()
                    return
                end

                local flow = getFlowN()

                if flow >= 100 then
                    state.wasFlow100 = true
                    state.ready = false
                    state.animUsed = false
                elseif state.wasFlow100 and flow < 100 then
                    state.ready = true
                else
                    state.ready = false
                end

                if flow <= 0 then
                    reset()
                elseif hasBlockedAnimation() then
                    state.animUsed = true
                end
            end

            local function execute()
                if state.executing or not state.enabled then return false end
                if not styleAllowedN(styles) then return false end
                if requireBall and not hasBallN() then return false end

                if cfg.toolSlot and cfg.toolText
                    and not toolTextMatchesN(cfg.toolSlot, cfg.toolText) then
                    return false
                end

                if cfg.enemyRadius and not nearestCheck(cfg.enemyRadius, true) then
                    return false
                end

                if cfg.playerRadius and not nearestCheck(cfg.playerRadius, false) then
                    return false
                end

                if requireLastAwaken and not lastAwakenIsMeN() then
                    return false
                end

                if requireFlowDrop and (not state.ready or (blockOnce and state.animUsed)) then
                    return false
                end

                if onCooldownN(cfg.skillName) then
                    return false
                end

                state.executing = true
                state.animUsed = true

                playAnim()
                task.wait(cfg.delay or 0.1)

                if cfg.kickPower then
                    local vector = cfg.kickVector or Vector3.new(0, 1, 0)

                    if cfg.kickFromLook then
                        local char = LocalPlayerN.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if not root then
                            state.executing = false
                            return false
                        end
                        vector = root.CFrame.LookVector + Vector3.new(0, 1, 0) * 50
                    end

                    fireKickN(cfg.kickPower, vector)
                end

                fireSkillN(cfg.skillName)
                notifyN(cfg.name .. " Executed")
                state.executing = false
                return true
            end

            local function start()
                if state.enabled then return end
                state.enabled = true
                reset()

                if state.heartbeat then state.heartbeat:Disconnect() end
                state.heartbeat = RunServiceN.Heartbeat:Connect(tickState)

                if state.charConn then state.charConn:Disconnect() end
                state.charConn = LocalPlayerN.CharacterAdded:Connect(function()
                    task.wait(1)
                    reset()
                end)

                notifyN(cfg.name .. " Enabled")
            end

            local function stop()
                state.enabled = false
                stopAnim()
                reset()

                if state.heartbeat then
                    state.heartbeat:Disconnect()
                    state.heartbeat = nil
                end
                if state.charConn then
                    state.charConn:Disconnect()
                    state.charConn = nil
                end

                notifyN(cfg.name .. " Disabled")
            end

            local path = "Player_" .. groupName .. "_Instant Skills_" .. cfg.name
            local toggle, initial = addToggleN(
                section, path, cfg.name, false,
                function(v)
                    if v then start() else stop() end
                end
            )

            addKeybindN(
                section,
                path .. " Keybind",
                cfg.name .. " Keybind",
                cfg.key or Enum.KeyCode.V,
                "Hold",
                function(pressed)
                    if pressed then execute() end
                end
            )

            if initial then start() end
            return state
        end

