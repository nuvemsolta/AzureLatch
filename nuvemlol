local teamHighlightState = {
    active = false,
    folder = nil,
    connections = {},
    playerConnections = {}
}

local function teamHighlightNotify(text)
    EvoNotify("Team Highlighting", text, 2)
end

local function disconnectTeamHighlightConnections()
    for i = #teamHighlightState.connections, 1, -1 do
        local connection = teamHighlightState.connections[i]
        if connection then connection:Disconnect() end
        teamHighlightState.connections[i] = nil
    end

    for player, list in pairs(teamHighlightState.playerConnections) do
        for i = #list, 1, -1 do
            local connection = list[i]
            if connection then connection:Disconnect() end
        end
        teamHighlightState.playerConnections[player] = nil
    end
end

local function clearTeamHighlights()
    if teamHighlightState.folder then
        teamHighlightState.folder:Destroy()
        teamHighlightState.folder = nil
    end
end

local function ensureTeamHighlightFolder()
    if teamHighlightState.folder and teamHighlightState.folder.Parent then
        return teamHighlightState.folder
    end

    local folder = Instance.new("Folder")
    folder.Name = "ActiveTeamHighlights"
    folder.Parent = game:GetService("CoreGui")
    teamHighlightState.folder = folder
    return folder
end

local function refreshPlayerHighlight(player)
    if not teamHighlightState.active or player == Players.LocalPlayer then return end

    local folder = ensureTeamHighlightFolder()
    local name = "P_" .. tostring(player.UserId)
    local highlight = folder:FindFirstChild(name)
    local character = player.Character

    if not character then
        if highlight then highlight:Destroy() end
        return
    end

    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.FillTransparency = 0.65
        highlight.OutlineTransparency = 0.2
        highlight.Parent = folder
    end

    local sameTeam = player.Team == Players.LocalPlayer.Team
    local color = sameTeam and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(255, 50, 50)
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.Adornee = character
end

local function refreshAllTeamHighlights()
    if not teamHighlightState.active then return end
    for _, player in ipairs(Players:GetPlayers()) do
        refreshPlayerHighlight(player)
    end
end

local function hookTeamHighlightPlayer(player)
    if player == Players.LocalPlayer or teamHighlightState.playerConnections[player] then return end

    local list = {}
    teamHighlightState.playerConnections[player] = list

    list[#list + 1] = player.CharacterAdded:Connect(function()
        task.defer(function()
            if teamHighlightState.active then refreshPlayerHighlight(player) end
        end)
    end)

    list[#list + 1] = player:GetPropertyChangedSignal("Team"):Connect(function()
        if teamHighlightState.active then refreshPlayerHighlight(player) end
    end)

    refreshPlayerHighlight(player)
end

