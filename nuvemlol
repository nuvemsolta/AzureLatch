task.spawn(function()
    local ok, err = pcall(function()
        --[[
        EvoHub RE - Core gameplay helpers (clean reconstruction)
        Phase 2 / v1

        Important recovered detail:
        EvoHub does NOT permanently hardcode the ByteNet "use" packet id.
        It starts with defaults and then reads ReplicatedStorage.BytenetStorage.Networking
        to discover current packet IDs.

        Recovered defaults:
            bytenet_use        = 30
            bytenet_findBall   = 29
            bytenet_selectRole = 4
        ]]

        local function createCoreHelpers(ctx)
            local ReplicatedStorage = assert(ctx.replicatedStorage, "replicatedStorage required")
            local Workspace = assert(ctx.workspace, "workspace required")
            local LocalPlayer = assert(ctx.player, "player required")

            local core = {}

            core.PacketIds = {
                use = 30,
                findBall = 29,
                selectRole = 4,
            }

            function core:readPacketIds()
                task.spawn(function()
                    pcall(function()
                        local storage = ReplicatedStorage:WaitForChild("BytenetStorage", 10)
                        if not storage then
                            return
                        end

                        local networking = storage:WaitForChild("Networking", 10)
                        if not networking or not networking:IsA("StringValue") then
                            return
                        end

                        local text = networking.Value
                        if not text or text == "" then
                            return
                        end

                        local useId = text:match('"bytenet_use"%s*:%s*(%d+)')
                        if useId then
                            self.PacketIds.use = tonumber(useId)
                        end

                        local findBallId = text:match('"bytenet_findBall"%s*:%s*(%d+)')
                        if findBallId then
                            self.PacketIds.findBall = tonumber(findBallId)
                        end

                        local selectRoleId = text:match('"bytenet_selectRole"%s*:%s*(%d+)')
                        if selectRoleId then
                            self.PacketIds.selectRole = tonumber(selectRoleId)
                        end
                    end)
                end)
            end

            function core:useBuffer()
                return buffer.fromstring(string.char(self.PacketIds.use) .. "\1")
            end

            function core:findBallBuffer()
                return buffer.fromstring(string.char(self.PacketIds.findBall))
            end

            -- Recovered packet shape used throughout the defensive features:
            -- ByteNetReliable:FireServer(useBuffer, {{skillName}})
            function core:fireUse(skillName, ...)
                local remote = ReplicatedStorage:FindFirstChild("ByteNetReliable")
                if not remote then
                    return false
                end

                local args = {...}
                local payload = {skillName}
                for _, value in ipairs(args) do
                    table.insert(payload, value)
                end

                local ok = pcall(function()
                    remote:FireServer(self:useBuffer(), {payload})
                end)

                return ok
            end

            function core:getTeam(playerName)
                local characters = Workspace:FindFirstChild("characters")
                local character = characters and characters:FindFirstChild(playerName)
                if not character then
                    return nil
                end

                local state = character:FindFirstChild("state")
                local team = state and state:FindFirstChild("team")
                return team and team.Value or nil
            end

            function core:hasIFrame(playerName)
                local characters = Workspace:FindFirstChild("characters")
                local character = characters and characters:FindFirstChild(playerName)
                if not character then
                    return false
                end

                local state = character:FindFirstChild("state")
                local iframe = state and state:FindFirstChild("iframe")
                return iframe and iframe.Value == true or false
            end

            function core:hasBall(playerName)
                local characters = Workspace:FindFirstChild("characters")
                local character = characters and characters:FindFirstChild(playerName or LocalPlayer.Name)
                return character and character:FindFirstChild("Ball") ~= nil or false
            end

            function core:getHotbarSlot(slotName)
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                local hotbar = playerGui and playerGui:FindFirstChild("Hotbar")
                local backpack = hotbar and hotbar:FindFirstChild("Backpack")
                local nestedHotbar = backpack and backpack:FindFirstChild("Hotbar")

                if nestedHotbar then
                    local slot = nestedHotbar:FindFirstChild(slotName)
                    if slot then
                        return slot
                    end
                end

                if hotbar then
                    local slot = hotbar:FindFirstChild(slotName, true)
                    if slot then
                        return slot
                    end
                end

                return nil
            end

            -- Exact recovered interpretation:
            -- missing slot -> true (treat as unavailable / cooldown)
            -- slot without Cooldown -> false
            -- otherwise height > 1 OR visible with BackgroundTransparency < 0.9
            function core:isOnCooldown(slotName)
                local slot = self:getHotbarSlot(slotName)
                if not slot then
                    return true
                end

                local cooldown = slot:FindFirstChild("Cooldown")
                if not cooldown then
                    return false
                end

                return cooldown.AbsoluteSize.Y > 1
                    or (cooldown.Visible and cooldown.BackgroundTransparency < 0.9)
            end

            function core:getSkill4ToolName()
                local slot = self:getHotbarSlot("skill4")
                local base = slot and slot:FindFirstChild("Base")
                local toolName = base and base:FindFirstChild("ToolName")
                return toolName and toolName.Text or nil
            end

            core:readPacketIds()

            return core
        end
        --[[
        EvoHub RE - Movement / Distance Increase Engine (clean reconstruction)
        Phase 2 / v1

        Reconstructed from the captured EvoHub stage:
        - engine state: ActiveBuffs / ActiveDashes / RenderConn / AnimConn
        - AnimationPlayed matching
        - slider distance is multiplied by 6 for actual travel
        - animation length can replace configured duration
        - directional and MoveDirection modes
        - heightFunc(dt) support
        - stopAnimIds support
        - 0.15s default trigger cooldown

        This file is intentionally readable. Original variable names/comments were destroyed by
        obfuscation, so semantic names below are reconstructed from behavior.

        Expected context:
            local engine = createDistanceEngine({
                player = Players.LocalPlayer,
                runService = RunService,
                ui = yourUILibrary,             -- optional; see registerWithUI
                notify = function(msg, dur, sound) ... end, -- optional
                autoLineupState = AutoLineupState,           -- optional
            })

        Then:
            engine:setupCharacter(player.Character)
            engine:addConfig(config)
        ]]

        local function createDistanceEngine(ctx)
            local player = assert(ctx.player, "player required")
            local RunService = assert(ctx.runService, "runService required")
            local autoLineupState = ctx.autoLineupState

            local engine = {
                ActiveBuffs = {},
                ActiveDashes = {},
                RenderConn = nil,
                AnimConn = nil,
                CharacterConn = nil,
            }

            local FALLBACK_FORWARD = Vector3.new(0, 0, 1)

            local function autoLineupBusy()
                return autoLineupState
                    and (autoLineupState.IsExecuting or autoLineupState.Frozen)
            end

            local function horizontalUnit(v, fallback)
                local h = Vector3.new(v.X, 0, v.Z)
                if h.Magnitude < 0.01 then
                    return fallback
                end
                return h.Unit
            end

            local function namedDirection(hrp, name)
                local forward = horizontalUnit(hrp.CFrame.LookVector, FALLBACK_FORWARD)
                local right = horizontalUnit(hrp.CFrame.RightVector, Vector3.new(1, 0, 0))

                if name == "Right" then
                    return right
                elseif name == "Left" then
                    return -right
                elseif name == "Front" then
                    return forward
                elseif name == "Back" then
                    return -forward
                elseif name == "FrontRight" then
                    return (forward + right).Unit
                elseif name == "FrontLeft" then
                    return (forward - right).Unit
                elseif name == "RightBack" then
                    return (-forward + right).Unit
                elseif name == "LeftBack" then
                    return (-forward - right).Unit
                end

                return forward
            end

            function engine:stopAll()
                table.clear(self.ActiveDashes)

                if self.RenderConn then
                    self.RenderConn:Disconnect()
                    self.RenderConn = nil
                end
            end

            local function updateDashes(dt)
                if autoLineupBusy() then
                    engine:stopAll()
                    return
                end

                for index = #engine.ActiveDashes, 1, -1 do
                    local dash = engine.ActiveDashes[index]
                    local hrp = dash.hrp

                    if not hrp or not hrp.Parent then
                        table.remove(engine.ActiveDashes, index)
                        continue
                    end

                    local stepDistance
                    if dash.isUnlimited then
                        stepDistance = dash.speed * dt
                    else
                        stepDistance = math.min(dash.speed * dt, dash.remaining)
                    end

                    local direction

                    if dash.isDirectional and dash.directionName then
                        direction = namedDirection(hrp, dash.directionName)
                    elseif dash.useMovement then
                        local character = hrp.Parent
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                        if humanoid and humanoid.MoveDirection.Magnitude > 0.05 then
                            direction = horizontalUnit(humanoid.MoveDirection, FALLBACK_FORWARD)
                        else
                            direction = horizontalUnit(hrp.CFrame.LookVector, FALLBACK_FORWARD)
                        end
                    else
                        direction = horizontalUnit(hrp.CFrame.LookVector, FALLBACK_FORWARD)
                    end

                    if not direction or direction.Magnitude < 0.01 then
                        direction = FALLBACK_FORWARD
                    end

                    local nextPosition = hrp.Position + direction * stepDistance
                    local y = hrp.Position.Y

                    if dash.heightFunc then
                        local deltaY = dash.heightFunc(dt)
                        if deltaY then
                            y += deltaY
                        end
                    end

                    -- Original code discards pitch/roll and preserves yaw only.
                    local _, yaw = hrp.CFrame:ToOrientation()
                    hrp.CFrame = CFrame.new(nextPosition.X, y, nextPosition.Z)
                        * CFrame.Angles(0, yaw, 0)

                    dash.remaining -= stepDistance

                    if dash.remaining <= 0 then
                        table.remove(engine.ActiveDashes, index)
                    end
                end

                if #engine.ActiveDashes == 0 and engine.RenderConn then
                    engine.RenderConn:Disconnect()
                    engine.RenderConn = nil
                end
            end

            local function triggerDash(hrp, buff, track, directionName)
                local sliderDistance = buff.distance or 0

                if not buff.enabled or sliderDistance <= 0 then
                    return
                end

                if autoLineupBusy() then
                    return
                end

                local now = tick()
                if buff.lastTrigger and (now - buff.lastTrigger) < (buff.cooldown or 0.15) then
                    return
                end
                buff.lastTrigger = now

                task.delay(buff.delay or 0, function()
                    if not hrp or not hrp.Parent then
                        return
                    end

                    if not buff.enabled or autoLineupBusy() then
                        return
                    end

                    if buff.requiresBall then
                        local ball = hrp.Parent:FindFirstChild("Ball")
                        if not ball or not ball:IsA("MeshPart") then
                            return
                        end
                    end

                    -- Only one active distance push is kept for the same HRP.
                    for i = #engine.ActiveDashes, 1, -1 do
                        if engine.ActiveDashes[i].hrp == hrp then
                            table.remove(engine.ActiveDashes, i)
                        end
                    end

                    -- Important recovered detail:
                    -- slider value is a multiplier and the engine converts it to studs with x6.
                    local totalDistance = sliderDistance * 6

                    local duration = buff.duration
                    if track and track.Length and track.Length > 0.1 then
                        local animationRemainder = track.Length - (buff.delay or 0)
                        if animationRemainder > 0.05 then
                            duration = animationRemainder
                        end
                    end

                    if not duration or duration <= 0 then
                        duration = (buff.duration and buff.duration > 0) and buff.duration or 0.4
                    end

                    local dash = {
                        hrp = hrp,
                        buff = buff,
                        directionName = directionName,
                        remaining = totalDistance,
                        speed = buff.isUnlimited
                            and (buff.speed or 150)
                            or (totalDistance / duration),
                        isUnlimited = buff.isUnlimited == true,
                        isDirectional = buff.isDirectional == true or directionName ~= nil,
                        useMovement = buff.useMovement == true,
                        heightFunc = buff.heightFunc,
                    }

                    if track then
                        local stopped
                        stopped = track.Stopped:Connect(function()
                            dash.remaining = 0
                            if stopped then
                                stopped:Disconnect()
                            end
                        end)
                    end

                    table.insert(engine.ActiveDashes, dash)

                    if not engine.RenderConn then
                        engine.RenderConn = RunService.RenderStepped:Connect(updateDashes)
                    end
                end)
            end

            function engine:onAnimationPlayed(track)
                if autoLineupBusy() or not track.Animation then
                    return
                end

                local fullId = tostring(track.Animation.AnimationId)
                local digits = fullId:match("%d+")
                if not digits then
                    return
                end

                local character = player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if not hrp then
                    return
                end

                -- Some buffs explicitly cancel an in-progress push when another animation starts.
                for _, dash in ipairs(self.ActiveDashes) do
                    local stopSet = dash.buff and dash.buff.stopAnimIds
                    if stopSet and (stopSet[digits] or stopSet[fullId]) then
                        dash.remaining = 0
                    end
                end

                for _, buff in ipairs(self.ActiveBuffs) do
                    if buff.enabled and (buff.distance or 0) > 0 then
                        local matched = false
                        local directionName = nil

                        if type(buff.animIds) == "table" then
                            directionName = buff.animIds[digits] or buff.animIds[fullId]

                            if directionName ~= nil then
                                matched = true
                            else
                                -- Handles array-form animIds where numeric keys map to string IDs.
                                for key, value in pairs(buff.animIds) do
                                    if value == digits
                                        or value == fullId
                                        or key == digits
                                        or key == fullId then
                                        matched = true
                                        break
                                    end
                                end
                            end
                        elseif buff.animId == digits or buff.animId == fullId then
                            matched = true
                        end

                        if matched then
                            triggerDash(hrp, buff, track, directionName)
                        end
                    end
                end
            end

            function engine:setupCharacter(character)
                if self.AnimConn then
                    self.AnimConn:Disconnect()
                    self.AnimConn = nil
                end

                local humanoid = character:WaitForChild("Humanoid", 5)
                if not humanoid then
                    return
                end

                local animator = humanoid:WaitForChild("Animator", 5) or humanoid
                self.AnimConn = animator.AnimationPlayed:Connect(function(track)
                    self:onAnimationPlayed(track)
                end)
            end

            function engine:addConfig(def)
                local stopSet = nil

                if def.stopAnimIds then
                    stopSet = {}
                    for _, id in ipairs(def.stopAnimIds) do
                        stopSet[tostring(id)] = true
                    end
                end

                local buff = {
                    name = def.name or "Move Buff",
                    animIds = def.animIds or (def.animId and {def.animId} or {}),
                    animId = def.animId,
                    delay = def.delay or def.wait or 0,
                    duration = def.duration or 0.4,
                    distance = def.defaultDistance or def.distance or 4,
                    maxDistance = def.maxDistance or 10,
                    isDirectional = def.isDirectional or false,
                    useMovement = def.useMovement or false,
                    isUnlimited = def.isUnlimited or false,
                    speed = def.speed or 150,
                    requiresBall = def.requiresBall or false,
                    cooldown = def.cooldown or 0.15,
                    stopAnimIds = stopSet,
                    heightFunc = def.heightFunc,
                    enabled = false,
                }

                table.insert(self.ActiveBuffs, buff)
                return buff
            end

            function engine:registerWithUI(section, def)
                local buff = self:addConfig(def)
                local ui = assert(ctx.ui, "ctx.ui required for registerWithUI")

                ui:CreateToggle(section, {
                    Name = buff.name,
                    Default = false,
                    Callback = function(value)
                        buff.enabled = value

                        if ctx.notify then
                            ctx.notify(
                                buff.name .. (value and " Enabled" or " Disabled"),
                                2,
                                value and "Enable" or "Disable"
                            )
                        end
                    end,
                })

                ui:CreateSlider(section, {
                    Name = buff.name .. " Distance",
                    Min = def.minDistance or 0.1,
                    Max = buff.maxDistance,
                    Default = buff.distance,
                    Step = 0.1,
                    Suffix = "",
                    Callback = function(value)
                        buff.distance = value
                    end,
                })

                return buff
            end

            if player.Character then
                task.spawn(function()
                    engine:setupCharacter(player.Character)
                end)
            end

            engine.CharacterConn = player.CharacterAdded:Connect(function(character)
                engine:setupCharacter(character)
            end)

            function engine:destroy()
