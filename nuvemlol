-- V18 capture native path:
-- Main_Main_Auto QTE_Auto QTE
-- Original UI location: Main.Content.ContentScroll.RightColumn.Auto QTE
local autoQteSection = mainUI:FolderInGroup(
    "Main",
    "Auto QTE",
    Color3.fromRGB(24, 255, 228),
    true,
    "Main"
)

do
    local LocalPlayer = Players.LocalPlayer
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local qteEnabled = false
    local generation = 0
    local playerGuiConnection = nil
    local qteDescendantConnection = nil
    local watchedConnections = {}
    local activePrompt = false
    local promptToken = 0
    local lastButton = nil
    local currentQteGui = nil
    local currentQteGroup = nil
    local currentQteButton = nil

    local NORMAL_QTE_DELAY = 0.863
    local DON_QTE_DELAY = 0.3665
    local donCacheAt = 0
    local donCacheValue = false

    local function normalizeName(value)
        return string.lower(tostring(value or "")):gsub("[^%w]", "")
    end

    local function isDonText(value)
        local valueNormalized = normalizeName(value)
        return valueNormalized == "donlorenzo"
            or valueNormalized == "donlorenzomastery"
            or valueNormalized == "masterylorenzo"
            or string.find(valueNormalized, "donlorenzo", 1, true) ~= nil
            or string.find(valueNormalized, "zombiedribble", 1, true) ~= nil
    end

    local function objectLooksLikeDon(object)
        if not object then return false end
        if isDonText(object.Name) then return true end

        for name, value in pairs(object:GetAttributes()) do
            if isDonText(name) or isDonText(value) then return true end
        end

        if object:IsA("StringValue") and isDonText(object.Value) then return true end
        if (object:IsA("TextLabel") or object:IsA("TextButton")) and isDonText(object.Text) then
            return true
        end

        return false
    end

    local function scanSmallTree(root)
        if not root then return false end
        if objectLooksLikeDon(root) then return true end

        for _, object in ipairs(root:GetDescendants()) do
            if objectLooksLikeDon(object) then return true end
        end

        return false
    end

    local function isDonLorenzo()
        local now = os.clock()
        if now - donCacheAt < 1 then
            return donCacheValue
        end

        donCacheAt = now
        donCacheValue = false

        local character = LocalPlayer.Character
        if objectLooksLikeDon(LocalPlayer) or scanSmallTree(character) then
            donCacheValue = true
            return true
        end

        local charactersFolder = Workspace:FindFirstChild("characters")
        local workspaceCharacter = charactersFolder and charactersFolder:FindFirstChild(LocalPlayer.Name)
        if workspaceCharacter ~= character and scanSmallTree(workspaceCharacter) then
            donCacheValue = true
            return true
        end

        local hotbar = playerGui:FindFirstChild("Hotbar")
        if scanSmallTree(hotbar) then
            donCacheValue = true
        end

        return donCacheValue
    end

    local function isVisibleThroughParents(object)
        local current = object
        while current and current ~= playerGui do
            if current:IsA("ScreenGui") and not current.Enabled then return false end
            if current:IsA("GuiObject") and not current.Visible then return false end
            current = current.Parent
        end
        return true
    end

    local function findQTE()
        local qteGui = playerGui:FindFirstChild("Qte") or playerGui:FindFirstChild("QTE")
        if not qteGui then return nil, nil, nil end

        local qteGroup = qteGui:FindFirstChild("QTE", true)
            or qteGui:FindFirstChild("CanvasGroup", true)
            or qteGui

        local targetButton = qteGroup:FindFirstChild("Button", true)
        if targetButton and not targetButton:IsA("GuiButton") then
            targetButton = nil
        end

        return qteGui, qteGroup, targetButton
    end

    local function promptIsVisible()
        local qteGui, qteGroup, button = findQTE()
        if not qteGui or not button then return false, qteGui, qteGroup, button end
        if not isVisibleThroughParents(qteGui) or not isVisibleThroughParents(button) then
            return false, qteGui, qteGroup, button
        end
        if qteGroup:IsA("GuiObject") and not isVisibleThroughParents(qteGroup) then
            return false, qteGui, qteGroup, button
        end
        return true, qteGui, qteGroup, button
    end

    local function fireButton(button)
        if not button or not button.Parent then return end

        local fired = false
        if type(firesignal) == "function" then
            local ok1 = pcall(firesignal, button.Activated)
            local ok2 = pcall(firesignal, button.MouseButton1Click)
            fired = ok1 or ok2
        end

        if not fired and type(getconnections) == "function" then
            for _, signal in ipairs({button.Activated, button.MouseButton1Click}) do
                local ok, list = pcall(getconnections, signal)
                if ok and type(list) == "table" then
                    for _, connection in ipairs(list) do
                        if type(connection.Fire) == "function" then
                            pcall(function() connection:Fire() end)
                            fired = true
                        elseif type(connection.Function) == "function" then
                            pcall(function() connection:Function() end)
                            fired = true
                        end
                    end
                end
            end
        end

        if fired then return end

        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local center = button.AbsolutePosition + button.AbsoluteSize / 2
            vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
            vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
        end)
    end

    local function cancelPrompt()
        activePrompt = false
        lastButton = nil
        promptToken += 1
    end

    local function beginPrompt(startedAt, knownButton)
        if not qteEnabled or activePrompt then return end

        activePrompt = true
        lastButton = knownButton
        promptToken += 1
        local myToken = promptToken
        local delayTime = isDonLorenzo() and DON_QTE_DELAY or NORMAL_QTE_DELAY
        local targetTime = (startedAt or os.clock()) + delayTime

        task.spawn(function()
            while qteEnabled and myToken == promptToken do
                local remaining = targetTime - os.clock()
                if remaining <= 0 then break end
                task.wait(math.max(math.min(remaining, 0.05), 0.005))
            end

            if not qteEnabled or myToken ~= promptToken then return end

            local visible, _, _, liveButton = promptIsVisible()
            if visible and liveButton then
                fireButton(liveButton)
            end

            activePrompt = false
        end)
    end

    local function probeQTE(eventTime)
        if not qteEnabled then return end

        local visible, _, _, button = promptIsVisible()
        if not visible then
            if activePrompt then cancelPrompt() end
            return
        end

        if not activePrompt then
            beginPrompt(eventTime or os.clock(), button)
        elseif button and lastButton ~= button then
            lastButton = button
        end
    end

    local function disconnectWatched()
        for i = #watchedConnections, 1, -1 do
            local connection = watchedConnections[i]
            if connection then connection:Disconnect() end
            watchedConnections[i] = nil
        end

        if qteDescendantConnection then
            qteDescendantConnection:Disconnect()
            qteDescendantConnection = nil
        end
    end

    local function watchVisibility(object)
        if not object then return end

        if object:IsA("ScreenGui") then
            watchedConnections[#watchedConnections + 1] = object:GetPropertyChangedSignal("Enabled"):Connect(function()
                if qteEnabled then probeQTE(os.clock()) end
            end)
        elseif object:IsA("GuiObject") then
            watchedConnections[#watchedConnections + 1] = object:GetPropertyChangedSignal("Visible"):Connect(function()
                if qteEnabled then probeQTE(os.clock()) end
            end)
        end
    end

    local function refreshQTEWatchers()
        if not qteEnabled then return end

        local qteGui, qteGroup, button = findQTE()
        if qteGui ~= currentQteGui
            or qteGroup ~= currentQteGroup
            or button ~= currentQteButton then
            disconnectWatched()
            currentQteGui = qteGui
            currentQteGroup = qteGroup
            currentQteButton = button

            if qteGui then
                watchVisibility(qteGui)
                watchVisibility(qteGroup)
                watchVisibility(button)

                qteDescendantConnection = qteGui.DescendantAdded:Connect(function(object)
                    if object.Name == "QTE"
                        or object.Name == "CanvasGroup"
                        or object.Name == "Button" then
                        task.defer(function()
                            if qteEnabled then
                                refreshQTEWatchers()
                                probeQTE(os.clock())
                            end
                        end)
                    end
                end)
            end
        end
    end

    local function disconnectQTE()
        generation += 1
        if playerGuiConnection then
            playerGuiConnection:Disconnect()
            playerGuiConnection = nil
        end
        disconnectWatched()
        currentQteGui = nil
        currentQteGroup = nil
        currentQteButton = nil
        cancelPrompt()
    end

    local function setQTEEnabled(value)
        qteEnabled = value == true
        disconnectQTE()
        if not qteEnabled then return end

        generation += 1
        local myGeneration = generation

        playerGuiConnection = playerGui.DescendantAdded:Connect(function(object)
            if not qteEnabled then return end

            if object.Name == "Qte" or object.Name == "QTE" then
                task.defer(function()
                    if qteEnabled then
                        refreshQTEWatchers()
                        probeQTE(os.clock())
                    end
                end)
                return
            end

            if currentQteGui
                and object:IsDescendantOf(currentQteGui)
                and (object.Name == "CanvasGroup" or object.Name == "Button") then
                task.defer(function()
                    if qteEnabled then
                        refreshQTEWatchers()
                        probeQTE(os.clock())
                    end
                end)
            end
        end)

        refreshQTEWatchers()
        task.defer(probeQTE)

        task.spawn(function()
            while qteEnabled and generation == myGeneration do
                probeQTE()
                task.wait(0.15)
            end
        end)
    end

    local nativeAutoQteToggle = autoQteSection:Toggle(
        "Auto QTE",
        nil,
        false,
        function(value)
            setQTEEnabled(value)
        end
    )

    -- Original source Default=false. A saved config may still restore ON.
    if nativeAutoQteToggle
        and nativeAutoQteToggle.Value == true then
        setQTEEnabled(true)
    end
end



-- Requested Main placement: directly below native Auto QTE.
local infinitePassSection = mainUI:FolderInGroup(
    "Main",
    "Infinite Range Passing",
    Color3.fromRGB(24, 255, 228),
    true,
    "Main"
)

do
    local passState = {
        enabled = false,
        busy = false,
        lastUse = {},
        hotbar = nil,
        slots = {},
        connections = {},
        dirty = true,
        watchConnection = nil,
        watchAccumulator = 0
    }

    local passPlayer = Players.LocalPlayer
    local passRemote = safeWaitForChild(ReplicatedStorage, "ByteNetReliable", 8)
    local passKeys = {
        [Enum.KeyCode.One] = "skill1",
        [Enum.KeyCode.Two] = "skill2",
        [Enum.KeyCode.Three] = "skill3",
        [Enum.KeyCode.Four] = "skill4"
    }

    local function isTouchInput()
        local ok, preferred = pcall(function()
            return UserInputService.PreferredInput
        end)

        if ok then
            return preferred == Enum.PreferredInput.Touch
        end

        return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    end

    local function aimPoint(useCenter)
        local camera = Workspace.CurrentCamera
        if not camera then return nil end

        if useCenter then
            return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        end

        local mouse = UserInputService:GetMouseLocation()
        return Vector2.new(mouse.X, mouse.Y)
    end

    local function closestTeammate(useCenter)
        local camera = Workspace.CurrentCamera
        local point = aimPoint(useCenter)
        if not camera or not point then return nil end

        local bestOnScreen, bestOnScreenDist = nil, math.huge
        local bestForward, bestForwardDist = nil, math.huge

        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= passPlayer and other.Team == passPlayer.Team then
                local character = other.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")

                if humanoid and root and humanoid.Health > 0 then
                    local screen, onScreen = camera:WorldToViewportPoint(root.Position)
                    if screen.Z > 0 then
                        local distance = (Vector2.new(screen.X, screen.Y) - point).Magnitude

                        if onScreen and distance < bestOnScreenDist then
                            bestOnScreenDist = distance
                            bestOnScreen = character
                        end

                        if useCenter and distance < bestForwardDist then
                            bestForwardDist = distance
                            bestForward = character
                        end
                    end
                end
            end
        end

        return bestOnScreen or (useCenter and bestForward or nil)
    end

    local function inLobby()
        local teams = game:GetService("Teams")
        local lobby = teams:FindFirstChild("lobby")
        return lobby and passPlayer.Team == lobby
    end

    local function sendInfinitePass(skillName, useCenter)
        if not passState.enabled or passState.busy or inLobby() then return end

        local now = os.clock()
        local last = passState.lastUse[skillName] or 0
        if now - last < 0.18 then return end

        local target = closestTeammate(useCenter)
        if not target then return end

        passState.lastUse[skillName] = now
        passState.busy = true

        pcall(function()
            passRemote:FireServer(
                buffer.fromstring(buffers["base"]),
                {{skillName, target}}
            )
        end)

        task.delay(0.12, function()
            passState.busy = false
        end)
    end

    local function currentHotbar()
        local gui = passPlayer:FindFirstChild("PlayerGui")
        local hotbar = gui and gui:FindFirstChild("Hotbar")
        local backpack = hotbar and hotbar:FindFirstChild("Backpack")
        return backpack and backpack:FindFirstChild("Hotbar") or nil
    end

    local function disconnectMobileHooks()
        for _, connection in ipairs(passState.connections) do
            connection:Disconnect()
        end
        table.clear(passState.connections)
        table.clear(passState.slots)
    end

    local function addConnection(connection)
        passState.connections[#passState.connections + 1] = connection
    end

    local function hookSkillButton(button, skillName)
        if not button:IsA("GuiButton") then return end

        addConnection(button.Activated:Connect(function()
            if isTouchInput() then
                sendInfinitePass(skillName, true)
            end
        end))

        addConnection(button.InputBegan:Connect(function(input)
            if isTouchInput() and input.UserInputType == Enum.UserInputType.Touch then
                sendInfinitePass(skillName, true)
            end
        end))
    end

    local function hookSkillSlot(slot, skillName)
        passState.slots[skillName] = slot

        if slot:IsA("GuiButton") then
            hookSkillButton(slot, skillName)
        elseif slot:IsA("GuiObject") then
            addConnection(slot.InputBegan:Connect(function(input)
                if isTouchInput() and input.UserInputType == Enum.UserInputType.Touch then
                    sendInfinitePass(skillName, true)
                end
            end))
        end

        for _, object in ipairs(slot:GetDescendants()) do
            if object:IsA("GuiButton") then
                hookSkillButton(object, skillName)
            end
        end

        local cooldown = slot:FindFirstChild("Cooldown", true)
        if cooldown and cooldown:IsA("GuiObject") then
            local wasVisible = cooldown.Visible
            addConnection(cooldown:GetPropertyChangedSignal("Visible"):Connect(function()
                local visible = cooldown.Visible
                if isTouchInput() and visible and not wasVisible then
                    sendInfinitePass(skillName, true)
                end
                wasVisible = visible
            end))
        end

        addConnection(slot.DescendantAdded:Connect(function()
            passState.dirty = true
        end))
        addConnection(slot.DescendantRemoving:Connect(function()
            passState.dirty = true
        end))
    end

    local function rebuildMobileHooks()
        local hotbar = currentHotbar()
        disconnectMobileHooks()
        passState.hotbar = hotbar
        passState.dirty = false

        if not hotbar then return end

        for index = 1, 4 do
            local skillName = "skill" .. index
            local slot = hotbar:FindFirstChild(skillName)
            if slot then
                hookSkillSlot(slot, skillName)
            end
        end

        addConnection(hotbar.ChildAdded:Connect(function()
            passState.dirty = true
        end))
        addConnection(hotbar.ChildRemoved:Connect(function()
            passState.dirty = true
        end))
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or isTouchInput() then return end
        local skillName = passKeys[input.KeyCode]
        if skillName then
            sendInfinitePass(skillName, false)
        end
    end)

    local function stopPassWatcher()
        if passState.watchConnection then
            passState.watchConnection:Disconnect()
            passState.watchConnection = nil
        end

        passState.watchAccumulator = 0
        disconnectMobileHooks()
        passState.hotbar = nil
        passState.dirty = true
    end

    local function startPassWatcher()
        stopPassWatcher()
        rebuildMobileHooks()

        passState.watchConnection =
            RunService.Heartbeat:Connect(function(dt)
                if not passState.enabled then
                    return
                end

                passState.watchAccumulator += dt

                if passState.watchAccumulator < 0.2 then
                    return
                end

                passState.watchAccumulator = 0

                local hotbar = currentHotbar()

                if hotbar ~= passState.hotbar then
                    passState.dirty = true
                end

                if not passState.dirty and hotbar then
                    for index = 1, 4 do
                        local name = "skill" .. index

                        if hotbar:FindFirstChild(name)
                            ~= passState.slots[name] then

                            passState.dirty = true
                            break
                        end
                    end
                end

                if passState.dirty then
                    rebuildMobileHooks()
                end
            end)
    end

    infinitePassSection:Toggle(
        "Infinite Range Passing",
        "Passes to the teammate closest to your cursor or screen center.",
        function(value)
            passState.enabled = value == true

            if passState.enabled then
                startPassWatcher()
            else
                stopPassWatcher()
            end

            EvoNotify("Infinite Pass", passState.enabled and "Enabled." or "Disabled.", 3)
        end
