local function applyKeybindGeometry(count)
    local g = computeKeybindGeometry(count)

    keybindsHolder.Position = UDim2.fromOffset(
        g.LeftMargin,
        g.Top
    )
    keybindsHolder.Size = UDim2.fromOffset(
        g.Width,
        g.Height
    )

    keybindsHeader.Position = UDim2.fromOffset(10, 0)
    keybindsHeader.Size = UDim2.new(1, -20, 0, g.HeaderHeight)

    keybindsDivider.Position = UDim2.fromOffset(
        0,
        g.HeaderHeight - 1
    )
    keybindsDivider.Size = UDim2.new(1, 0, 0, 1)

    keybindsContent.Position = UDim2.fromOffset(
        0,
        g.HeaderHeight
    )
    keybindsContent.Size = UDim2.new(
        1,
        0,
        1,
        -g.HeaderHeight
    )

    return g
end

local function clearKeybindRows()
    for _, row in ipairs(keybindRows) do
        if row and row.Parent then
            row:Destroy()
        end
    end
    table.clear(keybindRows)
end

local function animateKeybindVisibility(showing)
    ensureKeybindDisplay()

    keybindVisibilityToken += 1
    local token = keybindVisibilityToken
    local TweenServiceKeybinds = game:GetService("TweenService")

    if showing then
        keybindsGui.Enabled = true

        local target = keybindsHolder.Position
        keybindsHolder.Position = UDim2.new(
            target.X.Scale,
            target.X.Offset - 8,
            target.Y.Scale,
            target.Y.Offset
        )
        keybindsHolder.BackgroundTransparency = 1
        keybindsHeader.TextTransparency = 1
        keybindsDivider.BackgroundTransparency = 1

        pcall(function()
            TweenServiceKeybinds:Create(
                keybindsHolder,
                TweenInfo.new(
                    0.15,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out
                ),
                {
                    Position = target,
                    BackgroundTransparency = 0.14,
                }
            ):Play()

            TweenServiceKeybinds:Create(
                keybindsHeader,
                TweenInfo.new(0.15),
                { TextTransparency = 0 }
            ):Play()

            TweenServiceKeybinds:Create(
                keybindsDivider,
                TweenInfo.new(0.15),
                { BackgroundTransparency = 0 }
            ):Play()
        end)

        for index, row in ipairs(keybindRows) do
            local nameLabel = row:FindFirstChild("Name")
            local keyLabel = row:FindFirstChild("Key")

            if nameLabel then nameLabel.TextTransparency = 1 end
            if keyLabel then keyLabel.TextTransparency = 1 end

            task.delay(math.min((index - 1) * 0.01, 0.08), function()
                if token ~= keybindVisibilityToken then return end

                if nameLabel and nameLabel.Parent then
                    pcall(function()
                        TweenServiceKeybinds:Create(
                            nameLabel,
                            TweenInfo.new(0.11),
                            { TextTransparency = 0 }
                        ):Play()
                    end)
                end

                if keyLabel and keyLabel.Parent then
                    pcall(function()
                        TweenServiceKeybinds:Create(
                            keyLabel,
                            TweenInfo.new(0.11),
                            { TextTransparency = 0 }
                        ):Play()
                    end)
                end
            end)
        end
    else
        if not keybindsGui.Enabled then return end

        pcall(function()
            TweenServiceKeybinds:Create(
                keybindsHolder,
                TweenInfo.new(
                    0.13,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.In
                ),
                { BackgroundTransparency = 1 }
            ):Play()

            TweenServiceKeybinds:Create(
                keybindsHeader,
                TweenInfo.new(0.12),
                { TextTransparency = 1 }
            ):Play()

            TweenServiceKeybinds:Create(
                keybindsDivider,
                TweenInfo.new(0.12),
                { BackgroundTransparency = 1 }
            ):Play()
        end)

        for _, row in ipairs(keybindRows) do
            local nameLabel = row:FindFirstChild("Name")
            local keyLabel = row:FindFirstChild("Key")

            if nameLabel then nameLabel.TextTransparency = 1 end
            if keyLabel then keyLabel.TextTransparency = 1 end
        end

        task.delay(0.14, function()
            if token == keybindVisibilityToken
                and not settingsState.KeybindsDisplay
                and keybindsGui then
                keybindsGui.Enabled = false
            end
        end)
    end
end

