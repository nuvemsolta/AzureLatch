    local function formatNumber(value, increment)
        increment = math.abs(tonumber(increment) or 1)
        if increment >= 1 then
            return tostring(math.floor(value + 0.5))
        end
        local decimals = math.clamp(math.ceil(-math.log10(increment)), 1, 4)
        return string.format("%." .. tostring(decimals) .. "f", value)
    end

