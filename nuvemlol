        local function nagiTrapBall()
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            return (terrain and terrain:FindFirstChild("Ball")) or workspace:FindFirstChild("Ball")
        end

        local function nagiTrapAnimationPlaying()
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then return false end
            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                local id = track.Animation and tostring(track.Animation.AnimationId) or ""
                if id:find("73387016994281", 1, true) then return true end
            end
            return false
        end

        local function nagiTrapValidBall(ball)
            local char = player.Character
            if not ball or not char or char:FindFirstChild("Ball") then return false end
            if ball.Position.Y < nagiTrap.minBallHeight then return false end
            local root = char:FindFirstChild("HumanoidRootPart")
            return root ~= nil and (root.Position - ball.Position).Magnitude <= nagiTrap.radius
        end

        local function stopNagiTrapMagnet()
            nagiTrap.active = false
            if nagiTrap.conn then
                nagiTrap.conn:Disconnect()
                nagiTrap.conn = nil
            end
        end

        local function startNagiTrapMagnet()
            if nagiTrap.active then return end
            nagiTrap.active = true
            nagiTrap.startTime = tick()

            if nagiTrap.conn then nagiTrap.conn:Disconnect() end
            nagiTrap.conn = RunService.Heartbeat:Connect(function()
                if not nagiTrap.active or not nagiTrapAnimationPlaying() then
                    stopNagiTrapMagnet()
                    return
                end

                local elapsed = tick() - nagiTrap.startTime
                if elapsed < nagiTrap.activationDelay then return end
                if elapsed > nagiTrap.duration then
                    stopNagiTrapMagnet()
                    return
                end

                local ball = nagiTrapBall()
                if not nagiTrapValidBall(ball) then return end
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end

                local target = ball.Position + Vector3.new(0, nagiTrap.verticalOffset, 0)
                local current = root.Position
                if (current - target).Magnitude < 2 then return end

                local nextPos = current:Lerp(target, nagiTrap.speed)
                if current.Y > 10 then
                    nextPos = Vector3.new(nextPos.X, current.Y, nextPos.Z)
                end
                root.CFrame = CFrame.new(nextPos)
            end)

            task.delay(nagiTrap.duration + 0.1, stopNagiTrapMagnet)
        end

