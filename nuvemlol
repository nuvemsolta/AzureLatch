                    B = {minX = -668.01, maxX = -407.68, minZ = 841.70, maxZ = 935.59},
                },

                GlobalEnemyGoalboxes = {
                    A = {minX = -858.81, maxX = -217.79, minZ = 1460.15, maxZ = 1706.26},
                    B = {minX = -859.01, maxX = -217.90, minZ = 841.60, maxZ = 1098.19},
