                -- Earlier values exist in the obfuscated initializer, but later duplicate
                -- keys overwrite them. Effective values are 200 / 200.
                MAX_BALL_DISTANCE = 200,
                MAX_VERTICAL_DISTANCE = 200,

                GlobalGoalboxes = {
