    task.defer(function()
        if type(writefile) ~= "function" then
            return
        end

        local decodeBase64

        if crypt and type(crypt.base64decode) == "function" then
            decodeBase64 = crypt.base64decode
        elseif syn and syn.crypt and syn.crypt.base64
            and type(syn.crypt.base64.decode) == "function" then
            decodeBase64 = syn.crypt.base64.decode
        end

        local encoded = [[]]

        local raw

        if decodeBase64 then
            local ok, result = pcall(
                decodeBase64,
                encoded
            )

            if ok then
                raw = result
            end
        end

        if not raw then
            local alphabet =
                "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

            local lookup = {}

            for i = 1, #alphabet do
                lookup[alphabet:sub(i, i)] = i - 1
            end

            local out = {}
            local buffer = 0
            local bits = 0

            for i = 1, #encoded do
                local c = encoded:sub(i, i)

                if c == "=" then
                    break
                end

                local value = lookup[c]

                if value then
                    buffer = buffer * 64 + value
                    bits += 6

                    if bits >= 8 then
                        bits -= 8

                        local byte =
                            math.floor(
                                buffer / (2 ^ bits)
                            ) % 256

                        out[#out + 1] =
                            string.char(byte)
                    end
                end
            end

            raw = table.concat(out)
        end

        local fileName =
            "celeron_home_frieren.jpg"

        local wrote =
            pcall(
                writefile,
                fileName,
                raw
            )

        if not wrote then
            return
        end

        local getAsset =
            type(getcustomasset) == "function"
            and getcustomasset
            or (
                type(getsynasset) == "function"
                and getsynasset
            )

        if not getAsset then
            return
        end

        local okAsset, asset =
            pcall(
                getAsset,
                fileName
            )

        if not okAsset or not asset then
            return
        end

        local localPlayer =
            game:GetService("Players").LocalPlayer

        for _ = 1, 60 do
            local darkUI =
                game:GetService("CoreGui"):
                FindFirstChild("dark_UI")
                or localPlayer.PlayerGui:
                    FindFirstChild("dark_UI")

            if darkUI then
                local banner =
                    darkUI:
                    FindFirstChild(
                        "banner",
                        true
                    )

                if banner
                    and banner:IsA("ImageLabel") then

                    banner.Image = asset
                    banner.ScaleType =
                        Enum.ScaleType.Crop

                    return
                end
            end

            task.wait()
        end
    end)
end

