    mobileKeySystem = {}
    getgenv().MobileKeySystem = mobileKeySystem
end

mobileKeySystem.keyCode = mobileKeySystem.keyCode or nil
mobileKeySystem.keyName = mobileKeySystem.keyName or ""
mobileKeySystem.buttons = mobileKeySystem.buttons or {}

local mobileKeyAliases = {
    leftalt = "LeftAlt",
    rightalt = "RightAlt",
    leftshift = "LeftShift",
    rightshift = "RightShift",
    leftctrl = "LeftControl",
    rightctrl = "RightControl",
    leftcontrol = "LeftControl",
    rightcontrol = "RightControl",
    enter = "Return",
    returnkey = "Return",
    space = "Space",
    backspace = "Backspace",
    delete = "Delete",
    tab = "Tab",
    escape = "Escape"
}

local mobileNumberKeys = {
    ["0"] = "Zero",
    ["1"] = "One",
    ["2"] = "Two",
    ["3"] = "Three",
    ["4"] = "Four",
    ["5"] = "Five",
    ["6"] = "Six",
    ["7"] = "Seven",
    ["8"] = "Eight",
    ["9"] = "Nine"
}

local function resolveMobileKey(value)
    if typeof(value) ~= "string" then
        return nil
    end

    local cleaned = value:gsub("%s+", "")
    if cleaned == "" then
        return nil
    end

    local lower = cleaned:lower()
    local enumName = mobileKeyAliases[lower] or mobileNumberKeys[lower]

    if not enumName then
        if #cleaned == 1 and cleaned:match("%a") then
            enumName = cleaned:upper()
        else
            enumName = cleaned:sub(1, 1):upper() .. cleaned:sub(2)
        end
    end

    local ok, keyCode = pcall(function()
        return Enum.KeyCode[enumName]
    end)

    if ok and keyCode then
        return keyCode
    end

    return nil
end

