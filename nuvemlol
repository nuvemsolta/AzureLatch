        local function clearSearchResults()
            for _, child in ipairs(resultsList:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end
        end

        local function openSearchResult(tab, section)
            if selectedTab ~= tab then
                selectTab(tab)
            end
            applyGroup(tab, section.Group)
            task.defer(function()
                if section.Frame.Visible then
                    local relative = section.Frame.AbsolutePosition.Y
                        - tab.Page.AbsolutePosition.Y
                        + tab.Page.CanvasPosition.Y
                        - 4
                    tab.Page.CanvasPosition = Vector2.new(0, math.max(0, relative))
                end
            end)
        end

        local function refreshSearch()
            local query = tostring(searchBox.Text or ""):lower()
            clearSearchResults()

            if query == "" then
                searchResults.Visible = false
                searchResults.Size = UDim2.new(1, 0, 0, 0)
                return
            end

            local hits = {}
            for _, tab in ipairs(window.Tabs) do
                for _, section in ipairs(tab.Sections) do
                    local sectionMatch = section.Name:lower():find(query, 1, true) ~= nil
                    local matchedControl = nil
                    for _, record in ipairs(section.Controls) do
                        if record.Name:lower():find(query, 1, true) then
                            matchedControl = record.Name
                            break
                        end
                    end

                    if sectionMatch or matchedControl then
                        hits[#hits + 1] = {
                            Tab = tab,
                            Section = section,
                            Text = matchedControl
                                and (section.Group .. "  •  " .. section.Name .. "  •  " .. matchedControl)
                                or (section.Group .. "  •  " .. section.Name),
                        }
                    end
                end
            end

            for index, hit in ipairs(hits) do
                if index > 8 then break end

                local resultButton = create("TextButton", {
                    Name = "Result",
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundColor3 = Theme.Section,
                    BorderSizePixel = 0,
                    Text = hit.Text,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.SourceSans,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    ZIndex = 11,
                }, resultsList)
                padding(resultButton, 5, 3, 0, 0)

                resultButton.MouseEnter:Connect(function()
                    resultButton.BackgroundColor3 = Theme.Control
                end)
                resultButton.MouseLeave:Connect(function()
                    resultButton.BackgroundColor3 = Theme.Section
                end)
                resultButton.Activated:Connect(function()
                    openSearchResult(hit.Tab, hit.Section)
                    searchResults.Visible = false
                    searchResults.Size = UDim2.new(1, 0, 0, 0)
                end)
            end

            local shown = math.min(#hits, 8)
            searchResults.Visible = shown > 0
            searchResults.Size = UDim2.new(1, 0, 0, shown > 0 and math.min(138, shown * 21 + 6) or 0)
        end

        searchBox:GetPropertyChangedSignal("Text"):Connect(refreshSearch)

        searchBox.Focused:Connect(function()
            pcall(function()
                TweenService:Create(searchStroke, TweenInfo.new(0.15), {
                    Transparency = 0.1
                }):Play()
            end)
            refreshSearch()
        end)

        searchBox.FocusLost:Connect(function()
            pcall(function()
                TweenService:Create(searchStroke, TweenInfo.new(0.15), {
                    Transparency = 0.5999966859817505
                }):Play()
            end)
            task.delay(0.1, function()
                if not searchBox:IsFocused() then
                    searchResults.Visible = false
                    searchResults.Size = UDim2.new(1, 0, 0, 0)
                end
            end)
        end)

        return window
    end

