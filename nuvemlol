                    local dash = {
                        hrp = hrp,
                        buff = buff,
                        directionName = directionName,
                        remaining = totalDistance,
                        speed = buff.isUnlimited
                            and (buff.speed or 150)
                            or (totalDistance / duration),
                        isUnlimited = buff.isUnlimited == true,
                        isDirectional = buff.isDirectional == true or directionName ~= nil,
                        useMovement = buff.useMovement == true,
                        heightFunc = buff.heightFunc,
                    }

                    if track then
                        local stopped
                        stopped = track.Stopped:Connect(function()
                            dash.remaining = 0
                            if stopped then
                                stopped:Disconnect()
                            end
                        end)
                    end

                    table.insert(engine.ActiveDashes, dash)

                    if not engine.RenderConn then
                        engine.RenderConn = RunService.RenderStepped:Connect(updateDashes)
                    end
