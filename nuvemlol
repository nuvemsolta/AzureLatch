    end
    local function clearMap()
        state.generation=state.generation+1
        if state.frame then state.frame:Destroy() end
        state.frame,state.viewport,state.camera,state.geometry,state.status=nil,nil,nil,nil,nil
        state.markers={};state.ballMarker=nil;state.count=0
    end
    local function part(parent,size,cf,color,shape)
        return make("Part",{Size=size,CFrame=cf,Color=color,Shape=shape or Enum.PartType.Block,
            Material=Enum.Material.SmoothPlastic,Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,CastShadow=false},parent)
    end
    local function buildMap()
        clearMap()
        local generation=state.generation
        local frame=make("Frame",{Name="Radar3D",AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-16,0,20),
            Size=UDim2.new(0,360,0,310),BackgroundColor3=palette.bg,BorderSizePixel=0},win.Gui)
        make("UICorner",{CornerRadius=UDim.new(0,14)},frame)
        make("UIStroke",{Color=palette.line,Thickness=1},frame)
        local title=make("TextLabel",{Text="3D RADAR",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=palette.accent,
            TextXAlignment=Enum.TextXAlignment.Left,Position=UDim2.fromOffset(14,8),Size=UDim2.new(1,-65,0,26),BackgroundTransparency=1},frame)
        local close=make("TextButton",{Text="×",TextSize=20,TextColor3=palette.muted,Font=Enum.Font.Gotham,
            Position=UDim2.new(1,-40,0,6),Size=UDim2.fromOffset(30,30),BackgroundTransparency=1},frame)
        local viewport=make("ViewportFrame",{Position=UDim2.fromOffset(8,40),Size=UDim2.new(1,-16,1,-80),
            BackgroundColor3=palette.panel,BorderSizePixel=0,Ambient=Color3.fromRGB(210,220,230),
            LightColor=Color3.fromRGB(255,255,255),LightDirection=Vector3.new(-1,-2,-1)},frame)
        make("UICorner",{CornerRadius=UDim.new(0,10)},viewport)
        local world=make("WorldModel",{Name="TacticalWorld"},viewport)
        local camera=make("Camera",{FieldOfView=45},viewport);viewport.CurrentCamera=camera
        local status=make("TextLabel",{Text="Building map…",Font=Enum.Font.Gotham,TextSize=10,TextColor3=palette.muted,
            Position=UDim2.new(0,14,1,-31),Size=UDim2.new(1,-28,0,24),BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left},frame)
        state.frame,state.viewport,state.geometry,state.camera,state.status=frame,viewport,world,camera,status
        local screen=ws.CurrentCamera and ws.CurrentCamera.ViewportSize
        if screen then
            local width=math.min(360,math.max(240,screen.X-32))
            frame.Size=UDim2.fromOffset(width,math.min(310,math.max(210,screen.Y-40)))
        end
        close.Activated:Connect(function() state.radar=false;win:SetToggle("3D Radar",false);sync() end)
        task.spawn(function()
            local low,high,minimumY,skipped=nil,nil,nil,0
            local root=ws:FindFirstChild("map") or ws:FindFirstChild("Map") or ws:FindFirstChild("Stadium") or ws
            local descendants=root:GetDescendants()
            for index,object in ipairs(descendants) do
                if generation~=state.generation or not state.radar then return end
                if object:IsA("BasePart") and object.Name~="Ball" and object.Transparency<.95 and not object:IsDescendantOf(win.Gui) then
                    local excluded=false
                    local ancestor=object.Parent
                    while ancestor and ancestor~=ws do
                        if ancestor:IsA("Model") and (ancestor:FindFirstChildOfClass("Humanoid") or ps:GetPlayerFromCharacter(ancestor)) then excluded=true;break end
                        ancestor=ancestor.Parent
                    end
                    if not excluded then
                        if state.count<2000 then
                            local ok,clone=pcall(function() return object:Clone() end)
                            if ok and clone then
                                for _,child in ipairs(clone:GetChildren()) do child:Destroy() end
                                clone.Anchored=true;clone.CanCollide=false;clone.CanTouch=false;clone.CanQuery=false;clone.CastShadow=false
                                clone.Material=Enum.Material.SmoothPlastic;clone.CFrame=object.CFrame;clone.Parent=world
                                state.count=state.count+1
                                local cf,size=object.CFrame,object.Size*.5
                                for _,x in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do
                                    local corner=cf:PointToWorldSpace(Vector3.new(size.X*x,0,size.Z*z))
                                    low=low and Vector3.new(math.min(low.X,corner.X),0,math.min(low.Z,corner.Z)) or corner
                                    high=high and Vector3.new(math.max(high.X,corner.X),0,math.max(high.Z,corner.Z)) or corner
                                end end
                                minimumY=minimumY and math.min(minimumY,object.Position.Y) or object.Position.Y
                            end
                        else skipped=skipped+1 end
                    end
                end
                if index%64==0 then task.wait() end
            end
            if generation~=state.generation then return end
            local char=lp.Character;local hrp=char and char:FindFirstChild("HumanoidRootPart")
            state.center=low and high and Vector3.new((low.X+high.X)/2,minimumY or 0,(low.Z+high.Z)/2) or (hrp and hrp.Position or Vector3.zero)
            state.span=low and high and math.max(high.X-low.X,high.Z-low.Z,80) or 160
            if state.count==0 then status.Text="No replicated map parts · player markers only"
            else status.Text=tostring(state.count).." parts"..(skipped>0 and " · geometry capped" or "").." · terrain not included" end
            state.mapStatus=status.Text
        end)
    end
    local elapsed=0
    local function update(dt)
        elapsed=elapsed+dt;if elapsed<1/state.hz then return end;elapsed=0
        if not state.radar or not state.geometry or not state.camera then return end
        local char=lp.Character;local ownRoot=char and char:FindFirstChild("HumanoidRootPart")
        local center=state.follow and ownRoot and ownRoot.Position or state.center
        local distance=(state.follow and 105 or state.span*1.45)*state.zoom
        local offset=state.view=="Top Down" and Vector3.new(0,distance,.01) or Vector3.new(distance*.4,distance*.8,distance*.6)
        state.camera.CFrame=CFrame.lookAt(center+offset,center)
        local visible={}
        for player,record in pairs(state.players) do
            local root=record.char and record.char:FindFirstChild("HumanoidRootPart")
            if root and (not state.enemiesOnly or enemy(player) or player==lp) then
                visible[player]=true
                local marker=state.markers[player]
                if not marker then
                    local width=math.max(3,state.span/90)
                    marker=part(state.geometry,Vector3.new(width,5,width),root.CFrame,palette.accent)
                    state.markers[player]=marker
                end
                marker.CFrame=root.CFrame
                local danger=runtime.isCounterActive(player)
                marker.Color=danger and Color3.fromRGB(255,188,78) or player==lp and Color3.fromRGB(255,255,255)
                    or enemy(player) and Color3.fromRGB(255,99,117) or palette.accent
            end
        end
        for player,marker in pairs(state.markers) do if not visible[player] then marker:Destroy();state.markers[player]=nil end end
        local ball=ws.Terrain:FindFirstChild("Ball")
        if ball and ball:IsA("BasePart") then
            if not state.ballMarker then state.ballMarker=part(state.geometry,Vector3.new(2.5,2.5,2.5),ball.CFrame,Color3.fromRGB(255,218,95),Enum.PartType.Ball) end
            state.ballMarker.CFrame=ball.CFrame
        elseif state.ballMarker then state.ballMarker:Destroy();state.ballMarker=nil end
    end
    local running=false
    sync=function()
        local desired=state.radar or state.monitor or state.record
        if desired~=running then
            running=desired
            if running then
                for _,player in ipairs(ps:GetPlayers()) do watchPlayer(player) end
                connect(state.connections,ps.PlayerAdded,watchPlayer)
                connect(state.connections,ps.PlayerRemoving,removePlayer)
                connect(state.connections,rs.Heartbeat,update)
            else
                disconnect(state.connections)
                for player in pairs(state.players) do removePlayer(player) end
                state.active={}
            end
        end
        if state.radar and not state.frame then buildMap() elseif not state.radar and state.frame then clearMap() end
    end
    mapControls:Toggle("3D Radar",function(value) state.radar=value;sync() end)
    mapControls:Toggle("Follow Player",function(value) state.follow=value end)
    mapControls:Toggle("Enemies Only",function(value) state.enemiesOnly=value end)
    mapControls:Dropdown("Radar View",{"Angled","Top Down"},function(value) state.view=value end)
    mapControls:Slider("Radar Zoom",1,.35,2.5,.05,function(value) state.zoom=value end)
    mapControls:Slider("Radar Refresh",20,5,30,1,function(value) state.hz=value end)
    mapControls:Button("Rebuild Map",function() if state.radar then buildMap() end end)
    safetyControls:Textbox("Confirmed Counter IDs","IDs separated by commas",function(value)
        local ids={};for id in value:gmatch("%d+") do ids[id]=true end
        state.ids=ids;state.active={}
    end)
    safetyControls:Toggle("Counter Guard",function(value)
        if value and next(state.ids)==nil then warn("[Nuvem] Add confirmed counter animation IDs first.");return false end
        state.monitor=value;sync()
        if value then
            for player,record in pairs(state.players) do
                for animator in pairs(record.animators) do
                    local ok,tracks=pcall(function() return animator:GetPlayingAnimationTracks() end)
                    if ok then for _,track in ipairs(tracks) do observe(player,track) end end
                end
            end
        end
        return value
    end)
    safetyControls:Toggle("Record Enemy Actions",function(value) state.record=value;sync() end)
    safetyControls:Button("Copy Action Log",function()
        local report="Observed enemy actions (not automatically confirmed counters)\n"..table.concat(state.events,"\n")
        local clipboard=setclipboard or toclipboard
        if type(clipboard)=="function" then local ok=pcall(clipboard,report);if ok then return end end
        if type(writefile)=="function" then local ok=pcall(writefile,"nuvem_actions.txt",report);if ok then return end end
        print(report)
    end)
    safetyControls:Button("Clear Action Log",function() state.events={} end)
    function runtime.destroy()
        state.radar,state.monitor,state.record=false,false,false
        sync();clearMap()
    end
    win:OnDestroy(runtime.destroy)
end

