            end

            local function onScorpionAnimation(track)
                local _, humanoid, root = getCharacter()

                if not humanoid or not root then
                    return
                end

                if not GagamaruEnabled.scorpionDist
                    or (Distances.scorpionDist or 0) <= 0 then
                    return
                end

                generation += 1
                local token = generation

                task.spawn(function()
                    local direction = chooseScorpionDirection(
                        humanoid,
                        root,
                        token
                    )

                    if token ~= generation
                        or not direction
                        or not track.IsPlaying then
                        return
                    end

                    startBoost(
                        DashConfigs.Scorpion,
                        direction,
                        track
                    )
                end)
            end

            local function hookAnimator(char)
                if animatorConnection then
                    animatorConnection:Disconnect()
                    animatorConnection = nil
                end

                local humanoid = char:WaitForChild("Humanoid", 5)

                if not humanoid then
                    return
                end

                local animator =
                    humanoid:FindFirstChildOfClass("Animator")
                    or humanoid:WaitForChild("Animator", 5)

                if not animator then
                    return
                end

                animatorConnection = animator.AnimationPlayed:Connect(function(track)
                    if not track.Animation then
                        return
                    end

                    local animationId = tostring(
                        track.Animation.AnimationId
                    ):match("%d+")

                    if animationId == WILD_LEFT_ANIMATION_ID then
                        onWildAnimation(-1)

                    elseif animationId == WILD_RIGHT_ANIMATION_ID then
                        onWildAnimation(1)

                    elseif animationId == SCORPION_ANIMATION_ID then
                        onScorpionAnimation(track)
                    end
                end)
            end

            if axisConnection then
                axisConnection:Disconnect()
            end

            axisConnection = RunService.Heartbeat:Connect(function()
                if os.clock() < freezeRightUntil then
                    return
                end

                local _, _, root = getCharacter()

                if not root then
                    cachedRight = nil
                    return
                end

                local right = flatUnit(root.CFrame.RightVector)

                if right then
                    cachedRight = right
                end
            end)

            if Players.LocalPlayer.Character then
                local _, _, root = getCharacter()

                if root then
                    cachedRight = flatUnit(root.CFrame.RightVector)
                end

                hookAnimator(Players.LocalPlayer.Character)
            end

            Players.LocalPlayer.CharacterAdded:Connect(function(char)
                generation += 1
                cachedRight = nil
                freezeRightUntil = 0

                cancelBoost(
                    DashConfigs.WildInstincts
                )

                cancelBoost(
                    DashConfigs.Scorpion
                )

                task.defer(
                    hookAnimator,
                    char
                )
            end)
        end


        local divingToggle = d:Toggle("Diving Header", function(value)
            GagamaruEnabled.divingDist = value == true
        end)
        local divingSlider = d:Slider(
            "Diving Header Distance",
            DashConfigs.DivingHeader.defaultDistance,
            GAGAMARU_MIN_DISTANCE,
            DashConfigs.DivingHeader.maxDistance,
            0.1,
            function(v)
                Distances.divingDist =
                    clampGagamaruDistance(
                        DashConfigs.DivingHeader,
                        v
                    )
            end
        )

        local wildToggle = d:Toggle("Wild Instincts", function(value)
            GagamaruEnabled.wildInstinctsDist = value == true
        end)
        local wildSlider = d:Slider(
            "Wild Instincts Distance",
            DashConfigs.WildInstincts.defaultDistance,
            GAGAMARU_MIN_DISTANCE,
            DashConfigs.WildInstincts.maxDistance,
            0.1,
            function(v)
                Distances.wildInstinctsDist =
                    clampGagamaruDistance(
                        DashConfigs.WildInstincts,
                        v
                    )
            end
        )

        local scorpionToggle = d:Toggle("Scorpion", function(value)
            GagamaruEnabled.scorpionDist = value == true
        end)
        local scorpionSlider = d:Slider(
            "Scorpion Distance",
            DashConfigs.Scorpion.defaultDistance,
            GAGAMARU_MIN_DISTANCE,
            DashConfigs.Scorpion.maxDistance,
            0.1,
            function(v)
                Distances.scorpionDist =
                    clampGagamaruDistance(
                        DashConfigs.Scorpion,
                        v
                    )
            end
        )

        -- Folder wrappers restore saved values silently. Mirror those restored
        -- values into the runtime so visual state and feature state never differ.
        if divingToggle then
            GagamaruEnabled.divingDist = divingToggle.Value == true
        end
        if wildToggle then
            GagamaruEnabled.wildInstinctsDist = wildToggle.Value == true
        end
        if scorpionToggle then
            GagamaruEnabled.scorpionDist = scorpionToggle.Value == true
        end

        local function syncDistanceControl(slider, cfg)
            local value = clampGagamaruDistance(
                cfg,
                slider and slider.Value
                    or cfg.defaultDistance
            )

            Distances[cfg.sliderVar] = value

            if slider
                and tonumber(slider.Value) ~= value
                and type(slider.SetValue) == "function" then
                pcall(function()
                    slider:SetValue(value)
                end)
            end
        end

        syncDistanceControl(
            divingSlider,
            DashConfigs.DivingHeader
        )
        syncDistanceControl(
            wildSlider,
            DashConfigs.WildInstincts
        )
        syncDistanceControl(
            scorpionSlider,
            DashConfigs.Scorpion
        )

    end)

    if not moveBuffOK then
        warn("[MoveBuffs][BOOT] " .. tostring(moveBuffError))
    end
end)

