local function normalizeKey(key)
    if not key then return nil end

    key = tostring(key):gsub("%s+", ""):lower()

    local map = {
        leftalt = "LeftAlt",
        rightalt = "RightAlt",
        leftshift = "LeftShift",
        rightshift = "RightShift",
        leftctrl = "LeftControl",
        rightctrl = "RightControl",

        enter = "Return",
        returnkey = "Return",
        space = "Space",
        backspace = "Backspace",
        delete = "Delete",
        tab = "Tab",
        escape = "Escape",
    }

    if map[key] then
        return map[key]
    end

    if key:find("mouse") then
        return nil
    end

    if #key == 1 and key:match("%a") then
        return key:upper()
    end

    if key:match("^%d$") then
        return key
    end

    return key:sub(1,1):upper() .. key:sub(2)
end

