        -- EVOHUB TRAP HELPER ENGINE
        -- ========================================================
        local function newTrapHelper(section, groupName, cfg)
            local state = {
                enabled = false,
                active = false,
                startTime = 0,
                magnetRadius = 55,
                magnetSpeed = 0.07,
                activationDelay = 0.01,
                magnetDuration = 1.5,
                verticalOffset = 2,
                minBallHeight = 5,
                magnetConn = nil,
                animConn = nil,
                charConn = nil,
            }

            local function ball()
                local terrain = WorkspaceN:FindFirstChildOfClass("Terrain")
                return (terrain and terrain:FindFirstChild("Ball"))
                    or WorkspaceN:FindFirstChild("Ball")
            end

            local function validBall(b)
                if not b then return false end

                local char = LocalPlayerN.Character
                if not char or char:FindFirstChild("Ball") then return false end
                if b.Position.Y < state.minBallHeight then return false end

                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return false end
                return (root.Position - b.Position).Magnitude <= state.magnetRadius
            end

            local function movingAnimation()
                local char = LocalPlayerN.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then return false end

                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    local id = track.Animation and tostring(track.Animation.AnimationId) or ""
                    if id:find(tostring(cfg.animId), 1, true) then
                        return true
                    end
                end
                return false
            end

            local function magnetTick()
                local b = ball()
                if not b or not validBall(b) then return false end

                local char = LocalPlayerN.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return false end

                local target = b.Position + Vector3.new(0, state.verticalOffset, 0)
                local current = root.Position
                if (current - target).Magnitude < 2 then return true end

                local nextPos = current:Lerp(target, state.magnetSpeed)
                if current.Y > 10 then
                    nextPos = Vector3.new(nextPos.X, current.Y, nextPos.Z)
                end

                root.CFrame = CFrame.new(nextPos)
                return true
            end

            local function stopMagnet()
                state.active = false
                if state.magnetConn then
                    state.magnetConn:Disconnect()
                    state.magnetConn = nil
                end
            end

            local function startMagnet()
                if state.active then return end
                state.startTime = tick()
                state.active = true

                if state.magnetConn then state.magnetConn:Disconnect() end
                state.magnetConn = RunServiceN.Heartbeat:Connect(function()
                    if not state.active or not movingAnimation() then
                        stopMagnet()
                        return
                    end

                    local elapsed = tick() - state.startTime
                    if elapsed < state.activationDelay then return end
                    if elapsed > state.magnetDuration then
                        stopMagnet()
                        return
                    end

                    magnetTick()
                end)

                task.delay(state.magnetDuration + 0.1, stopMagnet)
            end

            local function setupMonitor()
                local char = LocalPlayerN.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then return end

                if state.animConn then state.animConn:Disconnect() end
                state.animConn = hum.AnimationPlayed:Connect(function(track)
                    if not state.enabled then return end
                    local id = track.Animation and tostring(track.Animation.AnimationId) or ""
                    if id:find(tostring(cfg.animId), 1, true) then
                        task.delay(state.activationDelay, function()
                            local b = ball()
                            if state.enabled and b and validBall(b) then
                                startMagnet()
                            end
                        end)
