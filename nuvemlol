                maxTime = 3.5,
                lineColor = Color3.fromRGB(160, 45, 245),
                secondaryColor = Color3.fromRGB(210, 110, 255),
                landingColor = Color3.fromRGB(180, 60, 255)
            }
        }

        local STYLE_OPTIONS = {
            "Auto", "Yukimiya", "Kaiser", "Mastery Kaiser", "Sae", "Rin", "Karasu"
        }

        local STYLE_OPTION_TO_KEY = {
            ["Yukimiya"] = "yukimiya",
            ["Kaiser"] = "kaiser",
            ["Mastery Kaiser"] = "masterykaiser",
            ["Sae"] = "sae",
            ["Rin"] = "rin",
            ["Karasu"] = "karasu"
        }

        local state = {
            enabled = false,
            selectedStyle = "Auto",
            verticalMultiplier = 1,
            lineThickness = 0.2,
            lineTransparency = 0.2,
            maxPoints = 50,
            onlyNearEnemyGoal = false,
            onlyInOurGoal = false,
            onlyWhenGK = false,
            model = nil,
            traces = {},
            landing = nil,
            connection = nil,
            colorsForStyle = nil,
            currentStyle = nil,
            points = table.create(50)
        }

        local GOALBOXES = {
            A = { minX = -858.91, maxX = -217.89, minZ = 1500.9, maxZ = 1706.09 },
            B = { minX = -858.61, maxX = -217.91, minZ = 841.9, maxZ = 1041.18 }
        }

        local function normalizeStyle(raw)
            raw = tostring(raw or ""):lower():gsub("%s+", "")
            if raw == "mastery_kaiser" then raw = "masterykaiser" end
            return raw
        end

        local function getStyle()
            if state.selectedStyle ~= "Auto" then
                return STYLE_OPTION_TO_KEY[state.selectedStyle]
            end

            local char = player.Character
            local raw = player:GetAttribute("style") or player:GetAttribute("Style")

            if char then
                raw = char:GetAttribute("style") or char:GetAttribute("Style") or raw
                local st = char:FindFirstChild("state")
                local sv = st and st:FindFirstChild("style")
                if sv and sv.Value and tostring(sv.Value) ~= "" then
                    raw = sv.Value
                end
            end

            return normalizeStyle(raw)
        end

        local function getTeam()
            local chars = Workspace:FindFirstChild("characters")
            local wc = chars and chars:FindFirstChild(player.Name)
            local st = wc and wc:FindFirstChild("state")
            local tv = st and st:FindFirstChild("team")
            local raw = tv and tostring(tv.Value):upper() or ""

            if raw == "A" then return "A" end
            if raw == "B" then return "B" end

            local char = player.Character
            local cst = char and char:FindFirstChild("state")
            local ctv = cst and cst:FindFirstChild("team")
            raw = ctv and tostring(ctv.Value):upper() or raw

            if raw == "A" then return "A" end
            if raw == "B" then return "B" end
            return nil
        end

        local function inBox(position, box)
            return position.X >= box.minX
                and position.X <= box.maxX
                and position.Z >= box.minZ
                and position.Z <= box.maxZ
        end

        local function clearVisual()
            for i = 1, #state.traces do
                local part = state.traces[i]
                if part and part.Parent then
                    part.Transparency = 1
                    part.CFrame = CFrame.new(0, -500, 0)
                end
            end

            if state.landing and state.landing.Parent then
                state.landing.Transparency = 1
                state.landing.CFrame = CFrame.new(0, -500, 0)
            end
        end

        local function ensureVisual()
            if state.model and state.model.Parent then return end

            local effects = Workspace:FindFirstChild("Effects") or Workspace
            local model = Instance.new("Model")
            model.Name = "AzureLockShotPrediction"
            model.Parent = effects

            state.model = model
            table.clear(state.traces)

            for i = 1, state.maxPoints do
                local part = Instance.new("Part")
                part.Name = "Trace_" .. i
                part.Anchored = true
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
                part.CastShadow = false
                part.Material = Enum.Material.Neon
                part.Transparency = 1
                part.Size = Vector3.new(state.lineThickness, state.lineThickness, 1)
                part.CFrame = CFrame.new(0, -500, 0)
                part.Parent = model
                state.traces[i] = part
            end

            local landing = Instance.new("Part")
            landing.Name = "LandingMarker"
            landing.Anchored = true
            landing.CanCollide = false
            landing.CanTouch = false
            landing.CanQuery = false
            landing.CastShadow = false
            landing.Material = Enum.Material.Neon
            landing.Shape = Enum.PartType.Cylinder
            landing.Size = Vector3.new(2.3, 0.15, 2.3)
            landing.Transparency = 1
            landing.CFrame = CFrame.new(0, -500, 0)
            landing.Parent = model
            state.landing = landing
        end

        local function destroyVisual()
            if state.model and state.model.Parent then
                state.model:Destroy()
            end
            state.model = nil
            state.landing = nil
            table.clear(state.traces)
        end

        local function updateColors(config)
            if state.colorsForStyle == config then return end
            state.colorsForStyle = config

            local last = math.max(1, state.maxPoints - 1)
            for i = 1, #state.traces do
                local alpha = (i / last) * 0.75
                state.traces[i].Color = config.lineColor:Lerp(config.secondaryColor, alpha)
            end

            if state.landing then
                state.landing.Color = config.landingColor
            end
        end

        local function aimDirection(root)
            local camera = Workspace.CurrentCamera
            if not camera then return root.CFrame.LookVector end

            local _, yaw, _ = camera.CFrame:ToEulerAnglesYXZ()
            local flat = CFrame.fromEulerAnglesYXZ(0, yaw, 0).LookVector
            local vertical = camera.CFrame.LookVector.Y * state.verticalMultiplier
            vertical = math.clamp(vertical, 0.15, 1)

            local dir = Vector3.new(flat.X, vertical, flat.Z)
            return dir.Magnitude > 0.001 and dir.Unit or root.CFrame.LookVector
        end

        local function startPosition(char, root, direction)
            local attached = char:FindFirstChild("Ball")
            if attached and attached:IsA("BasePart")
                and attached.Position.Y < root.Position.Y - 1 then
                return attached.Position
            end

            local worldBall = Workspace:FindFirstChild("Football")
                or (Workspace:FindFirstChild("Effects") and Workspace.Effects:FindFirstChild("Ball"))

            if worldBall and worldBall:IsA("BasePart")
                and (worldBall.Position - root.Position).Magnitude < 7
                and worldBall.Position.Y < root.Position.Y - 1 then
                return worldBall.Position
            end

            local horizontal = Vector3.new(direction.X, 0, direction.Z)
            horizontal = horizontal.Magnitude > 0.001 and horizontal.Unit or root.CFrame.LookVector

            return Vector3.new(
                root.Position.X + horizontal.X * 1.8,
                root.Position.Y - 2.15,
                root.Position.Z + horizontal.Z * 1.8
            )
        end

        local function barrierParams(char)
            local params = RaycastParams.new()
            local map = Workspace:FindFirstChild("map")
            local barrier = map and map:FindFirstChild("barriar")

            if barrier then
                params.FilterType = Enum.RaycastFilterType.Include
                params.FilterDescendantsInstances = { barrier }
                return params, true
            end

            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = char and { char } or {}
            return params, false
        end

        local function simulate(cframe, initialVelocity, config, char)
            local gravity = -490.5
            local speed = config.speed
            local maxTime = config.maxTime
            local curveTime = config.curveTime
            local curvePower = config.curvePower
            local curve = config.curve

            local velocity = initialVelocity
            local curveBase = velocity.Magnitude * curveTime
            local negativeRight = -cframe.RightVector

            if curve then
                if curve == "up" then
                    curveBase *= 0.5
                elseif curve == "left" then
                    velocity += -cframe.RightVector * curveBase
                else
                    velocity += cframe.RightVector * curveBase
                end
            end

            local x, y, z = cframe.Position.X, cframe.Position.Y, cframe.Position.Z
            local vx, vy, vz = velocity.X, velocity.Y, velocity.Z
            local elapsed = 0
            local curveElapsed = 0
            local dtStep = 1 / 45
            local bounces = 5
            local groundY = 0.85
            local count = 1

            state.points[1] = Vector3.new(x, y, z)

            local rayParams, hasBarrier = barrierParams(char)

            while elapsed < maxTime do
                local step = math.min(dtStep, maxTime - elapsed)
                elapsed += step
                if step <= 0 then break end

                local physicsDt = step / speed
                local speedSq = vx * vx + vy * vy + vz * vz

                if speedSq > 0.01 then
                    local drag = math.pow(0.1, physicsDt)
                    vx *= drag
                    vy *= drag
                    vz *= drag
                end

                vy += gravity * physicsDt

                local nextVX, nextVY, nextVZ = vx, vy, vz

                if curve == "up" then
                    if curveElapsed < curveTime then
                        curveElapsed = math.clamp(curveElapsed + physicsDt, 0, curveTime)
                        nextVY += (
                            ((2 * (curveBase * curvePower)) / curveTime)
                            * (1 - curveElapsed / curveTime)
                        ) * physicsDt

                        if curveElapsed >= curveTime then
                            curve = nil
                        end
                    end
                elseif curve and curveElapsed < curveTime then
                    curveElapsed = math.clamp(curveElapsed + physicsDt, 0, curveTime)
                    local force = (curveBase * curvePower * 2) * physicsDt

                    if curve == "left" then
                        nextVX -= negativeRight.X * force
                        nextVZ -= negativeRight.Z * force
                    else
                        nextVX += negativeRight.X * force
                        nextVZ += negativeRight.Z * force
                    end
                end

                if hasBarrier then
                    local horizontalMove = Vector3.new(nextVX * physicsDt, 0, nextVZ * physicsDt)
                    local current = Vector3.new(x, y, z)
                    local hit = Workspace:Raycast(current, horizontalMove, rayParams)

                    if hit then
                        local n = hit.Normal
                        local dot = nextVX * n.X + nextVZ * n.Z
                        nextVX -= 2 * dot * n.X
                        nextVZ -= 2 * dot * n.Z
                        x = hit.Position.X + n.X * 0.1
                        z = hit.Position.Z + n.Z * 0.1

                        if curve then
                            nextVX *= 0.5
                            nextVZ *= 0.5
                            curve = nil
                        end
                    end
                end

                x += nextVX * physicsDt
                y += nextVY * physicsDt
                z += nextVZ * physicsDt

                if y <= groundY then
                    y = groundY

                    if math.abs(nextVY) > 0.1 and bounces > 0 then
                        bounces -= 1
                        nextVY = -nextVY * 0.7
                    else
                        nextVY = 0
                    end

                    if nextVX * nextVX + nextVZ * nextVZ < 0.01 then
                        nextVX = 0
                        nextVZ = 0
                    end
                end

                vx, vy, vz = nextVX, nextVY, nextVZ
                count += 1
                state.points[count] = Vector3.new(x, y, z)

                if count >= state.maxPoints then break end
                if (vx * vx + vy * vy + vz * vz) < 0.01 and y < 1.85 then break end
            end

            return count
        end

        local function render(count, config)
            if count < 2 then
                clearVisual()
                return
            end

            updateColors(config)

            local segments = count - 1

            for i = 1, segments do
                local a = state.points[i]
                local b = state.points[i + 1]
                local delta = b - a
                local length = delta.Magnitude
                local part = state.traces[i]

                if length > 0.02 then
                    part.Size = Vector3.new(state.lineThickness, state.lineThickness, length)
                    part.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -length * 0.5)
                    part.Transparency = state.lineTransparency
                else
                    part.Transparency = 1
                end
            end

            for i = segments + 1, #state.traces do
                if state.traces[i].Transparency ~= 1 then
                    state.traces[i].Transparency = 1
                    state.traces[i].CFrame = CFrame.new(0, -500, 0)
                end
            end

            local landingPoint = state.points[count]
            state.landing.Transparency = 0.35
            state.landing.CFrame =
                CFrame.new(landingPoint.X, landingPoint.Y + 0.08, landingPoint.Z)
                * CFrame.Angles(0, 0, math.rad(90))
        end

        local function allowedByFilters(root)
            local char = player.Character
            if state.onlyWhenGK then
                local st = char and char:FindFirstChild("state")
                local roleValue = st and st:FindFirstChild("role")
                if not roleValue or tostring(roleValue.Value) ~= "GK" then
                    return false
                end
            end

            local team = getTeam()
            if state.onlyNearEnemyGoal or state.onlyInOurGoal then
                if not team then return false end

                local enemy = team == "A" and GOALBOXES.B or GOALBOXES.A
                local ours = team == "A" and GOALBOXES.A or GOALBOXES.B

                if state.onlyNearEnemyGoal and not inBox(root.Position, enemy) then
                    return false
                end

                if state.onlyInOurGoal and not inBox(root.Position, ours) then
                    return false
                end
            end

            return true
        end

        local function update()
            if not state.enabled then
                clearVisual()
                return
            end

            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not root or not char:IsDescendantOf(Workspace) then
                clearVisual()
                return
            end

            if not allowedByFilters(root) then
                clearVisual()
                return
            end

            local style = getStyle()
            local config = style and SHOT_CONFIGS[style]
            if not config then
                clearVisual()
                return
            end

            ensureVisual()

            local direction = aimDirection(root)
            local origin = startPosition(char, root, direction)
            local shotCFrame = CFrame.lookAt(origin, origin + direction)
            local velocity = direction * ((config.shotPower / 10) * 50)

            local count = simulate(shotCFrame, velocity, config, char)
            render(count, config)
            state.currentStyle = style
        end

        local function stop()
            state.enabled = false
            if state.connection then
                state.connection:Disconnect()
                state.connection = nil
            end
            clearVisual()
        end

        local function start()
            stop()
            state.enabled = true
            ensureVisual()
            state.connection = RunService.RenderStepped:Connect(update)
        end

        -- V16 native section has exactly four visible controls.
        folder:Toggle("Only In Our Goalbox", nil, false, function(value)
            state.onlyInOurGoal = value == true
        end)

        folder:Toggle("Only Near Goal", nil, false, function(value)
            state.onlyNearEnemyGoal = value == true
        end)

        folder:Toggle("Only When GK", nil, false, function(value)
            state.onlyWhenGK = value == true
        end)

        folder:Toggle(
            "Shot Predictor",
            nil,
            false,
            function(value)
                if value then start() else stop() end
            end
        )

        player.CharacterAdded:Connect(function()
            task.wait(0.25)
            if state.enabled then
                clearVisual()
            end
        end)
    end

    installEvoHubREShotPredictor()
end

