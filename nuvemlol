                if cfg._animId and id == cfg._animId then
                    match = true

                elseif cfg._animIds then
                    if cfg.isDirectional then
                        directionName =
                            cfg._animIds[id]

                        if directionName then
                            match = true
                        end
                    elseif cfg._animIds[id] then
                        match = true
                    end
                end

                if match and cfg.moveName then
                    local wildActive =
                        (Distances.wildInstinctsDist or 0) > 0

                    local scorpionActive =
                        (Distances.scorpionDist or 0) > 0

                    if wildActive and scorpionActive then
