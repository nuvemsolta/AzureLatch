    local function setThemeAccent(color)
        if typeof(color) ~= "Color3" then return end
        Theme.Accent = color
        for i = #Library.AccentElements, 1, -1 do
            local entry = Library.AccentElements[i]
            if not entry.Object or not entry.Object.Parent then
                table.remove(Library.AccentElements, i)
            else
                pcall(function()
                    entry.Object[entry.Property] = color
                end)
            end
        end
        for i = #Library.AccentTextElements, 1, -1 do
            local object = Library.AccentTextElements[i]
            if not object or not object.Parent then
                table.remove(Library.AccentTextElements, i)
            else
                object.TextColor3 = color
            end
        end
    end
