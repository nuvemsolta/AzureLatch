                    end
                end)
            end

            if axisConnection then
                axisConnection:Disconnect()
            end

            axisConnection = RunService.Heartbeat:Connect(function()
                if os.clock() < freezeRightUntil then
                    return
                end

                local _, _, root = getCharacter()

                if not root then
                    cachedRight = nil
                    return
                end

                local right = flatUnit(root.CFrame.RightVector)

                if right then
                    cachedRight = right
                end
            end)

            if Players.LocalPlayer.Character then
                local _, _, root = getCharacter()

                if root then
                    cachedRight = flatUnit(root.CFrame.RightVector)
                end

                hookAnimator(Players.LocalPlayer.Character)
            end

            Players.LocalPlayer.CharacterAdded:Connect(function(char)
                generation += 1
                cachedRight = nil
                freezeRightUntil = 0

                cancelBoost(
                    DashConfigs.WildInstincts
                )

                cancelBoost(
                    DashConfigs.Scorpion
                )

                task.defer(
                    hookAnimator,
                    char
                )
            end)
        end


