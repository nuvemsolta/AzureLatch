            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then return end

            if nagiTrap.animConn then nagiTrap.animConn:Disconnect() end
            nagiTrap.animConn = hum.AnimationPlayed:Connect(function(track)
                if not nagiTrap.enabled then return end
                local id = track.Animation and tostring(track.Animation.AnimationId) or ""
                if id:find("73387016994281", 1, true) then
                    task.delay(nagiTrap.activationDelay, function()
