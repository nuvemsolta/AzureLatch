            local function cloneAnimations(withMaxDistance)
                local out = {}
                local controls = {}

                for id, info in pairs(COMMON_ANIMATIONS) do
                    out[id] = {
                        delay = info.delay,
                        maxDistance = withMaxDistance and 90 or nil,
                    }
                    table.insert(controls, {name = info.name, id = id})
                end

                return out, controls
            end

            local function inGoalbox(position, team, enemy)
                local box
                if enemy then
                    box = AutoDefensive.GlobalEnemyGoalboxes[team == "A" and "B" or "A"]
                else
                    box = AutoDefensive.GlobalGoalboxes[team]
                end

                return box
                    and position.X >= box.minX
                    and position.X <= box.maxX
                    and position.Z >= box.minZ
                    and position.Z <= box.maxZ
                    or false
            end

            local function velocityPointsAt(ball, velocity, targetPosition)
                if not ball or velocity.Magnitude == 0 then
                    return false
                end

                return velocity.Unit:Dot((targetPosition - ball.Position).Unit)
                    > math.cos(math.rad(45))
            end

            local function withinVariantRange(ball, targetPosition, variant)
                if not ball then
                    return false
                end

                local horizontal = (
                    Vector3.new(targetPosition.X, 0, targetPosition.Z)
                    - Vector3.new(ball.Position.X, 0, ball.Position.Z)
                ).Magnitude

                local maxHorizontal = variant.maxBallDistance or AutoDefensive.MAX_BALL_DISTANCE
                local maxVertical = variant.maxVerticalDistance or AutoDefensive.MAX_VERTICAL_DISTANCE

                return horizontal <= maxHorizontal
                    and math.abs(targetPosition.Y - ball.Position.Y) <= maxVertical
            end

            local function facingWithin(root, targetPosition, degrees)
                if not root then
                    return false
                end

                degrees = degrees or 20
                return root.CFrame.LookVector:Dot((targetPosition - root.Position).Unit)
                    > math.cos(math.rad(degrees))
            end

            local function behindOrSide(root, targetPosition)
                if not root then
                    return false
                end

                return root.CFrame.LookVector:Dot((targetPosition - root.Position).Unit)
                    < math.cos(math.rad(60))
            end

            -- Returns closestTime, closestHorizontalDistance, closestVerticalDistance.
            local function predictClosestApproach(ball, velocity, targetPosition, maxTime)
                if not ball or velocity.Magnitude <= 0 then
                    return nil
                end

                local position = ball.Position
                local currentVelocity = velocity

                local bestTime = nil
                local bestHorizontal = math.huge
                local bestVertical = math.huge

                for t = 0, maxTime, 0.05 do
                    local horizontal = (
                        Vector3.new(position.X, 0, position.Z)
                        - Vector3.new(targetPosition.X, 0, targetPosition.Z)
                    ).Magnitude
                    local vertical = math.abs(position.Y - targetPosition.Y)

                    if horizontal < bestHorizontal then
                        bestTime = t
                        bestHorizontal = horizontal
                        bestVertical = vertical
                    end

                    position += currentVelocity * 0.05
                    currentVelocity = Vector3.new(
                        currentVelocity.X * 0.9737,
                        currentVelocity.Y - Workspace.Gravity * 0.05,
                        currentVelocity.Z * 0.9737
                    )
                end

                if bestHorizontal <= AutoDefensive.MAX_BALL_DISTANCE
                    and bestVertical <= AutoDefensive.MAX_VERTICAL_DISTANCE then
                    return bestTime, bestHorizontal, bestVertical
                end

                return nil
            end

            local function findCurrentBallOwner()
                local characters = Workspace:FindFirstChild("characters")
                if not characters then
                    return nil, nil
                end

                for _, character in ipairs(characters:GetChildren()) do
                    if character:FindFirstChild("Ball") then
                        local state = character:FindFirstChild("state")
                        local team = state and state:FindFirstChild("team")
                        if team then
                            return character.Name, team.Value
                        end
                    end
                end

                return nil, nil
            end

            local function targetTeamMatches(variant, ownerTeam, ourTeam)
                local mode = variant.targetTeam or "enemy"

                if mode == "enemy" then
                    return ownerTeam ~= ourTeam
                elseif mode == "teammate" then
                    return ownerTeam == ourTeam
                elseif mode == "both" then
                    return true
                end

                return false
            end

            local function passesGoalboxFilters(variant, rootPosition, ourTeam)
                local ownGoalbox = inGoalbox(rootPosition, ourTeam, false)
                local enemyGoalbox = inGoalbox(rootPosition, ourTeam, true)

                if variant.goalboxOnly and not ownGoalbox then
                    return false
                end

                if variant.enemyGoalboxOnly and not enemyGoalbox then
                    return false
                end

                if variant.ownGoalboxOnly and not ownGoalbox then
                    return false
                end

                return true
            end

            local function jump()
                local character = LocalPlayer.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    humanoid.Jump = true
                end
            end

            local function flickAwayFromCamera(targetPosition)
                local camera = Workspace.CurrentCamera
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")

                if not camera or not root then
                    return
                end

                local toTarget = targetPosition - root.Position
                if toTarget.Magnitude <= 0 then
                    return
                end

                if root.CFrame.LookVector:Dot(toTarget.Unit) <= 0.5 then
                    return
                end

                local look = camera.CFrame.LookVector
                local backwards = Vector3.new(-look.X, 0, -look.Z)
                if backwards.Magnitude <= 0 then
                    return
                end

                backwards = backwards.Unit
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + backwards)
                root.CFrame = CFrame.new(root.Position, root.Position + backwards)
            end

            local function aggressiveFire(skill, virtualKey)
                local remote = ReplicatedStorage:FindFirstChild("ByteNetReliable")
                    or AutoDefensive.ByteNetReliable

                if remote then
                    pcall(function()
                        remote:FireServer(Core:useBuffer(), {{skill}})
                    end)

                    pcall(function()
                        remote:FireServer(Core:useBuffer(), {{skill, true}})
                    end)
                end

                -- The original then fires the same skill through its generic helper again.
                Core:fireUse(skill)

                pcall(function()
                    local packets = require(ReplicatedStorage:FindFirstChild("packets"))
                    if packets and packets.bytenet_use and packets.bytenet_use.send then
                        packets.bytenet_use.send({skill})
                        packets.bytenet_use.send({skill, true})
                    end
                end)

                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, virtualKey, false, game)
                    task.delay(0.03, function()
                        pcall(function()
                            vim:SendKeyEvent(false, virtualKey, false, game)
                        end)
                    end)
                end)
            end

            function AutoDefensive:Register(variant)
                table.insert(self.Variants, variant)
                return variant
            end

            local function mainStep()
                if not AutoDefensive.Enabled or not LocalPlayer.Character then
                    return
                end

                local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not root then
                    return
                end

                local ourTeam = Core:getTeam(LocalPlayer.Name)
                if not ourTeam or ourTeam == "lobby" then
                    return
                end

                local style = LocalPlayer:GetAttribute("style")

                local variant = nil
                for _, candidate in ipairs(AutoDefensive.Variants) do
                    if candidate.enabled and candidate.isSupported(style) then
                        variant = candidate
                        break
                    end
                end

                if not variant then
                    return
                end

                local rootPosition = root.Position
                local now = tick()

                local characters = Workspace:FindFirstChild("characters")
                if not characters then
                    return
                end

                local ownerName, ownerTeam = findCurrentBallOwner()
                if ownerTeam then
                    AutoDefensive.lastBallOwnerTeam = ownerTeam
                    AutoDefensive.lastBallOwnerName = ownerName
                end

                local ball = Workspace.Terrain:FindFirstChild("Ball")
                    or Workspace:FindFirstChild("Ball")

                local cfBall = ReplicatedStorage:FindFirstChild("CFBall")
                local velocityValue = cfBall and cfBall:FindFirstChild("velocity")

                if ball and velocityValue then
                    local velocity = velocityValue.Value
                    local valid = velocity.Magnitude >= variant.minBallSpeed
                    local context = {isBallDirectlyAtUs = false}

                    if valid and variant.useImpact then
                        local impactTime, horizontal = predictClosestApproach(
                            ball,
                            velocity,
                            rootPosition,
                            variant.predictWindow or 0.75
                        )

                        if not impactTime then
                            valid = false
                        elseif horizontal <= 12 then
                            context.isBallDirectlyAtUs = true
                        end

                    elseif valid then
                        local fullDistance = (ball.Position - rootPosition).Magnitude
                        local movingToward = velocityPointsAt(ball, velocity, rootPosition)
                        local inRange = withinVariantRange(ball, rootPosition, variant)

                        if not inRange then
                            valid = false
                        elseif not movingToward and fullDistance > 15 then
                            valid = false
                        elseif velocity.Magnitude > 0
                            and velocity.Unit:Dot((rootPosition - ball.Position).Unit) > 0.85 then
                            context.isBallDirectlyAtUs = true
                        end
                    end

                    local ownerMatches = targetTeamMatches(
                        variant,
                        AutoDefensive.lastBallOwnerTeam,
                        ourTeam
                    )

                    if valid
                        and AutoDefensive.lastBallOwnerTeam
                        and AutoDefensive.lastBallOwnerTeam ~= "lobby"
                        and AutoDefensive.lastBallOwnerName ~= LocalPlayer.Name
                        and ownerMatches
                        and passesGoalboxFilters(variant, rootPosition, ourTeam)
                        and now - AutoDefensive.LastDefenseTime > 2 then

                        if variant.performDefense(ball, rootPosition, velocity, context) then
                            AutoDefensive.LastDefenseTime = now
                        end
                    end
                end

                -- Expire stale animation prediction records.
                for key, record in pairs(AutoDefensive.AnimationTracking) do
                    if now - record.detectedTime > 5 then
                        AutoDefensive.AnimationTracking[key] = nil
                    end
                end

                if not variant.animPredict
                    or not passesGoalboxFilters(variant, rootPosition, ourTeam) then
                    return
                end

                for _, target in ipairs(characters:GetChildren()) do
                    if target.Name ~= LocalPlayer.Name and target:FindFirstChild("Ball") then
                        local state = target:FindFirstChild("state")
                        local team = state and state:FindFirstChild("team")

                        if team and team.Value ~= "lobby"
                            and targetTeamMatches(variant, team.Value, ourTeam) then

                            local targetRoot = target:FindFirstChild("HumanoidRootPart")
                            local humanoid = target:FindFirstChildOfClass("Humanoid")
                            local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

                            if targetRoot and animator then
                                local dist = (targetRoot.Position - rootPosition).Magnitude
                                local enemyFacingUs = facingWithin(targetRoot, rootPosition, 45)
                                local areWeFacingEnemy = facingWithin(root, targetRoot.Position, 45)
                                local isBehindOrSide = behindOrSide(targetRoot, rootPosition)

                                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                    local id = track.Animation and track.Animation.AnimationId
                                    local animCfg = id and variant.animations[id]

                                    if id and track.IsPlaying and animCfg then
                                        if not animCfg.maxDistance or dist <= animCfg.maxDistance then
                                            local key = target.Name .. "_" .. id
                                            local record = AutoDefensive.AnimationTracking[key]

                                            if not record then
                                                record = {
                                                    detectedTime = now,
                                                    hasTriggered = false,
                                                    delay = animCfg.delay,
                                                }
                                                AutoDefensive.AnimationTracking[key] = record
                                            end

                                            if not record.hasTriggered
                                                and now - record.detectedTime >= record.delay
                                                and now - AutoDefensive.LastDefenseTime > 2 then

                                                -- Exact quirk recovered from the source:
                                                -- in this path isBallDirectlyAtUs is set equal to enemyFacingUs.
                                                local animContext = {
                                                    isEnemyFacingUs = enemyFacingUs,
                                                    areWeFacingEnemy = areWeFacingEnemy,
                                                    isBehindOrSide = isBehindOrSide,
                                                    dist = dist,
                                                    targetHrp = targetRoot,
                                                    isBallDirectlyAtUs = enemyFacingUs,
                                                }

                                                if variant.performDefense(
                                                    target:FindFirstChild("Ball"),
                                                    rootPosition,
                                                    nil,
                                                    animContext
                                                ) then
                                                    AutoDefensive.LastDefenseTime = now
                                                    record.hasTriggered = true
                                                end
                                            end
                                        end

                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end

            function AutoDefensive:CheckAnyEnabled()
                local anyEnabled = false
                for _, variant in ipairs(self.Variants) do
                    if variant.enabled then
                        anyEnabled = true
                        break
                    end
                end

                if anyEnabled and not self.Enabled then
                    self.ByteNetReliable = ReplicatedStorage:FindFirstChild("ByteNetReliable")
                    if not self.ByteNetReliable then
                        return
                    end

                    self.Enabled = true
                    self.Connection = RunService.RenderStepped:Connect(mainStep)

                elseif not anyEnabled and self.Enabled then
                    self.Enabled = false

                    if self.Connection then
                        self.Connection:Disconnect()
                        self.Connection = nil
                    end

                    self.AnimationTracking = {}
                    self.LastDefenseTime = 0
                end
            end

