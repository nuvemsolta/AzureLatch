local function testBallTarget()
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    local freeBall = terrain and terrain:FindFirstChild("Ball")
    if freeBall then
        if freeBall:IsA("BasePart") then
            return freeBall
        elseif freeBall:IsA("Model") then
            return freeBall.PrimaryPart or freeBall:FindFirstChildWhichIsA("BasePart", true)
        end
    end

    for _, plr in ipairs(testFeatureRuntime.Players:GetPlayers()) do
        if plr ~= testFeatureRuntime.LocalPlayer then
            local char = testWorldCharacter(plr)
            local held = char and char:FindFirstChild("Ball")
            if held then
                if held:IsA("BasePart") then
                    return held
                elseif held:IsA("Model") then
                    return held.PrimaryPart or held:FindFirstChildWhichIsA("BasePart", true)
                else
                    return held:FindFirstChildWhichIsA("BasePart", true)
                end
            end
        end
    end

    return nil
end

testFeatures:Button(
    "Bring Ball",
    "Celeron Test: Steals The Ball Then Teleports Back. Click Again To Cancel.",
    function()
        local localPlayer = testFeatureRuntime.LocalPlayer
        local hrp = testRoot(localPlayer)
        if not hrp then return end

        if testBringActive then
            testBringActive = false
            return
        end

        testBringActive = true
        local originalCFrame = hrp.CFrame

        task.spawn(function()
            while testBringActive do
                hrp = testRoot(localPlayer)
                if not hrp or not hrp.Parent then break end
                if testHasBall(localPlayer) then break end

                local ball = testBallTarget()
                if ball and ball.Parent then
                    hrp.CFrame = CFrame.new(ball.Position)
                end

                -- Exact Celeron idea: when another player owns the ball,
                -- teleport to it and issue the normal tackle packet.
                for _, plr in ipairs(testFeatureRuntime.Players:GetPlayers()) do
                    if not testBringActive then break end
                    if plr ~= localPlayer and testHasBall(plr) then
                        local otherChar = testWorldCharacter(plr)
                        local held = otherChar and otherChar:FindFirstChild("Ball")
                        local heldPart = held

                        if held and held:IsA("Model") then
                            heldPart = held.PrimaryPart
                                or held:FindFirstChildWhichIsA("BasePart", true)
                        elseif held and not held:IsA("BasePart") then
                            heldPart = held:FindFirstChildWhichIsA("BasePart", true)
                        end

                        if heldPart and heldPart:IsA("BasePart") then
                            hrp.CFrame = heldPart.CFrame
                            if testFeatureRuntime.ByteNetReliable then
                                pcall(function()
                                    testFeatureRuntime.ByteNetReliable:FireServer(
                                        testFeatureRuntime.basePacket,
                                        {{"tackle"}}
                                    )
                                end)
                            end
                        end
                    end
                end

                task.wait(0.05)
            end

            hrp = testRoot(localPlayer)
            if testBringActive
                and hrp
                and hrp.Parent
                and testHasBall(localPlayer) then
                hrp.CFrame = originalCFrame
            end

            testBringActive = false
        end)
    end
)

