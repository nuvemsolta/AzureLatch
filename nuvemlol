                return cam and (
                    cam.CameraType == Enum.CameraType.Scriptable
                    or cam.CameraType == Enum.CameraType.Fixed
                )
            end

            local function stopAnim()
                if state.CurrentTrack then
                    pcall(function() state.CurrentTrack:Stop() end)
                    state.CurrentTrack = nil
                end
                state.IsPlayingAnimation = false
                state.JumpAfterKick = false
            end

            local function playAnim()
                if state.CurrentTrack then
                    pcall(function() state.CurrentTrack:Stop() end)
                end

                local track = makeTrackN("76587445975710")
                state.CurrentTrack = track
                if track then pcall(function() track:Play() end) end
                state.IsPlayingAnimation = true
                state.JumpAfterKick = true

                task.delay(state.AnimationDuration, function()
                    if state.Enabled then
                        state.IsPlayingAnimation = false
                    end
                end)
            end

            local function kickVector(root)
                -- Exact recovered EvoHub direction logic.
                -- Power is packet strength; it does not alter this direction.
                local look = root.CFrame.LookVector
                local v = Vector3.new(
                    look.X * state.Forward,
                    state.Height,
                    look.Z * state.Forward
                )

                if v.Magnitude <= 0 then
                    return Vector3.new(0, state.VectorScale, 0)
                end

                return v.Unit * state.VectorScale
            end

            local function autoJump()
                if not state.AutoJumpEnabled then return end

                local char = LocalPlayerN.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then return end

                local start = tick()
                while tick() - start <= 1 do
                    local humState = hum:GetState()
                    if humState == Enum.HumanoidStateType.Landed
                        or humState == Enum.HumanoidStateType.Running
                        or humState == Enum.HumanoidStateType.RunningNoPhysics then

                        task.wait(0.03)
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        hum.Jump = true
                        return
                    end
                    task.wait()
                end
            end

            local function execute()
                if not state.Enabled or cameraBlocked() then return false end

                local now = tick()
                if now - state.LastExecution < state.ExecutionDelay then
                    return false
                end

                local char = LocalPlayerN.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return false end

                if not hasBallN() then
                    stopAnim()
                    return false
                end

                playAnim()
                fireKickN(state.Power, kickVector(root))

                if state.AutoJumpEnabled then
                    task.spawn(function()
                        task.wait(0.15)
                        autoJump()
                    end)
                end

                state.LastExecution = now
                return true
            end

            local function holdLoop()
                while state.Enabled and state.IsKeyHeld do
                    if cameraBlocked() then
                        task.wait(0.1)
                    elseif hasBallN() then
                        execute()
                        task.wait()
                    else
                        task.wait()
                    end
                end
            end

            local function setEnabled(v)
                state.Enabled = v == true
                state.IsPlayingAnimation = false
                state.IsKeyHeld = false
                state.IsActive = false

                if state.Enabled then
                    state.JumpAfterKick = true
                else
                    state.JumpAfterKick = false
                    stopAnim()
                end

                notifyN("Air Dribble " .. (state.Enabled and "Enabled" or "Disabled"))
            end

            local function removeMobile()
                for i = 1, #state.MobileConnections do
                    local connection = state.MobileConnections[i]
                    if connection then
                        pcall(function() connection:Disconnect() end)
                    end
                end
                table.clear(state.MobileConnections)

                if state.MobileGui then
