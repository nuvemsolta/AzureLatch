            player = player or LocalPlayerN
            local chars = WorkspaceN:FindFirstChild("characters")
            local char = chars and chars:FindFirstChild(player.Name)
            if not char then char = player.Character end
            return char and char:FindFirstChild("Ball") ~= nil
