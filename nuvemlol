                        else
                            direction = horizontalUnit(hrp.CFrame.LookVector, FALLBACK_FORWARD)
                        end
                    else
                        direction = horizontalUnit(hrp.CFrame.LookVector, FALLBACK_FORWARD)
                    end

                    if not direction or direction.Magnitude < 0.01 then
                        direction = FALLBACK_FORWARD
