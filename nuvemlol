local autoGoalState = {
    enabled = false,
    conn = nil,
    accumulator = 0,
    busy = false
}

local autoGoalPlayers = game:GetService("Players")
local autoGoalRunService = game:GetService("RunService")
local autoGoalReplicatedStorage = game:GetService("ReplicatedStorage")
local autoGoalRemote = autoGoalReplicatedStorage:WaitForChild("ByteNetReliable")
local autoGoalPacket = buffer.fromstring(buffers["base"])
local autoGoalPlayer = autoGoalPlayers.LocalPlayer

local function autoGoalCharacter()
    return autoGoalPlayer.Character
end

local function autoGoalRoot()
    local char = autoGoalCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function autoGoalHasBall()
    local char = autoGoalCharacter()
    return char and char:FindFirstChild("Ball") ~= nil
end

local function autoGoalInGame()
    local char = autoGoalCharacter()
    local stateFolder = char and char:FindFirstChild("state")
    local ingame = stateFolder and stateFolder:FindFirstChild("ingame")
    return ingame and ingame.Value == true
end

local function autoGoalDisableCollisions(map, agoal, bgoal)
    local gk = map and map:FindFirstChild("gkbarriar")
    if gk then
        local a = gk:FindFirstChild("A")
        local b = gk:FindFirstChild("B")
        if a then a.CanCollide = false end
        if b then b.CanCollide = false end
    end
    if agoal then agoal.CanCollide = false end
    if bgoal then bgoal.CanCollide = false end
end

local function autoGoalSteal(root)
    if not root or autoGoalHasBall() then return end

    local looseBall = Workspace.Terrain:FindFirstChild("Ball")
    if looseBall then
        root.CFrame = CFrame.new(looseBall.Position.X, 0, looseBall.Position.Z)
        return
    end

    for _, otherPlayer in ipairs(autoGoalPlayers:GetPlayers()) do
        if otherPlayer ~= autoGoalPlayer then
            local otherCharacter = otherPlayer.Character
            local heldBall = otherCharacter and otherCharacter:FindFirstChild("Ball")
            local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
            if heldBall and otherRoot then
                root.CFrame = otherRoot.CFrame
                autoGoalRemote:FireServer(autoGoalPacket, {{"tackle"}})
                return
            end
        end
    end
end

ballfolder:Toggle("Auto Goal", "Attempts To Steal The Ball And Score.", function()
    autoGoalState.enabled = not autoGoalState.enabled
    game.StarterGui:SetCore("SendNotification", {
        Title = "Auto Goal",
        Text = autoGoalState.enabled and "Enabled." or "Disabled.",
        Duration = 1
    })

    if not autoGoalState.enabled then
        if autoGoalState.conn then
            autoGoalState.conn:Disconnect()
            autoGoalState.conn = nil
        end
        autoGoalState.accumulator = 0
        autoGoalState.busy = false
        return
    end

    local map = Workspace:WaitForChild("map")
    local agoal = map:WaitForChild("Agoal")
    local bgoal = map:WaitForChild("Bgoal")
    autoGoalDisableCollisions(map, agoal, bgoal)

    if autoGoalState.conn then
        autoGoalState.conn:Disconnect()
    end

    autoGoalState.accumulator = 0
    autoGoalState.busy = false

    autoGoalState.conn = autoGoalRunService.Heartbeat:Connect(function(dt)
        if not autoGoalState.enabled then return end

        autoGoalState.accumulator += dt
        if autoGoalState.accumulator < (1 / 30) then return end
        autoGoalState.accumulator = 0

        if not autoGoalInGame() then return end

        local root = autoGoalRoot()
        if not root then return end

        if not autoGoalHasBall() then
            autoGoalSteal(root)
            return
        end

        if autoGoalState.busy then return end
        autoGoalState.busy = true

        task.spawn(function()
            local liveRoot = autoGoalRoot()
            local team = autoGoalPlayer.Team
            local goal = team and team.Name == "A" and bgoal or agoal

            if liveRoot and goal and autoGoalState.enabled then
                liveRoot.CFrame = goal.CFrame
