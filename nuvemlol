                            )
                        end)

                        return true
                    end

                    local direct = context and context.isBallDirectlyAtUs or false

                    if direct then
                        if attempt("skill4", ball, rootPosition, direct) then
                            return true
                        end
                        return attempt("skill3", ball, rootPosition, false)
                    end

                    if variant.preferSkill == "Skill4" then
                        if not Core:isOnCooldown("skill4") then
                            return attempt("skill4", ball, rootPosition, direct)
                        end
                        return attempt("skill3", ball, rootPosition, false)
                    end

                    if not Core:isOnCooldown("skill3") then
