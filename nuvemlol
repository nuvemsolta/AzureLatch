        local function variantPage(variant)
            if variant.name == "Auto Venom Trap" then
                return "Aiku", "Auto Venom Trap"
            elseif variant.name == "Kaiser Auto Volley" then
                return "Kaiser", "Auto Volley"
            elseif variant.name == "Auto Defense" then
                return "Don Lorenzo", "Auto Defense"
            elseif variant.name == "Nel Isagi Auto Volley" or variant.name == "NEL Isagi Auto Volley" then
                return "Nel Isagi", "Auto Volley"
            elseif variant.name == "Auto Frost Guard" then
                return "Hiori", "Auto Frost Guard"
            end
            return nil, nil
        end

        local function normalizeDefensiveStyle(raw)
            return tostring(raw or "")
                :lower()
                :gsub("[%s_%-]", "")
        end

        local function currentDefensiveStyle()
            local raw =
                player:GetAttribute("style")
                or player:GetAttribute("Style")

            local char = player.Character
            if char then
                raw =
                    char:GetAttribute("style")
                    or char:GetAttribute("Style")
                    or raw

                local stateFolder = char:FindFirstChild("state")
                local styleValue =
                    stateFolder
                    and (
                        stateFolder:FindFirstChild("style")
                        or stateFolder:FindFirstChild("Style")
                    )

                if styleValue
                    and styleValue:IsA("ValueBase")
                    and tostring(styleValue.Value) ~= "" then
                    raw = styleValue.Value
                end
            end

            local characters = workspace:FindFirstChild("characters")
            local worldChar =
                characters
                and characters:FindFirstChild(player.Name)
            local worldState =
                worldChar
                and worldChar:FindFirstChild("state")
            local worldStyle =
                worldState
                and (
                    worldState:FindFirstChild("style")
                    or worldState:FindFirstChild("Style")
                )

            if worldStyle
                and worldStyle:IsA("ValueBase")
                and tostring(worldStyle.Value) ~= "" then
                raw = worldStyle.Value
            end

            return normalizeDefensiveStyle(raw)
        end

        local function variantSupportedNow(variant)
            if not variant
                or type(variant.isSupported) ~= "function" then
                return false
            end

            local ok, supported =
                pcall(
                    variant.isSupported,
                    currentDefensiveStyle()
                )

            return ok and supported == true
        end

        local defensiveToggleRecords = {}

        for _, variant in ipairs(defensive.Variants) do
            local pageName, sectionName = variantPage(variant)
            if pageName then
                local folder = playerUI:FolderInGroup(
                    pageName,
                    sectionName .. ".",
                    Color3.fromRGB(24, 255, 228),
                    true,
                    "Player"
                )

                local variantToggle
                variantToggle = folder:Toggle(sectionName, function(value)
                    value = value == true

                    -- Original variants expose isSupported(). Do not merely
                    -- ignore the runtime when the wrong style is equipped:
                    -- reject the UI state itself.
                    if value and not variantSupportedNow(variant) then
                        variant.enabled = false
                        defensive:CheckAnyEnabled()

                        task.defer(function()
                            if variantToggle
                                and variantToggle.Value == true then
                                variantToggle:SetValue(false)
                            end
                        end)

                        return
                    end

                    variant.enabled = value
                    defensive:CheckAnyEnabled()
                end)

                variant._uiToggle = variantToggle

                defensiveToggleRecords[#defensiveToggleRecords + 1] = {
                    Variant = variant,
                    Toggle = variantToggle,
                    Page = pageName,
                    Name = sectionName,
                }

                -- Saved configs are restored visually without callbacks.
                -- Only restore an enabled defense if this style supports it.
                if variantToggle and variantToggle.Value == true then
                    if variantSupportedNow(variant) then
                        variant.enabled = true
                    else
                        variant.enabled = false
                        variantToggle:SetValue(false)
                    end
                end

                if variant.goalboxOnly ~= nil then
                    folder:Toggle("Goalbox Only", nil, variant.goalboxOnly, function(value)
                        variant.goalboxOnly = value == true
                    end)
                end
                if variant.enemyGoalboxOnly ~= nil then
                    folder:Toggle("Only near/in Enemy Goalbox", nil, variant.enemyGoalboxOnly, function(value)
                        variant.enemyGoalboxOnly = value == true
                    end)
                end
                if variant.ownGoalboxOnly ~= nil then
                    folder:Toggle("Only near/in Goalbox", nil, variant.ownGoalboxOnly, function(value)
                        variant.ownGoalboxOnly = value == true
                    end)
                end
                if variant.animPredict ~= nil then
                    folder:Toggle("Animation Predict", nil, variant.animPredict, function(value)
                        variant.animPredict = value == true
                    end)
                end
                if variant.useJump ~= nil then
                    folder:Toggle("Use Jump", nil, variant.useJump, function(value)
                        variant.useJump = value == true
                    end)
                end
                if variant.useFlick ~= nil then
                    folder:Toggle("Flick", nil, variant.useFlick, function(value)
                        variant.useFlick = value == true
                    end)
                end
                if variant.minBallSpeed ~= nil then
                    folder:Slider("Min Ball Speed", variant.minBallSpeed, 0.1, 300, 0.1, function(value)
                        variant.minBallSpeed = value
                    end)
                end
                if variant.predictWindow ~= nil then
                    folder:Slider("Predict Window", variant.predictWindow, 0.1, 1.5, 0.05, function(value)
                        variant.predictWindow = value
                    end)
                end
                if variant.skill3MinHeight ~= nil then
                    folder:Slider("Skill 3 Min Height", variant.skill3MinHeight, 0, 20, 0.5, function(value)
                        variant.skill3MinHeight = value
                    end)
                end
                if variant.skill2MinHeight ~= nil then
                    folder:Slider("Skill 2 Min Height", variant.skill2MinHeight, 0, 20, 0.5, function(value)
                        variant.skill2MinHeight = value
                    end)
                end
                if variant.skill3MaxDist ~= nil then
                    folder:Slider("Skill 3 Max Distance", variant.skill3MaxDist, 10, 150, 1, function(value)
                        variant.skill3MaxDist = value
                    end)
                end
                if variant.skill3MaxVert ~= nil then
                    folder:Slider("Skill 3 Max Vertical", variant.skill3MaxVert, 10, 200, 1, function(value)
                        variant.skill3MaxVert = value
                    end)
                end
                if variant.skill4MinHeight ~= nil then
                    folder:Slider("Skill 4 Min Height", variant.skill4MinHeight, 0, 20, 0.5, function(value)
                        variant.skill4MinHeight = value
                    end)
                end
                if variant.skill4MaxDist ~= nil then
                    folder:Slider("Skill 4 Max Distance", variant.skill4MaxDist, 10, 150, 1, function(value)
                        variant.skill4MaxDist = value
                    end)
                end
                if variant.skill4MaxVert ~= nil then
                    folder:Slider("Skill 4 Max Vertical", variant.skill4MaxVert, 10, 200, 1, function(value)
                        variant.skill4MaxVert = value
                    end)
                end
                if variant.preferSkill ~= nil then
                    folder:Dropdown("Prefer", {"Skill3", "Skill4"}, function(value)
                        variant.preferSkill = value
                    end)
                end

                if variant.AnimationDelayControls and variant.animations then
                    local predictFolder = playerUI:FolderInGroup(
                        pageName,
                        "Animation Predict.",
                        Color3.fromRGB(24, 255, 228),
                        true,
                        "Player"
                    )

                    for _, control in ipairs(variant.AnimationDelayControls) do
                        local info = variant.animations[control.id]
                        if info then
                            predictFolder:Slider(
                                control.name,
                                tonumber(info.delay) or 0,
                                0,
                                2,
                                0.01,
                                function(value)
                                    info.delay = value
                                end
                            )
                        end
                    end
                end
            end
        end

        defensive:CheckAnyEnabled()

        local defensiveGuardAccumulator = 0
        local defensiveStyleGuard =
            RunService.Heartbeat:Connect(function(dt)
                defensiveGuardAccumulator += dt
                if defensiveGuardAccumulator < 0.05 then
                    return
                end
                defensiveGuardAccumulator = 0

                local changed = false

                for _, record in ipairs(defensiveToggleRecords) do
                    local variant = record.Variant
                    local toggle = record.Toggle
                    local supported = variantSupportedNow(variant)

                    if not supported then
                        if variant.enabled then
                            variant.enabled = false
                            changed = true
                        end

                        if toggle and toggle.Value == true then
                            -- Non-silent SetValue updates saved config and
                            -- visibly plays the same toggle-off animation.
                            toggle:SetValue(false)
                            changed = true
                        end
                    end
                end

                if changed then
                    defensive:CheckAnyEnabled()
                end
            end)

        local runtime = {
            core = core,
            distance = distanceEngine,
            defensive = defensive,
            movementGroups = movementGroups,
            defensiveStyleGuard = defensiveStyleGuard,
        }

        function runtime.destroy()
            pcall(function()
                if runtime.defensiveStyleGuard then
                    runtime.defensiveStyleGuard:Disconnect()
                    runtime.defensiveStyleGuard = nil
                end
            end)
            pcall(function()
                if distanceEngine and distanceEngine.destroy then distanceEngine:destroy() end
            end)
            pcall(function()
                if defensive then
                    for _, variant in ipairs(defensive.Variants) do
                        variant.enabled = false
                        if variant._uiToggle
                            and variant._uiToggle.Value == true then
                            variant._uiToggle:SetValue(false)
                        end
                    end
                    defensive:CheckAnyEnabled()
                end
            end)
            if env.CeleronEvoRERuntime == runtime then
                env.CeleronEvoRERuntime = nil
            end
        end

        env.CeleronEvoRERuntime = runtime
        warn("[EvoHub RE Phase2 V5] Core + 74 Distance configs + AutoDefensive READY")
    end)

    if not ok then
        warn("[EvoHub RE Phase2 V5][BOOT] " .. tostring(err))
    end
end)

local autoact = maintab2:Folder("Auto Activate Features.", Color3.fromRGB(24, 255, 228), true)
autoact:Label("Auto Activate: Activates The Move When Ball Within Range.")

do
    local autoActivateState = {
        enabled = false,
        distance = 10,
        moveNumber = 1,
        m2Held = false,
        armed = true,
        waitingCooldown = false,
        cooldownSeen = false,
        cooldownObject = nil,
        cooldownSkill = nil,
        lastBall = nil,
        lastFire = 0,
        connection = nil,
        accumulator = 0
    }

    local autoActivateUIS = game:GetService("UserInputService")
    local autoActivateRunService = game:GetService("RunService")
    local autoActivatePlayers = game:GetService("Players")
    local autoActivateReplicatedStorage = game:GetService("ReplicatedStorage")
    local autoActivateRemote = safeWaitForChild(autoActivateReplicatedStorage, "ByteNetReliable", 8)
    local autoActivatePacket = buffer.fromstring(buffers["base"])
    local autoActivatePlayer = autoActivatePlayers.LocalPlayer

    local function isMobile()
        local ok, preferred = pcall(function()
            return autoActivateUIS.PreferredInput
        end)

        if ok then
            return preferred == Enum.PreferredInput.Touch
        end

        return autoActivateUIS.TouchEnabled
            and not autoActivateUIS.KeyboardEnabled
    end

    local function resetCycle()
        autoActivateState.armed = true
        autoActivateState.waitingCooldown = false
        autoActivateState.cooldownSeen = false
        autoActivateState.lastBall = nil
        autoActivateState.lastFire = 0
    end

    local function clearCooldown()
        autoActivateState.cooldownObject = nil
        autoActivateState.cooldownSkill = nil
    end

    local function getCooldown()
        local skillName = "skill" .. tostring(autoActivateState.moveNumber)

        if autoActivateState.cooldownObject
            and autoActivateState.cooldownObject.Parent
            and autoActivateState.cooldownSkill == skillName then

            return autoActivateState.cooldownObject
        end

        clearCooldown()

        local playerGui = autoActivatePlayer:FindFirstChild("PlayerGui")
        local hotbar = playerGui and playerGui:FindFirstChild("Hotbar")
        local backpack = hotbar and hotbar:FindFirstChild("Backpack")
        local slots = backpack and backpack:FindFirstChild("Hotbar")
        local slot = slots and slots:FindFirstChild(skillName)
        local cooldown = slot and slot:FindFirstChild("Cooldown", true)

        if cooldown and cooldown:IsA("GuiObject") then
            autoActivateState.cooldownObject = cooldown
            autoActivateState.cooldownSkill = skillName
            return cooldown
        end
    end

    local function cooldownState()
        local cooldown = getCooldown()

        if not cooldown then
            return false, false
        end

        return true, cooldown.Visible == true
    end

    local function canActivate()
        if not autoActivateState.enabled then
            return false
        end

        if isMobile() then
            return true
        end

        return autoActivateState.m2Held
    end

    local function fireMove(now)
        if now - autoActivateState.lastFire < 0.12 then
            return
        end

        autoActivateState.lastFire = now
        autoActivateState.armed = false
        autoActivateState.waitingCooldown = true
        autoActivateState.cooldownSeen = false

        autoActivateRemote:FireServer(
            autoActivatePacket,
            {
                {
                    "skill" .. autoActivateState.moveNumber
                }
            }
        )
    end

    local startAutoActivateLoop
    local stopAutoActivateLoop

    autoact:Textbox("Auto Activate Move Number", "Example: 1, 2, 3, 4, 5.", function(value)
        local number = tonumber(value)

        if number and number >= 1 and number <= 5 then
            autoActivateState.moveNumber = number
            clearCooldown()
            resetCycle()
        end
    end)

    autoact:Slider("Auto Activate Distance", 10, 3, 70, 0.5, function(value)
        autoActivateState.distance = value
    end)

    autoact:Toggle("Auto Activate", function(value)
        autoActivateState.enabled = value == true
        autoActivateState.m2Held = false
        clearCooldown()
        resetCycle()

        if autoActivateState.enabled then
            startAutoActivateLoop()
        else
            stopAutoActivateLoop()
        end
    end)

    autoActivateUIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or isMobile() then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            autoActivateState.m2Held = true

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end
    end)

    autoActivateUIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            autoActivateState.m2Held = false

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end
    end)

    autoActivatePlayer.CharacterAdded:Connect(function()
        clearCooldown()
        resetCycle()
    end)

    local function autoActivateStep(dt)
        if not autoActivateState.enabled then
            return
        end

        autoActivateState.accumulator += dt

        if autoActivateState.accumulator < (1 / 30) then
            return
        end

        autoActivateState.accumulator = 0

        local character = autoActivatePlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        local now = os.clock()
        local ball = workspace.Terrain:FindFirstChild("Ball")
        local cooldownKnown, cooldownActive = cooldownState()

        if autoActivateState.waitingCooldown then
            if cooldownKnown and cooldownActive then
                autoActivateState.cooldownSeen = true

            elseif autoActivateState.cooldownSeen and not cooldownActive then
                autoActivateState.waitingCooldown = false
                autoActivateState.cooldownSeen = false
                autoActivateState.armed = true
            end
        end

        if not ball then
            autoActivateState.lastBall = nil

            if autoActivateState.waitingCooldown
                and not autoActivateState.cooldownSeen
                and now - autoActivateState.lastFire >= 0.2 then

                autoActivateState.waitingCooldown = false
                autoActivateState.armed = true

            elseif not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end

            return
        end

        if autoActivateState.lastBall ~= ball then
            autoActivateState.lastBall = ball

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end

        local delta = root.Position - ball.Position
        local distanceSq = delta:Dot(delta)
        local triggerDistance = autoActivateState.distance
        local inRange = distanceSq <= triggerDistance * triggerDistance
        local exitDistance = triggerDistance
            + math.max(1.5, triggerDistance * 0.08)

        if distanceSq > exitDistance * exitDistance then
            if autoActivateState.waitingCooldown
                and not autoActivateState.cooldownSeen
                and now - autoActivateState.lastFire >= 0.2 then

                autoActivateState.waitingCooldown = false
                autoActivateState.armed = true

            elseif not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end

        if not canActivate()
            or not inRange
            or not autoActivateState.armed
            or autoActivateState.waitingCooldown
            or cooldownActive then

            return
        end

        fireMove(now)
    end

    stopAutoActivateLoop = function()
        if autoActivateState.connection then
            autoActivateState.connection:Disconnect()
            autoActivateState.connection = nil
        end

        autoActivateState.accumulator = 0
    end

    startAutoActivateLoop = function()
        stopAutoActivateLoop()

        autoActivateState.connection =
            autoActivateRunService.Heartbeat:Connect(
                autoActivateStep
            )
    end
end

