    task.defer(function()
        if type(writefile) ~= "function" then return end

        local fileName = "celeron_home_frieren.jpg"
        local alreadyExists = false
        if type(isfile) == "function" then
            local ok, exists = pcall(isfile, fileName)
            alreadyExists = ok and exists
        end

        if not alreadyExists then
            local encoded = [[]]
            local rawImage

            if crypt and type(crypt.base64decode) == "function" then
                local ok, result = pcall(crypt.base64decode, encoded)
                if ok then rawImage = result end
            elseif syn and syn.crypt and syn.crypt.base64
                and type(syn.crypt.base64.decode) == "function" then
                local ok, result = pcall(syn.crypt.base64.decode, encoded)
                if ok then rawImage = result end
            end

            if not rawImage then
                local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
                local lookup = {}
                for i = 1, #alphabet do
                    lookup[alphabet:sub(i, i)] = i - 1
                end

                local bytes = {}
                local valueBuffer, bits = 0, 0
                for i = 1, #encoded do
                    local c = encoded:sub(i, i)
                    if c == "=" then break end
                    local value = lookup[c]
                    if value then
                        valueBuffer = valueBuffer * 64 + value
                        bits += 6
                        if bits >= 8 then
                            bits -= 8
                            bytes[#bytes + 1] = string.char(math.floor(valueBuffer / (2 ^ bits)) % 256)
                        end
                    end
                end
                rawImage = table.concat(bytes)
            end

            if not rawImage or not pcall(writefile, fileName, rawImage) then return end
            rawImage = nil
        end

        local getAsset = type(getcustomasset) == "function" and getcustomasset
            or (type(getsynasset) == "function" and getsynasset)
        if not getAsset then return end

        local okAsset, asset = pcall(getAsset, fileName)
        if not okAsset or not asset then return end

        local localPlayer = game:GetService("Players").LocalPlayer
        for _ = 1, 60 do
            local darkUI = game:GetService("CoreGui"):FindFirstChild("dark_UI")
                or localPlayer.PlayerGui:FindFirstChild("dark_UI")
            local banner = darkUI and darkUI:FindFirstChild("banner", true)
            if banner and banner:IsA("ImageLabel") then
                banner.Image = asset
                banner.ScaleType = Enum.ScaleType.Crop
                return
            end
            task.wait()
        end
    end)
end


