                        Enabled = true,
                    }, parentGui())

                    local pickerFrame = create("Frame", {
                        Name = "PickerFrame",
                        Position = UDim2.new(0.5, -100, 0.5, -100),
                        Size = UDim2.fromOffset(200, 200),
                        BackgroundColor3 = Color3.fromRGB(18, 18, 20),
                        BorderSizePixel = 0,
                        Visible = false,
                        ZIndex = 50,
                    }, pickerGui)
                    corner(pickerFrame, 4)
                    create("UIStroke", {
                        Thickness = 1,
                        Color = Color3.fromRGB(35, 35, 40),
                        Transparency = 0,
                    }, pickerFrame)

                    local hue, sat, val = value:ToHSV()

                    local satVal = create("ImageButton", {
                        Name = "SatVal",
                        Position = UDim2.fromOffset(10, 10),
                        Size = UDim2.fromOffset(160, 160),
                        BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
                        BorderSizePixel = 0,
                        Image = "rbxassetid://8180999986",
                        ImageColor3 = Color3.new(0, 0, 0),
                        ImageTransparency = 0,
                        ScaleType = Enum.ScaleType.Stretch,
                        AutoButtonColor = false,
                        ZIndex = 51,
                    }, pickerFrame)
                    corner(satVal, 3)

                    local svCursor = create("Frame", {
                        Name = "Cursor",
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.fromScale(sat, 1 - val),
                        Size = UDim2.fromOffset(8, 8),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        BorderSizePixel = 0,
                        ZIndex = 53,
                    }, satVal)
                    create("UICorner", { CornerRadius = UDim.new(1, 0) }, svCursor)
                    create("UIStroke", { Thickness = 2, Color = Color3.new(0,0,0), Transparency = 0 }, svCursor)

                    local hueBar = create("ImageButton", {
                        Name = "Hue",
                        Position = UDim2.fromOffset(175, 10),
                        Size = UDim2.fromOffset(15, 160),
                        BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0,
                        Image = "rbxassetid://8180989234",
                        ImageColor3 = Color3.new(1,1,1),
                        ImageTransparency = 0,
                        ScaleType = Enum.ScaleType.Crop,
                        AutoButtonColor = false,
                        ZIndex = 51,
                    }, pickerFrame)
                    corner(hueBar, 3)

                    local hueCursor = create("Frame", {
                        Name = "Cursor",
                        Position = UDim2.fromScale(0, hue),
                        Size = UDim2.new(1, 0, 0, 3),
                        BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0,
                        ZIndex = 53,
                    }, hueBar)

                    local hex = create("TextBox", {
                        Name = "Hex",
                        Position = UDim2.fromOffset(10, 175),
                        Size = UDim2.new(1, -20, 0, 20),
                        BackgroundColor3 = Color3.fromRGB(22, 22, 25),
                        BorderSizePixel = 0,
                        ClearTextOnFocus = false,
                        TextColor3 = Theme.Text,
                        Font = Enum.Font.SourceSans,
                        TextSize = 13,
                        TextXAlignment = Enum.TextXAlignment.Center,
                        PlaceholderText = "",
                        ZIndex = 51,
                    }, pickerFrame)
                    corner(hex, 3)
                    padding(hex, 8, 8, 0, 0)

                    local object = {
                        Instance = row,
                        Value = value,
                        Open = false,
                        PickerGui = pickerGui,
                        PickerFrame = pickerFrame,
                    }

                    local function colorToHex(c)
                        return string.format("#%02X%02X%02X",
                            math.floor(c.R * 255 + 0.5),
                            math.floor(c.G * 255 + 0.5),
                            math.floor(c.B * 255 + 0.5))
                    end

                    local function updateVisuals(fire)
                        object.Value = Color3.fromHSV(hue, sat, val)
                        swatch.BackgroundColor3 = object.Value
                        satVal.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                        svCursor.Position = UDim2.fromScale(sat, 1 - val)
                        hueCursor.Position = UDim2.fromScale(0, hue)
                        hex.Text = colorToHex(object.Value)
                        if fire ~= false then
                            pcall(callback, object.Value)
                        end
                    end

                    function object:SetValue(newValue, silent)
                        if typeof(newValue) ~= "Color3" then return end
                        hue, sat, val = newValue:ToHSV()
                        updateVisuals(silent ~= true)
                    end

                    function object:GetValue()
                        return self.Value
                    end

                    function object:Close()
                        self.Open = false
                        pickerFrame.Visible = false
                    end

                    function object:Toggle(force)
                        if type(force) == "boolean" then
                            self.Open = force
                        else
                            self.Open = not self.Open
                        end
                        for _, other in ipairs(Library.ColorPickers) do
                            if other ~= self and other.Close then other:Close() end
                        end
                        pickerFrame.Visible = self.Open
                    end

                    local function drag2D(inputX, inputY)
                        local alphaX = math.clamp((inputX - satVal.AbsolutePosition.X) / math.max(1, satVal.AbsoluteSize.X), 0, 1)
                        local alphaY = math.clamp((inputY - satVal.AbsolutePosition.Y) / math.max(1, satVal.AbsoluteSize.Y), 0, 1)
                        sat = alphaX
                        val = 1 - alphaY
                        updateVisuals(true)
                    end

                    local function dragHue(inputY)
                        hue = math.clamp((inputY - hueBar.AbsolutePosition.Y) / math.max(1, hueBar.AbsoluteSize.Y), 0, 1)
                        updateVisuals(true)
                    end

                    local draggingSV = false
                    local draggingHue = false
                    satVal.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = true
                            drag2D(input.Position.X, input.Position.Y)
                        end
                    end)
                    satVal.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = false
                        end
                    end)
                    hueBar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingHue = true
                            dragHue(input.Position.Y)
                        end
                    end)
                    hueBar.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingHue = false
                        end
                    end)
                    UIS.InputChanged:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                            if draggingSV then drag2D(input.Position.X, input.Position.Y) end
                            if draggingHue then dragHue(input.Position.Y) end
                        end
                    end)

                    hex.FocusLost:Connect(function()
                        local raw = tostring(hex.Text or ""):gsub("#", "")
                        if #raw == 6 then
                            local r = tonumber(raw:sub(1,2), 16)
                            local g = tonumber(raw:sub(3,4), 16)
                            local b = tonumber(raw:sub(5,6), 16)
                            if r and g and b then
                                object:SetValue(Color3.fromRGB(r,g,b))
                                return
                            end
                        end
                        hex.Text = colorToHex(object.Value)
                    end)

                    button.Activated:Connect(function()
                        object:Toggle()
                    end)

                    updateVisuals(false)
                    Library.ColorPickers[#Library.ColorPickers + 1] = object
                    addControlRecord(self, row, nameText)
                    return registerControl(key, object)
                end

                return section
            end

            tabButton.Activated:Connect(function()
                selectTab(tab)
            end)

            tabButton.MouseEnter:Connect(function()
                if selectedTab ~= tab then
                    pcall(function()
                        TweenService:Create(tabButton, TweenInfo.new(0.15), {
                            TextColor3 = Theme.Text
                        }):Play()
                    end)
                end
            end)

            tabButton.MouseLeave:Connect(function()
                if selectedTab ~= tab then
                    pcall(function()
                        TweenService:Create(tabButton, TweenInfo.new(0.15), {
                            TextColor3 = Theme.Muted
                        }):Play()
                    end)
                end
            end)

            if not selectedTab then
                selectTab(tab)
            end

            return tab
        end

        local function clearSearchResults()
            for _, child in ipairs(resultsList:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end
        end

        local function openSearchResult(tab, section)
            if selectedTab ~= tab then
                selectTab(tab)
            end
            applyGroup(tab, section.Group)
            task.defer(function()
                if section.Frame.Visible then
                    local relative = section.Frame.AbsolutePosition.Y
                        - tab.Page.AbsolutePosition.Y
                        + tab.Page.CanvasPosition.Y
                        - 4
                    tab.Page.CanvasPosition = Vector2.new(0, math.max(0, relative))
                end
            end)
        end

        local function refreshSearch()
            local query = tostring(searchBox.Text or ""):lower()
            clearSearchResults()

            if query == "" then
                searchResults.Visible = false
                searchResults.Size = UDim2.new(1, 0, 0, 0)
                return
            end

            local hits = {}
            for _, tab in ipairs(window.Tabs) do
                for _, section in ipairs(tab.Sections) do
                    local sectionMatch = section.Name:lower():find(query, 1, true) ~= nil
                    local matchedControl = nil
                    for _, record in ipairs(section.Controls) do
                        if record.Name:lower():find(query, 1, true) then
                            matchedControl = record.Name
                            break
                        end
                    end

                    if sectionMatch or matchedControl then
                        hits[#hits + 1] = {
                            Tab = tab,
                            Section = section,
                            Text = matchedControl
                                and (section.Group .. "  •  " .. section.Name .. "  •  " .. matchedControl)
                                or (section.Group .. "  •  " .. section.Name),
                        }
                    end
                end
            end

            for index, hit in ipairs(hits) do
                if index > 8 then break end

                local resultButton = create("TextButton", {
                    Name = "Result",
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundColor3 = Theme.Section,
                    BorderSizePixel = 0,
                    Text = hit.Text,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.SourceSans,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    ZIndex = 11,
                }, resultsList)
                padding(resultButton, 5, 3, 0, 0)

                resultButton.MouseEnter:Connect(function()
                    resultButton.BackgroundColor3 = Theme.Control
                end)
                resultButton.MouseLeave:Connect(function()
                    resultButton.BackgroundColor3 = Theme.Section
                end)
                resultButton.Activated:Connect(function()
                    openSearchResult(hit.Tab, hit.Section)
                    searchResults.Visible = false
                    searchResults.Size = UDim2.new(1, 0, 0, 0)
                end)
            end

            local shown = math.min(#hits, 8)
            searchResults.Visible = shown > 0
            searchResults.Size = UDim2.new(1, 0, 0, shown > 0 and math.min(138, shown * 21 + 6) or 0)
        end

        searchBox:GetPropertyChangedSignal("Text"):Connect(refreshSearch)

        searchBox.Focused:Connect(function()
            pcall(function()
                TweenService:Create(searchStroke, TweenInfo.new(0.15), {
                    Transparency = 0.1
                }):Play()
            end)
            refreshSearch()
        end)

        searchBox.FocusLost:Connect(function()
            pcall(function()
                TweenService:Create(searchStroke, TweenInfo.new(0.15), {
                    Transparency = 0.5999966859817505
                }):Play()
            end)
            task.delay(0.1, function()
                if not searchBox:IsFocused() then
                    searchResults.Visible = false
                    searchResults.Size = UDim2.new(1, 0, 0, 0)
                end
            end)
        end)

        return window
    end

    -- Expose helpers under the same names observed in the live library table.
    function Library:CreateKeybind(section, settings, key)
        return section:CreateKeybind(settings, key)
    end
    function Library:CreateColorPicker(section, settings, key)
        return section:CreateColorPicker(settings, key)
    end
    function Library:CreateButton(section, settings)
        return section:CreateButton(settings)
    end
    function Library:CreateLabel(section, settings)
        return section:CreateLabel(settings)
    end
    function Library:CreateSection(tab, name)
        return tab:CreateSection(name)
    end
    function Library:CreateKeybinds()
        return self.KeybindsWindow
    end



    -- ================================================================
    -- EvoHub captured-core compatibility layer
    -- Maps the clean 1:1 renderer API to the API expected by stage2.
    -- ================================================================
    do
        local originalCreateWindow = Library.CreateWindow

        function Library:CreateWindow(settings)
            local window = originalCreateWindow(self, settings)

            function window:CreateTopTab(name)
                return self:CreateTab({ Name = tostring(name or "Tab") })
            end

            function window:CreateCategory(topTab, name)
                local categoryName = tostring(name or "Category")
                if topTab and type(topTab.EnsureGroup) == "function" then
                    topTab:EnsureGroup(categoryName)
                end
                return {
                    __evoCategory = true,
                    __tab = topTab,
                    __group = categoryName,
                }
            end

            function window:SetUIScale(value)
                local n = tonumber(value) or 100
                if n > 10 then n = n / 100 end
                return self:SetScale(n)
            end

            function window:SetToggleKey(key)
                self.ToggleKey = key
            end

            if not window.Watermark then
                window.Watermark = { SetVisible = function(_) end }
            elseif type(window.Watermark.SetVisible) ~= "function" then
                window.Watermark.SetVisible = function(_) end
            end

            return window
        end

        function Library:CreateSection(target, name, side)
            local tab = target
            local group = nil
            if type(target) == "table" and target.__evoCategory then
                tab = target.__tab
                group = target.__group
            end
            if not tab or type(tab.CreateSection) ~= "function" then
                error("[evo hub // re] invalid section target: " .. tostring(name))
            end

            -- Clean renderer alternates columns; set the flip state so the
            -- captured core's explicit left/right placement is preserved.
            if side == "left" then
                tab._columnFlip = false
            elseif side == "right" then
                tab._columnFlip = true
            end
            return tab:CreateSection(tostring(name or "Section"), group)
        end

        function Library:CreateToggle(section, settings, key)
            return section:CreateToggle(settings, key)
        end
        function Library:CreateSlider(section, settings, key)
            return section:CreateSlider(settings, key)
        end
        function Library:CreateDropdown(section, settings, key)
            return section:CreateDropdown(settings, key)
        end
        function Library:CreateInput(section, settings, key)
            return section:CreateInput(settings, key)
        end

        local previousUpdateAccent = Library.UpdateAccentColor
        function Library:UpdateAccentColor(color)
            if type(previousUpdateAccent) == "function" then
                return previousUpdateAccent(self, color)
            end
            if type(self.SetAccent) == "function" then
                return self.SetAccent(color)
            end
        end

        if type(Library.LoadNotificationSounds) ~= "function" then
            function Library:LoadNotificationSounds()
                return self.NotificationSounds
            end
        end

        if type(Library.ConfigSystem.Load) ~= "function" then
            Library.ConfigSystem.Load = function(_)
                return true
            end
        end
    end

    return Library
end)()

