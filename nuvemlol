                        local skill = "skill4"
                        if Core:isOnCooldown(skill) then
                            return false
                        end

                        local stance = reoMove == "Defensive Stance"
                        local intercept = reoMove == "Horrific Intercept"

                        local maxDist = stance and variant.skill3MaxDist or variant.skill4MaxDist
                        local maxVert = stance and variant.skill3MaxVert or variant.skill4MaxVert
                        local horizontal, vertical = horizontalVertical(ball, rootPosition)

                        if horizontal > maxDist or vertical > maxVert then
                            return false
                        end

                        if intercept and ball.Position.Y < variant.skill4MinHeight then
                            return false
                        end

                        if variant.useJump and ball.Position.Y >= 5 then
                            jump()
                            task.wait(0.03)
                        end

                        local direct = intercept
                            and context
                            and context.isBallDirectlyAtUs
