local function prettyKeybindName(path, control)
    if control
        and type(control.Name) == "string"
        and control.Name ~= "" then
        return control.Name
    end

    local raw = tostring(path or "Keybind")
    return raw:match("([^_]+)$") or raw
end

local function collectNativeKeybinds()
    local entries = {}

    for path, control in pairs(Luna.ConfigSystem.Controls) do
        if type(control) == "table"
            and type(control.GetValue) == "function"
            and control.Mode ~= nil
            and control.ManualWatermark == true then

            local key = control:GetValue()

            if typeof(key) == "EnumItem"
                and key ~= Enum.KeyCode.Unknown then

                entries[#entries + 1] = {
                    Path = tostring(path),
                    Name = prettyKeybindName(path, control),
                    Key = key,
                    Active = control.Active == true,
                }
            end
        end
    end

    table.sort(entries, function(a, b)
        local an = tostring(a.Name):lower()
        local bn = tostring(b.Name):lower()

        if an == bn then
            return a.Path < b.Path
        end

        return an < bn
    end)

    return entries
end

local function computeKeybindGeometry(rowCount)
    local camera = workspace.CurrentCamera
    local viewport =
        camera and camera.ViewportSize
        or Vector2.new(1560, 740)

    -- User-confirmed original behavior: compact panel on the LEFT.
    -- Keep it deliberately small on mobile instead of scaling with the hub.
    local width = math.clamp(
        math.floor(viewport.X * 0.14),
        205,
        280
    )

    local leftMargin = math.clamp(
        math.floor(viewport.X * 0.018),
        10,
        28
    )

    local top = math.clamp(
        math.floor(viewport.Y * 0.20),
        90,
        165
    )

    local headerHeight = 28
    local rowHeight = 25
    local visibleRows = math.min(math.max(rowCount, 1), 10)

    local height =
        headerHeight
        + visibleRows * rowHeight
        + 6

    return {
        Width = width,
        Height = height,
        HeaderHeight = headerHeight,
        RowHeight = rowHeight,
        LeftMargin = leftMargin,
        Top = top,
    }
end

