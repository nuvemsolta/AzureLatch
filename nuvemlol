                    local control = controlRoot(label)

                    if control and not seen[control] then
                        seen[control] = true

                        local container = findContainer(control)
                        local tabButton = container and map[container]

                        if container and tabButton then
                            local title, textValue = controlText(control)
                            local folder = findFolder(control)
                            local folderTitle = folderName(folder)

                            index[#index + 1] = {
                                title = title,
                                normalizedTitle = norm(title),
                                searchable = norm(
                                    tabButton.Text
                                    .. " "
                                    .. folderTitle
                                    .. " "
                                    .. textValue
                                ),
                                context =
                                    folderTitle ~= ""
                                    and (tabButton.Text .. " • " .. folderTitle)
                                    or tabButton.Text,
                                control = control,
                                container = container,
                                tabButton = tabButton,
                                folder = folder
                            }
                        end
                    end
                end
            end

            searchIndex = index
        end

        local function collect(query)
            if not searchIndex then
                buildSearchIndex()
            end

            local words = {}
            local entries = {}
            local normalizedQuery = norm(query)

            for word in string.gmatch(normalizedQuery, "%S+") do
                words[#words + 1] = word
            end

            for _, indexed in ipairs(searchIndex) do
                local matches = true

                for _, word in ipairs(words) do
                    if not string.find(indexed.searchable, word, 1, true) then
                        matches = false
                        break
                    end
                end

                if matches then
                    local score = 0

                    if indexed.normalizedTitle == normalizedQuery then
                        score += 1000
                    end

                    if string.sub(indexed.normalizedTitle, 1, #normalizedQuery)
                        == normalizedQuery then

                        score += 250
                    end

                    if string.find(
                        indexed.normalizedTitle,
                        normalizedQuery,
                        1,
                        true
                    ) then
                        score += 120
                    end

                    entries[#entries + 1] = {
                        title = indexed.title,
                        context = indexed.context,
                        control = indexed.control,
                        container = indexed.container,
                        tabButton = indexed.tabButton,
                        folder = indexed.folder,
                        score = score
                    }
                end
            end

            table.sort(entries, function(x, y)
                if x.score ~= y.score then
                    return x.score > y.score
                end

                return x.title < y.title
            end)

            return entries
        end

        local function clearResults()
            for _, child in ipairs(holder:GetChildren()) do
                if child:IsA("GuiButton") or child:IsA("Frame") or child:IsA("TextLabel") then
                    child:Destroy()
                end
            end
        end

        local function openFolder(folder)
            if not folder then return end
            local content = folder:FindFirstChild("Content")
            local header = folder:FindFirstChild("Header")
            if content then content.Visible = true end
            folder.BackgroundTransparency = 0.7

            if header then
                for _, object in ipairs(header:GetChildren()) do
                    if object:IsA("ImageLabel") and object.Image == "rbxassetid://2418686949" then
                        object.Rotation = 90
                    end
                end
            end
        end

        local function navigate(entry)
            local selected = entry.container:GetAttribute("ContainerInt")
            if selected == nil then return end

            for _, container in ipairs(main:GetChildren()) do
                if container:IsA("Frame") and container.Name == "container" then
                    local index = container:GetAttribute("ContainerInt")
                    local inner = container:FindFirstChild("containerr")
                    if index ~= nil and inner then
                        inner.Position = UDim2.new(index - selected, 0, 0, 0)
                    end
                end
            end

            for _, button in ipairs(tabs:GetChildren()) do
                if button:IsA("TextButton") then
                    button.TextTransparency = button == entry.tabButton and 0 or 0.5
                end
            end

            openFolder(entry.folder)
            results.Visible = false
            input.Text = ""

            task.defer(function()
                task.wait()
                local current = entry.control.Parent
                local pageHolder = nil

                while current and current ~= main do
                    if current:IsA("ScrollingFrame") and current.Name == "holder" then
                        pageHolder = current
                        break
                    end
                    current = current.Parent
                end

                if pageHolder and entry.control.Parent then
                    local y = entry.control.AbsolutePosition.Y - pageHolder.AbsolutePosition.Y + pageHolder.CanvasPosition.Y - 8
                    pageHolder.CanvasPosition = Vector2.new(0, math.max(0, y))
                end

                if entry.control and entry.control.Parent then
                    local oldHighlight = entry.control:FindFirstChild("searchHighlight")
                    if oldHighlight then oldHighlight:Destroy() end

                    local highlight = Instance.new("UIStroke")
                    highlight.Name = "searchHighlight"
                    highlight.Color = Color3.fromRGB(95, 220, 200)
                    highlight.Thickness = 1.5
                    highlight.Parent = entry.control

                    task.delay(0.8, function()
                        if highlight.Parent then highlight:Destroy() end
                    end)
                end
            end)
        end

        local function addResult(entry, order)
            local button = Instance.new("TextButton")
            button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            button.BackgroundTransparency = 0.08
            button.AutoButtonColor = false
            button.Text = ""
            button.Size = UDim2.new(1, -4, 0, 39)
            button.LayoutOrder = order
            button.ZIndex = 62
            button.Parent = holder
            Instance.new("UICorner", button).CornerRadius = UDim.new(0, 5)

            local title = Instance.new("TextLabel")
            title.BackgroundTransparency = 1
            title.Font = Enum.Font.GothamMedium
            title.Text = entry.title
            title.TextColor3 = Color3.fromRGB(238, 238, 238)
            title.TextSize = 12
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.Position = UDim2.fromOffset(10, 3)
            title.Size = UDim2.new(1, -20, 0, 18)
            title.ZIndex = 63
            title.Parent = button

            local context = Instance.new("TextLabel")
            context.BackgroundTransparency = 1
            context.Font = Enum.Font.Gotham
            context.Text = entry.context
            context.TextColor3 = Color3.fromRGB(145, 145, 145)
            context.TextSize = 9
            context.TextXAlignment = Enum.TextXAlignment.Left
            context.Position = UDim2.fromOffset(10, 21)
            context.Size = UDim2.new(1, -20, 0, 13)
            context.ZIndex = 63
            context.Parent = button

            button.Activated:Connect(function()
                navigate(entry)
            end)
        end

        local function update()
            local query = trim(input.Text)
            clear.Visible = query ~= ""

            if query == "" then
                results.Visible = false
                clearResults()
                return
            end

            local entries = collect(query)
            clearResults()
            results.Visible = true

            if #entries == 0 then
                local empty = Instance.new("TextLabel")
                empty.BackgroundTransparency = 1
                empty.Font = Enum.Font.Gotham
                empty.Text = "Nothing found"
                empty.TextColor3 = Color3.fromRGB(150, 150, 150)
                empty.TextSize = 11
                empty.Size = UDim2.new(1, 0, 0, 34)
                empty.ZIndex = 62
                empty.Parent = holder
                return
            end

            for index = 1, math.min(#entries, 30) do
                addResult(entries[index], index)
            end
        end

        input:GetPropertyChangedSignal("Text"):Connect(update)
        clear.Activated:Connect(function()
            input.Text = ""
            input:CaptureFocus()
        end)
    end)
end

local function runOptionalRemote(label, url, useCacheFlag)
    local okHttp, source = pcall(function()
        if useCacheFlag then
            return game:HttpGet(url, true)
        end
        return game:HttpGet(url)
    end)

    if not okHttp or type(source) ~= "string" or source == "" then
        warn("[Celeron] Optional loader failed to download: " .. label)
        return false
    end

    local chunk, compileError = loadstring(source)
    if type(chunk) ~= "function" then
        warn("[Celeron] Optional loader failed to compile: " .. label .. " | " .. tostring(compileError))
        return false
    end

    local okRun, runtimeError = pcall(chunk)
    if not okRun then
        warn("[Celeron] Optional loader failed to run: " .. label .. " | " .. tostring(runtimeError))
        return false
    end

    return true
end

