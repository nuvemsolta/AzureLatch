            DonLorenzo = { radius = 49, skillName = "skill2" },
            Sae = { radius = 38, skillName = "skill2" },
            Kunigami = { radius = 29, skillName = "skill3" },
            Barou = { radius = 49, skillName = "skill5" },
            Kurona = { radius = 27, skillName = "skill1" },
            Lorenzo = { radius = 49, skillName = "skill2" },
            Reo = {
                radius = 15,
                skillName = "skill3",
                requiresFlow = true,
                requiredSkillText = "Dobermann Press",
            },
            MasteryAiku = { radius = 38, skillName = "skill2" },
        },
    }

    local variantRemote =
        safeWaitForChild(ReplicatedStorage, "ByteNetReliable", 8)

    local function worldCharacterFor(name)
        local chars = Workspace:FindFirstChild("characters")
        return chars and chars:FindFirstChild(name)
    end

    local function getPlayerTeam(name)
        local char = worldCharacterFor(name)
        local state = char and char:FindFirstChild("state")
        local team = state and state:FindFirstChild("team")
        return team and team.Value or nil
    end

    local function findMyFlow()
        local char = worldCharacterFor(Players.LocalPlayer.Name)
        local state = char and char:FindFirstChild("state")
        return state and state:FindFirstChild("flow") or nil
    end

    local function getFreeBall()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        return (terrain and terrain:FindFirstChild("Ball"))
            or Workspace:FindFirstChild("Ball")
    end

    local function getHotbar()
        local pg = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
        return pg
            and pg:FindFirstChild("Hotbar")
            and pg.Hotbar:FindFirstChild("Backpack")
            and pg.Hotbar.Backpack:FindFirstChild("Hotbar")
    end

    local function getSkill3Name()
        local hotbar = getHotbar()
        local slot = hotbar and hotbar:FindFirstChild("skill3")
        local base = slot and slot:FindFirstChild("Base")
        local toolName = base and base:FindFirstChild("ToolName")
        return toolName and tostring(toolName.Text) or nil
    end

    local function findSkillWidget(skillName)
        local hotbar = getHotbar()
        if not hotbar then return nil end

        local direct = hotbar:FindFirstChild(skillName)
        if direct then return direct end

        for _, descendant in ipairs(hotbar:GetDescendants()) do
            if descendant.Name == skillName then
                return descendant
            end
        end

        return nil
    end

    local function isCooldown(skillName)
        local slot = findSkillWidget(skillName)

        -- This mirrors the original: a missing widget is treated as unavailable.
        if not slot then return true end

        local cooldown = slot:FindFirstChild("Cooldown")
        if not cooldown then return false end

        return cooldown.AbsoluteSize.Y > 1
            or (
                cooldown.Visible
                and cooldown.BackgroundTransparency < 0.9
            )
    end

    local function checkBallProximity(radius)
        local myTeam = getPlayerTeam(Players.LocalPlayer.Name)
        if not myTeam then return false end

        local char = Players.LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return false end

        local freeBall = getFreeBall()

        if freeBall
            and freeBall:IsA("BasePart")
            and (freeBall.Position - root.Position).Magnitude <= radius then
            return true
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Players.LocalPlayer then
                local enemyTeam = getPlayerTeam(player.Name)

                if enemyTeam
                    and enemyTeam ~= myTeam then

                    local enemyWorld = worldCharacterFor(player.Name)
                    local heldBall =
                        enemyWorld
                        and enemyWorld:FindFirstChild("Ball")

                    if heldBall then
                        local part =
                            heldBall:IsA("BasePart")
                            and heldBall
                            or heldBall:FindFirstChildWhichIsA(
                                "BasePart",
                                true
                            )

                        if part
                            and (part.Position - root.Position).Magnitude
                                <= radius then
                            return true
                        end
                    end
                end
            end
        end

        return false
    end

    local function variantUseBuffer()
        return packetBufferOneByte("bytenet_use", 30, true)
    end

    local function pressSkill(skillName)
        if not variantRemote then
            return false
        end

        local ok = pcall(function()
            variantRemote:FireServer(
                variantUseBuffer(),
                {{ tostring(skillName) }}
            )
        end)

        return ok
    end

    local function resetVariantCycle()
        variantState.IsPressing = false
        variantState.HasReached100 = false
        variantState.WaitingForCooldown = false
    end

    local function stopVariant()
        variantState.Enabled = false

        if variantState.Connection then
            variantState.Connection:Disconnect()
            variantState.Connection = nil
        end

        variantState.CurrentCharacter = nil
        variantState.MyTeam = nil
        resetVariantCycle()
    end

    local function processVariant()
        if not variantState.Enabled then return end

        local now = tick()
        local style =
            tostring(
                Players.LocalPlayer:GetAttribute("style")
                or Players.LocalPlayer:GetAttribute("Style")
                or ""
            ):lower()

        local mapped =
            variantState.StyleMapping[
                style:gsub("[%s_%-]", "")
            ]

        local flowObject = findMyFlow()
        local team =
            flowObject
            and flowObject.Parent
            and flowObject.Parent:FindFirstChild("team")
            and flowObject.Parent.team.Value
            or nil

        if team ~= "A" and team ~= "B" then
            resetVariantCycle()
            variantState.CurrentCharacter = nil
            return
        end

        if mapped ~= variantState.CurrentCharacter then
            variantState.CurrentCharacter = mapped
            resetVariantCycle()

            if mapped then
                variantState.MyTeam = team
            end
        end

        if not variantState.CurrentCharacter then return end

        local cfg =
            variantState.CharacterConfig[
                variantState.CurrentCharacter
            ]

        if not cfg then return end

        if cfg.requiredSkillText
            and getSkill3Name() ~= cfg.requiredSkillText then
            variantState.IsPressing = false
            return
        end

        flowObject = findMyFlow()
        if not flowObject then return end

        local flowValue = tonumber(flowObject.Value) or 0

        if flowValue <= 0 then
            variantState.IsPressing = false
            variantState.HasReached100 = false
            return
        end

        if flowValue >= 100
            and not variantState.HasReached100 then
            variantState.HasReached100 = true
        end

        local flowSpent =
            variantState.HasReached100
            and flowValue < 100

        if cfg.requiresFlow and not flowSpent then
            variantState.IsPressing = false
            return
        end

        if flowSpent then
            if isCooldown(cfg.skillName) then
                variantState.IsPressing = false
                return
            end

            if checkBallProximity(cfg.radius) then
                if not variantState.IsPressing then
                    variantState.IsPressing = true
                    variantState.LastPressTime = now
                end
            elseif variantState.IsPressing then
                variantState.IsPressing = false
            end
        elseif variantState.IsPressing then
            variantState.IsPressing = false
        end

        if variantState.IsPressing
            and now - variantState.LastPressTime >= 0.1 then

            pressSkill(cfg.skillName)
            variantState.LastPressTime = now
        end

        variantState.LastFlowValue = flowValue
    end

    local function startVariant()
        stopVariant()

        variantState.Enabled = true
        variantState.LastPressTime = 0
        variantState.LastFlowValue = 0

        variantState.Connection =
            RunService.Heartbeat:Connect(processVariant)
    end

    variantStealSection:Toggle(
        "Auto Variant Steal",
        nil,
        false,
        function(value)
            if value then
                startVariant()
            else
                stopVariant()
            end
        end
    )
end

