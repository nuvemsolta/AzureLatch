local function controlKey(tabName, folderName, controlName)
    -- Exact legacy format from Daffy's UI.
    return tostring(tabName) .. "/" .. tostring(folderName or "") .. "/" .. tostring(controlName)
end

local frierenEncoded = [[]]
local frierenAsset = nil
local frierenPreparing = false
local frierenTargets = {}

local function applyFrierenAsset(asset)
    frierenAsset = asset
    for i = #frierenTargets, 1, -1 do
        local image = frierenTargets[i]
        if image and image.Parent then
            image.Image = asset
        end
        table.remove(frierenTargets, i)
    end
end

local function prepareFrierenAsset()
    if frierenAsset or frierenPreparing then return end
    frierenPreparing = true

    task.spawn(function()
        local fileName = "celeron_home_frieren.jpg"
        local haveFile = false

        if type(isfile) == "function" then
            local ok, exists = pcall(isfile, fileName)
            haveFile = ok and exists
        end

        if not haveFile and type(writefile) == "function" then
            local rawImage
            if crypt and type(crypt.base64decode) == "function" then
                local ok, result = pcall(crypt.base64decode, frierenEncoded)
                if ok then rawImage = result end
            elseif syn and syn.crypt and syn.crypt.base64
                and type(syn.crypt.base64.decode) == "function" then
                local ok, result = pcall(syn.crypt.base64.decode, frierenEncoded)
                if ok then rawImage = result end
            end

            if not rawImage then
                local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
                local lookup = {}
                for i = 1, #alphabet do
                    lookup[alphabet:sub(i, i)] = i - 1
                end
                local bytes = {}
                local valueBuffer, bits = 0, 0
                for i = 1, #frierenEncoded do
                    local c = frierenEncoded:sub(i, i)
                    if c == "=" then break end
                    local value = lookup[c]
                    if value then
                        valueBuffer = valueBuffer * 64 + value
                        bits += 6
                        if bits >= 8 then
                            bits -= 8
                            bytes[#bytes + 1] = string.char(
                                math.floor(valueBuffer / (2 ^ bits)) % 256
                            )
                        end
                    end
                    if i % 8192 == 0 then task.wait() end
                end
                rawImage = table.concat(bytes)
            end

            if rawImage then
                pcall(writefile, fileName, rawImage)
                rawImage = nil
            end
        end

        local getAsset = type(getcustomasset) == "function" and getcustomasset
            or (type(getsynasset) == "function" and getsynasset)

        if getAsset then
            local ok, asset = pcall(getAsset, fileName)
            if ok and asset then
                applyFrierenAsset(asset)
            end
        end

        frierenPreparing = false
    end)
end

local function cleanSectionName(name)
    name = tostring(name or "Section")
    return name:gsub("%s*%.%s*$", "")
end

local function makeContainer(realTab, section, tabName, folderName)
    local container = {}

    function container:Label(text)
        return section:CreateLabel({
            Text = tostring(text or ""),
            Style = 1
        })
    end

    function container:Button(name, descriptionOrCallback, maybeCallback)
        local description, callback
        if type(descriptionOrCallback) == "function" then
            callback = descriptionOrCallback
        else
            description = descriptionOrCallback
            callback = maybeCallback
        end
        return section:CreateButton({
            Name = tostring(name or "Button"),
            Description = description and tostring(description) or nil,
            Callback = type(callback) == "function" and callback or function() end
        })
    end

    function container:Toggle(name, descriptionOrDefault, defaultOrCallback, maybeCallback)
        local description = nil
        local onByDefault = false
        local callback = nil

        if type(descriptionOrDefault) == "function" then
            callback = descriptionOrDefault
        else
            description = descriptionOrDefault
            if type(defaultOrCallback) == "boolean" then
                onByDefault = defaultOrCallback
                callback = maybeCallback
            elseif type(defaultOrCallback) == "function" then
                callback = defaultOrCallback
            end
        end

        callback = type(callback) == "function" and callback or function() end
        local key = controlKey(tabName, folderName, name)
        local saved = configGet(key, onByDefault)
        if type(saved) ~= "boolean" then saved = onByDefault end

        return section:CreateToggle({
            Name = tostring(name or "Toggle"),
            Description = description and tostring(description) or nil,
            CurrentValue = saved,
            Callback = function(value)
                callback(value)
                configSet(key, value == true)
            end
        }, key)
    end

    function container:Slider(name, currentValue, minimum, maximum, increment, callback)
        callback = type(callback) == "function" and callback or function() end
        local key = controlKey(tabName, folderName, name)
        local initial = configGet(key, tonumber(currentValue) or tonumber(minimum) or 0)
        if type(initial) ~= "number" then
            initial = tonumber(currentValue) or tonumber(minimum) or 0
        end

        return section:CreateSlider({
            Name = tostring(name or "Slider"),
            Range = { tonumber(minimum) or 0, tonumber(maximum) or 100 },
            Increment = tonumber(increment) or 1,
            CurrentValue = initial,
            Callback = function(value)
                callback(value)
                configSet(key, value)
            end
        }, key)
    end

    function container:Textbox(name, placeholder, callback)
        callback = type(callback) == "function" and callback or function() end
        local key = controlKey(tabName, folderName, name)
        local saved = configGet(key, "")
        if type(saved) ~= "string" then saved = tostring(saved or "") end

        local input = section:CreateInput({
            Name = tostring(name or "Input"),
            CurrentValue = saved,
            PlaceholderText = placeholder and tostring(placeholder) or "",
            RemoveTextAfterFocusLost = false,
            Numeric = false,
            Enter = true,
            Callback = function(value)
                callback(value)
                configSet(key, tostring(value or ""))
            end
        }, key)

        -- Luna does not fire input callbacks on creation. The old UI restored
        -- saved textbox values into feature state, so do the same only when saved.
        if configData[key] ~= nil and saved ~= "" then
            task.defer(function()
                pcall(callback, saved)
            end)
        end
        return input
    end

    function container:Dropdown(name, options, descriptionOrCallback, maybeCallback)
        options = type(options) == "table" and options or {}
        local description, callback
        if type(descriptionOrCallback) == "function" then
            callback = descriptionOrCallback
        else
            description = descriptionOrCallback
            callback = maybeCallback
        end
        callback = type(callback) == "function" and callback or function() end

        local key = controlKey(tabName, folderName, name)
        local fallback = options[1]
        local initial = configGet(key, fallback)
        if type(initial) ~= "string" or not table.find(options, initial) then
            initial = fallback
        end

        return section:CreateDropdown({
            Name = tostring(name or "Dropdown"),
            Description = description and tostring(description) or nil,
            Options = options,
            CurrentOption = initial and { initial } or {},
            MultipleOptions = false,
            Callback = function(value)
                local selected = type(value) == "table" and value[1] or value
                if selected ~= nil then
                    callback(selected)
                    configSet(key, selected)
                end
            end
        }, key)
    end

    function container:Banner(assetId, height)
        local parent = realTab.Page
        if not parent then return end

        local image = Instance.new("ImageLabel")
        image.Name = "FrierenBanner"
        image.BackgroundTransparency = 1
        image.BorderSizePixel = 0
        image.Size = UDim2.new(1, -25, 0, math.clamp(tonumber(height) or 180, 130, 210))
        image.Image = frierenAsset or ("rbxassetid://" .. tostring(assetId or 13308582899))
        image.ScaleType = Enum.ScaleType.Crop
        image.LayoutOrder = -50
        image.Parent = parent

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 7)
        corner.Parent = image

        if not frierenAsset then
            frierenTargets[#frierenTargets + 1] = image
            prepareFrierenAsset()
        end
        return image
    end

    return container
end

local function wrapTab(realTab, tabName)
    local tab = {}
    local defaultSection = nil
    local defaultContainer = nil

    local function getDefaultContainer()
        if not defaultContainer then
            defaultSection = realTab:CreateSection(tabName == "Home" and "Overview" or tabName)
            defaultContainer = makeContainer(realTab, defaultSection, tabName, "")
        end
        return defaultContainer
    end

    function tab:Folder(name, _color, _expanded)
        local folderName = tostring(name or "Section")
        local section = realTab:CreateSection(cleanSectionName(folderName))
        return makeContainer(realTab, section, tabName, folderName)
    end

    function tab:Label(...) return getDefaultContainer():Label(...) end
    function tab:Button(...) return getDefaultContainer():Button(...) end
    function tab:Toggle(...) return getDefaultContainer():Toggle(...) end
    function tab:Slider(...) return getDefaultContainer():Slider(...) end
    function tab:Textbox(...) return getDefaultContainer():Textbox(...) end
    function tab:Dropdown(...) return getDefaultContainer():Dropdown(...) end
    function tab:Banner(...) return getDefaultContainer():Banner(...) end

    tab.Instance = realTab.Page
    return tab
end

local function makeTab(name, icon)
    local realTab = Window:CreateTab({
        Name = name,
        ShowTitle = true,
        Icon = icon or "list",
        ImageSource = "Material"
    })
    return wrapTab(realTab, name)
end

