do
    local autoActivateState = {
        enabled = false,
        distance = 10,
        moveNumber = 1,
        m2Held = false,
        armed = true,
        waitingCooldown = false,
        cooldownSeen = false,
        cooldownObject = nil,
        cooldownSkill = nil,
        lastBall = nil,
        lastFire = 0,
        connection = nil,
        accumulator = 0
    }

    local autoActivateUIS = game:GetService("UserInputService")
    local autoActivateRunService = game:GetService("RunService")
    local autoActivatePlayers = game:GetService("Players")
    local autoActivateReplicatedStorage = game:GetService("ReplicatedStorage")
    local autoActivateRemote = autoActivateReplicatedStorage:WaitForChild("ByteNetReliable")
    local autoActivatePacket = buffer.fromstring(buffers["base"])
    local autoActivatePlayer = autoActivatePlayers.LocalPlayer

    local function isMobile()
        local ok, preferred = pcall(function()
            return autoActivateUIS.PreferredInput
        end)

        if ok then
            return preferred == Enum.PreferredInput.Touch
        end

        return autoActivateUIS.TouchEnabled
            and not autoActivateUIS.KeyboardEnabled
    end

    local function resetCycle()
        autoActivateState.armed = true
        autoActivateState.waitingCooldown = false
        autoActivateState.cooldownSeen = false
        autoActivateState.lastBall = nil
        autoActivateState.lastFire = 0
    end

    local function clearCooldown()
        autoActivateState.cooldownObject = nil
        autoActivateState.cooldownSkill = nil
    end

    local function getCooldown()
        local skillName = "skill" .. tostring(autoActivateState.moveNumber)

        if autoActivateState.cooldownObject
            and autoActivateState.cooldownObject.Parent
            and autoActivateState.cooldownSkill == skillName then

            return autoActivateState.cooldownObject
        end

        clearCooldown()

        local playerGui = autoActivatePlayer:FindFirstChild("PlayerGui")
        local hotbar = playerGui and playerGui:FindFirstChild("Hotbar")
        local backpack = hotbar and hotbar:FindFirstChild("Backpack")
        local slots = backpack and backpack:FindFirstChild("Hotbar")
        local slot = slots and slots:FindFirstChild(skillName)
        local cooldown = slot and slot:FindFirstChild("Cooldown", true)

        if cooldown and cooldown:IsA("GuiObject") then
            autoActivateState.cooldownObject = cooldown
            autoActivateState.cooldownSkill = skillName
            return cooldown
        end
    end

    local function cooldownState()
        local cooldown = getCooldown()

        if not cooldown then
            return false, false
        end

        return true, cooldown.Visible == true
    end

    local function canActivate()
        if not autoActivateState.enabled then
            return false
        end

        if isMobile() then
            return true
        end

        return autoActivateState.m2Held
    end

    local function fireMove(now)
        if now - autoActivateState.lastFire < 0.12 then
            return
        end

        autoActivateState.lastFire = now
        autoActivateState.armed = false
        autoActivateState.waitingCooldown = true
        autoActivateState.cooldownSeen = false

        autoActivateRemote:FireServer(
            autoActivatePacket,
            {
                {
                    "skill" .. autoActivateState.moveNumber
                }
            }
        )
    end

    local startAutoActivateLoop
    local stopAutoActivateLoop

    autoact:Textbox("Auto Activate Move Number", "Example: 1, 2, 3, 4, 5.", function(value)
        local number = tonumber(value)

        if number and number >= 1 and number <= 5 then
            autoActivateState.moveNumber = number
            clearCooldown()
            resetCycle()
        end
    end)

    autoact:Slider("Auto Activate Distance", 10, 3, 70, 0.5, function(value)
        autoActivateState.distance = value
    end)

    autoact:Toggle("Auto Activate", function(value)
        autoActivateState.enabled = value == true
        autoActivateState.m2Held = false
        clearCooldown()
        resetCycle()

        if autoActivateState.enabled then
            startAutoActivateLoop()
        else
            stopAutoActivateLoop()
        end
    end)

    autoActivateUIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or isMobile() then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            autoActivateState.m2Held = true

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end
    end)

    autoActivateUIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            autoActivateState.m2Held = false

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end
    end)

    autoActivatePlayer.CharacterAdded:Connect(function()
        clearCooldown()
        resetCycle()
    end)

    local function autoActivateStep(dt)
        if not autoActivateState.enabled then
            return
        end

        autoActivateState.accumulator += dt

        if autoActivateState.accumulator < (1 / 30) then
            return
        end

        autoActivateState.accumulator = 0

        local character = autoActivatePlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        local now = os.clock()
        local ball = workspace.Terrain:FindFirstChild("Ball")
        local cooldownKnown, cooldownActive = cooldownState()

        if autoActivateState.waitingCooldown then
            if cooldownKnown and cooldownActive then
                autoActivateState.cooldownSeen = true

            elseif autoActivateState.cooldownSeen and not cooldownActive then
                autoActivateState.waitingCooldown = false
                autoActivateState.cooldownSeen = false
                autoActivateState.armed = true
            end
        end

        if not ball then
            autoActivateState.lastBall = nil

            if autoActivateState.waitingCooldown
                and not autoActivateState.cooldownSeen
                and now - autoActivateState.lastFire >= 0.2 then

                autoActivateState.waitingCooldown = false
                autoActivateState.armed = true

            elseif not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end

            return
        end

        if autoActivateState.lastBall ~= ball then
            autoActivateState.lastBall = ball

            if not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end

        local delta = root.Position - ball.Position
        local distanceSq = delta:Dot(delta)
        local triggerDistance = autoActivateState.distance
        local inRange = distanceSq <= triggerDistance * triggerDistance
        local exitDistance = triggerDistance
            + math.max(1.5, triggerDistance * 0.08)

        if distanceSq > exitDistance * exitDistance then
            if autoActivateState.waitingCooldown
                and not autoActivateState.cooldownSeen
                and now - autoActivateState.lastFire >= 0.2 then

                autoActivateState.waitingCooldown = false
                autoActivateState.armed = true

            elseif not autoActivateState.waitingCooldown then
                autoActivateState.armed = true
            end
        end

        if not canActivate()
            or not inRange
            or not autoActivateState.armed
            or autoActivateState.waitingCooldown
            or cooldownActive then

            return
        end

        fireMove(now)
    end

    stopAutoActivateLoop = function()
        if autoActivateState.connection then
            autoActivateState.connection:Disconnect()
            autoActivateState.connection = nil
        end

        autoActivateState.accumulator = 0
    end

    startAutoActivateLoop = function()
        stopAutoActivateLoop()

        autoActivateState.connection =
            autoActivateRunService.Heartbeat:Connect(
                autoActivateStep
            )
    end
end

