local function magnetWorldCharacter(name)
    local characters = Workspace:FindFirstChild("characters")
    return characters and characters:FindFirstChild(name)
end

local function magnetTeam(name)
    local char = magnetWorldCharacter(name)
    local state = char and char:FindFirstChild("state")
    local team = state and state:FindFirstChild("team")
    return team and team.Value or nil
end

local function magnetBall()
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    local ball = terrain and terrain:FindFirstChild("Ball")
    if ball then return ball end
    return Workspace:FindFirstChild("Ball")
end

local function volleyAnimationPlaying(humanoid)
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then return false end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local animation = track.Animation
        local id = animation and tostring(animation.AnimationId):match("%d+")
        if id and BALL_MAGNET_VOLLEY_IDS[id] then
            return true
        end
    end

    return false
end

local function inGoalbox(position, team)
    if team == "A" then
        return position.X >= -668.15
            and position.X <= -407.51
            and position.Z >= 1611.19
            and position.Z <= 1706.13
    elseif team == "B" then
        return position.X >= -668.01
            and position.X <= -407.68
            and position.Z >= 841.7
            and position.Z <= 935.59
    end

    return false
end

local function magnetGKEligible(root)
    if not ballMagnetState.GKAndGoalboxOnly then
        return true
    end

    local worldChar = magnetWorldCharacter(Players.LocalPlayer.Name)
    local state = worldChar and worldChar:FindFirstChild("state")
    local roleValue = state and state:FindFirstChild("role")

    if not roleValue or tostring(roleValue.Value) ~= "GK" then
        return false
    end

    return inGoalbox(root.Position, magnetTeam(Players.LocalPlayer.Name))
end

local function destroyMagnetRange()
    if ballMagnetState.RangeConnection then
        ballMagnetState.RangeConnection:Disconnect()
        ballMagnetState.RangeConnection = nil
    end

    if ballMagnetState.RangeFolder then
        pcall(function() ballMagnetState.RangeFolder:Destroy() end)
    end

    ballMagnetState.RangeFolder = nil
    ballMagnetState.RangeBase = nil
end

local function startMagnetRange()
    destroyMagnetRange()

    local folder, base = createFlatRangeRing(
        "BallMagnet_Range",
        Color3.fromRGB(70, 190, 255),
        Color3.fromRGB(150, 235, 255)
    )

    ballMagnetState.RangeFolder = folder
    ballMagnetState.RangeBase = base

    ballMagnetState.RangeConnection = RunService.RenderStepped:Connect(function()
        if not ballMagnetState.ShowRange then return end

        local char = Players.LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local team = magnetTeam(Players.LocalPlayer.Name)

        if not root or not team or team == "lobby" then
            base.Parent = nil
            return
        end

        if base.Parent ~= folder then
            base.Parent = folder
        end

        local diameter = ballMagnetState.MagnetRange * 2
        base.Size = Vector3.new(diameter, 0.05, diameter)
        base.CFrame = CFrame.new(
            root.Position - Vector3.new(0, 3.2, 0)
        )
    end)
end

local function stopBallMagnet()
    ballMagnetState.Enabled = false

    if ballMagnetState.Connection then
        ballMagnetState.Connection:Disconnect()
        ballMagnetState.Connection = nil
    end
end

local function startBallMagnet()
    stopBallMagnet()
    ballMagnetState.Enabled = true

    ballMagnetState.Connection = RunService.Heartbeat:Connect(function()
        if not ballMagnetState.Enabled then return end

        if ballMagnetState.RequireHoldKey
            and not ballMagnetState.HoldKeyDown then
            return
        end

        local char = Players.LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not humanoid then return end
        if volleyAnimationPlaying(humanoid) then return end
        if not magnetGKEligible(root) then return end

        local ball = magnetBall()
        if not ball or not ball:IsA("BasePart") then return end

        if (root.Position - ball.Position).Magnitude
            > ballMagnetState.MagnetRange then
            return
        end

        if ballMagnetRemote then
            pcall(function()
                ballMagnetRemote:FireServer(
                    packetBufferOneByte("bytenet_findBall", 29, false)
                )
            end)
        end
    end)
end

ballmag:Toggle("Ball Magnet", nil, false, function(value)
