            char = p.Character
            if not char then continue end
            hum = char:FindFirstChild("Humanoid")
            hrp = char:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > 0 then
                screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
