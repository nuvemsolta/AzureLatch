                local ok, list = pcall(getconnections, signal)
                if ok and type(list) == "table" then
                    for _, connection in ipairs(list) do
                        if type(connection.Fire) == "function" then
                            pcall(function() connection:Fire() end)
                            fired = true
                        elseif type(connection.Function) == "function" then
                            pcall(function() connection:Function() end)
                            fired = true
                        end
                    end
                end
            end
        end

        if fired then return end

        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local center = button.AbsolutePosition + button.AbsoluteSize / 2
            vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
            vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
        end)
    end

    local function cancelPrompt()
        activePrompt = false
        lastButton = nil
        promptToken += 1
    end

    local function beginPrompt(startedAt, knownButton)
        if not qteEnabled or activePrompt then return end

        activePrompt = true
        lastButton = knownButton
        promptToken += 1
        local myToken = promptToken
        local delayTime = isDonLorenzo() and DON_QTE_DELAY or NORMAL_QTE_DELAY
        local targetTime = (startedAt or os.clock()) + delayTime

        task.spawn(function()
            while qteEnabled and myToken == promptToken do
                local remaining = targetTime - os.clock()
                if remaining <= 0 then break end
                task.wait(math.max(math.min(remaining, 0.05), 0.005))
            end

            if not qteEnabled or myToken ~= promptToken then return end

            local visible, _, _, liveButton = promptIsVisible()
            if visible and liveButton then
                fireButton(liveButton)
            end

            activePrompt = false
        end)
    end

    local function probeQTE(eventTime)
        if not qteEnabled then return end

        local visible, _, _, button = promptIsVisible()
        if not visible then
            if activePrompt then cancelPrompt() end
            return
        end

        if not activePrompt then
            beginPrompt(eventTime or os.clock(), button)
        elseif button and lastButton ~= button then
            lastButton = button
        end
    end

    local function disconnectWatched()
        for i = #watchedConnections, 1, -1 do
            local connection = watchedConnections[i]
            if connection then connection:Disconnect() end
            watchedConnections[i] = nil
        end

        if qteDescendantConnection then
            qteDescendantConnection:Disconnect()
            qteDescendantConnection = nil
        end
    end

    local function watchVisibility(object)
        if not object then return end

        if object:IsA("ScreenGui") then
            watchedConnections[#watchedConnections + 1] = object:GetPropertyChangedSignal("Enabled"):Connect(function()
                if qteEnabled then probeQTE(os.clock()) end
            end)
        elseif object:IsA("GuiObject") then
            watchedConnections[#watchedConnections + 1] = object:GetPropertyChangedSignal("Visible"):Connect(function()
                if qteEnabled then probeQTE(os.clock()) end
            end)
        end
    end

    local function refreshQTEWatchers()
        if not qteEnabled then return end

        local qteGui, qteGroup, button = findQTE()
        if qteGui ~= currentQteGui
            or qteGroup ~= currentQteGroup
            or button ~= currentQteButton then
            disconnectWatched()
            currentQteGui = qteGui
            currentQteGroup = qteGroup
            currentQteButton = button

            if qteGui then
                watchVisibility(qteGui)
                watchVisibility(qteGroup)
                watchVisibility(button)

                qteDescendantConnection = qteGui.DescendantAdded:Connect(function(object)
                    if object.Name == "QTE"
                        or object.Name == "CanvasGroup"
                        or object.Name == "Button" then
                        task.defer(function()
                            if qteEnabled then
                                refreshQTEWatchers()
                                probeQTE(os.clock())
                            end
                        end)
                    end
                end)
            end
        end
    end

    local function disconnectQTE()
        generation += 1
        if playerGuiConnection then
            playerGuiConnection:Disconnect()
            playerGuiConnection = nil
        end
        disconnectWatched()
        currentQteGui = nil
        currentQteGroup = nil
        currentQteButton = nil
        cancelPrompt()
    end

    local function setQTEEnabled(value)
        qteEnabled = value == true
        disconnectQTE()
        if not qteEnabled then return end

        generation += 1
        local myGeneration = generation

        playerGuiConnection = playerGui.DescendantAdded:Connect(function(object)
            if not qteEnabled then return end

            if object.Name == "Qte" or object.Name == "QTE" then
                task.defer(function()
                    if qteEnabled then
                        refreshQTEWatchers()
                        probeQTE(os.clock())
                    end
                end)
                return
            end

            if currentQteGui
                and object:IsDescendantOf(currentQteGui)
                and (object.Name == "CanvasGroup" or object.Name == "Button") then
                task.defer(function()
                    if qteEnabled then
                        refreshQTEWatchers()
                        probeQTE(os.clock())
                    end
                end)
            end
        end)

        refreshQTEWatchers()
        task.defer(probeQTE)

        task.spawn(function()
            while qteEnabled and generation == myGeneration do
                probeQTE()
                task.wait(0.15)
            end
        end)
    end

    othersil:Toggle(
        "Auto QuickTimeEvent",
        "Automatically Does QuickTimeEvents.",
        function(value)
            setQTEEnabled(value)
        end
    )
end


